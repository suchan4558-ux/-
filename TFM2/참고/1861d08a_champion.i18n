    "description": {
      "astrologer": {
        "name": "Kilo Hōkū",
        "skill": "Ma hope o <#ffb900ff>{Delay}<> kekona, hoʻokuʻu i kekahi hōkū lele ma kahi i koho ʻia, e hāʻawi ana i <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> o ka mana mākau ma ke ʻano he pōʻino kilokilo i nā ʻenemi ma loko o ka ʻāpana, a e hoʻēmi ana i ko lākou māmā neʻe e <#ef5350ff>{Slow}%<> no <#ef5350ff>{SlowTime}<> kekona.",
        "skill2": "Hāʻawi i <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> o ka mana mākau ma ke ʻano he pōʻino kilokilo i nā ʻenemi ma kahi laina a waiho i ka hōʻailona pūʻulu hōkū. Ke mau nei ka hōʻailona no <#ffb900ff>{MarkTime}<> kekona, a loaʻa i nā ʻenemi i hōʻailona ʻia ka pōʻino hou mai ka pahū pūʻulu hōkū o ka hana piha.",
        "ult": "Kahakiʻi i ka pūʻulu hōkū ma ka ʻāpana i koho ʻia a hōʻailona i nā ʻenemi a pau. Ma hope o <#ffb900ff>{Delay}<> kekona, pahū pū nā hōʻailona, e hāʻawi ana i <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> o ka mana mākau ma ke ʻano he pōʻino kilokilo. Hoʻonui ʻia ka pōʻino e <#ffb900ff>{Amplify}%<> no kēlā me kēia ʻenemi hou i hoʻohui ʻia. Loaʻa i nā ʻenemi i hōʻailona mua ʻia he <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> o ka Mana Kilo ma ke ʻano he poino hou."
      },
      "archer": {
        "name": "Mea Pana Pua",
        "skill": "ma ke kuhikuhi i koho ʻia lele ana i ka ʻenemi i paʻi hope ʻia <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "skill2": "i kekahi ʻenemi kokoke e pana ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ef5350ff>hoʻoluli<> hoʻi i hope.",
        "ult": "piha {Count}. {Range} i loko o ka palena i kekahi ʻenemi wale, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>."
      },
      "bard": {
        "name": "Inoa",
        "skill": "o kekahi hoa hui <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> <#ffb900ff>{Duration}kekona<> no hoʻonui.",
        "skill2": "ma loko o ka palena mākau manawa kali hou {Duration}kekona no <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> emi.",
        "ult": "<#ffb900ff>{Duration}kekona<> no kokoke {Range} palena koa <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>hoʻouka {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {AttackRatio}%<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>kilokilo {MagicPower}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}%<>, mākau manawa kali hou {CoolReduce}%, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pale {DefenceReduce}%<> <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>kūʻē kilokilo {MagicResistanceReduce}%<> emi."
      },
      "barrier_magician": {
        "name": "Inoa",
        "skill": "ma kahi i koho ʻia <#ffb900ff>{Duration}kekona<> no e hoʻonoho ana <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {ShieldCoef}%<> e like me <#e8d44dff>pale kaua<> <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeedReduce}%<>. pae 3 palena <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka<> hou <#ef5350ff>hoʻolohi<>.",
        "skill2": "ma kahi i koho ʻia <#ffb900ff>{Duration}kekona<> no e kāhea ana.",
        "ult": "koa kokoke. <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> e like me <#a974ffff>pōʻino kilokilo<> <#ef5350ff>{Time}kekona no pōniuniu<>."
      },
      "berserker": {
        "name": "Inoa",
        "skill": "{Duration}kekona no minuke <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}% <> <#6aff55ff>{Vamp}% ʻai ola<> loaʻa.",
        "skill2": "palena ka ʻenemi <#ef5350ff>{Time}kekona no lele ʻia<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "ult": "{Range} mamao i ka ʻenemi e lele wiki ana ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>ola<> manawa kali hou emi."
      },
      "boomerang_hunter": {
        "name": "Inoa",
        "skill": "ma ke ala pololei e kiola ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. mamao lā hola manawa, i ka ʻenemi <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {DotCoef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "skill2": ". <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "ult": "ma ke ala pololei e pana ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. koa koa lumi, pōʻino <#ff9028ff>{Increase}%<> piʻi. palena kiʻekiʻe {MaxBounce}manawa."
      },
      "chef": {
        "name": "Inoa",
        "skill": "ma ke ala pololei e kiola ana <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> e like me <#a974ffff>pōʻino kilokilo<> <#ef5350ff>{SlowTime}kekona no {Slow}% hoʻolohi<>.",
        "skill2": "i nā hoa hui kokoke <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {HealCoef}%<> <#6aff55ff>ola hoʻōla<>. hoʻōla hoʻōla <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {SelfHealCoef}%<> piʻi.",
        "ult": "i ka koa hoa hui e kiola ana <#ffb900ff>{Duration}kekona<> no <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>ola kiʻekiʻe {HpRatio}% <>. pōʻino <#e8d44dff>{SpreadRatio}%<> pōʻino minuke."
      },
      "clown": {
        "name": "Inoa",
        "skill": "e neʻe koke ana lā <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ffb900ff>{Duration}kekona<> no <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>māmā neʻe {MoveSpeed}% <>.",
        "skill2": "kokoke i loko o ka palena i ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. (mākau )",
        "ult": "<#ffb900ff>{Time}kekona<> no kūlana nā mea a pau i ka ʻenemi."
      },
      "dancer": {
        "name": "Inoa",
        "skill": "i ka ʻenemi e kiola ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. hou 1mea mākau pōʻino {StackCoef}% piʻi.",
        "skill2": "ka ʻenemi lā hoʻouka 1mea hou. (palena kiʻekiʻe <#ffb900ff>{MaxCount}<>mea, hou pōʻino hoʻouka <#ffb900ff>{Reduce}%<> )",
        "ult": "lumi {Count}(+) hou puka e pana ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {ReturnCoef}%<> e like me <#ff9028ff>pōʻino kino<> hou. (palena kiʻekiʻe {MaxCount}mea)"
      },
      "dark_mage": {
        "name": "Inoa",
        "skill": "ma ke ala pololei e pana ana i ka ʻenemi i pā ʻia <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> e like me <#a974ffff>pōʻino kilokilo<> <#ef5350ff>{Time}kekona no paʻa<>.",
        "skill2": "lā palena i loko o ka palena i ka ʻenemi <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> e like me <#a974ffff>pōʻino kilokilo<>.",
        "ult": "{Range} i loko o ka palena koa <#ffb900ff>{Duration}kekona<> no koa pilina. pilina pōʻino <#a974ffff>{ShareRatio}%<> pilina."
      },
      "demon": {
        "name": "Inoa",
        "skill": "ka ʻenemi. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> kūlana.",
        "skill2": "{Time}kekona no hoʻololi kino. no <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>hoʻouka {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pale {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>māmā neʻe {MoveSpeed}%<> piʻi.",
        "ult": "kokoke {Range} i loko o ka palena nā mea a pau i ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>, <#ef5350ff>{Time}kekona no makaʻu<> hāʻawi."
      },
      "dual_blader": {
        "name": "Inoa",
        "skill": "ma ke ala pololei e pana ana i ka ʻenemi i pā ʻia <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>, <#ef5350ff>{Time}kekona no paʻa<>.",
        "skill2": "<#ef5350ff> <> kūlana {Range} i loko o ka palena i ka ʻenemi e lele wiki ana ka ʻenemi <#ef5350ff>{Time}kekona no lele ʻia<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "ult": "{Range} i loko o ka palena one {Count} <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#f5f5f5ff>pōʻino ʻoiaʻiʻo<>."
      },
      "executioner": {
        "name": "Inoa",
        "skill": "e pana ana i ka ʻenemi i pā ʻia <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>.",
        "skill2": "<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ef5350ff>{Duration}kekona no koko kahe<>. koko kahe pōʻino {Tick}kekona <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {TickCoef}%<> e like me <#ff9028ff>pōʻino kino<>, pōʻino <#ef5350ff>{Debuff}% <>.",
        "ult": "lumi {Range} palena ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>, <#ef5350ff>{Time}kekona no pale hoʻōla<> kūlana."
      },
      "exorcist": {
        "name": "Inoa",
        "skill": "o kekahi hoa hui <#ef5350ff>kūlana<> ola <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> <#6aff55ff>hoʻōla<>. Removes stun, sleep, root, fear, charm, taunt, airborne and forced movement. Does not remove buff-based effects such as slows or poison.",
        "skill2": "1poʻe <#ffb900ff>{Duration}kekona<> no <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>hoʻouka {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}%<> hoʻonui. no mākau hopena hoʻohana.",
