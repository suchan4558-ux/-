    "description": {
      "astrologer": {
        "name": "占星术师",
        "skill": "在指定位置于<#ffb900ff>{Delay}秒<>后召唤陨星坠落，对范围内的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<><#a974ffff>魔法伤害<>，并使其移动速度降低<#ef5350ff>{Slow}%<>，持续<#ef5350ff>{SlowTime}秒<>。",
        "skill2": "对直线上的敌人造成<#a974ffff>{LinkDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<><#a974ffff>魔法伤害<>，并留下星座标记。标记持续<#ffb900ff>{MarkTime}秒<>，带有标记的敌人会在终极技能的星座爆炸中受到额外伤害。",
        "ult": "在指定范围内绘制星座，为所有敌人留下标记。<#ffb900ff>{Delay}秒<>后，所有标记同时爆炸，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<><#a974ffff>魔法伤害<>。每多连接一名敌人，伤害提高<#ffb900ff>{Amplify}%<>。 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>已带有印记的敌人额外受到法术强度{MarkCoef}%<>的伤害。"
      },
      "archer": {
        "name": "弓箭手",
        "skill": "弓箭手向指定方向跳跃，对最近的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "向附近敌人发射重箭造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，使其短暂<#ef5350ff>眩晕<>并向后跳跃拉开距离。",
        "ult": "原地瞄准，发射共{Count}支箭。箭矢随机飞向附近{Range}范围内的敌人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。"
      },
      "bard": {
        "name": "吟游诗人",
        "skill": "为一名己方英雄增加<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>的<#ceff99ff>攻击速度<>，持续<#ffb900ff>{Duration}秒<>。",
        "skill2": "指定范围内的己方英雄技能冷却时间在{Duration}秒内减少<#ffb900ff>{CoolReduce}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>内持续引导，使周围{Range}范围内友方英雄的<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}%法术强度<>)点，<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度增加{MagicPower}<>点，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度增加{AttackSpeed}%<>，技能冷却时间减少{CoolReduce}%。但同时，友方英雄的<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>护甲减少{DefenceReduce}%<>，<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抗性减少{MagicResistanceReduce}%<>。"
      },
      "barrier_magician": {
        "name": "结界术师",
        "skill": "创造一个维持<#ffb900ff>{Duration}秒<>的结界，为结界内的友方英雄提供<#e8d44dff>{Shield}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%法术强度<>的<#e8d44dff>护盾<>，并降低敌人<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeedReduce}%攻击速度<>。结界从3级起范围扩大，结界内的队友将获得额外<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度<>，结界内的敌人还会被<#ef5350ff>减速<>。",
        "skill2": "创造一个维持<#ffb900ff>{Duration}秒<>的屏障结界，消除进入结界内部的所有投射物。",
        "ult": "在敌方英雄周围设置一个逐渐缩小的圆形结界。触碰结界边缘的敌人将受到<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>并被<#ef5350ff>晕眩{Time}秒<>。"
      },
      "berserker": {
        "name": "狂战士",
        "skill": "进入狂怒状态，持续{Duration}秒，期间<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度上升{AttackSpeed}%<>并获得<#6aff55ff>{Vamp}%吸血<>。",
        "skill2": "持双斧重击地面，将小范围内的敌人<#ef5350ff>击飞{Time}秒<>并造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "向{Range}距离内指定的敌人冲锋并对其猛击，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。该技能的冷却时间会根据失去的<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>生命值<>成比例减少。"
      },
      "boomerang_hunter": {
        "name": "回旋镖手",
        "skill": "向直线方向投掷回旋镖，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。回旋镖在射程末端旋转一段时间，对触碰到的敌人持续造成<#ff9028ff>{DotDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "向三个方向投掷回旋镖，回旋镖飞到尽头后返回，对路径上所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "向前甩出弹力回旋镖，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。命中敌方英雄时，向最近的另一名敌方英雄方向反弹，每次反弹伤害增加<#ff9028ff>{Increase}%<>。最多反弹{MaxBounce}次。"
      },
      "chef": {
        "name": "厨师",
        "skill": "沿直线丢出菜刀，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使敌人<#ef5350ff>减速{Slow}%持续{SlowTime}秒<>。",
        "skill2": "向周围己方英雄分发料理，持续回复<#6aff55ff>{Heal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法术强度<>点<#6aff55ff>生命值<>。仅有自己受到治疗时，治疗量增加为<#6aff55ff>{SelfHeal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}%法术强度<>。",
        "ult": "向己方英雄投喂特别料理。使其在<#ffb900ff>{Duration}秒<>内<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值增加{HpRatio}%<>。受到伤害的<#e8d44dff>{SpreadRatio}%<>分散成持续伤害。"
      },
      "clown": {
        "name": "小丑",
        "skill": "瞬间移动到目标旁。若目标为敌人，则造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并获得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移动速度<>持续<#ffb900ff>{Duration}秒<>。",
        "skill2": "向周围掷出大量短剑，对范围内敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。(施放期间小丑可自由移动)",
        "ult": "<#ffb900ff>{Time}秒<>内进入狂热演出状态，所有短剑变为可在敌人间反弹的特殊短剑。"
      },
      "dancer": {
        "name": "舞姬",
        "skill": "向敌人投掷环刃，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。每个额外环刃都会使此技能伤害提高{StackCoef}%。",
        "skill2": "每次参与击杀后为普通攻击追加相应个数的环刃。(最多<#ffb900ff>{MaxCount}<>个，每当一个追加环刃命中，伤害降低<#ffb900ff>{Reduce}%<>)",
        "ult": "向扇形范围发射{Count}(+额外环刃数)个穿透环刃，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。环刃回归时造成<#ff9028ff>{ReturnDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}%攻击力<>点<#ff9028ff>物理伤害<>。(最多{MaxCount}个)"
      },
      "dark_mage": {
        "name": "黑魔法师",
        "skill": "发射黑暗法箭，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并将敌人<#ef5350ff>禁锢{Time}秒<>。",
        "skill2": "在短暂延迟后，使指定区域陷入黑暗，对区域内敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点 <#a974ffff>魔法伤害<>。",
        "ult": "对{Range}范围内的一位敌方英雄施加诅咒，使其自动连接到距离其最近的另一敌方单位<#ffb900ff>{Duration}秒<>。当连接目标受到伤害时，另一名连接目标也会受到<#a974ffff>{ShareRatio}%<>的伤害。"
      },
      "demon": {
        "name": "恶魔",
        "skill": "召唤地狱之爪从地底涌出。命中时造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并与敌人互换位置。",
        "skill2": "变身为大恶魔，持续 {Time}秒。变身期间，<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>， <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力增加{Defense}<>，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度增加{AttackSpeed}%<>，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{MoveSpeed}%<>。",
        "ult": "对周围{Range}范围内的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并施加<#ef5350ff>{Time}秒恐惧<>。"
      },
      "dual_blader": {
        "name": "双刀客",
        "skill": "沿直线挥出风刃，对命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并<#ef5350ff>禁锢<>目标{Time}秒。",
        "skill2": "向{Range}范围内处于<#ef5350ff>不可移动<>状态的敌人突进，将命中的敌人<#ef5350ff>击飞<>{Time}秒并造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "用双刀飞速斩击指定{Range}范围内的敌人，造成{Count}次 <#f5f5f5ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#f5f5f5ff>真实伤害<>。"
      },
      "executioner": {
        "name": "处刑人",
        "skill": "投掷弯钩，对命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>并将其拉到自己面前。",
        "skill2": "用弯钩撕裂1名敌人，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并施加<#ef5350ff>{Duration}秒流血<>效果。流血伤害每{Tick}秒造成<#ff9028ff>{TickDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>受到伤害提高{Debuff}%<>。",
        "ult": "用弯钩扫掠{Range}前方半圆形区域内的敌人，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其在<#ef5350ff>{Time}秒内无法恢复生命值<>。"
      },
      "exorcist": {
        "name": "驱魔师",
        "skill": "解除一名己方英雄的<#ef5350ff>负面状态<>，并使其<#6aff55ff>恢复{Heal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#6aff55ff>生命值<>。 可解除眩晕、睡眠、禁锢、恐惧、魅惑、嘲讽、击飞和强制位移；无法解除以增益或减益形式施加的效果，例如减速或中毒。",
        "skill2": "为一名己方英雄降下神之庇护，使其在<#ffb900ff>{Duration}秒<>内<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>,<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度增加{AttackSpeed}%<>。持续期间若受到控制技能影响，则会反射该控制效果，并施加给对方。",
        "ult": "在指定区域爆发圣光，对范围内敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。敌人每拥有一个增益效果，额外造成<#a974ffff>{BonusDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}%法术强度<>点追加伤害。"
      },
      "fighter": {
        "name": "格斗家",
        "skill": "以{Speed}的速度冲向{Range}距离内的目标，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>眩晕{Stun}秒<>。",
        "skill2": "用脚猛踏地面，对周围 {Range} 范围内的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>减速{Slow}%，持续{SlowTime}秒<>。",
        "ult": "猛击地面，对周围{Range}范围内的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并将其<#ef5350ff>击飞{Time}秒<>。"
      },
      "gambler": {
        "name": "赌徒",
        "skill": "掷骰子并以骰子点数相同的次数抛出银币攻击{Range}范围内的敌人。每枚银币造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "掷出筹码，在{Range}范围内生成一个大小为{AttackRange}的<#ef5350ff>{Slow}%减速<>区域，持续{Time}秒。区域消失时会爆炸，对范围内敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "抛出大量金币，沿直线魅惑敌人。被击中的敌人受到<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并被<#ef5350ff>魅惑{Time}秒<>。"
      },
      "ghost": {
        "name": "幽灵",
        "skill": "进入无法选中状态，并沿直线突进。每次参与击杀敌人时，<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力永久增加{Attack}<>，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度永久增加{AttackSpeed}%<>，并<#6aff55ff>恢复{Heal}生命值<>。",
        "skill2": "向前短距离突进，对首个碰撞到的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。最多可连续使用{Time}次。",
        "ult": "在<#ffb900ff>{Time}秒<>内免疫移动控制效果。每次参与击杀敌人时，重置基础技能的冷却时间。"
      },
      "gunner": {
        "name": "快枪手",
        "skill": "移动时也可攻击敌人。到达3级后，每次攻击敌人时，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{Value}%<>，持续{Time}秒。",
        "skill2": "强化攻击，持续{Time}秒。期间，<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>，且每第3次攻击时，子弹会使敌人<#ef5350ff>减速{Slow}%，持续{SlowTime}秒<>。",
        "ult": "强化攻击，持续{Time}秒。期间，<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力增加{Attack}<>，并会向攻击目标周围的2名敌人额外发射子弹。额外子弹造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。"
      },
      "ice_mage": {
        "name": "寒冰法师",
        "skill": "冻结一名敌人，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使其<#ef5350ff>眩晕{Time}秒<>。",
        "skill2": "召唤一片持续{Duration}秒的寒域，使{Range}范围内的敌人<#ef5350ff>移动速度降低{MoveSpeed}%<>，寒域每{Tick}秒造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。寒域消失时，冻结范围内的敌人，使其<#ef5350ff>眩晕{Stun}秒<>。",
        "ult": "释放冰暴，对前方扇形范围内的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并将其击退。随后使其<#ef5350ff>减速{Slow}%，持续{SlowDuration}秒<>，并使其在<#ef5350ff>{BlockDuration}秒<>内无法使用位移技能。"
      },
      "illusionist": {
        "name": "幻术师",
        "skill": "抛掷迷惑敌人的投射物，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并在敌人面前形成幻术师的分身，使其<#ef5350ff>嘲讽{Time}秒<>。",
        "skill2": "对{Range}范围内的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并施加<#ef5350ff>{Time}秒恐惧<>。",
        "ult": "制造一名附近己方英雄的幻影，持续<#ffb900ff>{Duration}秒<>。幻影只能进行普通攻击，并拥有与被复制英雄相同的属性。"
      },
      "jiangshi": {
        "name": "僵尸",
        "skill": "召唤小僵尸扑向敌人并造成伤害。小僵尸会在攻击3次后消失，每次攻击造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "猛击敌人，使其<#ef5350ff>眩晕{Time}秒<>，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并<#6aff55ff>恢复{Heal}生命值<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>内，从周围{Range}范围内的敌人身上吸取<#6aff55ff>{Heal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法术强度<>点<#6aff55ff>生命值<>，并造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}%法术强度<>点<#a974ffff>魔法伤害<>。"
      },
      "knight": {
        "name": "骑士",
        "skill": "挑衅一名目标，使其受到<#ef5350ff>{Time}秒嘲讽<>。",
        "skill2": "为自身施加一个持续{Time}秒的<#e8d44dff>护盾<>(<#e8d44dff>护盾<>值为：<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}%最大生命值<>+<#e8d44dff>{Amount}<>)。护盾存在期间，<#ff9028ff>反射{Reflect}%所受伤害<>。",
        "ult": "召唤一个范围为{Range}的守护领域，持续<#ffb900ff>{Time}秒<>。区域内的己方单位受到的伤害降低<#e8d44dff>{Coef}%<>+<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值的{HpCoef}%<>。区域内的敌方单位被<#ef5350ff>减速{MoveSpeedReduce}%<>。"
      },
      "lancer": {
        "name": "长枪兵",
        "skill": "挥舞长枪，击退周围{Range}范围内的敌人，并造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "挺枪突进，对敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}%攻击力<>点<#ff9028ff>物理伤害<>，并穿过敌人移动至其身后。",
        "ult": "向前突进{Range}距离，对突进过程中碰撞到的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并将其<#ef5350ff>击飞{Time}秒<>。"
      },
      "lightning_mage": {
        "name": "雷电法师",
        "skill": "向指定敌人施放闪电，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。若范围内存在其他目标，闪电会继续扩散，但不会多次作用于同一目标。",
        "skill2": "在指定范围内降下雷霆，对命中的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使其<#ef5350ff>眩晕{Time}秒<>。",
        "ult": "对敌方英雄引导闪电光束<#ffb900ff>{Duration}秒<>。引导期间使目标<#ef5350ff>眩晕<>，并对周围敌人持续造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。"
