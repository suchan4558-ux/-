    "description": {
      "gladiator": {
        "name": "Gladiator",
        "skill": "Throw a net in a <#ffb900ff>{FanAngle}<>-degree cone, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>rooting<> enemies for <#ffb900ff>{Stun}s<>.",
        "skill2": "Thrust forward for <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<>. Hitting the same champion again within <#ffb900ff>{Time}s<> adds <#ffb900ff>{Amplify}%<> damage per stack, up to <#ffb900ff>{MaxAmplifyTargets}<> stacks. Hitting another champion resets the chain.",
        "ult": "Rush an enemy champion, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>taunting<> for <#ffb900ff>{Stun}s<>. The target cannot heal or gain new shields. Damage to the Gladiator from other enemies is reduced by <#ffb900ff>{Amplify}%<>. Cleansing the taunt or killing the target ends the duel."
      },
      "ferryman": {
        "name": "Ferryman",
        "skill": "Throw an anchor at the first champion in its path. Pull an ally at or below <#ffb900ff>{AllyHpRatio}%<> health to your side and grant <#ffb900ff>{Amplify}%<> movement speed for <#ffb900ff>{Time}s<>; healthier allies are passed over. Enemies instead take <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> and are slowed by <#ffb900ff>{Slow}%<> for <#ffb900ff>{SlowTime}s<>.",
        "skill2": "Create a river of length <#ffb900ff>{Range}<> and width <#ffb900ff>{Width}<> for <#ffb900ff>{Time}s<>. Allies on it gain <#ffb900ff>{Amplify}%<> movement speed; enemies are slowed by <#ffb900ff>{Slow}%<>.",
        "ult": "Cleanse an allied champion other than yourself at or below <#ffb900ff>{AllyHpRatio}%<> health, then ferry them <#ffb900ff>{MoveDistance}<> toward your base over <#ffb900ff>{Time}s<>. The passenger is untargetable, cannot act, and is immune to movement control. On landing, heal <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% AP<> and grant <#ffb900ff>{Slow}%<> movement speed for <#ffb900ff>{SlowTime}s<>."
      },
      "bombardier": {
        "name": "Bombardier",
        "skill": "Deploy or pack the cannon. Deployment prevents movement, adds <#ffb900ff>{MoveDistance}<> basic attack and skill 2 range, and grants <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% AD<>. Packing grants <#ffb900ff>{Slow}%<> movement speed for <#ffb900ff>{Time}s<>.",
        "skill2": "Lob a shell at the target location, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> in a radius of <#ffb900ff>{Radius}<> and slowing enemies by <#ffb900ff>{Slow}%<> for <#ffb900ff>{SlowTime}s<>. Deployment increases cast range.",
        "ult": "Fire <#ffb900ff>{ProjectileCount}<> shells across the chosen area. Each deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>physical damage<> in a radius of <#ffb900ff>{ProjectileRadius}<>. Deployment adds a further <#ffb900ff>{MoveDistance}<> cast range. Crowd control interrupts the remaining shots."
      },
      "hypnotist": {
        "name": "Hypnotist",
        "skill": "Send a piercing pendulum forward for <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% AP<> <#a974ffff>magic damage<> and a <#ffb900ff>{Slow}%<> slow lasting <#ffb900ff>{SlowTime}s<>. This damage does not wake <#ef5350ff>sleep<>ing enemies.",
        "skill2": "After <#ffb900ff>{Delay}s<>, put enemies within radius <#ffb900ff>{Radius}<> to <#ef5350ff>sleep<> for <#ffb900ff>{Time}s<>. Sleep prevents movement and actions. Damage, including damage over time, wakes the target and that first hit deals <#ffb900ff>{Amplify}%<> increased damage.",
        "ult": "After <#ffb900ff>{Delay}s<>, put enemies within radius <#ffb900ff>{Radius}<> to <#ef5350ff>sleep<> for <#ffb900ff>{Time}s<>. Damage wakes the target and the waking hit deals <#ffb900ff>{Amplify}%<> increased damage. Cleanse removes both <#ef5350ff>sleep<> and its damage bonus."
      },
      "astrologer": {
        "name": "Astrologer",
        "skill": "Calls down a meteor at the target location after <#ffb900ff>{Delay}s<>, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in the area and, for <#ef5350ff>{SlowTime}s<>, reducing their Move Speed by <#ef5350ff>{Slow}%<>.",
        "skill2": "Deals <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in a line and leaves a constellation mark. The mark lasts <#ffb900ff>{MarkTime}s<>, and marked enemies take additional damage from the Ultimate's constellation detonation.",
        "ult": "Draws a constellation in the target area and marks all enemies. After <#ffb900ff>{Delay}s<>, all marks explode simultaneously, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>. Damage increases by <#ffb900ff>{Amplify}%<> for each additional linked enemy. Enemies that were already marked take an additional <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> of Ability Power as damage."
      },
      "archer": {
        "name": "Archer",
        "skill": "Leaps in the targeted direction, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the most recently attacked enemy.",
        "skill2": "Fires an arrow at a nearby enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% attack damage<> as <#ff9028ff>physical damage<>, briefly <#ef5350ff>stunning<> them, then jumps backward.",
        "ult": "Stop in place and fire a total of {Count} arrows. Each arrow flies toward a random enemy within {Range} range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% attack damage<> as <#ff9028ff>physical damage<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Increase one ally's <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>attack speed by {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% ability power<> for <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduces the skill cooldowns of allies within the targeted area by <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> for {Duration}s.",
        "ult": "Channels for <#ffb900ff>{Duration}s<>, increasing the <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage<> of allied champions within {Range} range by <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% Ability Power<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Ability Power<> by {MagicPower}, and <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed<> by {AttackSpeed}%, while reducing ability cooldowns by {CoolReduce}%. However, their <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Armor<> is reduced by {DefenceReduce}% and their <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>Magic Resistance<> is reduced by {MagicResistanceReduce}%."
      },
      "barrier_magician": {
        "name": "Barrier Mage",
        "skill": "Creates a barrier in the target area for <#ffb900ff>{Duration}s<>, granting allies inside it a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Ability Power<> and reducing enemies’ <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeedReduce}%<>. From level 3, the barrier’s area increases, and allies inside it gain additional <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed<> while enemies are <#ef5350ff>slowed<>.",
        "skill2": "Summons a barrier lasting <#ffb900ff>{Duration}s<> in the targeted area that destroys all projectiles inside.",
        "ult": "Creates a shrinking circular barrier around an enemy champion. Enemies who touch the barrier’s edge take <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and are <#ef5350ff>stunned for {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Enters a rage for {Duration}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeed}%<> and gaining <#6aff55ff>{Vamp}% Life Steal<>.",
        "skill2": "Slams the ground with both hands, launching enemies in a narrow area <#ef5350ff>airborne for {Time}s<> and dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "ult": "Rushes toward an enemy within {Range} range and strikes them down, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. Cooldown is reduced in proportion to lost <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>Health<>."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Throws a boomerang in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. At the end of its range, the boomerang spins in place, continuously dealing <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies it touches.",
        "skill2": "Throws boomerangs in three directions. The boomerangs travel out and return, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in their path.",
        "ult": "Fires a powerful boomerang in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. On hitting an enemy champion, it bounces toward the nearest other enemy champion, and its damage increases by <#ff9028ff>{Increase}%<> with each bounce. Bounces up to {MaxBounce} times."
      },
      "chef": {
        "name": "Chef",
        "skill": "Throws a kitchen knife in a straight line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and <#ef5350ff>slowing<> enemies hit by {Slow}% for {SlowTime}s.",
        "skill2": "Shares food with nearby allies, continuously <#6aff55ff>restoring health<> equal to <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Ability Power<>. If only healing themself, the amount increases to <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% Ability Power<>.",
        "ult": "Throws a special dish to an allied champion, increasing their <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximum health by {HpRatio}%<> for <#ffb900ff>{Duration}s<>. <#e8d44dff>{SpreadRatio}%<> of incoming damage is spread out as damage over time."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleports beside the target. If the target is an enemy, deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and increases <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>movement speed by {MoveSpeed}%<> for <#ffb900ff>{Duration}s<>.",
        "skill2": "Scatters daggers around them, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in range. (Can move while using this ability)",
        "ult": "Enters a frenzy for <#ffb900ff>{Time}s<>, turning all daggers into special daggers that ricochet between enemies."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Throws a chakram at an enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. Each added chakram increases this skill's damage by {StackCoef}%.",
        "skill2": "Each kill adds a chakram to basic attacks. (Max <#ffb900ff>{MaxCount}<>; damage decreases by <#ffb900ff>{Reduce}%<> with each consecutive added-chakram hit)",
        "ult": "Fires {Count}(+stacks) piercing chakrams in a cone, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. The chakrams return at the end of their path, dealing an additional <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% Attack Damage<> as <#ff9028ff>physical damage<>. (Up to {MaxCount})"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Fires a dark arrow in a straight line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies hit and <#ef5350ff>rooting<> them for {Time}s.",
        "skill2": "After a short delay, covers an area in darkness, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies within the area.",
        "ult": "Curses an enemy champion within {Range} range, linking them to the nearest allied champion for <#ffb900ff>{Duration}s<>. When either linked target takes damage, <#a974ffff>{ShareRatio}%<> of that damage is also transferred to the other linked target."
      },
      "demon": {
        "name": "Demon",
        "skill": "A hellish claw rises from the ground to grab an enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and swapping positions with them.",
        "skill2": "Transforms into a greater demon for {Time}s. While transformed, increases <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack by {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Armor by {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeed}%<>, and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Movement Speed by {MoveSpeed}%<>.",
        "ult": "Deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies within {Range} range and <#ef5350ff>fears<> them for {Time}s."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Fires a sword wave in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies hit and <#ef5350ff>rooting<> them for {Time}s.",
        "skill2": "Dashes to an <#ef5350ff>immobilized<> enemy within {Range} range, launching them <#ef5350ff>airborne for {Time}s<> and dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "ult": "Slashes an enemy within the targeted {Range} range, dealing <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#f5f5f5ff>true damage<> {Count} times."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Fires a hook, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies hit and pulling them toward the user.",
        "skill2": "Slashes an enemy with a hook, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and causing them to <#ef5350ff>bleed for {Duration}s<>. Bleeding enemies take <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% Attack Damage<> as <#ff9028ff>physical damage<> every {Tick}s, and their damage taken is <#ef5350ff>increased by {Debuff}%<>.",
        "ult": "Sweeps enemies in a semicircle within {Range} in front with a hook, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and rendering them <#ef5350ff>unable to heal for {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Cleanses one ally of <#ef5350ff>crowd-control effects<> and restores <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> health. Removes stun, sleep, root, fear, charm, taunt, airborne and forced movement. Does not remove buff-based effects such as slows or poison.",
        "skill2": "Grants divine protection to one ally for <#ffb900ff>{Duration}s<>, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage by {Attack}<> and <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeed}%<>. While protected, if the ally is hit by a crowd-control ability, the crowd-control effect is reflected back onto the attacker.",
        "ult": "Creates an explosion at the target location, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in range. Deals an additional <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% Ability Power<> damage for each buff on the target."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Charges toward a target within {Range} range at {Speed} speed, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>stunning<> them for {Stun}s.",
        "skill2": "Stomps the ground, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies within {Range} range, then applying a {Slow}% <#ef5350ff>slow<> for {SlowTime}s.",
        "ult": "Slams the ground, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies within {Range} range and <#ef5350ff>knocking them airborne<> for {Time}s."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Rolls a die, attacking enemies within {Range} range a number of times equal to the roll. Each attack deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Throws a chip, creating a {AttackRange}-size area within {Range} range that <#ef5350ff>slows<> enemies by {Slow}% for {Time}s. When the area expires, it explodes, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in range.",
        "ult": "Fires a pile of money in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies hit and <#ef5350ff>charming<> them for {Time}s."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Becomes untargetable and dashes in a straight line. On takedown participation, gains <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Attack Damage<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<>, and <#6aff55ff>restores {Heal} health<>.",
        "skill2": "Dashes a short distance, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first target hit. Can be recast up to {Time} times.",
        "ult": "Becomes immune to movement-impairing effects for <#ffb900ff>{Time}s<>. On takedown participation, resets basic ability cooldowns."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Can attack enemies while moving. From level 3, attacking an enemy grants <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}% Movement Speed<> for {Time}s.",
        "skill2": "Empowers attacks for {Time}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage by {Attack}<>. Every third attack causes the bullet to <#ef5350ff>slow<> the enemy by {Slow}% for {SlowTime}s.",
        "ult": "Empowers attacks for {Time}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage by {Attack}<> and firing additional bullets at 2 enemies near the attack target. Additional bullets deal <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>."
      },
      "ice_mage": {
        "name": "Ice Mage",
        "skill": "Freezes an enemy, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and <#ef5350ff>stunning<> them for {Time}s.",
        "skill2": "Summons an ice field in the target area for {Duration}s, <#ef5350ff>slowing<> enemies within {Range} range by {MoveSpeed}% and dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> every {Tick}s. When the field expires, enemies in range are frozen and <#ef5350ff>stunned<> for {Stun}s.",
        "ult": "Deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in a cone and knocks them back. <#ef5350ff>Slows<> them by {Slow}% for {SlowDuration}s and <#ef5350ff>prevents them from using movement abilities<> for {BlockDuration}s."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Fires a disorienting projectile, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and summoning an Illusionist clone in front of the enemy, <#ef5350ff>taunting<> them for {Time}s.",
        "skill2": "Deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies within {Range} range and <#ef5350ff>fears<> them for {Time}s.",
        "ult": "Creates an illusion of one nearby allied champion for <#ffb900ff>{Duration}s<>. The illusion can only use basic attacks and has the same stats as the copied champion."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Summons a small jiangshi that rushes at enemies and attacks them. The small jiangshi disappears after 3 attacks, with each attack dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Slams the enemy, <#ef5350ff>stunning<> them for {Time}s, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>, and <#6aff55ff>restoring {Heal} health<>.",
        "ult": "For <#ffb900ff>{Duration}s<>, drains <#6aff55ff>health<> equal to <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Ability Power<> from enemies within {Range} range, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Ability Power<> as <#a974ffff>magic damage<>."
      },
      "knight": {
        "name": "Knight",
        "skill": "Targets one enemy and <#ef5350ff>taunts<> them for {Time}s.",
        "skill2": "Grants themself a <#e8d44dff>shield<> for {Time}s. (<#e8d44dff>Shield<> value: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maximum health<> + <#e8d44dff>{Amount}<>). While the shield holds, <#ff9028ff>reflects {Reflect}% of damage taken<>.",
        "ult": "Summons a defensive area with {Range} range at the target location for <#ffb900ff>{Time}s<>. Allies inside the area have their damage taken reduced by <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maximum health<>, while enemies inside are <#ef5350ff>slowed by {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancer",
        "skill": "Knocks back nearby enemies within {Range} range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Charges a short distance, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% Attack Damage<> as <#ff9028ff>physical damage<> to an enemy, then passes through them and moves behind them.",
        "ult": "Charges {Range} distance, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies hit and <#ef5350ff>knocking them airborne<> for {Time}s."
      },
      "lightning_mage": {
        "name": "Lightning Mage",
        "skill": "Fires lightning at a target enemy, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>. The lightning continues to chain to nearby targets within range and cannot hit the same target more than once.",
        "skill2": "Calls down lightning on the target area, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies hit and <#ef5350ff>stunning<> them for {Time}s.",
        "ult": "Channels a lightning beam at an enemy champion for <#ffb900ff>{Duration}s<>, <#ef5350ff>stunning<> them. Continuously deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to the target and nearby enemies."
      },
      "magic_knight": {
        "name": "Magic Knight",
        "skill": "Detonates magic energy in a long, narrow line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>.",
        "skill2": "Creates an arcane core in a small area for {Duration}s, pulling enemies within {Range} slightly toward its center every {Tick}s and dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>.",
        "ult": "For <#ffb900ff>{Time}s<>, gains <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} range<> and <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Ability Power<>. Each basic attack triggers their first Ability."
      },
      "monk": {
        "name": "Monk",
        "skill": "Restores <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> <#6aff55ff>health<> to nearby allies within {Range} range. If Monk only heals themself, the healing amount increases to <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<>.",
        "skill2": "Slams the ground with their palm, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies within {Range} range and <#ef5350ff>stunning them for {Time}s<>.",
        "ult": "Grants nearby allies within {Range} range a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<>. Shielded allies gain <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Summons a ghoul as a minion for <#ffb900ff>{Duration}(+{DurationCoef}% Ability Power)s<>. This ability’s cooldown decreases with level, and the ghoul’s duration increases by <#ffb900ff>{DurationPerLevel}s<> per level.",
        "skill2": "Marks one enemy as the ghoul’s attack target for <#ffb900ff>{Time}s<>, causing the ghoul to go berserk. The ghoul gains <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Ability Power<> and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% Ability Power<>.",
        "ult": "Revives a dead allied champion as a wraith. While the summon is maintained, it loses <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} health<> every second."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Fires a shadow orb, then charges at the enemy hit, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Charges a short distance toward the target enemy, becoming untargetable and attacking three times in succession. Each attack deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "ult": "Charges at an enemy within {Range} range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Each time Ogre takes damage from an enemy champion, gains <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value} maximum health<>.",
        "skill2": "Slams a single target with a club, <#ef5350ff>stunning them for {Time}s<> and dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maximum health<> as <#ff9028ff>physical damage<>.",
        "ult": "Becomes gigantic for {Time}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximum health by {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maximum health<>."
      },
      "plague_doctor": {
        "name": "Plague Doctor",
        "skill": "Injects themself and one allied champion, increasing <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Ability Power<> and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Movement Speed by {MoveSpeed}%<> for <#ffb900ff>{Duration}s<>.",
        "skill2": "Performs a procedure on one allied champion, increasing their <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>range<> by {Range} + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% Ability Power<> for <#ffb900ff>{Duration}s<> and causing their attacks to dash toward the target.",
        "ult": "Administers a forbidden elixir to one ally, reducing their current health by {HpReduceRatio}%. For {Duration}s, their health cannot fall below 1, and they gain <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Attack Damage<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Ability Power<>, and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<>."
      },
      "poison_dart_hunter": {
        "name": "Poison Dart Hunter",
        "skill": "Spreads a poison field, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in range, poisoning them for <#ffb900ff>{Duration}s<> and <#ef5350ff>slowing them by {Slow}%<>.",
        "skill2": "When attacking a poisoned enemy, gains <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} range<>. When moving away from a poisoned enemy, gains <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Movement Speed<>.",
        "ult": "Grants nearby allies’ attacks a poison effect for <#ffb900ff>{Duration}s<>. The poison deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> over <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Priestess",
        "skill": "Creates a healing field with {Range} range for {Duration}s, restoring <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> <#6aff55ff>health<> to allies standing on it every {Tick}s.",
        "skill2": "Grants one ally a <#e8d44dff>shield<> equal to <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> for {Time}s. While the shield holds, the ally gains <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<>.",
        "ult": "Flies into the air and becomes fixed in place for {Time}s, firing a healing projectile every {Tick}s at the lowest-health ally within ultimate range. The projectile restores <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> <#6aff55ff>health<>."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Drops a fireball, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies within {Range} range.",
        "skill2": "Summons a flame field in the target area for {Duration}s, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> every {Tick}s to enemies within {Range} range.",
        "ult": "Creates a massive explosion within {Range} range, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to all enemies in the blast area."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Restores one ally’s health by <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<>.",
        "skill2": "Restores one ally’s health by <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> and deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Ability Power<> as <#a974ffff>magic damage<> to enemies within {Range} range around that ally.",
        "ult": "Summons a Spirit Gate. The Spirit Gate fires projectiles that either restore <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> health to allies within {Range} range, or deal <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Ability Power<> as <#a974ffff>magic damage<> to enemies."
      },
      "shadowmancer": {
        "name": "Shadowmancer",
        "skill": "Black shadows emerge from the ground, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in range and <#ef5350ff>rooting them for {Time}s<>.",
        "skill2": "Explodes the shadow of an immobilized enemy, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>.",
        "ult": "Fires a piercing shadow projectile in a straight line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemy champions hit and <#ef5350ff>banishing them for {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Shield Bearer",
        "skill": "Grants a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maximum health<> to the user and one target ally within range. (Lasts {Duration}s)",
        "skill2": "Takes <#ef5350ff>{Damage}%<> of the damage received by nearby allies instead of them, and slows enemies who attack those allies by <#ef5350ff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% Armor<>. (Lasts {Duration}s)",
        "ult": "On use, gains <#e8d44dff>{DamageReduce}% damage reduction<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% Magic Resistance<> and crowd-control immunity for {Duration}s, then <#ef5350ff>taunts<> all enemies in a wide area around them for {TauntDuration}s. Cannot move while taunting."
      },
      "soldier": {
        "name": "Sniper",
        "skill": "Each time Sniper levels up, gains <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange} range<>.",
        "skill2": "Fires three consecutive shots at one enemy, dealing heavy <#ff9028ff>physical damage<>. (Per shot: <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> damage). This ability’s range scales with basic attack range.",
        "ult": "Fires a giant bullet in a straight line, sniping an enemy within {Range} range. The bullet deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in its path, with damage reduced by {Decay}% each time it hits an enemy."
      },
      "swordman": {
        "name": "Swordsman",
        "skill": "Fires a sword wave, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies hit. (Sword wave range: {Range})",
        "skill2": "Slashes a single target three times in succession, dealing heavy <#ff9028ff>physical damage<>. Each hit deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> damage.",
        "ult": "Dashes {Range} distance in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in the dash path. The damage is split between enemies hit. If this ultimate kills an enemy, its cooldown is reset."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Seals an enemy with a talisman, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and <#ef5350ff>preventing them from using basic attacks for {Time}(+{TimeCoef}% Ability Power)s<>.",
        "skill2": "Attaches a talisman to an enemy, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and <#ef5350ff>silencing them for {Time}(+{TimeCoef}% Ability Power)s<>.",
        "ult": "Fires a talisman projectile in a straight line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies hit, making them <#ef5350ff>incapacitated for {Time}s<> and untargetable. When the effect ends, it spreads to nearby enemies."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Drains an enemy’s blood, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>, <#6aff55ff>restoring {Heal} health<>, and gaining a stack. Each stack <#6aff55ff>increases healing by {Stack}<>.",
        "skill2": "Consumes {Value}% of their own health to spray blood in a cone, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>. Damage increases by {Stack} per stack.",
        "ult": "Becomes untargetable and dashes {Range} distance, <#6aff55ff>draining {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> <#6aff55ff>health<> from each enemy in the dash path and dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Ability Power<> as <#a974ffff>magic damage<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Slashes enemies in a crescent-shaped area in front of them, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#6aff55ff>healing for {HealRatio}% of the damage dealt<>.",
        "skill2": "Charges forward, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies hit and <#ef5350ff>slowing<> them by {Slow}% for {SlowTime}s.",
        "ult": "For <#ffb900ff>{Duration}s<>, repeatedly deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in a cone in the target direction, and applies <#ef5350ff>Bleed for {BleedTime}s<>. Bleed: <#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% Attack Damage<>"
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Empowers the club for <#ffb900ff>{Duration}s<>, causing attacks to release a cone-shaped shockwave. The shockwave deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Hardens their skin for <#ffb900ff>{Duration}s<>, granting a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> and <#e8d44dff>{DamageReduction}% damage reduction<>.",
        "ult": "Fires a projectile in a straight line, gradually <#ef5350ff>slowing enemies hit over {SlowTime}s<> before <#ef5350ff>rooting them for {BindTime}s<>. When the root is applied, deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to nearby enemies, spreading the same effect to enemies damaged."
      },
      "hammerer": {
        "name": "Hammerer",
        "skill": "Swings a hammer at one nearby enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>knocking them airborne for {Time}s<>.",
        "skill2": "Raises the hammer and channels briefly before slamming the ground, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to nearby enemies within {Range} range and <#ef5350ff>slowing them by {Move}% for {Time}s<>.",
        "ult": "Swings the hammer in a wide arc, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in a forward semicircle within {Range} range. Enemies hit by the hammer are knocked back for {Time}s, and enemy champions they collide with are <#ef5350ff>knocked airborne for {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Dashes a short distance, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first enemy hit and applying <#ef5350ff>bleed<>.",
        "skill2": "Slashes a target enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. If the enemy is <#ef5350ff>bleeding<>, Ability 1’s cooldown is reset.",
        "ult": "Charges at a nearby enemy champion, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies around the arrival point. Enemies reduced to {Threshold}% maximum health or below are executed. If an enemy is executed, nearby enemies are <#ef5350ff>feared for {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Pole Warrior",
        "skill": "Jumps at an enemy and slams down with the pole, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Moves a short distance and vaults onto the pole, becoming untargetable for {Time}s before swinging the pole and dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all nearby enemies within {Range} range.",
        "ult": "Charges at a target enemy within {Range} range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>knocking the target airborne for {Time}s<>."
      },
      "spirit_caller": {
        "name": "Spirit Caller",
        "skill": "Attaches a spirit to an ally, restoring <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% Ability Power<> <#6aff55ff>health<> over <#ffb900ff>{Duration}s<> and increasing <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Movement Speed by {SpeedUp}%<>.",
        "skill2": "Attaches a spirit to an enemy, reducing their <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Armor<> by {DefDown} + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% Ability Power<> and <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>Magic Resistance<> by {MrDown} + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% Ability Power<> for <#ffb900ff>{Duration}s<>, and <#ef5350ff>slowing<> them by {Slow}%.",
        "ult": "Detonates attached spirits. Allied spirits grant a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Ability Power<> and <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% increased Attack Speed<>. Enemy spirits deal <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Ability Power<> as <#a974ffff>magic damage<> and <#ef5350ff>stun<> for {StunTime}s."
      },
      "whip_master": {
        "name": "Whip Master",
        "skill": "Strikes an enemy with a whip, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>, plus damage equal to <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% of the target’s health<>.",
        "skill2": "Swings a whip in a cone, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in range and knocking them back.",
        "ult": "Channels for <#ffb900ff>{Duration}s<>, repeatedly firing straight-line piercing projectiles toward random enemies in range, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>."
      },
      "enchanter": {
        "name": "Enchanter",
        "skill": "Enhances an ally for <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>increasing range by {Increase}<>.",
        "skill2": "Enhances an ally’s equipment for <#ffb900ff>{Duration}s<>, increasing stats gained from items by <#ffb900ff>{Percent}%<>.",
        "ult": "Enhances an allied champion for {Duration}s, increasing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage by {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% Ability Power<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AttackSpeed}%<>, and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Movement Speed by {MoveSpeed}%<>, and grants crowd-control immunity."
      },
      "siege_breaker": {
        "name": "Siege Breaker",
        "skill": "Slams a mace down on the target, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. Deals {Bonus}% additional damage to structures.",
        "skill2": "Slams the ground with a mace, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in range, including structures.",
        "ult": "For {Time}s, gains <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Attack Damage<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<>, and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<>."
      },
      "prisoner": {
        "name": "Prisoner",
        "skill": "Throws an iron ball in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in range.",
        "skill2": "Roars, gaining a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maximum health<> for {Time}s and <#ef5350ff>taunting<> all nearby enemies.",
        "ult": "Charges at a target enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies around the landing point and <#ef5350ff>stunning them for {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Fires a shockwave in a straight line. When the shockwave hits an enemy or reaches the end of its range, it explodes in an area, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in range and applying a {Slow}% <#ef5350ff>slow<> for {Time}s.",
        "skill2": "Grants themself a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maximum health<> for {Time}s. When the shield expires or breaks, enemies within {Range} range are <#ef5350ff>stunned<> for {StunTime}s.",
        "ult": "Grants a target ally within {Range} range a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maximum health<>. After {Time}s, teleports to that ally."
      },
      "white_mage": {
        "name": "White Mage",
        "skill": "After a short delay, a straight-line beam explodes, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to all enemies in range.",
        "skill2": "Summons beams in a circular area, striking 5 times and dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in range, <#ef5350ff>slowing<> them by {Slow}% for {SlowTime}s.",
        "ult": "Fires a piercing beam in a straight line, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies hit and <#ef5350ff>rooting<> them for {Time}s."
      },
      "wind_mage": {
        "name": "Wind Mage",
        "skill": "Summons a whirlwind for <#ffb900ff>{Duration}s<>, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> every {Tick}s to enemies within {Range} range. Allies inside the whirlwind gain <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<>.",
        "skill2": "Fires five whirlwinds forward, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> to enemies in range.",
        "ult": "Fires a giant whirlwind that slowly moves toward the nearest enemy champion. Enemies hit take <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and are <#ef5350ff>knocked airborne for {AirborneTime}s<>. Each time the whirlwind hits, its size, damage, and airborne duration decrease, then it redirects toward another enemy champion."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Throws a bomb, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in range.",
        "skill2": "Plants a mine that is invisible to enemies. When an enemy steps on it, the mine deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>roots<> them for {Time}s. The mine is not triggered by minions.",
        "ult": "Throws a large bomb at the target location, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to all enemies in range and <#ef5350ff>slowing<> them by {Slow}% for {SlowTime}s."
      },
      "cavalry_knight": {
        "name": "Cavalry",
        "skill": "Charges in a straight line, impaling the first enemy hit with a spear, <#ef5350ff>rooting<> them for {Time}s and dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. Charge speed scales with Movement Speed.",
        "skill2": "For {Time}s, gains <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Movement Speed<> and empowers their weapon into a flaming spear. Attacks deal additional burn damage equal to <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% Attack Damage<> for {BurnTime}s.",
        "ult": "For {Time}s, gains <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Movement Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Attack Damage<> and creates a path leading to Cavalry’s position. Allies on the path gain <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}% Movement Speed<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Attack Damage<> while moving toward Cavalry."
      },
      "druid": {
        "name": "Druid",
        "skill": "Summons a bear. If the bear dies, the Druid takes <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% Ability Power<> damage. If used while the bear is summoned, restores the bear’s health by <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Ability Power<>.",
        "skill2": "Summons an eagle. If the eagle dies, the Druid takes damage. If used while the eagle is summoned, the eagle charges at an enemy, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and <#6aff55ff>healing for {Lifesteal}% of the damage dealt<>.",
        "ult": "Fires {Count} bear and eagle spirits in succession in the target direction. Each projectile deals <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and knocks enemies back."
      },
      "voodoo_shaman": {
        "name": "Voodoo Shaman",
        "skill": "Fires a cursed projectile, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>, <#ef5350ff>slowing<> enemies hit by {Slow}% for {Time}s, and reducing their <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Attack Speed by {AtkSpd}%<> for <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Curses a target enemy for <#ffb900ff>{Time}s<>, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>. While cursed, the target takes an additional <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% Ability Power<> damage each time they are attacked. (Maximum {Max} times)",
        "ult": "Creates a voodoo area at the target location for <#ffb900ff>{Duration}s<>. Enemies inside the area continuously take <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maximum health<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and are <#ef5350ff>silenced, preventing them from using abilities<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Fires three consecutive shots. The first shot <#ef5350ff>stuns the enemy for {StunTime}s<>, and each of the next two shots deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>.",
        "skill2": "Teleports behind the enemy champion most recently attacked within <#ffb900ff>{Range}<> range.",
        "ult": "Marks an enemy champion, then after <#ffb900ff>{Duration}s<> deals <#ff9028ff>{Damage} + {Coef}% of the damage taken during the mark<> as <#ff9028ff>physical damage<>. If the target is killed, becomes stealthed for <#ffb900ff>{InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Guardian Spirit",
        "skill": "Restores <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> health to nearby allies.",
        "skill2": "Grants an ally a <#e8d44dff>shield<> equal to <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Ability Power<> and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% increased Movement Speed<>.",
        "ult": "Creates a sanctuary for <#ffb900ff>{Duration}s<>, continuously <#6aff55ff>restoring<> <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Ability Power<> health to allies in range and granting them a resurrection shield."
      },
      "hunter": {
        "name": "Hunter",
        "skill": "Teleports to an enemy and switches to ranged attack mode. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Range increases by {RangeIncrease}<>.",
        "marks": "Ranged basic attacks mark enemy champions for <#ffb900ff>{Duration}s<>. Further hits refresh existing marks. The second skill can target enemies with 3 marks.",
        "skill2": "Charges at an enemy with 3 marks, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>silencing<> them for {SilenceTime}s.",
        "ult": "Dashes forward, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies in its path. Resets on takedown participation."
      },
      "circus_blade": {
        "name": "Circus Blade",
        "skill": "Fires a blade in the target direction, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and <#ef5350ff>slowing<> enemies hit by {Slow}% for {SlowTime}s. Stores up to <#ffb900ff>{ChargeCount} charges<> and gains <#ffb900ff>1 charge<> when a basic attack hits an enemy champion.",
        "skill2": "For <#ffb900ff>{Duration}s<>, gains <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Movement Speed<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Attack Speed<>, and the ability to pass through walls.",
        "ult": "Charges at a target enemy, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. Deals <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% Attack Damage<> area damage to nearby enemies, <#ef5350ff>knocks them back<>, then disappears."
      },
      "sand_mage": {
        "name": "Sand Mage",
        "skill": "Basic attacks carry sand energy, dealing <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% Ability Power<> as <#a974ffff>bonus magic damage<>. This bonus damage and the sand eruption can critically strike. On use, erupts sand around the target, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>area magic damage<>.",
        "skill2": "Absorbs sand energy for <#ffb900ff>{Time}s<>, increasing <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Movement Speed by {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% Ability Power<> and <#6aff55ff>healing self<> for <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Ability Power<>.",
        "ult": "Creates a sand swamp around the target for <#ffb900ff>{Duration}s<>. Every {Tick}s, enemies inside take <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> and are pulled toward the center."
      },
      "alchemist": {
        "name": "Alchemist",
        "skill": "Throws a flask that bursts and leaves a toxic pool for <#ffb900ff>{Time}s<>. Enemies in the pool are <#78e85cff>poisoned<> for <#ffb900ff>{DotTime}s<>, taking <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> every {DotTick}s, and their healing is reduced by {HealReduce}%.",
        "skill2": "Injects one enemy with an unstable reagent, dealing <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<>. For <#ffb900ff>{Time}s<>, the target cannot be healed and is slowed by {Slow}%.",
        "ult": "Throws a toxic flask in a line. When it hits an enemy champion, it creates a poison cloud that expands up to {CloudRadius} range for <#ffb900ff>{CloudTime}s<>. Enemies in the cloud are <#78e85cff>poisoned<> for <#ffb900ff>{DotTime}s<>, taking <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Ability Power<> as <#a974ffff>magic damage<> every {DotTick}s, and lose <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% Ability Power<> Armor and <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% Ability Power<> Magic Resist."
      },
      "crossbowman": {
        "name": "Crossbowman",
        "skill": "Fires a powerful arrow in a line, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first enemy champion hit. While the ultimate mark lasts, it deals an additional <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Attack Damage<>.",
        "skill2": "Fires a piercing arrow forward in a line, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies, while being pushed back for <#ffb900ff>{BackstepTime}s<>. While the ultimate mark lasts, it deals an additional <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Attack Damage<>.",
        "ult": "Fires a tracer round in a line, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first enemy champion hit and marking them for <#ffb900ff>{Duration}s<>. While the mark lasts, all skills hit the marked target regardless of distance and skill cooldowns are reduced by <#ffb900ff>{CoolReduce}%<>. Other champions in the path can intercept."
      },
      "nightmare": {
        "name": "Nightmare",
        "skill": "Fires a nightmare shard in a line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first enemy hit. Can be used up to <#ffb900ff>{UseCount} times<> in succession.",
        "skill2": "Dashes <#ffb900ff>{Range}<> in the chosen direction, then deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies within <#ffb900ff>{Radius}<> and becomes invisible for <#ffb900ff>{StealthTime}s<>.",
        "ult": "Dashes to the target enemy champion and deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>. If this damage kills the target, teleports next to a living allied champion regardless of distance."
      },
      "strongman": {
        "name": "Strongman",
        "skill": "Grabs one nearby enemy, throws them over his shoulder behind himself, and deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<>, <#ef5350ff>stunning them for {Stun}s<>.",
        "skill2": "Swings his barbell in a wide arc, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to enemies within <#ffb900ff>{Range}<> and <#ef5350ff>knocking them back<>.",
        "ult": "Throws one nearby allied champion to the target location. After landing, the thrown ally gains a <#e8d44dff>{Shield} shield<> for <#ffb900ff>{ShieldTime}s<>, and enemies within <#ffb900ff>{Radius}<> of the landing point take <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for {Stun}s<>. If there is no nearby ally to throw, Strongman leaps instead; in this case, the stun lasts <#ef5350ff>{SelfStun}s<>."
      },
      "harpooner": {
        "name": "Harpooner",
        "skill": "Fires a harpoon in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> to the first enemy champion hit. For <#ffb900ff>{RecastDuration}s<> after hitting, recast to pull yourself toward the target or pull the target toward you.",
        "skill2": "Fires a powerful harpoon in a straight line, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> of the target's missing Health as <#ff9028ff>physical damage<> to the first enemy hit.",
        "ult": "Fires <#ffb900ff>{ProjectileCount}<> chained harpoons in a forward cone, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Attack Damage<> as <#ff9028ff>physical damage<> and binding those hit for <#ffb900ff>{LinkDuration}s<>. Bound enemies are slowed by <#ef5350ff>{Slow}%<>. If they move more than <#ffb900ff>{LinkRange}<> apart, the chains tighten: the slow increases to <#ef5350ff>{TensionSlow}%<> and they are dragged toward each other."
      },
      "spellbreaker": {
        "name": "Spellbreaker",
        "skill": "Sweeps the greatsword across the front, dealing <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of Attack<> as <#ff9028ff>physical damage<> and <#ef5350ff>slowing by {Slow}% for {Time} seconds<>.",
        "skill2": "Charges a short distance and deals <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% of Attack<> as <#ff9028ff>physical damage<> to the first enemy hit. After the charge, <#ffb900ff>damage taken is reduced by {Reduce}% for {Time} seconds<>.",
        "ult": "Instantly destroys all shields on enemies within <#ffb900ff>{Range}<>. An enemy whose shield is destroyed takes <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% of Magic Power<> as <#a974ffff>magic damage<>, is <#ef5350ff>stunned for {Stun} seconds<>, and <#ffb900ff>cannot gain shields for {BlockTime} seconds<>. An enemy without a shield instead takes only <#a974ffff>{Damage} magic damage<>."
      }
    }
  },
