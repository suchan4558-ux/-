    "description": {
      "astrologer": {
        "name": "Astrolog",
        "skill": "Po <#ffb900ff>{Delay}s<> zrzuca meteor na wybrane miejsce, zadając wrogom w obszarze <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> oraz zmniejszając ich prędkość ruchu o <#ef5350ff>{Slow}%<> na <#ef5350ff>{SlowTime}s<>.",
        "skill2": "Zadaje wrogom w linii prostej <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> i pozostawia znak gwiazdozbioru. Znak utrzymuje się przez <#ffb900ff>{MarkTime}s<>, a oznaczeni wrogowie otrzymują dodatkowe obrażenia od detonacji gwiazdozbioru superumiejętności.",
        "ult": "Rysuje gwiazdozbiór w wybranym obszarze i oznacza wszystkich wrogów. Po <#ffb900ff>{Delay}s<> wszystkie znaki wybuchają jednocześnie, zadając <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<>. Obrażenia zwiększają się o <#ffb900ff>{Amplify}%<> za każdego dodatkowego połączonego wroga. Wrogowie już oznaczeni otrzymują dodatkowo <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> mocy umiejętności jako obrażenia."
      },
      "archer": {
        "name": "Archer",
        "skill": "Doskakuje w wybranym kierunku i zadaje ostatnio atakowanemu przeciwnikowi <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Wystrzeliwuje strzałę w pobliskiego przeciwnika zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>, ogłuszając chwilowo cel i odskakując w tył.",
        "ult": "Zatrzymuje się w miejscu i wystrzeliwuje {Count} strzał. Każda strzała leci w kierunku losowego przeciwnika w zasięgu {Range} jednostek, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Zwiększa <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku<> wybranego sojusznika o {AttackSpeed}% (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) na <#ffb900ff>{Duration}s<>.",
        "skill2": "Skraca czas odnowienia umiejętności sojuszników na wybranym obszarze o <#ffb900ff>{CoolReduce}%<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) na {Duration}s.",
        "ult": "W ciągu <#ffb900ff>{Duration}s<> czasu trwania tej umiejętności Bard wzmacnia <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff> obrażenia od ataku o {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% mocy umiejętności<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff> moc umiejętności o {MagicPower}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff> prędkość ataku o {AttackSpeed}%<>, oraz skraca czas oczekiwania na umiejętności o {CoolReduce}% w zasięgu {Range} jednostek, ale obniża <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pancerz o {DefenceReduce}%<> oraz <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>odporność na magię o {MagicResistanceReduce}%<> swoich sojuszników."
      },
      "barrier_magician": {
        "name": "Barrier Mage",
        "skill": "Tworzy barierę utrzymującą się przez <#ffb900ff>{Duration}s<> zapewniającą <#e8d44dff>{Shield}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% mocy umiejętności<>) <#e8d44dff>pkt. osłony sojusznikom<> oraz redukuje <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeedReduce}%<> przeciwnikom. Od 3 poziomu bohatera, umiejętność zapewnia dodatkową <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku<> sojusznikom oraz <#ef5350ff>spowalnia<> przeciwników.",
        "skill2": "Tworzy barierę trwającą <#ffb900ff>{Duration}s<> na wybranym obszarze, zatrzymując wszystkie nadchodzące pociski przeciwników.",
        "ult": "Tworzy zanikającą barierę wokół przeciwnika. Wróg dotykający jej krawędzi otrzymuje <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#a974ffff>magicznych obrażeń<> oraz zostaje <#ef5350ff>ogłuszony na {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Wpada w dziki szał na {Duration}s zwiększając swoją <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<> i otrzymując <#6aff55ff>{Vamp}% kradzieży życia<>.",
        "skill2": "Uderza w ziemię oburącz, <#ef5350ff>podrzucając<> wrogów na {Time}s i zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Pędzi w stronę przeciwnika w zasięgu {Range} jednostek, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Czas odnowienia tej umiejętności jest skrócony w zależności od <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>brakującego zdrowia<> Berserka."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Rzuca bumerangiem w linii prostej , zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>)jako <#ff9028ff>obrażenia fizyczne<>. Na końcu zasięgu bumerang kręci się, zadając ciągłe <#ff9028ff>{DotDamage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Rzuca trzy bumerangi zadające <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> wszystkim trafionym przeciwnikom w trakcie lotu i z powrotem.",
        "ult": "Rzuca potężnym bumerangiem w linii prostej , zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Przy trafieniu przeciwnika bumerang odbija się w kierunku najbliższego przeciwnika, zwiększając swoje obrażenia o <#ff9028ff>{Increase}%<> przy każdym odbiciu. Bumerang odbija się maksymalnie {MaxBounce} razy."
      },
      "chef": {
        "name": "Chef",
        "skill": "Rzuca tasakiem w linii prostej, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>spowalniając trafionych przeciwników o {Slow}% na {SlowTime}s<>.",
        "skill2": "Dzieli się potrawą z pobliskimi sojusznikami, stale przywracając im <#6aff55ff>{Heal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>. Jeśli leczy wyłącznie siebie, wartość leczenia wzrasta do <#6aff55ff>{SelfHeal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% mocy umiejętności<>).",
        "ult": "Rzuca specjalnym daniem w sojuszniczego bohatera, zwiększając jego <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maksymalne zdrowie o {HpRatio}%<> na <#ffb900ff>{Duration}s<>. <#e8d44dff>{SpreadRatio}%<> otrzymywanych przez niego obrażeń zostaje rozłożone w czasie."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleportuje się obok celu. Jeśli celem jest przeciwnik, zadaje mu <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz przez <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa swoją prędkość ruchu o {MoveSpeed}%<>.",
        "skill2": "Rzuca sztyletami we wszystkich przeciwników w zasięgu, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. (Może poruszać się podczas używania umiejętności)",
        "ult": "Przez <#ffb900ff>{Time}s<> wpada w szał, sprawiając, że wszystkie sztylety zamieniają się w specjalne ostrza odbijające się od przeciwników. (Dotyczy ataków podstawowych oraz umiejętności 2)."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Rzuca czakramem w przeciwnika, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Każdy dodatkowy czakram zwiększa obrażenia tej umiejętności o {StackCoef}%.",
        "skill2": "Każde zabójstwo wrogiego bohatera dodaje <#ffb900ff>1 czakram<> do ataku podstawowego (maks. <#ffb900ff>{MaxCount} czakramów<>). Ataki podstawowe i umiejętności zadają dodatkowe obrażenia zależne od liczby czakramów. Podczas ataku wszystkie czakramy uderzają cel, a każdy kolejny czakram zadaje o {Reduce}% mniej obrażeń",
        "ult": "Wystrzeliwuje <#ffb900ff>{Count}(+ładunki)<> przebijających czakramów w stożku przed sobą, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Czakramy zawracają po osiągnięciu maksymalnego zasięgu i przy powrocie zadają dodatkowo <#ff9028ff>{ReturnDamage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. (maks. {MaxCount} czakramów)"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Wystrzeliwuje mroczną strzałę w linii prostej, zadając trafionym przeciwnikom <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>unieruchamiając ich na {Time}s<>.",
        "skill2": "Po chwili spowija wybrany obszar mrokiem, zadając przeciwnikom znajdującym się w zasięgu <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Nakłada klątwę na wrogiego bohatera w zasięgu {Range} jednostek, łącząc go z najbliższym sojuszniczym bohaterem na <#ffb900ff>{Duration}s<>. Gdy jeden z połączonych celów otrzyma obrażenia, <#a974ffff>{ShareRatio}%<> z nich zostaje przeniesione na drugi połączony cel."
      },
      "demon": {
        "name": "Demon",
        "skill": "Przywołuje z ziemi piekielną dłoń, która chwyta przeciwnika. Po trafieniu zadaje <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> zamieniając pozycję użytkownika z celem umiejętności.",
        "skill2": "Na {Time}s przemienia się w wielkiego demona. Podczas transformacji <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>zwiększa swoje obrażenia od ataku o {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pancerz o {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<> oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>prędkość ruchu o {MoveSpeed}%<>.",
        "ult": "Zadaje wszystkim przeciwnikom w promieniu {Range} jednostek <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>przestrasza ich na {Time}s<>."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Wystrzeliwuje falę ostrzy w linii prostej, zadając trafionym przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>unieruchamiając ich na {Time}s<>.",
        "skill2": "Doskakuje do <#ef5350ff>unieruchomionego<> przeciwnika w zasięgu {Range} jednostek, <#ef5350ff>podrzucając trafiony cel na {Time}s<> oraz zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Wyprowadza serię cięć wybranemu przeciwnikowi w zasięgu {Range} jednostek, zadając <#ffb900ff>{Count} razy<> <#f5f5f5ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#f5f5f5ff>obrażenia nieuchronne<>."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Rzuca swoim hakiem, zadając trafionemu przeciwnikowi <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz przyciągając go przed siebie.",
        "skill2": "Rozcina przeciwnika hakiem, zadając <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz nakładając <#ef5350ff>krwawienie na {Duration}s<>. Krwawiący przeciwnik co {Tick}s otrzymuje <#ff9028ff>{TickDamage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>, a otrzymywane przez niego obrażenia z wszystkich źródeł <#ef5350ff>zwiększają się o {Debuff}%<>.",
        "ult": "Wykonuje szeroki zamach hakiem w półokręgu o zasięgu {Range} jednostek przed sobą, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>uniemożliwiając trafionym wrogom leczenie na {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Usuwa <#ef5350ff>efekty kontroli tłumu<> z wybranego sojusznika oraz przywraca mu <#6aff55ff>{Heal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>. Usuwa ogłuszenie, sen, unieruchomienie, strach, zauroczenie, prowokację, podrzucenie i wymuszone przemieszczenie. Nie usuwa efektów nakładanych jako buffy, takich jak spowolnienie lub trucizna.",
        "skill2": "Obdarza sojusznika boskim błogosławieństwem na <#ffb900ff>{Duration}s<>, zwiększając jego <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Attack}<> oraz <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<>. Jeśli podczas działania efektu zostanie trafiony umiejętnością kontroli tłumu, efekt zostaje odbity i nałożony na przeciwnika.",
        "ult": "Powoduje eksplozję w wybranym obszarze, zadając przeciwnikom w zasięgu <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Za każdy efekt wzmocnienia nałożony na przeciwnika zadaje dodatkowo <#a974ffff>{BonusDamage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Doskakuje do celu w zasięgu {Range} jednostek z prędkością {Speed} jednostek, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>, a następnie <#ef5350ff>ogłuszając go na {Stun}s<>.",
        "skill2": "Uderza w ziemię, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> przeciwnikom znajdującym się w zasięgu {Range} jednostek i <#ef5350ff>spowalnia ich o {Slow}% na {SlowTime}s<>.",
        "ult": "Uderza w ziemie, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> wszystkim przeciwnikom znajdującym się w zasięgu {Range} jednostek i <#ef5350ff>podrzucając ich na {Time}s<>."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Rzuca kością i atakuje przeciwników w zasięgu {Range} jednostek tyle razy ile wynosi wartość rzutu. Każdy atak zadaje <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Rzuca żetonem w zasięgu {Range} jednostek, który tworzy obszar o wielkości {AttackRange} jednostek <#ef5350ff>spowalniający przeciwników o {Slow}%<> na {Time}s. Na koniec obszar wybucha, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> przeciwnikom w środku.",
        "ult": "Wystrzeliwuje w linii prostej stos pieniędzy, który <#ef5350ff>rzuca urok<> na trafionych przeciwników na <#ef5350ff>{Time}s<> oraz zadaje im <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Staje się nienamierzalny i szarżuje w linii prostej. Każdy udział w eliminacji przeciwnika zwiększa <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<> oraz <#6aff55ff>przywraca {Heal} zdrowia<>.",
        "skill2": "Wykonuje krótki doskok, zadając pierwszemu trafionemu przeciwnikowi <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Umiejętność może zostać użyta kolejno maksymalnie <#ffb900ff>{Time} razy<>.",
        "ult": "Staje się odporny na efekty kontroli tłumu na <#ffb900ff>{Time}s<>. Każdy udział w eliminacji przeciwnika resetuje czas odnowienia podstawowych umiejętności."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Może atakować przeciwników podczas ruchu. Od 3 poziomu każdy atak przeciwko przeciwnikowi zwiększa <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>prędkość ruchu o {Value}%<> na {Time}s.",
        "skill2": "Wzmacnia ataki na {Time}s, zwiększając <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Attack}<>. Co 3 atak <#ef5350ff>spowalnia trafionego przeciwnika o {Slow}% na {SlowTime}s<>.",
        "ult": "Wzmacnia ataki na <#ffb900ff>{Time}s<>, zwiększając <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Attack}<>. Ataki dodatkowo wystrzeliwują pociski do 2 przeciwników znajdujących się w pobliżu celu. Dodatkowe pociski zadają <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>."
      },
      "ice_mage": {
        "name": "Ice Mage",
        "skill": "Zamraża przeciwnika zadając mu <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>ogłuszając go na {Time}s<>.",
        "skill2": "Przywołuje lodową strefę utrzymującą się przez <#ffb900ff>{Duration}s<>, która <#ef5350ff>spowalnia przeciwników w promieniu {Range} jednostek o {MoveSpeed}%<> oraz co {Tick}s zadaje <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Po wygaśnięciu strefy zamraża znajdujących się w niej przeciwników, <#ef5350ff>ogłuszając ich na {Stun}s<>.",
        "ult": "Zadaje przeciwnikom w stożku przed sobą <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> i odrzuca ich do tyłu. Dodatkowo <#ef5350ff>spowalnia ich o {Slow}% na {SlowDuration}s<> oraz <#ef5350ff>uniemożliwia używanie umiejętności ruchu przez {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Wystrzeliwuje pocisk zakłócający zmysły przeciwnika, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Przed trafionym przeciwnikiem przywołuje iluzję iluzjonisty, która <#ef5350ff>prowokuje go przez {Time}s<>.",
        "skill2": "Zadaje przeciwnikom w promieniu {Range} jednostek <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>przestrasza ich na {Time}s<>.",
        "ult": "Tworzy iluzję pobliskiego sojuszniczego bohatera, która utrzymuje się przez <#ffb900ff>{Duration}s<>. Iluzja może wykonywać wyłącznie ataki podstawowe i posiada takie same statystyki jak skopiowany bohater."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Przywołuje małą jiangshi, która szarżuje na przeciwnika i atakuje go 3 razy przed zniknięciem, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<>) na uderzenie.",
        "skill2": "Uderza w przeciwnika <#ef5350ff> ogłuszając go na {Time}s<>, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#6aff55ff>przywracając sobie {Heal} zdrowia<>.",
        "ult": "Przez <#ffb900ff>{Duration}s<> wysysa zdrowie z przeciwników w promieniu {Range} jednostek, przywracając sobie <#6aff55ff>{Heal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mocy umiejętności<>) <#6aff55ff>zdrowia<> oraz zadając im <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>."
      },
      "knight": {
        "name": "Knight",
        "skill": "<#ef5350ff>Prowokuje<> wybranego przeciwnika na <#ef5350ff>{Time}s<>.",
        "skill2": "Nakłada na siebie <#e8d44dff>tarczę o wartości<> <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maksymalnego zdrowia<> + <#e8d44dff>{Amount}<>, która utrzymuje się przez <#ffb900ff>{Time}s<>. Podczas działania tarczy <#ff9028ff>otrzymane obrażenia są odbijane w {Reflect}%<>.",
        "ult": "Przywołuje w wybranym miejscu strefę ochronną o promieniu {Range}, która utrzymuje się przez <#ffb900ff>{Time}s<>. Sojusznicy znajdujący się w strefie otrzymują o <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maksymalnego zdrowia<> mniej obrażeń. Przeciwnicy znajdujący się w strefie są <#ef5350ff>spowolnieni o {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancer",
        "skill": "Odpycha przeciwników w zasięgu {Range} jednostek i zadaje <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Wykonuje krótki doskok, zadając przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz przenikając przez nich, by znaleźć się za ich plecami.",
        "ult": "Szarżuje na odległość {Range} jednostek, zadając wszystkim trafionym przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>podrzucając ich na {Time}s<>."
      },
      "lightning_mage": {
        "name": "Lightning Mage",
        "skill": "Wystrzeliwuje błyskawicę w wybranego przeciwnika, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Błyskawica rozprzestrzenia się na kolejnych przeciwników znajdujących się w pobliżu, ale nie może trafić tego samego celu więcej niż raz.",
        "skill2": "Przywołuje błyskawicę w wybranym obszarze, zadając trafionym przeciwnikom <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>ogłuszając ich na {Time}s<>.",
        "ult": "<#ef5350ff>Przygważdża<> wybranego wrogiego bohatera wiązką błyskawic na <#ffb900ff>{Duration}s<>. Podczas działania umiejętności cel oraz pobliscy przeciwnicy stale otrzymują <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>."
      },
      "magic_knight": {
        "name": "Magic Knight",
        "skill": "Powoduje eksplozję energii w długiej, wąskiej linii, zadając trafionym przeciwnikom <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "skill2": "Tworzy rdzeń magicznej energii utrzymujący się przez <#ffb900ff>{Duration}s<>, który co {Tick}s przyciąga przeciwników w promieniu {Range} jednostek w kierunku centrum oraz zadaje im <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Przez <#ffb900ff>{Time}s<> <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zwiększa swój zasięg ataku o {Range} jednostek<> oraz <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>zwiększa swoją prędkość ataku o {AttackSpeed}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% mocy umiejętności<>). Każdy atak podstawowy aktywuje umiejętność 1."
      },
      "monk": {
        "name": "Monk",
        "skill": "Przywraca sojusznikom w promieniu {Range} jednostek <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>. Jeśli leczy tylko siebie, wartość leczenia wzrasta do <#6aff55ff>{SingleValue}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>).",
        "skill2": "Uderza dłonią o ziemię, zadając przeciwnikom w promieniu {Range} jednostek <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>ogłuszając ich na {Time}s<>.",
        "ult": "Zapewnia sojusznikom w promieniu {Range} jednostek <#e8d44dff>tarczę o wartości {Shield}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>). Sojusznicy objęci tarczą <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zyskują {MoveSpeed}% prędkości ruchu<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Przywołuje gula, który walczy u boku bohatera przez <#ffb900ff>{Duration}(+{DurationCoef}% mocy umiejętności)s<>. Wraz ze wzrostem poziomu czas odnowienia umiejętności skraca się, a czas trwania gula wydłuża się o <#ffb900ff>{DurationPerLevel}s<>.",
        "skill2": "Oznacza przeciwnika jako cel ataku na <#ffb900ff>{Time}s<>, wprawiając gula w szał. Ghul zyskuje <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% mocy umiejętności<>) prędkości ataku oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% mocy umiejętności<>) prędkości ruchu.",
        "ult": "Wskrzesza poległego sojuszniczego bohatera jako upiora. Podczas działania przywołania co sekundę <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>traci {HpDrain} zdrowia<>."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Wystrzeliwuje kulę cienia, doskakując do trafionego przeciwnika i zadając mu <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Wykonuje krótki doskok w kierunku wybranego przeciwnika, stając się nienamierzalny i wyprowadzając trzy szybkie ataki. Każdy atak zadaje <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Doskakuje do przeciwnika znajdującego się w zasięgu {Range} jednostek, zadając mu <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Za każdym razem, gdy Ogre otrzyma obrażenia od wrogiego bohatera, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>zwiększa swoje maksymalne zdrowie o {Value}<>.",
        "skill2": "Uderza pojedynczego przeciwnika maczugą, <#ef5350ff>ogłuszając go na {Time}s<> oraz zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maksymalnego zdrowia<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Przez <#ffb900ff>{Time}s<> zwiększa swój rozmiar, a jego <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maksymalne zdrowie wzrasta o {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% maksymalnego zdrowia<>."
      },
      "plague_doctor": {
        "name": "Plague Doctor",
        "skill": "Podaje sobie i wybranemu sojusznikowi serum bojowe na <#ffb900ff>{Duration}s<>, zwiększając <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% mocy umiejętności<>) oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>prędkość ruchu o {MoveSpeed}%<>.",
        "skill2": "Przeprowadza rytuał na wybranym sojuszniku, zwiększając na <#ffb900ff>{Duration}s<> jego <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zasięg ataku o {Range} jednostek<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% mocy umiejętności<>) oraz nadając jego atakom efekt doskoku.",
        "ult": "Podaje wybranemu sojusznikowi zakazany eliksir, zmniejszając jego bieżące zdrowie o {HpReduceRatio}%. Przez <#ffb900ff>{Duration}s<> jego zdrowie nie może jednak spaść poniżej tej wartości. Będąc pod wpływem eliksiru, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>zyskuje {Attack} obrażeń od ataku<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% prędkości ataku<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% mocy umiejętności<>) oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% prędkości ruchu<>."
      },
      "poison_dart_hunter": {
        "name": "Poison Dart",
        "skill": "Tworzy toksyczną strefę, zadając przeciwnikom w obszarze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Trafieni przeciwnicy zostają <#ffb900ff>zatruci na {Duration}s<> oraz <#ef5350ff>spowolnieni o {Slow}%<>.",
        "skill2": "Atakując zatrutego przeciwnika, <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zwiększa swój zasięg ataku o {Range} jednostek<>. Oddalając się od zatrutego przeciwnika, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa swoją prędkość ruchu o {Speed}%<>.",
        "ult": "Przez <#ffb900ff>{Duration}s<> ataki pobliskich sojuszników zatruwają przeciwników. Trucizna przez <#ffb900ff>{PoisonDuration}s<> stale zadaje <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>."
      },
      "priest": {
        "name": "Priestess",
        "skill": "Tworzy leczącą strefę o promieniu {Range} jednostek, która utrzymuje się przez <#ffb900ff>{Duration}s<>. Sojusznicy znajdujący się w strefie odzyskują co {Tick}s <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>.",
        "skill2": "Zapewnia wybranemu sojusznikowi <#e8d44dff>tarczę o wartości {Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) na <#ffb900ff>{Time}s<>. Dopóki tarcza się utrzymuje, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku sojusznika wzrasta o {AttackSpeed}%<>.",
        "ult": "Wznosi się w powietrze i pozostaje w miejscu przez <#ffb900ff>{Time}s<>. W tym czasie co {Tick}s wystrzeliwuje pocisk leczniczy do sojusznika o najniższym poziomie zdrowia znajdującego się w zasięgu umiejętności, przywracając mu <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Przywołuje kulę ognia, która spada na wybrany obszar, zadając przeciwnikom w promieniu {Range} jednostek <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "skill2": "Przywołuje płomienną strefę, która utrzymuje się przez <#ffb900ff>{Duration}s<>. Przeciwnicy w promieniu {Range} jednostek otrzymują co {Tick}s <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Powoduje potężną eksplozję w promieniu {Range} jednostek, zadając wszystkim trafionym przeciwnikom <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>."
      },
      "pythoness": {
        "name": "Shrine Maiden",
        "skill": "Przywraca wybranemu sojusznikowi <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>.",
        "skill2": "Przywraca wybranemu sojusznikowi <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<> oraz zadaje przeciwnikom w promieniu {Range} jednostek wokół niego <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Przywołuje Bramę Duchów. Brama wystrzeliwuje pociski, które przywracają sojusznikom w promieniu {Range} jednostek <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<> lub zadają przeciwnikom <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>."
      },
      "shadowmancer": {
        "name": "Shadowmancer",
        "skill": "Ziemię spowija mroczny cień, zadając przeciwnikom w obszarze <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>unieruchamiając ich na {Time}s<>.",
        "skill2": "Detonuje cień unieruchomionego przeciwnika, zadając mu <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Wystrzeliwuje przebijający pocisk cienia, który zadaje trafionemu bohaterowi <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>wyklucza go z walki na {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Shield Bearer",
        "skill": "Zapewnia sobie i wybranemu sojusznikowi w zasięgu <#e8d44dff>tarczę o wartości {Shield}<>(+<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maksymalnego zdrowia<>), która utrzymuje się przez <#ffb900ff>{Duration}s<>.",
        "skill2": "Przez <#ffb900ff>{Duration}s<> przejmuje <#ff9028ff>{Damage}%<> obrażeń otrzymywanych przez pobliskich sojuszników. Przeciwnicy, którzy zaatakują chronionego sojusznika, zostają <#ef5350ff>spowolnieni o {Coef}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% pancerza<>).",
        "ult": "Ładuje umiejętność przez maksymalnie <#ffb900ff>{Duration}s<>, zyskując <#e8d44dff>{DamageReduce}% redukcji obrażeń<>(+<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% odporności na magię<>) oraz odporność na efekty kontroli tłumu. Po zakończeniu ładowania <#ef5350ff>prowokuje wszystkich przeciwników w dużym obszarze na {TauntDuration}s<>. Podczas prowokacji przeciwnicy nie mogą się poruszać."
      },
      "soldier": {
        "name": "Sniper",
        "skill": "Z każdym poziomem <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zwiększa swój zasięg ataku o {GrowthRange} jednostek<>.",
        "skill2": "Oddaje trzy szybkie strzały w wybranego przeciwnika, zadając wysokie <#ff9028ff>obrażenia fizyczne<> (<#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) za każdy strzał). Zasięg umiejętności zwiększa się wraz z <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zasięgiem ataku<>.",
        "ult": "Wystrzeliwuje ogromny pocisk snajperski lecący po linii prostej do przeciwnika znajdującego się w zasięgu {Range} jednostek. Pocisk zadaje wszystkim trafionym przeciwnikom na swojej drodze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>, a jego obrażenia zmniejszają się o {Decay}% z każdym kolejnym trafieniem."
      },
      "swordman": {
        "name": "Swordsman",
        "skill": "Wystrzeliwuje falę energii o zasięgu {Range} jednostek, zadając trafionym przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Trzykrotnie tnie wybranego przeciwnika, zadając wysokie <#ff9028ff>obrażenia fizyczne<>. Każde trafienie zadaje <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>).",
        "ult": "Szarżuje po linii prostej na odległość {Range} jednostek, zadając przeciwnikom na swojej drodze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Obrażenia są dzielone pomiędzy wszystkich trafionych przeciwników. Jeśli umiejętność zabije przeciwnika, jej czas odnowienia zostaje zresetowany."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Pieczętuje przeciwnika talizmanem, zadając <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> i uniemożliwiając mu wykonywanie ataków podstawowych przez <#ef5350ff>{Time}(+{TimeCoef}% mocy umiejętności)s<>.",
        "skill2": "Zapieczętowuje moce przeciwnika, zadając <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> i uniemożliwiając mu używanie umiejętności przez <#ef5350ff>{Time}(+{TimeCoef}% mocy umiejętności)s<>.",
        "ult": "Wystrzeliwuje talizman po linii prostej, który zadaje trafionemu przeciwnikowi <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>wyklucza go z walki na {Time}s<>. Po zakończeniu efektu przechodzi on na pobliskich przeciwników."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Wysysa krew przeciwnika, zadając mu <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#6aff55ff>przywracając sobie {Heal} zdrowia<>. Dodatkowo nakłada ładunek. Każdy ładunek <#6aff55ff>zwiększa wartość leczenia o {Stack} zdrowia<>.",
        "skill2": "Poświęca <#6aff55ff>{Value}% swojego zdrowia<>, wypluwając przed siebie falę krwi, która zadaje przeciwnikom w stożku <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Każdy ładunek <#ff9028ff>zwiększa obrażenia o {Stack}<>.",
        "ult": "Staje się <#ef5350ff>nieuchwytny<> i wykonuje doskok na odległość {Range} jednostek. Każdemu przeciwnikowi znajdującemu się na swojej drodze zadaje <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz wysysa z niego <#6aff55ff>{Heal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Rozdziera przeciwników przed sobą w kształcie półksiężyca, zadając im <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#6aff55ff>przywraca sobie zdrowie równe {HealRatio}% zadanych obrażeń<>.",
        "skill2": "Szarżuje do przodu, zadając trafionym przeciwnikom <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>spowalniając ich o {Slow}% na {SlowTime} s<>.",
        "ult": "Przez <#ffb900ff>{Duration}s<> wykonuje serię cięć w stożku przed sobą, wielokrotnie zadając przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz powodując <#ef5350ff>krwawienie na {BleedTime}s<>. Krwawienie zadaje <#ff9028ff>{BleedDamage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% obrażeń od ataku<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Przez <#ffb900ff>{Duration}s<> wzmacnia swój atak podstawowy. Ataki tworzą rozchodzącą się stożkowo falę uderzeniową, która zadaje <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Przez <#ffb900ff>{Duration}s<> wzmacnia swoją odporność, zyskując <#e8d44dff>tarczę o wartości {Shield}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) oraz <#e8d44dff>{DamageReduction}% redukcji obrażeń<>.",
        "ult": "Wystrzeliwuje pocisk po linii prostej, który <#ef5350ff>stopniowo spowalnia trafionego przeciwnika przez {SlowTime}s<>, a następnie <#ef5350ff>unieruchamia go na {BindTime}s<>. Po unieruchomieniu zadaje pobliskim przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Trafieni przeciwnicy również zostają objęci tym efektem."
      },
      "hammerer": {
        "name": "Hammerer",
        "skill": "Uderza pobliskiego przeciwnika młotem, zadając mu <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> i <#ef5350ff>podbijając go na {Time}s<>.",
        "skill2": "Unosi młot i przez chwilę koncentruje energię, po czym uderza nim o ziemię, zadając przeciwnikom w promieniu {Range} jednostek <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>spowalniając ich o {Move}% na {Time}s<>.",
        "ult": "Wykonuje szeroki zamach młotem, zadając wszystkim przeciwnikom w półokręgu o promieniu {Range} jednostek <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Trafieni przeciwnicy zostają odrzuceni na {Time}s. <#ef5350ff>Wrodzy bohaterowie, którzy zderzą się z odrzucanym przeciwnikiem, zostają podrzuceni na {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Wykonuje krótki doskok, zadając pierwszemu trafionemu przeciwnikowi <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz nakładając na niego <#ef5350ff>Krwawienie<>.",
        "skill2": "Rozcina wybranego przeciwnika, zadając mu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Jeśli przeciwnik jest pod wpływem <#ef5350ff>krwawienia<>, czas odnowienia umiejętności 1 zostaje zresetowany.",
        "ult": "Doskakuje do wrogiego bohatera, zadając wszystkim przeciwnikom w miejscu lądowania <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Przeciwnicy, których zdrowie po otrzymaniu obrażeń spadnie poniżej {Threshold}% maksymalnego zdrowia, zostają straceni. Jeśli egzekucja się powiedzie, pobliscy przeciwnicy zostają <#ef5350ff>przestraszeni na {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Pole Warrior",
        "skill": "Skacze do przeciwnika i uderza go z góry, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Przemieszcza się na krótki dystans, opierając się na swoim kiju i stając się nienamierzalny na {Time}s, po czym wykonuje zamach, zadając wszystkim przeciwnikom w promieniu {Range} jednostek obrażenia równe <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Doskakuje do wskazanego przeciwnika w zasięgu {Range} jednostek, zadając mu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>podrzucając go na {Time}s<>."
      },
      "spirit_caller": {
        "name": "Spirit Caller",
        "skill": "Przywołuje opiekuńczego ducha przy sojuszniku, który przez <#ffb900ff>{Duration}s<> <#6aff55ff>przywraca mu {Heal}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% mocy umiejętności<>) zdrowia oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa jego prędkość ruchu o {SpeedUp}%<>.",
        "skill2": "Przyzywa dręczącego ducha przy przeciwniku, który przez <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zmniejsza jego pancerz o {DefDown}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% mocy umiejętności<>), <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>odporność na magię o {MrDown}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% mocy umiejętności<>) oraz <#ef5350ff>spowalnia go o {Slow}%<>.",
        "ult": "Aktywuje przywołane duchy. Opiekuńczy duch zapewnia <#e8d44dff>tarczę o wartości {Shield}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% mocy umiejętności<>) oraz <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>zwiększa prędkość ataku o {AttackSpeed}%<>. Dręczący duch natomiast zadaje <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>ogłusza na {StunTime}s<>."
      },
      "whip_master": {
        "name": "Whip Master",
        "skill": "Uderza biczem, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz dodatkowe obrażenia równe <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maksymalnego zdrowia celu<>.",
        "skill2": "Uderza biczem w stożku przed sobą, zadając przeciwnikom w zasięgu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz odrzucając ich.",
        "ult": "Przez <#ffb900ff>{Duration}s<> nieustannie wystrzeliwuje przebijające pociski w linii prostej w kierunku losowych przeciwników w zasięgu. Pociski zadają <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Podczas używania umiejętności nie może się poruszać."
      },
      "enchanter": {
        "name": "Enchanter",
        "skill": "Wzmacnia wybranego sojusznika na <#ffb900ff>{Duration}s<>, zwiększając jego <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>zasięg ataku o {Increase} jednostek<>.",
        "skill2": "Wzmacnia wyposażenie wybranego sojusznika na <#ffb900ff>{Duration}s<>, zwiększając wszystkie statystyki zapewniane przez przedmioty o <#ffb900ff>{Percent}%<>.",
        "ult": "Wzmacnia wybranego sojusznika na <#ffb900ff>{Duration}s<>, zwiększając jego <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% mocy umiejętności<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>prędkość ruchu o {MoveSpeed}%<> oraz zapewniając mu odporność na efekty kontroli tłumu."
      },
      "siege_breaker": {
        "name": "Siege Breaker",
        "skill": "Uderza cel, zadając <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Zadaje dodatkowo {Bonus}% obrażeń strukturom.",
        "skill2": "Uderza o ziemię, zadając wszystkim przeciwnikom i strukturom w zasięgu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Przez <#ffb900ff>{Time}s<> <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>zwiększa swoje obrażenia od ataku o {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<> oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>prędkość ruchu o {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Prisoner",
        "skill": "Rzuca metalową kulę po linii prostej, zadając wszystkim przeciwnikom na jej drodze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Wydaje potężny ryk, zyskując na {Time}s <#e8d44dff>tarczę o wartości {Shield}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maksymalnego zdrowia<>) oraz <#ef5350ff>prowokując<> wszystkich pobliskich przeciwników.",
        "ult": "Doskakuje do wybranego przeciwnika, zadając wszystkim przeciwnikom w miejscu lądowania <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>ogłuszając ich na {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Wystrzeliwuje falę uderzeniową po linii prostej. Fala eksploduje po trafieniu przeciwnika lub po osiągnięciu maksymalnego zasięgu, zadając wszystkim przeciwnikom w obszarze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>spowalniając ich o {Slow}% na {Time}s<>.",
        "skill2": "Zyskuje <#e8d44dff>tarczę o wartości {Shield}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maksymalnego zdrowia<>) na {Time}s. Gdy tarcza wygaśnie lub zostanie zniszczona, <#ef5350ff>ogłusza wszystkich przeciwników w promieniu {Range} jednostek na {StunTime}s<>.",
        "ult": "Zapewnia wskazanemu sojusznikowi w zasięgu {Range} jednostek <#e8d44dff>tarczę o wartości {Shield}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maksymalnego zdrowia<>), dodatkowo teleportując się do niego po {Time}s."
      },
      "white_mage": {
        "name": "White Mage",
        "skill": "Wystrzeliwuje promień energii w linii prostej, który po chwili eksploduje, zadając wszystkim przeciwnikom w zasięgu <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "skill2": "Przywołuje wiązki energii w wybranym obszarze, które atakują 5 razy, zadając przeciwnikom w zasięgu <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>spowalniając ich o {Slow}% na {SlowTime}s<>.",
        "ult": "Wystrzeliwuje przebijający promień w linii prostej, zadając trafionym przeciwnikom <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>unieruchamiając ich na {Time}s<>."
      },
      "wind_mage": {
        "name": "Wind Mage",
        "skill": "Przywołuje wir na <#ffb900ff>{Duration}s<>, który co {Tick}s zadaje przeciwnikom w promieniu {Range} jednostek <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<>). Sojusznicy znajdujący się wewnątrz wiru <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zyskują {MoveSpeed}% prędkości ruchu<>.",
        "skill2": "Wystrzeliwuje przed siebie pięć wirów, zadając przeciwnikom w ich zasięgu <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>.",
        "ult": "Przywołuje ogromne tornado, które powoli podąża w stronę najbliższego wrogiego bohatera. Trafieni przeciwnicy otrzymują <#a974ffff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> i zostają <#ef5350ff>podrzuceni na {AirborneTime}s<>. Po każdym trafieniu rozmiar tornado, zadawane obrażenia oraz czas podrzucenia maleją, a tornado zmienia kierunek w stronę kolejnego wrogiego bohatera."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Rzuca bombą, zadając wszystkim przeciwnikom w zasięgu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Umieszcza niewidzialną minę. Gdy przeciwnik na nią nadepnie, otrzymuje <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> i zostaje <#ef5350ff>unieruchomiony na {Time}s<>. Mina nie aktywuje się na minionach.",
        "ult": "Rzuca ogromną bombę we wskazane miejsce, zadając wszystkim przeciwnikom w zasięgu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>spowalniając ich o {Slow}% na {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Cavalry",
        "skill": "Szarżuje w linii prostej, nabijając pierwszego trafionego przeciwnika na włócznię, <#ef5350ff>unieruchamiając go na {Time}s<> oraz zadając mu <#ff9028ff>{Damage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Prędkość szarży skaluje się z prędkością ruchu.",
        "skill2": "Przez {Time}s <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa swoją prędkość ruchu o {Speed}%<> , a jego broń staje w płomieniach. Ataki dodatkowo nakładają podpalenie, które przez {BurnTime}s zadaje <#ff9028ff>{BurnDamage}<> (+ <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% obrażeń od ataku<>) jako obrażenia od podpalenia.",
        "ult": "Przez {Time}s <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa swoją prędkość ruchu o {Speed}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% obrażeń od ataku<>) oraz tworzy ścieżkę prowadzącą do swojej pozycji. Sojusznicy znajdujący się na ścieżce <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zyskują {Buff}%<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% obrażeń od ataku<>) prędkości ruchu podczas poruszania się w jego kierunku."
      },
      "druid": {
        "name": "Druid",
        "skill": "Przywołuje niedźwiedzia, który atakuje pobliskich przeciwników. Gdy niedźwiedź zginie, zadaje druidowi <#ff9028ff>{DeathDamage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% mocy umiejętności<>) obrażeń, jednak efekt ten nie może obniżyć jego zdrowia poniżej 1. Użycie umiejętności podczas przywołania niedźwiedzia <#6aff55ff>przywraca mu {Heal}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mocy umiejętności<>) zdrowia.",
        "skill2": "Przywołuje orła, który atakuje pobliskich przeciwników. Gdy orzeł zginie, druid otrzymuje obrażenia, ale efekt ten nie może go zabić. Użycie umiejętności podczas przywołania orła sprawia, że rzuca się on na przeciwnika, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#6aff55ff>przywracając zdrowie równe {Lifesteal}% zadanych obrażeń<>.",
        "ult": "Wystrzeliwuje kolejno {Count} duchów niedźwiedzia i orła we wskazanym kierunku. Każdy z nich zadaje <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> i odpycha trafionych przeciwników."
      },
      "voodoo_shaman": {
        "name": "Voodoo Shaman",
        "skill": "Wystrzeliwuje przeklęty pocisk, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>, <#ef5350ff>spowalniając przeciwnika o {Slow}% na {Time}s<> oraz <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>zmniejszając jego prędkość ataku o {AtkSpd}%<> na <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Nakłada klątwę na wybranego przeciwnika na <#ffb900ff>{Time}s<>, zadając <#a974ffff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<>. Podczas działania klątwy każde otrzymane obrażenia nakładają ładunek klątwy. Po wygaśnięciu klątwy cel otrzymuje dodatkowo <#a974ffff>{HitDmg}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> za każdy ładunek. (maks. {Max} ładunków)",
        "ult": "Tworzy strefę voodoo we wskazanym miejscu na <#ffb900ff>{Duration}s<>. Przeciwnicy znajdujący się w obszarze stale otrzymują <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maksymalnego zdrowia<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> oraz <#ef5350ff>nie mogą używać umiejętności<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Oddaje serię trzech strzałów. Pierwszy pocisk <#ef5350ff>ogłusza trafionego przeciwnika na {StunTime}s<>, a każdy z dwóch kolejnych zadaje <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<>.",
        "skill2": "Teleportuje się za ostatnio zaatakowanego wrogiego bohatera w zasięgu <#ffb900ff>{Range}<> jednostek.",
        "ult": "Naznacza wrogiego bohatera. Po <#ffb900ff>{Duration}s<> zadaje mu <#ff9028ff>{Damage} + obrażenia otrzymane podczas działania oznaczenia w wysokości {Coef}%<> jako <#ff9028ff>obrażenia fizyczne<>. Po zabójstwie celu staje się niewidzialny na <#ffb900ff>{InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Guardian Spirit",
        "skill": "Przywraca pobliskim sojusznikom <#6aff55ff>{Value}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>.",
        "skill2": "Zapewnia sojusznikowi <#e8d44dff>tarczę o wartości {Shield}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% mocy umiejętności<>) oraz <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa jego prędkość ruchu o {MoveSpeed}%<>.",
        "ult": "Tworzy święty obszar na <#ffb900ff>{Duration}s<>, który stale przywraca sojusznikom w zasięgu <#6aff55ff>{HealValue}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mocy umiejętności<>) <#6aff55ff>zdrowia<>. Jeśli sojusznik zginie w obszarze działania umiejętności, zostaje wskrzeszony, a umiejętność natychmiast się kończy."
      },
      "hunter": {
        "name": "Hunter",
        "skill": "Teleportuje się do przeciwnika i przechodzi w tryb ataków dystansowych. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Zwiększa swój zasięg ataku o {RangeIncrease} jednostek<>.",
        "marks": "Podstawowe ataki dystansowe oznaczają wrogich bohaterów na <#ffb900ff>{Duration} s<>. Kolejne trafienia odnawiają czas istniejących znaczników. Drugiej umiejętności można użyć na wrogach z 3 znacznikami.",
        "skill2": "Doskakuje do przeciwnika z <#ffb900ff>3 ładunkami oznaczenia<>, zadając <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>uciszając go na {SilenceTime}s<>. Ataki podstawowe nakładają oznaczenie.",
        "ult": "Szarżuje przed siebie, zadając przeciwnikom na swojej drodze <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Udział w zabójstwie przeciwnika resetuje czas odnowienia tej umiejętności."
      },
      "circus_blade": {
        "name": "Circus Blade",
        "skill": "Wystrzeliwuje ostrze we wskazanym kierunku, zadając przeciwnikom <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>spowalniając ich o {Slow}% na {SlowTime}s<>. Umiejętność posiada maksymalnie <#ffb900ff>{ChargeCount} ładunków<>. Zadanie obrażeń wrogiemu bohaterowi atakiem podstawowym przywraca <#ffb900ff>1 ładunek<>.",
        "skill2": "Przez <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>zwiększa swoją prędkość ruchu o {MoveSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>prędkość ataku o {AttackSpeed}%<> oraz zyskuje możliwość przenikania przez ściany.",
        "ult": "Doskakuje do wskazanego przeciwnika, zadając mu <#ff9028ff>{Damage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Następnie zadaje pobliskim przeciwnikom <#ff9028ff>{SplashDamage}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% obrażeń od ataku<>) jako obrażenia obszarowe, <#ef5350ff>podrzucając ich<>, po czym staje się niewidzialny."
      },
      "sand_mage": {
        "name": "Mag piasku",
        "skill": "Ataki podstawowe niosą energię piasku i zadają <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% mocy umiejętności<> jako <#a974ffff>dodatkowe obrażenia magiczne<>. Te dodatkowe obrażenia i piaskowy wybuch mogą trafić krytycznie. Po użyciu wysadza piasek wokół celu, zadając <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obszarowe obrażenia magiczne<>.",
        "skill2": "Pochłania energię piasku na <#ffb900ff>{Time}s<>, zwiększając <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>szybkość ruchu o {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% mocy umiejętności<> i <#6aff55ff>lecząc się<> o <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mocy umiejętności<>.",
        "ult": "Tworzy wokół celu piaskowe bagno na <#ffb900ff>{Duration}s<>. Co {Tick}s wrogowie w środku otrzymują <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> i są przyciągani do centrum."
      },
      "alchemist": {
        "name": "Alchemik",
        "skill": "Rzuca fiolką, która wybucha i zostawia toksyczną kałużę na <#ffb900ff>{Time}s<>. Wrogowie w kałuży zostają <#78e85cff>otruci<> na <#ffb900ff>{DotTime}s<>, otrzymują <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> co {DotTick}s, a ich leczenie jest zmniejszone o {HealReduce}%.",
        "skill2": "Wstrzykuje jednemu wrogowi niestabilny odczynnik, zadając <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<>. Przez <#ffb900ff>{Time}s<> cel nie może być leczony i jest spowolniony o {Slow}%.",
        "ult": "Rzuca toksyczną fiolką po linii prostej. Po trafieniu wrogiego bohatera tworzy trującą chmurę, która przez <#ffb900ff>{CloudTime}s<> rozszerza się do zasięgu {CloudRadius}. Wrogowie w chmurze zostają <#78e85cff>otruci<> na <#ffb900ff>{DotTime}s<>, otrzymują <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<> jako <#a974ffff>obrażenia magiczne<> co {DotTick}s oraz tracą <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% mocy umiejętności<> pancerza i <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% mocy umiejętności<> odporności na magię."
      },
      "crossbowman": {
        "name": "Kusznik",
        "skill": "Wystrzeliwuje potężną strzałę w linii prostej, zadając pierwszemu trafionemu wrogiemu bohaterowi <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<>. Dopóki trwa znak superumiejętności, zadaje dodatkowo <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% obrażeń od ataku<> obrażeń.",
        "skill2": "Wystrzeliwuje przed siebie przebijającą strzałę w linii prostej, zadając wrogom <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<> i cofając się przez <#ffb900ff>{BackstepTime}s<>. Dopóki trwa znak superumiejętności, zadaje dodatkowo <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% obrażeń od ataku<> obrażeń.",
        "ult": "Wystrzeliwuje pocisk smugowy w linii prostej, zadając pierwszemu trafionemu wrogiemu bohaterowi <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<> i oznaczając go na <#ffb900ff>{Duration}s<>. Dopóki znak trwa, wszystkie umiejętności trafiają cel niezależnie od odległości, a ich czas odnowienia zmniejsza się o <#ffb900ff>{CoolReduce}%<>. Inni bohaterowie na torze lotu mogą przejąć trafienie."
      },
      "nightmare": {
        "name": "Koszmar",
        "skill": "Wystrzeliwuje odłamek koszmaru w linii prostej, zadając pierwszemu trafionemu wrogowi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<>. Może zostać użyty do <#ffb900ff>{UseCount} razy<> pod rząd.",
        "skill2": "Doskok na odległość <#ffb900ff>{Range}<> w wybranym kierunku, po czym zadaje wrogom w zasięgu <#ffb900ff>{Radius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<> i staje się niewidzialny na <#ffb900ff>{StealthTime} s<>.",
        "ult": "Doskok do wybranego wrogiego czempiona i zadanie <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażeń fizycznych<>. Jeśli ten cios zabije cel, teleportuje się obok żywego sojuszniczego czempiona niezależnie od odległości."
      },
      "strongman": {
        "name": "Siłacz",
        "skill": "Chwyta jednego pobliskiego wroga, przerzuca go przez ramię za siebie i zadaje <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<>, <#ef5350ff>ogłuszając go na {Stun} s<>.",
        "skill2": "Szeroko zamachuje się sztangą, zadając wrogom w promieniu <#ffb900ff>{Range}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<> i <#ef5350ff>odrzucając ich<>.",
        "ult": "Rzuca jednego pobliskiego sojuszniczego czempiona w wybrane miejsce. Po wylądowaniu rzucony sojusznik otrzymuje <#e8d44dff>tarczę o wartości {Shield}<> na <#ffb900ff>{ShieldTime} s<>. Wrogowie w promieniu <#ffb900ff>{Radius}<> od miejsca lądowania otrzymują <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<> jako <#ff9028ff>obrażenia fizyczne<> i zostają <#ef5350ff>ogłuszeni na {Stun} s<>. Jeśli w pobliżu nie ma sojusznika do rzucenia, Siłacz skacze sam; wtedy ogłuszenie trwa <#ef5350ff>{SelfStun} s<>."
      },
      "harpooner": {
        "name": "Harpunnik",
        "skill": "Wystrzeliwuje harpun w linii prostej, zadając pierwszemu trafionemu wrogiemu bohaterowi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> Obrażeń od ataku jako <#ff9028ff>obrażenia fizyczne<>. Przez <#ffb900ff>{RecastDuration}s<> po trafieniu można użyć umiejętności ponownie, aby przyciągnąć się do celu lub przyciągnąć cel do siebie.",
        "skill2": "Wystrzeliwuje potężny harpun w linii prostej, zadając pierwszemu trafionemu wrogowi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> Obrażeń od ataku + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> brakującego Zdrowia celu jako <#ff9028ff>obrażenia fizyczne<>.",
        "ult": "Wystrzeliwuje <#ffb900ff>{ProjectileCount}<> harpunów na łańcuchach w stożku przed sobą, zadając <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> Obrażeń od ataku jako <#ff9028ff>obrażenia fizyczne<> i wiążąc trafionych na <#ffb900ff>{LinkDuration}s<>. Związani wrogowie są spowolnieni o <#ef5350ff>{Slow}%<>. Gdy oddalą się o ponad <#ffb900ff>{LinkRange}<>, łańcuchy napinają się: spowolnienie rośnie do <#ef5350ff>{TensionSlow}%<> i wrogowie są przyciągani do siebie."
      },
      "spellbreaker": {
        "name": "Łamacz Zaklęć",
        "skill": "Wykonuje szerokie cięcie wielkim mieczem, zadając <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Ataku<> <#ff9028ff>obrażeń fizycznych<> i <#ef5350ff>spowalniając o {Slow}% na {Time} s<>.",
        "skill2": "Szarżuje na krótki dystans i zadaje pierwszemu trafionemu wrogowi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Ataku<> <#ff9028ff>obrażeń fizycznych<>. Po szarży <#ffb900ff>otrzymywane obrażenia są zmniejszone o {Reduce}% przez {Time} s<>.",
        "ult": "Natychmiast niszczy wszystkie tarcze wrogów w promieniu <#ffb900ff>{Range}<>. Wróg, którego tarcza została zniszczona, otrzymuje <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mocy Magicznej<> <#a974ffff>obrażeń magicznych<>, zostaje <#ef5350ff>ogłuszony na {Stun} s<> i <#ffb900ff>nie może otrzymywać tarcz przez {BlockTime} s<>. Wróg bez tarczy otrzymuje tylko <#a974ffff>{Damage} obrażeń magicznych<>."
      },
      "gladiator": {
        "name": "Gladiator",
        "skill": "Rzuca sieć w stożku <#ffb900ff>{FanAngle}°<> przed sobą, zadając <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> oraz <#ef5350ff>unieruchamiając<> przeciwników na <#ffb900ff>{Stun}s<>.",
        "skill2": "Pchnięciem trójzębu zadaje przed sobą <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<>. Ponowne trafienie tego samego bohatera w ciągu <#ffb900ff>{Time}s<> zwiększa obrażenia o <#ffb900ff>{Amplify}%<> za każdy ładunek (limit ładunków: <#ffb900ff>{MaxAmplifyTargets}<>). Trafienie innego bohatera resetuje ładunki.",
        "ult": "Doskakuje do wrogiego bohatera, zadając <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> i <#ef5350ff>prowokując<> go na <#ffb900ff>{Stun}s<>. Podczas pojedynku cel nie może być leczony ani otrzymywać nowych tarcz, a obrażenia otrzymywane przez Gladiatora od innych przeciwników są zmniejszone o <#ffb900ff>{Amplify}%<>. Pojedynek kończy się, gdy prowokacja zostanie oczyszczona lub cel zginie."
      },
      "ferryman": {
        "name": "Przewoźnik",
        "skill": "Rzuca kotwicę, która trafia pierwszego bohatera na swojej drodze. Sojusznik z co najwyżej <#ffb900ff>{AllyHpRatio}%<> zdrowia zostaje przyciągnięty do Przewoźnika i zyskuje <#ffb900ff>{Amplify}%<> prędkości ruchu na <#ffb900ff>{Time}s<>. Zdrowszych sojuszników kotwica omija. Przeciwnik otrzymuje natomiast <#a974ffff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> i zostaje spowolniony o <#ffb900ff>{Slow}%<> na <#ffb900ff>{SlowTime}s<>.",
        "skill2": "Tworzy przed sobą rzekę o długości <#ffb900ff>{Range}<> i szerokości <#ffb900ff>{Width}<> na <#ffb900ff>{Time}s<>. Sojusznicy na niej zyskują <#ffb900ff>{Amplify}%<> prędkości ruchu, a przeciwnicy zostają spowolnieni o <#ffb900ff>{Slow}%<>.",
        "ult": "Oczyszcza innego sojuszniczego bohatera z co najwyżej <#ffb900ff>{AllyHpRatio}%<> zdrowia i przewozi go łodzią o <#ffb900ff>{MoveDistance}<> w stronę sojuszniczej bazy w ciągu <#ffb900ff>{Time}s<>. Pasażer jest nienamierzalny, nie może działać i jest odporny na efekty przemieszczenia. Po zejściu na ląd odzyskuje <#6aff55ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% mocy umiejętności<>) zdrowia i zyskuje <#ffb900ff>{Slow}%<> prędkości ruchu na <#ffb900ff>{SlowTime}s<>."
      },
      "bombardier": {
        "name": "Kanonier",
        "skill": "Rozstawia lub składa działo. Po rozstawieniu nie może się poruszać, ale zasięg ataków podstawowych i umiejętności 2 rośnie o <#ffb900ff>{MoveDistance}<>, a <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>obrażenia od ataku o {Amplify}%<>. Po złożeniu zyskuje <#ffb900ff>{Slow}%<> prędkości ruchu na <#ffb900ff>{Time}s<>.",
        "skill2": "Wystrzeliwuje pocisk torem stromym w wybrane miejsce, zadając przeciwnikom w promieniu <#ffb900ff>{Radius}<> <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> i spowalniając ich o <#ffb900ff>{Slow}%<> na <#ffb900ff>{SlowTime}s<>. Po rozstawieniu działa zasięg rośnie.",
        "ult": "Wystrzeliwuje serię pocisków w wybrany obszar (łącznie: <#ffb900ff>{ProjectileCount}<>). Każdy zadaje <#ff9028ff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% obrażeń od ataku<>) jako <#ff9028ff>obrażenia fizyczne<> w promieniu <#ffb900ff>{ProjectileRadius}<>. Po rozstawieniu działa zasięg rośnie dodatkowo o <#ffb900ff>{MoveDistance}<>. Efekty kontroli tłumu przerywają pozostałe strzały."
      },
      "hypnotist": {
        "name": "Hipnotyzer",
        "skill": "Wypuszcza przebijające wahadło, które zadaje <#a974ffff>{Damage}<> (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% mocy umiejętności<>) jako <#a974ffff>obrażenia magiczne<> i spowalnia o <#ffb900ff>{Slow}%<> na <#ffb900ff>{SlowTime}s<>. Te obrażenia nie budzą <#ef5350ff>uśpionych<> przeciwników.",
        "skill2": "Po <#ffb900ff>{Delay}s<> <#ef5350ff>usypia<> przeciwników w promieniu <#ffb900ff>{Radius}<> na <#ffb900ff>{Time}s<>. Uśpieni nie mogą się poruszać ani działać. Obrażenia, także rozłożone w czasie, budzą cel, a to pierwsze trafienie zadaje o <#ffb900ff>{Amplify}%<> więcej obrażeń.",
        "ult": "Po <#ffb900ff>{Delay}s<> <#ef5350ff>usypia<> przeciwników w promieniu <#ffb900ff>{Radius}<> na <#ffb900ff>{Time}s<>. Obrażenia budzą cel, a budzące trafienie zadaje o <#ffb900ff>{Amplify}%<> więcej obrażeń. Oczyszczenie usuwa zarówno <#ef5350ff>uśpienie<>, jak i premię do obrażeń."
      }
    }
  },
