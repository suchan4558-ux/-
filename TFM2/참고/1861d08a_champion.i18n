        "skill": "召唤持续<#ffb900ff>{Duration}秒<>的旋风，每{Tick}秒对{Range}范围内的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。旋风内的己方英雄<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{MoveSpeed}%<>。",
        "skill2": "向前方发射五道飓风，对命中的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。",
        "ult": "向最近的敌方英雄卷起一道缓慢移动的巨型龙卷风。被龙卷风命中的敌人会受到<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>并被<#ef5350ff>击飞{AirborneTime}秒<>。每次命中时，龙卷风的大小、伤害和击飞时间都会减少，并改变目标扑向另一名敌方英雄。"
      },
      "bomber": {
        "name": "爆破手",
        "skill": "投掷炸弹，对爆炸范围内所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "埋设隐形地雷，敌人踩中时对其造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>禁锢{Time}秒<>。地雷不会被小兵触发。",
        "ult": "向目标区域投掷大爆弹，对爆炸范围内所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>减速{Slow}%，持续{SlowTime}秒<>。"
      },
      "cavalry_knight": {
        "name": "骑兵",
        "skill": "沿直线突进，刺穿第一个命中的敌人，将其<#ef5350ff>禁锢{Time}秒<>，并造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。突进速度与移动速度成正比。",
        "skill2": "在{Time}秒内，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{Speed}%<>，并将武器强化为烈焰长枪，攻击时附加{BurnTime}秒的燃烧伤害，额外造成<#ff9028ff>{BurnDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}%攻击力<>点<#ff9028ff>灼烧伤害<>。",
        "ult": "在{Time}秒内，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{Speed}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{SpeedCoef}%<>，并在原点生成一条指向自身的路径。路径上的友方英雄向骑兵所在方向移动时，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{Buff}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{SpeedCoef}%<>。"
      },
      "druid": {
        "name": "德鲁伊",
        "skill": "召唤一头熊。当熊死亡时，德鲁伊受到<#ff9028ff>{DeathDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}%法术强度<>点<#ff9028ff>物理伤害<>。在熊被召唤期间再次使用该技能，会使熊恢复<#6aff55ff>{Heal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法术强度<>点<#6aff55ff>生命值<>。",
        "skill2": "召唤一只鹰。鹰死亡时，德鲁伊会受到伤害。在鹰已被召唤的状态下再次使用该技能时，鹰会向敌人突进，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并恢复相当于伤害量<#6aff55ff>{Lifesteal}%<>的<#6aff55ff>生命值<>。",
        "ult": "向指定方向连续发射{Count}个熊与鹰的灵魂飞弹。每个飞弹造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并将敌人击退。"
      },
      "voodoo_shaman": {
        "name": "巫毒萨满",
        "skill": "抛掷诅咒之物，对命中的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使其<#ef5350ff>减速{Slow}%，持续{Time}秒<>，同时使其<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度减少{AtkSpd}%<>，持续<#ffb900ff>{AtkSpdTime}秒<>。",
        "skill2": "指定敌方目标，施加<#ffb900ff>{Time}秒<>的诅咒，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。诅咒持续期间，根据目标受到攻击的次数，造成<#a974ffff>{HitDmg}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}%法术强度<>点<#a974ffff>额外伤害<>。（最多{Max}次）",
        "ult": "生成一片持续<#ffb900ff>{Duration}秒<>的巫毒领域。领域内的敌人持续受到<#a974ffff>{HpRatio}%最大生命值<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并进入<#ef5350ff>沉默<>状态。"
      },
      "hitman": {
        "name": "杀手",
        "skill": "进行三连射。第一发射击使敌人<#ef5350ff>眩晕{StunTime}秒<>，随后的两发每发对其造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "在<#ffb900ff>{Range}<>距离内，瞬移到最近攻击过的敌方英雄身后。",
        "ult": "标记一名敌方英雄，在<#ffb900ff>{Duration}秒<>后造成<#ff9028ff>{Damage}+{Coef}%标记期间所受伤害量<>点<#ff9028ff>物理伤害<>。若击杀目标，则进入<#ffb900ff>{InvisibleDuration}秒<>隐身状态。"
      },
      "guardian_spirit": {
        "name": "戍魂灵",
        "skill": "使周围范围内的己方单位恢复<#6aff55ff>{Value}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#6aff55ff>生命值<>。",
        "skill2": "为己方单位施加<#e8d44dff>{Shield}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%法术强度<>点<#e8d44dff>护盾<>，并使其 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{MoveSpeed}%<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>内生成守护灵域，持续为范围内的己方单位恢复<#6aff55ff>{HealValue}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%法术强度<>点<#6aff55ff>生命值<>，并使灵域中的友方英雄死后以一定血量复活。"
      },
      "hunter": {
        "name": "追猎者",
        "skill": "瞬移到敌人身边并切换为远程攻击模式。<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>攻击距离增加{RangeIncrease}<>。",
        "marks": "远程普攻命中敌方英雄时施加持续<#ffb900ff>{Duration}秒<>的标记，再次命中会刷新已有标记的持续时间。第二个技能可以对叠有3层标记的敌人使用。",
        "skill2": "向叠加了3层标记的敌人突刺，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>沉默{SilenceTime}秒<>。",
        "ult": "向前施展追猎突袭，对突袭路径上的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。参与击杀时可再次使用。"
      },
      "circus_blade": {
        "name": "戏刃师",
        "skill": "沿指定方向投掷飞刀，对敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>减速{Slow}%，持续{SlowTime}秒<>。该技能最多可储备<#ffb900ff>{ChargeCount}层<>。在普通攻击命中敌方英雄时，会额外储备<#ffb900ff>1层<>。",
        "skill2": "施展把戏，在<#ffb900ff>{Duration}秒<>内，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度增加{MoveSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻击速度增加{AttackSpeed}%<>，并获得穿墙效果。",
        "ult": "冲向指定目标，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。随后对周围敌人造成<#ff9028ff>{SplashDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}%攻击力<>点<#ff9028ff>范围伤害<>并将其<#ef5350ff>击退<>，技能施展完毕后消失。"
      },
      "sand_mage": {
        "name": "沙术师",
        "skill": "普通攻击注入沙之力，造成<#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{PassiveCoef}%<> <#a974ffff>额外魔法伤害<>。该额外伤害与沙爆伤害可以暴击。使用时在目标周围引爆沙尘，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<> <#a974ffff>范围魔法伤害<>。",
        "skill2": "吸收沙之力，在<#ffb900ff>{Time}秒<>内使<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度提高{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{SpeedCoef}%<>，并<#6aff55ff>治疗自身<> <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{HealCoef}%<>。",
        "ult": "在目标周围设置持续<#ffb900ff>{Duration}秒<>的沙沼。沙沼每{Tick}秒对其中敌人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<> <#a974ffff>魔法伤害<>，并将其拉向中心。"
      },
      "alchemist": {
        "name": "炼金术师",
        "skill": "投掷烧瓶并引爆，留下持续<#ffb900ff>{Time}秒<>的毒性区域。区域内敌人会<#78e85cff>中毒<> <#ffb900ff>{DotTime}秒<>，每{DotTick}秒受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<> <#a974ffff>魔法伤害<>，且治疗量降低{HealReduce}%。",
        "skill2": "向一名敌人注入不稳定试剂，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<> <#a974ffff>魔法伤害<>。<#ffb900ff>{Time}秒<>内，目标无法被治疗，移动速度降低{Slow}%。",
        "ult": "沿直线投掷毒性烧瓶。命中敌方冠军时，生成一片在<#ffb900ff>{CloudTime}秒<>内扩散至最大{CloudRadius}范围的毒云。毒云内敌人会<#78e85cff>中毒<> <#ffb900ff>{DotTime}秒<>，每{DotTick}秒受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<> <#a974ffff>魔法伤害<>，并降低<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{DefenceCoef}%<>护甲和<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{MagicResistanceCoef}%<>魔法抗性。"
      },
      "crossbowman": {
        "name": "弩手",
        "skill": "沿直线发射强力箭矢，对首个命中的敌方冠军造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<> <#ff9028ff>物理伤害<>。终极技能标记持续期间，额外造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{MarkCoef}%<>伤害。",
        "skill2": "向前方直线发射贯穿箭矢，对敌人造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<> <#ff9028ff>物理伤害<>，并在<#ffb900ff>{BackstepTime}秒<>内向后退。终极技能标记持续期间，额外造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{MarkCoef}%<>伤害。",
        "ult": "沿直线发射曳光弹，对首个命中的敌方冠军造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<> <#ff9028ff>物理伤害<>，并留下持续<#ffb900ff>{Duration}秒<>的标记。标记持续期间，所有技能无视距离命中目标，冷却时间减少<#ffb900ff>{CoolReduce}%<>。路径上的其他冠军可以代为承受。"
      },
      "nightmare": {
        "name": "梦魇",
        "skill": "沿直线发射梦魇碎片，对首个命中的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>。最多可连续使用<#ffb900ff>{UseCount}次<>。",
        "skill2": "朝指定方向突进<#ffb900ff>{Range}<>距离，随后对<#ffb900ff>{Radius}<>范围内的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>，并隐身<#ffb900ff>{StealthTime}秒<>。",
        "ult": "突进至目标敌方冠军身边，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>。若该伤害击杀目标，则无视距离传送到一名存活友方冠军身旁。"
      },
      "strongman": {
        "name": "大力士",
        "skill": "抓住一名附近的敌人，将其过肩摔到自己身后，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>，并使其<#ef5350ff>眩晕{Stun}秒<>。",
        "skill2": "大幅挥舞杠铃，对周围<#ffb900ff>{Range}<>范围内的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>并将其<#ef5350ff>击退<>。",
        "ult": "将一名附近的友方冠军扔向指定位置。被扔出的友军落地后，获得持续<#ffb900ff>{ShieldTime}秒<>的<#e8d44dff>{Shield}护盾<>。落地点<#ffb900ff>{Radius}<>范围内的敌人受到<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力{Coef}%<>的<#ff9028ff>物理伤害<>并被<#ef5350ff>眩晕{Stun}秒<>。若附近没有可投掷的友军，则大力士亲自跃向目标位置；此时眩晕时间为<#ef5350ff>{SelfStun}秒<>。"
      },
      "harpooner": {
        "name": "鱼叉手",
        "skill": "沿直线发射鱼叉，对首个命中的敌方英雄造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<><#ff9028ff>物理伤害<>。命中后的<#ffb900ff>{RecastDuration}秒<>内可再次施放，将自身拉向目标或将目标拉向自身。",
        "skill2": "沿直线发射强力鱼叉，对首个命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>+目标已损失生命值的<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<><#ff9028ff>物理伤害<>。",
        "ult": "向前方扇形发射<#ffb900ff>{ProjectileCount}<>支锁链鱼叉，对命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<><#ff9028ff>物理伤害<>，并束缚<#ffb900ff>{LinkDuration}秒<>。被束缚的敌人移动速度降低<#ef5350ff>{Slow}%<>；当彼此距离超过<#ffb900ff>{LinkRange}<>时锁链收紧，减速强化至<#ef5350ff>{TensionSlow}%<>并互相拉扯。"
      },
      "spellbreaker": {
        "name": "破法者",
        "skill": "向前大幅横扫巨剑，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>，并<#ef5350ff>使目标减速{Slow}%，持续{Time}秒<>。",
        "skill2": "向前冲锋一小段距离，对首个命中的敌人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力的{Coef}%<>的<#ff9028ff>物理伤害<>。冲锋后，<#ffb900ff>{Time}秒内受到的伤害降低{Reduce}%<>。",
        "ult": "立即摧毁周围<#ffb900ff>{Range}<>范围内所有敌人的护盾。护盾被摧毁的敌人受到<#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法强的{Coef}%<>的<#a974ffff>魔法伤害<>，<#ef5350ff>眩晕{Stun}秒<>，并且<#ffb900ff>{BlockTime}秒内无法获得护盾<>。原本没有护盾的敌人只受到<#a974ffff>{Damage}魔法伤害<>。"
      },
      "gladiator": {
        "name": "角斗士",
        "skill": "向前方<#ffb900ff>{FanAngle}度<>扇形范围抛出渔网，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并将敌人<#ef5350ff>禁锢<><#ffb900ff>{Stun}秒<>。",
        "skill2": "用三叉戟向前方突刺，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。在<#ffb900ff>{Time}秒<>内连续命中同一英雄时，每次命中伤害提高<#ffb900ff>{Amplify}%<>（最多叠加<#ffb900ff>{MaxAmplifyTargets}<>层）。命中其他英雄时层数重置。",
        "ult": "突进至敌方英雄身边，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并<#ef5350ff>嘲讽<>目标<#ffb900ff>{Stun}秒<>。决斗期间，目标无法获得治疗和新的护盾，角斗士受到目标以外敌人的伤害降低<#ffb900ff>{Amplify}%<>。嘲讽被净化或目标死亡时，决斗结束。"
      },
      "ferryman": {
        "name": "摆渡人",
        "skill": "抛出船锚，命中路径上的第一个英雄。生命值在<#ffb900ff>{AllyHpRatio}%<>及以下的己方英雄会被拉到自己身前，并在<#ffb900ff>{Time}秒<>内移动速度提高<#ffb900ff>{Amplify}%<>；生命值更高的己方英雄则会被穿过。敌人则受到<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并被减速<#ffb900ff>{Slow}%<>，持续<#ffb900ff>{SlowTime}秒<>。",
        "skill2": "在前方制造长度<#ffb900ff>{Range}<>、宽度<#ffb900ff>{Width}<>的水道，持续<#ffb900ff>{Time}秒<>。水道上的己方英雄移动速度提高<#ffb900ff>{Amplify}%<>，敌人被减速<#ffb900ff>{Slow}%<>。",
        "ult": "净化一名生命值在<#ffb900ff>{AllyHpRatio}%<>及以下的其他己方英雄，并让其乘船在<#ffb900ff>{Time}秒<>内向己方基地方向移动<#ffb900ff>{MoveDistance}<>距离。乘船期间无法被选中、无法行动，且免疫位移控制。下船时恢复<#6aff55ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}%法术强度<>点生命值，并在<#ffb900ff>{SlowTime}秒<>内移动速度提高<#ffb900ff>{Slow}%<>。"
      },
      "bombardier": {
        "name": "炮击手",
        "skill": "架设或收起炮台。架设期间无法移动，但普通攻击和技能2的攻击距离增加<#ffb900ff>{MoveDistance}<>，且<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力提高{Amplify}%<>。收起后<#ffb900ff>{Time}秒<>内移动速度提高<#ffb900ff>{Slow}%<>。",
        "skill2": "向指定位置发射炮弹，对半径<#ffb900ff>{Radius}<>内的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其减速<#ffb900ff>{Slow}%<>，持续<#ffb900ff>{SlowTime}秒<>。架设期间施放距离增加。",
        "ult": "向指定区域连续发射<#ffb900ff>{ProjectileCount}<>枚炮弹，每枚炮弹对半径<#ffb900ff>{ProjectileRadius}<>内的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。架设炮台期间，施放距离额外增加<#ffb900ff>{MoveDistance}<>。发射期间受到控制效果时，剩余的炮击会中断。"
      },
      "hypnotist": {
        "name": "催眠师",
        "skill": "掷出可穿透的钟摆，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使敌人减速<#ffb900ff>{Slow}%<>，持续<#ffb900ff>{SlowTime}秒<>。此伤害不会唤醒处于<#ef5350ff>睡眠<>中的敌人。",
        "skill2": "<#ffb900ff>{Delay}秒<>后，使半径<#ffb900ff>{Radius}<>内的敌人陷入<#ef5350ff>睡眠<>，持续<#ffb900ff>{Time}秒<>。睡眠期间无法移动和行动。受到伤害（包括持续伤害）时会醒来，唤醒目标的首次伤害提高<#ffb900ff>{Amplify}%<>。",
        "ult": "<#ffb900ff>{Delay}秒<>后，使半径<#ffb900ff>{Radius}<>内的敌人陷入<#ef5350ff>睡眠<>，持续<#ffb900ff>{Time}秒<>。受到伤害时会醒来，唤醒目标的那次攻击伤害提高<#ffb900ff>{Amplify}%<>。净化可同时解除<#ef5350ff>睡眠<>和伤害加成。"
      }
    }
  },
