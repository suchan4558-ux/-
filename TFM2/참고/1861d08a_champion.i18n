    "description": {
      "astrologer": {
        "name": "Astrolog",
        "skill": "Hedeflenen konuma <#ffb900ff>{Delay}<> sn. sonra bir meteor düşürerek alandaki rakiplere <#a974ffff>{Damage}<> + Yetenek Gücünün <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> kadarı <#a974ffff>büyü hasarı<> verir ve Hareket Hızlarını <#ef5350ff>{SlowTime}<> sn. boyunca %<#ef5350ff>{Slow}<> azaltır.",
        "skill2": "Düz bir çizgideki rakiplere <#a974ffff>{LinkDamage}<> + Yetenek Gücünün <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> kadarı <#a974ffff>büyü hasarı<> verir ve bir takımyıldız işareti bırakır. İşaret <#ffb900ff>{MarkTime}<> sn. sürer ve işaretli düşmanlar, ultinin takımyıldız patlamasından ek hasar alır.",
        "ult": "Hedeflenen alana bir takımyıldız çizerek tüm rakipleri işaretler. <#ffb900ff>{Delay}<> sn. sonra tüm işaretler aynı anda patlayarak <#a974ffff>{Damage}<> + Yetenek Gücünün <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> kadarı <#a974ffff>büyü hasarı<> verir. Bağlanan her ilave rakip için hasar %<#ffb900ff>{Amplify}<> artar. Zaten işaretli olan düşmanlar ek olarak Beceri Gücünün <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>%{MarkCoef}<> kadarı hasar alır."
      },
      "archer": {
        "name": "Okçu",
        "skill": "Belirtilen yöne sıçra ve en son saldırılan düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Yakın bir düşmana ok atarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver, kısa süre <#ef5350ff>sersemlet<> ve geriye sıçra.",
        "ult": "Olduğu yerde durur ve toplam {Count} ok atar. Ok yakındaki {Range} menzilindeki rastgele bir düşmana doğru uçarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir."
      },
      "bard": {
        "name": "Ozan",
        "skill": "Bir müttefikin <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Büyü Gücü'nün {Coef}%'i<> kadar <#ffb900ff>{Duration}s<> boyunca artırır.",
        "skill2": "Hedeflenen alandaki müttefiklerin yetenek bekleme sürelerini {Duration}s boyunca <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Büyü Gücü'nün {Coef}%'i<> kadar azaltır.",
        "ult": "<#ffb900ff>{Duration}s<> boyunca kanal yapar; {Range} menzilindeki müttefik şampiyonların <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünü {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Büyü Gücü'nün {AttackRatio}%'i<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>büyü gücünü {MagicPower}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> artırır ve yetenek bekleme sürelerini {CoolReduce}% azaltır; ancak <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>savunmaları {DefenceReduce}%<> ve <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü dirençleri {MagicResistanceReduce}%<> azalır."
      },
      "barrier_magician": {
        "name": "Bariyer büyücüsü",
        "skill": "<#ffb900ff>{Duration}s<> süren bir bariyer yaratır, müttefiklere <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> verir ve düşmanların <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeedReduce}%<> azaltır. Seviye 3'ten itibaren müttefiklere ek <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı<> verir ve düşmanları <#ef5350ff>yavaşlatır<>.",
        "skill2": "Hedeflenen alanda <#ffb900ff>{Duration}s<> süren bir bariyer çağırır, içindeki tüm mermileri yok eder.",
        "ult": "Düşman şampiyonun etrafında küçülen bir bariyer yaratır. Kenara dokunan düşmanlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>{Time}s sersemler<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "{Duration}s boyunca öfkeye kapılarak saldırı hızını <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> artır ve <#6aff55ff>{Vamp}% can çalma<> kazan.",
        "skill2": "İki elle yere vurarak dar alandaki düşmanları <#ef5350ff>{Time}s havaya fırlat<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "{Range} menzil içindeki hedef düşmana doğru koşar ve düşmana saldırarak, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Bekleme süresi, kaybedilen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>can<>la orantılı olarak azalır."
      },
      "boomerang_hunter": {
        "name": "Bumerang avcısı",
        "skill": "Bir bumerang doğrultu boyunca atar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Maksimum menzilde döner, dokunan düşmanlara sürekli <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Geri dönen üç bumerang atar, yollarındaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "Doğrultu boyunca güçlü bir bumerang ateşler, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Düşman şampiyona vurduğunda en yakın diğer düşman şampiyona sıçrar, her sıçramada hasar <#ff9028ff>{Increase}%<> artar. En fazla {MaxBounce} kez sıçrar."
      },
      "chef": {
        "name": "Şef",
        "skill": "Bıçağı doğrultu boyunca fırlatır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "skill2": "Yakındaki müttefiklere yemek dağıtır, <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> sürekli olarak <#6aff55ff>can yeniler<>. Sadece kendine iyileşme <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% YG<> olur.",
        "ult": "Müttefik şampiyona özel yemek atar. <#ffb900ff>{Duration}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maksimum can {HpRatio}% artar<>. Alınan hasarın <#e8d44dff>{SpreadRatio}%<>'ı zaman içinde dağıtılır."
      },
      "clown": {
        "name": "Palyaço",
        "skill": "Hedefin yanına ışınlanır. Düşmansa, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ffb900ff>{Duration}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> kazanır.",
        "skill2": "Etrafa hançer saçar, alanındaki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. (Kullanırken hareket edebilir)",
        "ult": "<#ffb900ff>{Time}s<> boyunca cinnete girer. Tüm hançerler düşmanlar arasında sıçrayan özel hançerlere dönüşür."
      },
      "dancer": {
        "name": "Dansçı",
        "skill": "Bir düşmana chakram fırlatarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Her ek chakram bu yeteneğin hasarını %{StackCoef} artırır.",
        "skill2": "Her öldürme normal saldırılara çakra ekler. (Maks <#ffb900ff>{MaxCount}<>, her ek çakra vuruşunda hasar <#ffb900ff>{Reduce}%<> azalır)",
        "ult": "Yelpaze şeklinde {Count}(+yığın) delici çakra fırlatır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Çakralar geri döner, <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. (Maks {MaxCount})"
      },
      "dark_mage": {
        "name": "Karanlık büyücü",
        "skill": "Karanlık ok ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s köklendirir<>.",
        "skill2": "Gecikme sonrası alanı karanlıkla kaplar, içindeki düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "{Range} içindeki düşman şampiyonu lanetler, <#ffb900ff>{Duration}s<> boyunca en yakın müttefikle bağlar. Biri hasar aldığında <#a974ffff>{ShareRatio}%<>'ı diğerine aktarılır."
      },
      "demon": {
        "name": "Şeytan",
        "skill": "Yerden cehennem pençesi çıkarak bir düşmanı yakala, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve konumları değiştir.",
        "skill2": "{Time}s büyük şeytana dönüş. Dönüşüm sırasında saldırı <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, zırh <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, saldırı hızı <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<>, hareket hızı <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> artar.",
        "ult": "{Range} menzil içindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time} saniye boyunca korku<> uygular."
      },
      "dual_blader": {
        "name": "Çift kılıçlı",
        "skill": "Düz bir çizgide kılıç enerjisi ateşleyerek vurulan düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>hedefi {Time}s kökle<>.",
        "skill2": "{Range} alandaki <#ef5350ff>hareketsiz<> bir düşmana hücum ederek vurulan düşmanı <#ef5350ff>{Time}s havaya fırlat<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "Belirlenen {Range} menzilindeki bir düşmanı kılıçla keser, {Count} kez <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>%{Coef} saldırı gücü<> kadar <#f5f5f5ff>sabit hasar<> verir."
      },
      "executioner": {
        "name": "Cellat",
        "skill": "Kanca atarak vurulan düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve kendine çek.",
        "skill2": "Bir düşmanı kancayla keserek <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Duration}s süreyle kanama uygula<>. Kanayan düşmanlar her {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {TickCoef}%<>'si <#ff9028ff>fiziksel hasar<> alır ve <#ef5350ff>{Debuff}% daha fazla hasar alır<>.",
        "ult": "{Range} önündeki yarım daire şeklindeki alandaki düşmanları bir kancayla süpürür, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>{Time} saniye boyunca iyileşemez<> hale getirir."
      },
      "exorcist": {
        "name": "Şeytan kovucu",
        "skill": "Bir müttefiğin <#ef5350ff>durum etkilerini<> geçersiz kılar ve <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#6aff55ff>Can yeniler<>. Sersemletme, uyku, sabitleme, korku, büyüleme, kışkırtma, havaya savurma ve zorunlu hareketi kaldırır. Yavaşlatma veya zehir gibi buff tabanlı etkileri kaldırmaz.",
        "skill2": "Bir müttefike <#ffb900ff>{Duration}s<> kutsal koruma verir, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırıyı {Attack}<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> artırır. Aktifken kontrol etkilerini geri yansıtır.",
        "ult": "Hedef alanda patlama yaratır, düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir. Hedefteki her buff başına <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% YG<> bonus hasar verir."
      },
      "fighter": {
        "name": "Dövüşçü",
        "skill": "{Range} içindeki hedefe {Speed} hızla saldırır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Stun}s sersemleştirir<>.",
        "skill2": "Yere vurur, {Range} içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "Yere vurur, {Range} menzilindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>{Time}s havaya fırlatır<>."
      },
      "gambler": {
        "name": "Kumarbaz",
        "skill": "Zar at ve {Range} alandaki düşmanları zar sayısı kadar saldır. Her saldırı <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "{Range} menzil içinde bir çip atarak {AttackRange} alanda düşmanları {Time}s boyunca <#ef5350ff>%{Slow} yavaşlatan<> bir alan oluştur. Alan süresi dolduğunda patlar ve içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "Düşmanları düz bir çizgide büyüleyen bir yığın parayı ateşler. Vurulan düşman <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> alır ve <#ef5350ff>{Time} saniye boyunca büyülenir<>."
      },
      "ghost": {
        "name": "Hayalet",
        "skill": "Hedeflenemez olur ve doğrultu boyunca atılır. Öldürme/asistte <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} saldırı<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% saldırı hızı<> kazanır ve <#6aff55ff>{Heal} can yeniler<>.",
        "skill2": "Kısa mesafe atılır ve ilk vurduğu düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Üst üste {Time} kez kullanılabilir.",
        "ult": "<#ffb900ff>{Time}s<> boyunca kontrol etkilerinden bağışık olur. Öldürme veya asist temel yetenek bekleme süresini sıfırlar."
      },
      "gunner": {
        "name": "Silahlı",
        "skill": "Hareket ederken düşmanlara saldırabilir. Seviye 3'ten itibaren her saldırı {Time}s hareket hızını <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> artırır.",
        "skill2": "{Time}s boyunca saldırıları güçlendir, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücü {Attack} artar<>. Her 3. saldırıda düşmana <#ef5350ff>{SlowTime}s boyunca %{Slow} yavaşlatma<> uygula.",
        "ult": "{Time} saniye boyunca saldırılar güçlendirilir, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücü {Attack} artar<> ve saldırı hedefinin etrafındaki 2 düşmana ek mermiler ateşlenir. İlave mermiler, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir."
      },
      "ice_mage": {
        "name": "Buz büyücüsü",
        "skill": "Bir düşmanı dondurarak <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver ve <#ef5350ff>{Time}s sersemlet<>.",
        "skill2": "{Duration}s süren buz alanı çağır, {Range} alandaki düşmanların <#ef5350ff>hareket hızını %{MoveSpeed} yavaşlat<> ve her {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver. Sonunda dondur ve <#ef5350ff>{Stun}s sersemlet<>.",
        "ult": "Ön cone'daki düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve geri iter. <#ef5350ff>{SlowDuration}s boyunca {Slow}% yavaşlatır<> ve <#ef5350ff>{BlockDuration}s hareket yeteneklerini engeller<>."
      },
      "illusionist": {
        "name": "İllüzyonist",
        "skill": "Mermi ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s alay eden<> bir illüzyon çağırır.",
        "skill2": "{Range} içindeki düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s korkutur<>.",
        "ult": "<#ffb900ff>{Duration}s<> süren yakın müttefik şampiyonun illüzyonunu yaratır. İllüzyon sadece normal saldırı yapabilir ve kopyalanan şampiyonla aynı statlara sahiptir."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Düşmana saldıran ve kaybolmadan önce 3 kez saldıran küçük bir jiangshi çağırır, vuruş başına <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Düşmanı çarpar <#ef5350ff>{Time}s sersemleştirir<>, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#6aff55ff>{Heal} can yeniler<>.",
        "ult": "<#ffb900ff>{Duration}s<> boyunca {Range} içindeki düşmanlardan <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> <#6aff55ff>can<> emer ve <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% YG<> <#a974ffff>büyü hasarı<> verir."
      },
      "knight": {
        "name": "Şövalye",
        "skill": "Hedefe <#ef5350ff>{Time}s tahrik<> uygula.",
        "skill2": "Kendine {Time}s süren bir <#e8d44dff>kalkan<> verir (<#e8d44dff>kalkan<> değeri: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> + <#e8d44dff>{Amount}<>). Kalkan varken alınan hasarın <#ff9028ff>%{Reflect}'ini<> yansıtır.",
        "ult": "Belirlenen konumda <#ffb900ff>{Time}s<> süren, {Range} menzilli bir savunma alanı çağırır. Alandaki müttefikler <#e8d44dff>%{Coef}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{HpCoef}'i<> kadar daha az hasar alır ve alandaki düşmanlar <#ef5350ff>%{MoveSpeedReduce} yavaşlatılır<>."
      },
      "lancer": {
        "name": "Mızrakçı",
        "skill": "{Range} alandaki düşmanları it ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Kısa mesafe hücum et, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Value}%<>'si kadar <#ff9028ff>fiziksel hasar<> ver ve düşmanın arkasına geç.",
        "ult": "{Range} mesafeye hücum eder, hücum sırasında karşılaşılan tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>{Time} saniye boyunca havaya fırlatır<>."
      },
      "lightning_mage": {
        "name": "Yıldırım büyücüsü",
        "skill": "Hedefe yıldırım ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir. Yakın düşmanlara hedef tekrarlamadan zincirleme yapar.",
        "skill2": "Alana yıldırım düşürür, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s sersemleştirir<>.",
        "ult": "Düşman şampiyona <#ffb900ff>{Duration}s<> boyunca yıldırım huzmesi kanal yapar ve <#ef5350ff>sersemleştirir<>. Hedef ve yakın düşmanlara sürekli <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir."
      },
      "magic_knight": {
        "name": "Büyü şövalyesi",
        "skill": "Uzun dar bir çizgide mana patlat <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver.",
        "skill2": "{Duration}s süren mana çekirdeği yarat, {Range} alandaki düşmanları her {Tick}s merkeze çek ve <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver.",
        "ult": "<#ffb900ff>{Time}s<> boyunca <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>menzil {Range} artar<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı %{AttackSpeed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{AttackSpeedCoef}'i<> artar. Normal saldırılar ilk yeteneği tetikler."
      },
      "monk": {
        "name": "Keşiş",
        "skill": "{Range} alandaki müttefiklerin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#6aff55ff>yeniler<>. Sadece kendine yenileme miktarı <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'sine yükselir.",
        "skill2": "Avuç vuruşuyla {Range} alandaki rakibe <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver ve <#ef5350ff>{Time}s sersemlet<>.",
        "ult": "{Range} içindeki müttefiklere <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#e8d44dff>kalkan<> verir. Kalkan alan müttefikler <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>%{MoveSpeed} hareket hızı<> kazanır."
      },
      "necromancer": {
        "name": "Nekromanser",
        "skill": "<#ffb900ff>{Duration}(+yetenek gücünün %{DurationCoef}'i)s<> boyunca hizmet edecek bir gulyabani çağırır. Seviye arttıkça bekleme süresi azalır ve gulyabaninin süresi seviye başına <#ffb900ff>{DurationPerLevel}s<> artar.",
        "skill2": "Bir düşmanı <#ffb900ff>{Time}s<> boyunca saldırı hedefi olarak işaretleyerek gulyabanileri öfkelendirir. Gulyabaniler <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>%{AttackSpeed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{AttackSpeedCoef}'i<> saldırı hızı ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>%{MoveSpeed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{MoveSpeedCoef}'i<> hareket hızı kazanır.",
        "ult": "Ölmüş bir müttefik şampiyonu hayalet olarak diriltir. Çağrı sürerken saniyede <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} Can<> tüketilir."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Gölge küresi atarak vurulan düşmana hücum et ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Belirtilen düşmana kısa mesafe hücum et, hedeflenemez hale gel ve ardışık üç kez saldır, her saldırı <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "{Range} mesafe içindeki bir düşmana hücum ederek, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir."
      },
