      "soldier": {
        "name": "小銃手",
        "skill": "レベルが上がるたびに<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>射程<>が{GrowthRange}増加する。",
        "skill2": "敵1体に銃を三発連射し大きな<#ff9028ff>物理ダメージ<>を与える(一発当たり<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>のダメージ)。通常射程に比例してスキル射程が増加する。",
        "ult": "{Range}距離内の敵を狙う、一直線に飛ぶ巨大な弾丸を発射する。弾丸は軌道内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、敵に命中するたびにダメージが{Decay}%減少する。"
      },
      "swordman": {
        "name": "剣士",
        "skill": "剣気を発射し命中した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える(剣気射程 {Range})",
        "skill2": "単一対象を連続で三回斬り大きな<#ff9028ff>物理ダメージ<>を与える。打撃当たり <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の {Coef}%<>ダメージ。",
        "ult": "一直線に{Range}距離を突進し、突進範囲内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。アルティメットで敵を倒した場合、アルティメットの再使用待機時間が初期化される。"
      },
      "taoist": {
        "name": "道士",
        "skill": "護符で敵を封印し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}(+魔力の{TimeCoef}%)秒<>間、通常攻撃をできなくする。",
        "skill2": "敵に護符を貼り付け、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}(+魔力の{TimeCoef}%)秒<>間、スキルを使用できなくする。",
        "ult": "直線方向に護符の投射物を発射する。<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間対象を行動不能<>にし、ターゲット不能にする。効果終了時、近くの敵に拡散する。"
      },
      "vampire": {
        "name": "吸血鬼",
        "skill": "敵の血を吸収し<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#6aff55ff>体力を{Heal}回復<>しスタックを積む。<#6aff55ff>各スタック当たり体力回復量が{Stack}増加<>する。",
        "skill2": "自分の体力を{Value}%消費し前方扇形範囲に血を噴き<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。各スタック当たりダメージ量が{Stack}増加する。",
        "ult": "対象指定不可状態となり、{Range}距離を突進し、軌跡内の各敵から<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>分<#6aff55ff>体力を吸収<>し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{DamageCoef}%<>の<#a974ffff>魔法ダメージ<>を与える。"
      },
      "werewolf": {
        "name": "狼人間",
        "skill": "前方を引っ掻き、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#6aff55ff>与えたダメージの{HealRatio}%回復<>する。",
        "skill2": "前方にダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。",
        "ult": "<#ffb900ff>{Duration}秒<>間チャネリングし、繰り返し<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{BleedTime}秒間出血<>させる(<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{BleedCoef}%<>)。"
      },
      "dokkaebi": {
        "name": "ドッケビ",
        "skill": "<#ffb900ff>{Duration}秒<>間棍棒を強化する。各攻撃が扇状の衝撃波を発生させ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "<#ffb900ff>{Duration}秒<>間皮膚を強化し、<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>分の<#e8d44dff>シールド<>と<#e8d44dff>ダメージ軽減{DamageReduction}%<>を得る。",
        "ult": "直線方向に投射物を発射する。当たった敵は<#ef5350ff>{SlowTime}秒かけて徐々に鈍化<>し、その後<#ef5350ff>{BindTime}秒間束縛<>される。束縛時、近くの敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。効果はダメージを受けた敵に拡散する。"
      },
      "hammerer": {
        "name": "重歩兵",
        "skill": "近くの敵1体にハンマーを振り<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間空中に浮かび上げ<>る。",
        "skill2": "ハンマーを上げ精神を集中し地面を叩きつけ、周辺{Range}範囲内にいる敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間{Move}%減速<>効果を付与する。",
        "ult": "ハンマーを大きく振り、前方の{Range}範囲内の半円形エリアにいるすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。ハンマーで攻撃された敵は{Time}秒間ノックバックされ、押し出された敵にぶつかった敵チャンピオンは<#ef5350ff>{Airborne}秒間空中に浮く<>。"
      },
      "inquisitor": {
        "name": "異端審問官",
        "skill": "短距離をダッシュし、最初に当たった敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>出血<>を付与する。",
        "skill2": "対象の敵を斬り、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。<#ef5350ff>出血<>中の場合、スキル1のクールタイムをリセットする。",
        "ult": "敵チャンピオンに突進し、到着時に範囲内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。ダメージ後、最大HP{Threshold}%以下の敵を処刑する。処刑時、近くの敵を<#ef5350ff>{FearTime}秒間恐怖<>させる。"
      },
      "pole_warrior": {
        "name": "棒術師",
        "skill": "敵にジャンプし棒で叩きつけ <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の {Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "短い距離を移動し棒を踏んで上がり {Time}秒間対象指定不可状態になった後棒を振り回し周辺 {Range} 範囲内すべての敵に <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の {Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "{Range}範囲内にある指定された敵に突進し、敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、対象を<#ef5350ff>{Time}秒間空中に浮かせ<>る。"
      },
      "spirit_caller": {
        "name": "精霊師",
        "skill": "味方に<#ffb900ff>{Duration}秒<>間霊を付着させ、<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealRatio}%<>分<#6aff55ff>体力を回復<>させ、<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度を{SpeedUp}%上昇<>させる。",
        "skill2": "敵に精霊を取り付け、<#ffb900ff>{Duration}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力を{DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{DefCoef}%<>、<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抵抗を{MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{MrCoef}%<>減少させ、<#ef5350ff>{Slow}%スロウ<>を与える。",
        "ult": "付着した霊を起爆する。味方の霊は<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{ShieldCoef}%<>の<#e8d44dff>シールド<>と<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%攻撃速度<>を付与する。敵の霊は<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{DamageCoef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{StunTime}秒間気絶<>させる。"
      },
      "whip_master": {
        "name": "鞭術師",
        "skill": "鞭を振り、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>対象HPの{HpRatio}%<>を与える。",
        "skill2": "鞭を扇状に振り、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与えて敵をノックバックする。",
        "ult": "<#ffb900ff>{Duration}秒<>間チャネリングし、貫通する投射物を発射して<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。"
      },
      "enchanter": {
        "name": "エンチャンター",
        "skill": "味方に<#ffb900ff>{Duration}秒<>間強化を付与し、<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>射程を{Increase}増加<>させる。",
        "skill2": "味方の装備を<#ffb900ff>{Duration}秒<>間強化し、アイテムステータスを<#ffb900ff>{Percent}%<>増加させる。",
        "ult": "味方チャンピオンを{Duration}秒間強化し、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力{Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{AttackRatio}%<>)、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度{AttackSpeed}%<>、<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度{MoveSpeed}%<>、群衆制御免疫を付与する。"
      },
      "siege_breaker": {
        "name": "攻城兵",
        "skill": "鎖鉄球を叩きつけ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。建造物に{Bonus}%の追加ダメージを与える。",
        "skill2": "地面を叩きつけ、建造物を含むすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "{Time}秒間、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力を{Attack}%<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AttackSpeed}%<>、<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度を{MoveSpeed}%<>上昇させる。"
      },
      "prisoner": {
        "name": "囚人",
        "skill": "鉄球を直線投げ、範囲内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "咆哮して{Time}秒間<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の{Coef}%<>分の<#e8d44dff>シールド<>を獲得し、周囲のすべての敵に<#ef5350ff>挑発<>効果を付与する。",
        "ult": "敵に突進し、着地点の近くにいるすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間気絶<>させる。"
      },
      "android": {
        "name": "アンドロイド",
        "skill": "一直線に衝撃波を発射する。衝撃波は敵に命中するか射程の端に到達時に円形に爆発し、範囲内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間{Slow}%鈍化<>を付与する。",
        "skill2": "{Time}秒間持続する<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の{Coef}%<>分の<#e8d44dff>シールド<>を自身に付与する。シールドが消えると、周囲{Range}範囲内の敵を<#ef5350ff>{StunTime}秒間スタン<>させる。",
        "ult": "{Range}範囲内の指定した味方に<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の{Coef}%<>分の<#e8d44dff>シールド<>を付与し、{Time}秒後に指定した味方の位置へ瞬間移動する。"
      },
      "white_mage": {
        "name": "白魔術師",
        "skill": "ビームが遅延後に爆発し、すべての敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。",
        "skill2": "ビームを召喚して5回攻撃し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。",
        "ult": "貫通ビームを発射し、当たった敵に<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間束縛<>する。"
      },
      "wind_mage": {
        "name": "風術師",
        "skill": "<#ffb900ff>{Duration}秒<>間旋風を召喚し、{Range}内に{Tick}秒ごとに<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。内部の味方は<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>を獲得する。",
        "skill2": "前方に5つの旋風を発射し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。",
        "ult": "巨大な竜巻を放つ。当たった敵は<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<#ef5350ff>{AirborneTime}秒間エアボーン<>する。サイズ、ダメージ、エアボーン時間はヒットごとに減少する。他のチャンピオンに方向転換する。"
      },
      "bomber": {
        "name": "爆弾兵",
        "skill": "爆弾を投げ、範囲内のすべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "踏むと<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間束縛<>する見えない地雷を設置する。ミニオンには発動しない。",
        "ult": "対象エリアに大きな爆弾を投げ、すべての敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。"
      },
      "cavalry_knight": {
        "name": "騎兵",
        "skill": "一直線に突進し最初に命中した敵を槍に刺し、<#ef5350ff>{Time}秒間束縛<>し<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。突進速度は移動速度に比例する。",
        "skill2": "{Time}秒間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Speed}%上昇<>し、武器を炎の槍に強化して、攻撃時に{BurnTime}秒間<#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{BurnCoef}%<>分の火傷ダメージを追加で与える。",
        "ult": "{Time}秒間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SpeedCoef}%<>上昇し、自身の位置へ向かう床を生成する。その床の上の味方は騎兵のいる方向へ移動すると<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SpeedCoef}%<>増加する。"
      },
      "druid": {
        "name": "ドルイド",
        "skill": "熊を召喚する。死亡時、ドルイドが<#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{DeathCoef}%<>のダメージを受ける。召喚中に再使用すると熊の体力を<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HealCoef}%<>分<#6aff55ff>回復<>する。",
        "skill2": "鷲を召喚する。鷲が死亡するとドルイドはダメージを受ける。鷲が召喚されている間にこのスキルを使用すると、鷲が敵へ突進して<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、与えたダメージの<#6aff55ff>{Lifesteal}%分体力を回復<>する。",
        "ult": "指定方向へ熊と鷲の魂を連続で{Count}個発射する。各投射体は<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>分の<#a974ffff>魔法ダメージ<>を与え、敵を後方へ押し出す。"
      },
      "voodoo_shaman": {
        "name": "ブードゥーシャーマン",
        "skill": "呪いの投射物を発射し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>{Time}秒間{Slow}%鈍化<>させ、<#ffb900ff>{AtkSpdTime}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度を{AtkSpd}%<>減少させる。",
        "skill2": "敵を<#ffb900ff>{Time}秒<>間呪い、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。受けたヒットごとに<#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{HitCoef}%<>の追加ダメージを与える(最大{Max})。",
        "ult": "<#ffb900ff>{Duration}秒<>間ヴードゥーゾーンを作る。内部の敵は定期的に<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大HPの{HpRatio}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<#ef5350ff>沈黙<>する。"
      },
      "hitman": {
        "name": "ヒットマン",
        "skill": "3連射する。最初の弾は敵を<#ef5350ff>{StunTime}秒間気絶<>させ、続く2発はそれぞれ<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "<#ffb900ff>{Range}<>範囲内で最後に攻撃した敵チャンピオンの背後に瞬間移動する。",
        "ult": "敵チャンピオンに標的を付け、<#ffb900ff>{Duration}秒<>後に<#ff9028ff>{Damage} + 標的中に受けたダメージの{Coef}%<>分の<#ff9028ff>物理ダメージ<>を与える。対象を倒すと<#ffb900ff>{InvisibleDuration}秒<>間ステルス状態になる。"
      },
      "guardian_spirit": {
        "name": "守護霊",
        "skill": "近くの味方の体力を<#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>分<#6aff55ff>回復<>する。",
        "skill2": "味方に<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{ShieldCoef}%<>の<#e8d44dff>シールド<>と<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>を付与する。",
        "ult": "<#ffb900ff>{Duration}秒<>間、聖域を生成し、範囲内の味方を<#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{HealCoef}%<>分、継続的に<#6aff55ff>回復<>します。聖域内で味方チャンピオンが1体死亡すると、その味方を復活させ、聖域は即座に終了します。"
      },
      "hunter": {
        "name": "ハンター",
        "skill": "敵に瞬間移動し、遠距離モードに切り替える。<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>射程が{RangeIncrease}増加<>する。",
        "marks": "遠距離通常攻撃が敵チャンピオンに命中すると、<#ffb900ff>{Duration}秒<>間持続するマークを付与する。再び命中すると既存のマークの持続時間も更新される。マークが3つ付いた敵に第2スキルを使用できる。",
        "skill2": "3スタックマークされた敵にダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SilenceTime}秒間沈黙<>させる。",
        "ult": "前方にダッシュし、進路上の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。使用後、短時間だけ1回再使用でき、敵のキルまたはアシストに関与すると追加で1回再使用できる。"
      },
      "circus_blade": {
        "name": "サーカスブレード",
        "skill": "対象方向にブレードを発射し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{SlowTime}秒間{Slow}%鈍化<>させる。最大<#ffb900ff>{ChargeCount}<>チャージを保持する。敵チャンピオンへの基本攻撃で<#ffb900ff>1<>チャージを獲得する。",
        "skill2": "<#ffb900ff>{Duration}秒<>間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%攻撃速度<>、壁通過を獲得する。",
        "ult": "対象の敵にダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。<#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{SplashCoef}%<>のスプラッシュダメージを与え、近くの敵を<#ef5350ff>ノックバック<>させた後、消える。"
      },
      "sand_mage": {
        "name": "砂術師",
        "skill": "通常攻撃に砂の力を込め、<#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{PassiveCoef}%<>の<#a974ffff>追加魔法ダメージ<>を与える。この追加ダメージと砂の爆発ダメージはクリティカル可能。発動時、対象の周囲で砂を爆発させ、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>範囲魔法ダメージ<>を与える。",
        "skill2": "砂の力を吸収し、<#ffb900ff>{Time}秒<>間 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{SpeedCoef}%<>上昇し、自身を<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{HealCoef}%<>だけ<#6aff55ff>回復<>する。",
        "ult": "対象の周囲に<#ffb900ff>{Duration}秒<>間持続する砂の沼を設置する。沼は{Tick}秒ごとに内部の敵へ<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、中心へ引き寄せる。"
      },
      "alchemist": {
        "name": "錬金術師",
        "skill": "フラスコを投げて爆発させ、<#ffb900ff>{Time}秒<>間毒性の床を残す。床内の敵は<#ffb900ff>{DotTime}秒<>間<#78e85cff>中毒<>になり、{DotTick}秒ごとに<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、回復量が{HealReduce}%減少する。",
        "skill2": "不安定な試薬を敵1体に注入し、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与える。<#ffb900ff>{Time}秒<>間、対象は回復を受けられず、移動速度が{Slow}%低下する。",
        "ult": "毒性フラスコを直線に投げる。敵チャンピオンに命中すると、<#ffb900ff>{CloudTime}秒<>間、最大{CloudRadius}範囲まで広がる毒雲を作る。毒雲内の敵は<#ffb900ff>{DotTime}秒<>間<#78e85cff>中毒<>になり、{DotTick}秒ごとに<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力が{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{DefenceCoef}%<>、<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抵抗力が{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{MagicResistanceCoef}%<>低下する。"
      },
      "crossbowman": {
        "name": "石弓兵",
        "skill": "直線に強力な矢を放ち、最初に命中した敵チャンピオンに<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。究極技のマークが持続している間、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{MarkCoef}%<>の追加ダメージを与える。",
        "skill2": "前方直線に貫通する矢を放ち、敵に<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{BackstepTime}秒<>間後退する。究極技のマークが持続している間、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{MarkCoef}%<>の追加ダメージを与える。",
        "ult": "直線に曳光弾を放ち、最初に命中した敵チャンピオンに<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{Duration}秒<>間マークする。マークが持続している間、すべてのスキルは距離に関係なく対象に命中し、クールダウンが<#ffb900ff>{CoolReduce}%<>短縮される。経路上の他のチャンピオンが代わりに受けることができる。"
      },
      "nightmare": {
        "name": "夢魔",
        "skill": "悪夢の欠片を直線上に放ち、最初に命中した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。最大<#ffb900ff>{UseCount}回<>まで連続使用できる。",
        "skill2": "指定方向へ<#ffb900ff>{Range}<>距離ダッシュした後、周囲<#ffb900ff>{Radius}<>範囲の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{StealthTime}秒<>間ステルス状態になる。",
        "ult": "対象の敵チャンピオンへダッシュし、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。このダメージで対象を倒すと、距離に関係なく生存中の味方チャンピオンの隣へ瞬間移動する。"
      },
      "strongman": {
        "name": "怪力士",
        "skill": "近くの敵1体をつかみ、肩越しに自身の背後へ投げ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与えて、<#ef5350ff>{Stun}秒間気絶<>させる。",
        "skill2": "バーベルを大きく振り回し、周囲<#ffb900ff>{Range}<>以内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>ノックバック<>させる。",
        "ult": "指定位置へ近くの味方チャンピオン1体を投げる。投げられた味方は着地後<#ffb900ff>{ShieldTime}秒間<>、<#e8d44dff>{Shield}のシールド<>を得る。さらに着地点から<#ffb900ff>{Radius}<>以内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Stun}秒間気絶<>させる。投げられる味方が近くにいない場合は自身が跳躍し、その場合の気絶時間は<#ef5350ff>{SelfStun}秒<>となる。"
      },
      "harpooner": {
        "name": "銛使い",
        "skill": "直線上に銛を発射し、最初に命中した敵チャンピオンに<#ff9028ff>{Damage}<>＋<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。命中後<#ffb900ff>{RecastDuration}秒間<>、再使用すると自身を対象へ引き寄せるか、対象を自身のもとへ引き寄せられる。",
        "skill2": "直線上に強力な銛を発射し、最初に命中した敵に<#ff9028ff>{Damage}<>＋<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>＋対象の減少体力の<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "ult": "前方扇状に<#ffb900ff>{ProjectileCount}<>本の鎖銛を発射し、命中した敵に<#ff9028ff>{Damage}<>＋<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{LinkDuration}秒間<>鎖で縛る。縛られた敵は移動速度が<#ef5350ff>{Slow}%<>減少し、互いに<#ffb900ff>{LinkRange}<>以上離れると鎖が締まって減速が<#ef5350ff>{TensionSlow}%<>に強まり、引き寄せられる。"
      },
      "spellbreaker": {
        "name": "スペルブレイカー",
        "skill": "前方を大きく斬り払い、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ef5350ff>{Time}秒間、{Slow}%減速<>させる。",
        "skill2": "短い距離を突進し、最初に命中した敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。突進後、<#ffb900ff>{Time}秒間<>受けるダメージが<#ef5350ff>{Reduce}%減少<>する。",
        "ult": "周囲<#ffb900ff>{Range}<>内のすべての敵のシールドを即座に破壊する。シールドを破壊された敵は<#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を受け、<#ef5350ff>{Stun}秒間気絶<>し、<#ffb900ff>{BlockTime}秒間シールドを獲得できない<>。シールドがなかった敵は<#a974ffff>{Damage}の魔法ダメージ<>のみを受ける。"
      },
      "gladiator": {
        "name": "剣闘士",
        "skill": "前方<#ffb900ff>{FanAngle}度<>の扇状に網を投げ、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{Stun}秒<>間<#ef5350ff>束縛<>する。",
        "skill2": "三叉戟で前方を突き、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。<#ffb900ff>{Time}秒<>以内に同じチャンピオンへ続けて命中させると、命中ごとにダメージが<#ffb900ff>{Amplify}%<>ずつ増加する(最大<#ffb900ff>{MaxAmplifyTargets}<>スタック)。別のチャンピオンに命中するとスタックはリセットされる。",
        "ult": "敵チャンピオンに突進し、<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{Stun}秒<>間<#ef5350ff>挑発<>する。決闘中、対象は回復も新たなシールドも得られず、剣闘士が対象以外の敵から受けるダメージは<#ffb900ff>{Amplify}%<>減少する。挑発が浄化されるか対象が倒れると決闘は終わる。"
      },
      "ferryman": {
        "name": "渡し守",
        "skill": "錨を投げ、最初に当たったチャンピオンに命中する。体力が<#ffb900ff>{AllyHpRatio}%<>以下の味方は自分のもとへ引き寄せ、<#ffb900ff>{Time}秒<>間移動速度を<#ffb900ff>{Amplify}%<>増加させる。それより体力の多い味方は通り抜ける。敵には<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ffb900ff>{SlowTime}秒<>間<#ffb900ff>{Slow}%<>鈍化させる。",
        "skill2": "前方に長さ<#ffb900ff>{Range}<>、幅<#ffb900ff>{Width}<>の水路を<#ffb900ff>{Time}秒<>間作る。水路の上にいる味方は移動速度が<#ffb900ff>{Amplify}%<>増加し、敵は<#ffb900ff>{Slow}%<>鈍化する。",
        "ult": "体力が<#ffb900ff>{AllyHpRatio}%<>以下の自分以外の味方チャンピオンを浄化し、<#ffb900ff>{Time}秒<>間舟に乗せて味方の本陣方向へ<#ffb900ff>{MoveDistance}<>運ぶ。乗船中は対象指定不可・行動不能となり、移動妨害を受けない。下船すると体力を<#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>魔法力の{Coef}%<>回復し、<#ffb900ff>{SlowTime}秒<>間移動速度が<#ffb900ff>{Slow}%<>増加する。"
      },
      "bombardier": {
        "name": "砲撃手",
        "skill": "砲台を設置または回収する。設置中は移動できないが、通常攻撃とスキル2の射程が<#ffb900ff>{MoveDistance}<>増加し、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力が{Amplify}%増加<>する。回収後<#ffb900ff>{Time}秒<>間移動速度が<#ffb900ff>{Slow}%<>増加する。",
        "skill2": "指定位置に砲弾を撃ち、半径<#ffb900ff>{Radius}<>内の敵に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>{SlowTime}秒<>間<#ffb900ff>{Slow}%<>鈍化させる。設置中は射程が伸びる。",
        "ult": "指定エリアに砲弾を<#ffb900ff>{ProjectileCount}<>発連続で撃ち込む。各砲弾は半径<#ffb900ff>{ProjectileRadius}<>内に<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の{Coef}%<>の<#ff9028ff>物理ダメージ<>を与える。砲台設置中は射程がさらに<#ffb900ff>{MoveDistance}<>増加する。発射中に群衆制御を受けると残りの発射は中断される。"
      },
      "hypnotist": {
        "name": "催眠術師",
        "skill": "貫通する振り子を飛ばし、<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法力の{Coef}%<>の<#a974ffff>魔法ダメージ<>を与え、<#ffb900ff>{SlowTime}秒<>間<#ffb900ff>{Slow}%<>鈍化させる。このダメージでは<#ef5350ff>睡眠<>中の敵は目覚めない。",
        "skill2": "<#ffb900ff>{Delay}秒<>後、半径<#ffb900ff>{Radius}<>内の敵を<#ffb900ff>{Time}秒<>間<#ef5350ff>睡眠<>状態にする。睡眠中は移動も行動もできない。継続ダメージを含むダメージを受けると目覚め、その最初のダメージは<#ffb900ff>{Amplify}%<>増加する。",
        "ult": "<#ffb900ff>{Delay}秒<>後、半径<#ffb900ff>{Radius}<>内の敵を<#ffb900ff>{Time}秒<>間<#ef5350ff>睡眠<>状態にする。ダメージを受けると目覚め、目覚めさせた攻撃のダメージは<#ffb900ff>{Amplify}%<>増加する。浄化すると<#ef5350ff>睡眠<>とダメージ増加の両方が解除される。"
      }
    }
  },
