      "hitman": {
        "name": "Inoa",
        "skill": ". i ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ef5350ff>{StunTime}kekona pōniuniu<> hāʻawi.",
        "skill2": "<#ffb900ff>{Range}<> mamao hoʻouka koa.",
        "ult": "koa <#ffb900ff>{Duration}kekona<> <#ff9028ff>{Damage} + no pōʻino {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. <#ffb900ff>{InvisibleDuration}kekona<> no."
      },
      "guardian_spirit": {
        "name": "Inoa",
        "skill": "kokoke i loko o ka palena ola <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {Coef}%<> <#6aff55ff>hoʻōla<>.",
        "skill2": "<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>o ka mana mākau {ShieldCoef}%<> e like me <#e8d44dff>pale kaua<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>māmā neʻe {MoveSpeed}% <> hāʻawi.",
        "ult": "<#ffb900ff>{Duration} kekona<> e hana i kahi kapu, a <#6aff55ff>hoʻōla mau<> i nā hoa ma loko no <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% mana mākau<>. Inā make hoʻokahi koa hoa i loko, hoʻōla hou ʻia ia a pau koke ka wahi kapu."
      },
      "hunter": {
        "name": "Inoa",
        "skill": "i ka ʻenemi e neʻe koke ana mamao hoʻouka hoʻololi. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>mamao {RangeIncrease} <>.",
        "marks": "Ranged basic attacks mark enemy champions for <#ffb900ff>{Duration}s<>. Further hits refresh existing marks. The second skill can target enemies with 3 marks.",
        "skill2": "3mea i ka ʻenemi e lele wiki ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ef5350ff>{SilenceTime}kekona no <>.",
        "ult": "lumi i ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>."
      },
      "circus_blade": {
        "name": "Inoa",
        "skill": "ma ke kuhikuhi i koho ʻia e pana ana i ka ʻenemi <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<> <#ef5350ff>{SlowTime}kekona no {Slow}% hoʻolohi<>. palena kiʻekiʻe <#ffb900ff>{ChargeCount}manawa<>, koa hoʻouka <#ffb900ff>1manawa<>.",
        "skill2": "<#ffb900ff>{Duration}kekona<> no <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>māmā neʻe {MoveSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>māmā hoʻouka {AttackSpeed}%<> hopena.",
        "ult": "i ka ʻenemi e lele wiki ana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {Coef}%<> e like me <#ff9028ff>pōʻino kino<>. kokoke i ka ʻenemi <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>o ka pōʻino hoʻouka {SplashCoef}%<> e like me palena pōʻino <#ef5350ff><>."
      },
      "sand_mage": {
        "name": "Kilokilo One",
        "skill": "Hāpai nā ho'ouka kumu i ka mana one, a hana i <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo hou<>. Hiki i kēia poino hou a me ka pahū one ke pā koʻikoʻi. Ke hoʻohana ʻia, pahū ka one a puni ka pahu hopu, a hana i <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo āpana<>.",
        "skill2": "Huki i ka mana one no <#ffb900ff>{Time}s<>, hoʻonui i ka <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>māmā neʻe ma {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% Mana Kilokilo<> a <#6aff55ff>ho'ōla iā ia iho<> no <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Mana Kilokilo<>.",
        "ult": "Hana i kahi poho one a puni ka pahu hopu no <#ffb900ff>{Duration}s<>. I kēlā me kēia {Tick}s, loaʻa i nā ʻenemi i loko <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo<> a huki ʻia lākou i ke kikowaena."
      },
      "alchemist": {
        "name": "Mea Hana Kemia",
        "skill": "Kiola i kahi ipu wai e pahū ana a waiho i kahi wai ʻawaʻawa no <#ffb900ff>{Time}s<>. Hoʻopā ʻia nā ʻenemi i loko me ka <#78e85cff>lāʻau make<> no <#ffb900ff>{DotTime}s<>, loaʻa iā lākou <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo<> i kēlā me kēia {DotTick}s, a hoʻemi ʻia ko lākou ho'ōla e {HealReduce}%.",
        "skill2": "Hoʻokomo i kahi reagent kūpaʻa ʻole i hoʻokahi ʻenemi, hana i <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo<>. No <#ffb900ff>{Time}s<>, ʻaʻole hiki ke ho'ōla ʻia ka pahu hopu a lohi ʻo ia e {Slow}%.",
        "ult": "Kiola i kahi ipu ʻawaʻawa ma kahi laina. Ke pā i kekahi koa ʻenemi, hana ia i ao lāʻau make e hoʻonui ana a hiki i {CloudRadius} no <#ffb900ff>{CloudTime}s<>. Hoʻopā ʻia nā ʻenemi i loko me ka <#78e85cff>lāʻau make<> no <#ffb900ff>{DotTime}s<>, loaʻa iā lākou <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Mana Kilokilo<> ma ke ʻano he <#a974ffff>poino kilokilo<> i kēlā me kēia {DotTick}s, a nalowale <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% Mana Kilokilo<> pale a me <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% Mana Kilokilo<> kūʻē kilokilo."
      },
      "crossbowman": {
        "name": "Mea Pana Kea",
        "skill": "Pana i kahi pua ikaika ma kahi laina, hana i <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Ikaika Ho'ouka<> ma ke ʻano he <#ff9028ff>poino kino<> i ke koa ʻenemi mua i pā ʻia. ʻOiai e mau ana ka hōʻailona ultimate, hana hou ia i <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Ikaika Ho'ouka<> poino.",
        "skill2": "Pana i kahi pua komo i mua ma kahi laina, hana i <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Ikaika Ho'ouka<> ma ke ʻano he <#ff9028ff>poino kino<> i nā ʻenemi a hoʻi i hope no <#ffb900ff>{BackstepTime}s<>. ʻOiai e mau ana ka hōʻailona ultimate, hana hou ia i <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Ikaika Ho'ouka<> poino.",
        "ult": "Pana i kahi tracer ma kahi laina, hana i <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Ikaika Ho'ouka<> ma ke ʻano he <#ff9028ff>poino kino<> i ke koa ʻenemi mua i pā ʻia a waiho i kahi hōʻailona no <#ffb900ff>{Duration}s<>. ʻOiai e mau ana ka hōʻailona, pā nā mākau a pau i ka pahu hopu me ka nānā ʻole i ka mamao, a hoʻemi ʻia nā manawa kali hou e <#ffb900ff>{CoolReduce}%<>. Hiki i nā koa ʻē aʻe ma ke ala ke lawe i ka pā."
      },
      "nightmare": {
        "name": "Moemoeā",
        "skill": "Kī pololei i kahi ʻāpana moemoeā, a hāʻawi i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> i ka ʻenemi mua i pā. Hiki ke hoʻohana a hiki i <#ffb900ff>{UseCount} manawa<> ma ka lālani.",
        "skill2": "Lele <#ffb900ff>{Range}<> ma ke kuhikuhi i koho ʻia, a laila hāʻawi i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> i nā ʻenemi ma loko o <#ffb900ff>{Radius}<> a lilo i huna no <#ffb900ff>{StealthTime} kekona<>.",
        "ult": "Lele aku i ka champion ʻenemi i koho ʻia a hāʻawi i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<>. Inā pepehi kēia pōʻino i ka pahuhopu, teleport aʻe ma ka ʻaoʻao o kekahi champion hoa ola me ka nānā ʻole i ka mamao."
      },
      "strongman": {
        "name": "Kanaka Ikaika",
        "skill": "Hopu i hoʻokahi ʻenemi kokoke, kiola iā ia ma luna o ka poʻohiwi i kona kua, a hāʻawi i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<>, a <#ef5350ff>hoʻopōniuniu iā ia no {Stun} kekona<>.",
        "skill2": "Kowali ākea i kāna kaola kaumaha, a hāʻawi i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> i nā ʻenemi ma loko o <#ffb900ff>{Range}<>, a <#ef5350ff>kipaku iā lākou i hope<>.",
        "ult": "Kiola i hoʻokahi koa hoa kokoke i kahi i koho ʻia. Ma hope o ka pae ʻana, loaʻa i ka hoa i kiola ʻia he <#e8d44dff>pale {Shield}<> no <#ffb900ff>{ShieldTime} kekona<>. Loaʻa i nā ʻenemi ma loko o <#ffb900ff>{Radius}<> o kahi pae ka <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Mana Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> a <#ef5350ff>hoʻopōniuniu ʻia no {Stun} kekona<>. Inā ʻaʻohe hoa kokoke e kiola ai, lele ke Kanaka Ikaika iho; i kēia hihia, ʻo ka manawa hoʻopōniuniu he <#ef5350ff>{SelfStun} kekona<>."
      },
      "harpooner": {
        "name": "Mea Pana Ihe Lawaiʻa",
        "skill": "Pana i ka ihe lawaiʻa ma kahi laina pololei, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> o ka Ikaika Hoʻouka ma ke ʻano he poino kino i ke koa ʻenemi mua i pā ʻia. No <#ffb900ff>{RecastDuration}<> kekona ma hope o ka pā ʻana, hiki ke hoʻohana hou e huki iā ia iho i ka pahuhopu a i ʻole e huki i ka pahuhopu iā ia.",
        "skill2": "Pana i ka ihe lawaiʻa ikaika ma kahi laina pololei, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> o ka Ikaika Hoʻouka + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> o ke Ola i nalowale o ka pahuhopu ma ke ʻano he poino kino i ka ʻenemi mua i pā ʻia.",
        "ult": "Pana i <#ffb900ff>{ProjectileCount}<> ihe lawaiʻa kaulahao ma ke ʻano kea i mua, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> o ka Ikaika Hoʻouka ma ke ʻano he poino kino a nakinaki i nā mea i pā ʻia no <#ffb900ff>{LinkDuration}<> kekona. Ua lohi nā ʻenemi i nakinaki ʻia ma <#ef5350ff>{Slow}%<>. Inā ʻoi aku ka mamao ma mua o <#ffb900ff>{LinkRange}<>, paʻa nā kaulahao: piʻi ka lohi i <#ef5350ff>{TensionSlow}%<> a huki ʻia lākou kekahi i kekahi."
      },
      "spellbreaker": {
        "name": "Wāwahi Kilokilo",
        "skill": "Kahili i ka pahi nui i mua, e hana ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Hoʻouka<> <#ff9028ff>pōʻino kino<> a e <#ef5350ff>hoʻolohi i ka ʻenemi ma {Slow}% no {Time} kekona<>.",
        "skill2": "Hoʻouka i mua no kahi mamao pōkole a hana i ka ʻenemi mua i pā ʻia i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Hoʻouka<> <#ff9028ff>pōʻino kino<>. Ma hope o ka hoʻouka, <#ffb900ff>hoʻēmi ʻia ka pōʻino i loaʻa ma {Reduce}% no {Time} kekona<>.",
        "ult": "Wāwahi koke i nā pale a pau o nā ʻenemi i loko o <#ffb900ff>{Range}<>. ʻO ka ʻenemi nona ka pale i wāwahi ʻia, loaʻa iā ia <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% o ka Mana Kilokilo<> <#a974ffff>pōʻino kilokilo<>, <#ef5350ff>pōniuniu no {Stun} kekona<>, a <#ffb900ff>ʻaʻole hiki ke loaʻa he pale no {BlockTime} kekona<>. ʻO ka ʻenemi ʻaʻohe pale, loaʻa wale iā ia <#a974ffff>{Damage} pōʻino kilokilo<>."
      },
      "gladiator": {
        "name": "Koa Hakakā",
        "skill": "Kiola i ka ʻupena ma kahi ʻāpana peʻahi <#ffb900ff>{FanAngle}°<> i mua, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Ikaika Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> a e <#ef5350ff>hoʻopaʻa<> i nā ʻenemi no <#ffb900ff>{Stun} kekona<>.",
        "skill2": "Hou i mua me ka ihe kolu, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Ikaika Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<>. Inā pā hou ke koa like i loko o <#ffb900ff>{Time} kekona<>, piʻi ka pōʻino ma <#ffb900ff>{Amplify}%<> no kēlā me kēia puʻu (a hiki i <#ffb900ff>{MaxAmplifyTargets}<> puʻu). Inā pā i kekahi koa ʻē aʻe, hoʻihoʻi ʻia nā puʻu.",
        "ult": "Lele wikiwiki i kekahi koa ʻenemi, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Ikaika Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> a e <#ef5350ff>hoʻohenehene<> iā ia no <#ffb900ff>{Stun} kekona<>. I ka wā o ka hoʻokūkū, ʻaʻole hiki i ka pahuhopu ke hoʻōla ʻia a loaʻa paha he pale kaua hou, a emi ka pōʻino a ka Koa Hakakā mai nā ʻenemi ʻē aʻe ma <#ffb900ff>{Amplify}%<>. Pau ka hoʻokūkū ke hoʻomaʻemaʻe ʻia ka hoʻohenehene a i ʻole make ka pahuhopu."
      },
      "ferryman": {
        "name": "Mea Hoe Waʻa",
        "skill": "Kiola i ka heleuma e pā ana i ke koa mua ma kona ala. Huki ʻia ka hoa hui me ke ola ma lalo a like paha me <#ffb900ff>{AllyHpRatio}%<> i ka ʻaoʻao o ka Mea Hoe Waʻa a loaʻa iā ia he <#ffb900ff>{Amplify}%<> māmā neʻe no <#ffb900ff>{Time} kekona<>; hala aku ka heleuma i nā hoa hui ola nui aʻe. Loaʻa i ka ʻenemi he <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% o ka mana mākau<> ma ke ʻano he <#a974ffff>pōʻino kilokilo<> a hoʻolohi ʻia ma <#ffb900ff>{Slow}%<> no <#ffb900ff>{SlowTime} kekona<>.",
        "skill2": "Hana i kahawai lōʻihi <#ffb900ff>{Range}<> a laulā <#ffb900ff>{Width}<> i mua no <#ffb900ff>{Time} kekona<>. Loaʻa i nā hoa hui ma luna he <#ffb900ff>{Amplify}%<> māmā neʻe, a hoʻolohi ʻia nā ʻenemi ma <#ffb900ff>{Slow}%<>.",
        "ult": "Hoʻomaʻemaʻe i kekahi koa hoa hui ʻē aʻe me ke ola ma lalo a like paha me <#ffb900ff>{AllyHpRatio}%<>, a lawe iā ia ma ka waʻa he <#ffb900ff>{MoveDistance}<> i ke kahua hoa hui i loko o <#ffb900ff>{Time} kekona<>. ʻAʻole hiki ke koho ʻia ka mea holo, ʻaʻole hiki iā ia ke hana, a pale ʻia ʻo ia mai ka hoʻoneʻe ʻia. Ke pae i uka, hoʻōla ʻia ʻo ia he <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% o ka mana mākau<> a loaʻa iā ia he <#ffb900ff>{Slow}%<> māmā neʻe no <#ffb900ff>{SlowTime} kekona<>."
      },
      "bombardier": {
        "name": "Mea Pana Pūkuniahi",
        "skill": "Kūkulu a hoʻihoʻi paha i ka pūkuniahi. Ke kūkulu ʻia, ʻaʻole hiki ke neʻe, akā piʻi ka mamao o nā hoʻouka maʻamau a me ka mākau 2 ma <#ffb900ff>{MoveDistance}<> a loaʻa iā ia he <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% Ikaika Hoʻouka<>. Ma hope o ka hoʻihoʻi ʻana, loaʻa iā ia he <#ffb900ff>{Slow}%<> māmā neʻe no <#ffb900ff>{Time} kekona<>.",
        "skill2": "Pana i kekahi pōkā pio i ka wahi i koho ʻia, e hāʻawi ana i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Ikaika Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> i nā ʻenemi i loko o <#ffb900ff>{Radius}<> mai ke kikowaena a hoʻolohi iā lākou ma <#ffb900ff>{Slow}%<> no <#ffb900ff>{SlowTime} kekona<>. Ke kūkulu ʻia, piʻi ka mamao.",
        "ult": "Pana i nā pōkā he <#ffb900ff>{ProjectileCount}<> ma luna o ka wahi i koho ʻia. Hāʻawi kēlā me kēia pōkā i <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% o ka Ikaika Hoʻouka<> ma ke ʻano he <#ff9028ff>pōʻino kino<> i loko o <#ffb900ff>{ProjectileRadius}<> mai kona kikowaena. Ke kūkulu ʻia ka pūkuniahi, piʻi hou ka mamao ma <#ffb900ff>{MoveDistance}<>. Hoʻōki ka hoʻopaʻa ʻana i nā pana i koe."
      },
      "hypnotist": {
        "name": "Mea Hoʻohiamoe",
        "skill": "Hoʻolele i kekahi lewa houhou i mua, e hāʻawi ana i <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% o ka mana mākau<> ma ke ʻano he <#a974ffff>pōʻino kilokilo<> a hoʻolohi ma <#ffb900ff>{Slow}%<> no <#ffb900ff>{SlowTime} kekona<>. ʻAʻole hoʻāla kēia pōʻino i nā ʻenemi e <#ef5350ff>hiamoe<> ana.",
        "skill2": "Ma hope o <#ffb900ff>{Delay} kekona<>, e hoʻokau i ka <#ef5350ff>hiamoe<> ma luna o nā ʻenemi i loko o <#ffb900ff>{Radius}<> no <#ffb900ff>{Time} kekona<>. ʻAʻole hiki i ka mea hiamoe ke neʻe a hana. Hoʻāla ka pōʻino, me ka pōʻino mau, i ka pahuhopu, a hāʻawi kēlā hahau mua i <#ffb900ff>{Amplify}%<> pōʻino hou aʻe.",
        "ult": "Ma hope o <#ffb900ff>{Delay} kekona<>, e hoʻokau i ka <#ef5350ff>hiamoe<> ma luna o nā ʻenemi i loko o <#ffb900ff>{Radius}<> no <#ffb900ff>{Time} kekona<>. Hoʻāla ka pōʻino i ka pahuhopu, a hāʻawi ka hahau hoʻāla i <#ffb900ff>{Amplify}%<> pōʻino hou aʻe. Wehe ka hoʻomaʻemaʻe i ka <#ef5350ff>hiamoe<> a me ka pōʻino hou."
      }
    }
