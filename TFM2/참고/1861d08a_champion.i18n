    "description": {
      "astrologer": {
        "name": "Astrólogo",
        "skill": "Após <#ffb900ff>{Delay}s<>, faz um meteoro cair no local selecionado, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> do Poder de Habilidade como <#a974ffff>dano mágico<> aos inimigos na área e reduzindo a Velocidade de Movimento deles em <#ef5350ff>{Slow}%<> por <#ef5350ff>{SlowTime}s<>.",
        "skill2": "Causa <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> do Poder de Habilidade como <#a974ffff>dano mágico<> aos inimigos em linha reta e deixa uma marca de constelação. A marca dura <#ffb900ff>{MarkTime}s<>, e inimigos marcados sofrem dano adicional na detonação da constelação da Suprema.",
        "ult": "Desenha uma constelação na área selecionada e marca todos os inimigos. Após <#ffb900ff>{Delay}s<>, todas as marcas explodem ao mesmo tempo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> do Poder de Habilidade como <#a974ffff>dano mágico<>. O dano aumenta em <#ffb900ff>{Amplify}%<> para cada inimigo adicional ligado. Inimigos que já estavam marcados sofrem <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> do Poder de Habilidade como dano adicional."
      },
      "archer": {
        "name": "Archer",
        "skill": "Salta na direção escolhida, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> ao último inimigo atacado.",
        "skill2": "Dispara uma flecha contra um inimigo próximo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do dano de ataque<> como <#ff9028ff>dano físico<>, aplicando um breve <#ef5350ff>atordoamento<>, e então salta para trás.",
        "ult": "Para no lugar e dispara um total de {Count} flechas. Cada flecha é lançada em direção a um inimigo aleatório dentro do alcance de {Range}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Aumenta a velocidade de ataque de um aliado em <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> por <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduz o tempo de recarga das habilidades dos aliados na área selecionada em <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> por {Duration}s.",
        "ult": "Canaliza por <#ffb900ff>{Duration}s<>, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque<> dos campeões aliados em um raio de {Range} em <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% do poder de habilidade<>), o <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>poder de habilidade<> em {MagicPower}, a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque<> em {AttackSpeed}%, e reduz o tempo de recarga das habilidades em {CoolReduce}%. No entanto, a <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura<> é reduzida em {DefenceReduce}% e a <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistência mágica<> é reduzida em {MagicResistanceReduce}%."
      },
      "barrier_magician": {
        "name": "Barrier Mage",
        "skill": "Cria uma barreira na área selecionada por <#ffb900ff>{Duration}s<>, concedendo aos aliados dentro dela um <#e8d44dff>escudo<> equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% do poder de habilidade<> e reduzindo a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque<> dos inimigos em {AttackSpeedReduce}%. A partir do nível 3, a área da barreira aumenta e os aliados dentro dela recebem velocidade de ataque adicional, enquanto os inimigos sofrem <#ef5350ff>lentidão<>.",
        "skill2": "Invoca uma barreira na área selecionada, durando <#ffb900ff>{Duration}s<>, que destrói todos os projéteis dentro dela.",
        "ult": "Cria uma barreira circular ao redor de um campeão inimigo que vai encolhendo com o tempo. Inimigos que tocam a borda da barreira sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e são <#ef5350ff>atordoados por {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entra em estado de fúria por {Duration}s, aumentando a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> e ganhando <#6aff55ff>{Vamp}% de roubo de vida<>.",
        "skill2": "Atinge o chão com as duas armas, lançando inimigos em uma área estreita ao ar por <#ef5350ff>{Time}s<> e causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "ult": "Avança rapidamente até um inimigo dentro de {Range} de alcance e o atinge, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. O tempo de recarga desta habilidade é reduzido proporcionalmente à <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>vida perdida<>."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Lança um bumerangue em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Ao atingir o alcance máximo, o bumerangue gira no local, causando continuamente <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos que tocar.",
        "skill2": "Lança bumerangues em três direções. Os bumerangues avançam e retornam, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em seu trajeto.",
        "ult": "Dispara um poderoso bumerangue em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Ao atingir um campeão inimigo, ele ricocheteia para o campeão inimigo mais próximo, aumentando o dano em <#ff9028ff>{Increase}%<> a cada ricochete. Pode ricochetear até {MaxBounce} vezes."
      },
      "chef": {
        "name": "Chef",
        "skill": "Arremessa uma faca de cozinha em linha reta, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e aplicando <#ef5350ff>lentidão<> nos inimigos atingidos em {Slow}% por {SlowTime}s.",
        "skill2": "Compartilha comida com aliados próximos, <#6aff55ff>restaurando vida continuamente<> em uma quantidade equivalente a <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% do poder de habilidade<>. Caso esteja curando apenas a si mesmo, a cura aumenta para <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% do poder de habilidade<>.",
        "ult": "Arremessa um prato especial para um campeão aliado, aumentando sua <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>vida máxima em {HpRatio}%<> por <#ffb900ff>{Duration}s<>. Além disso, <#e8d44dff>{SpreadRatio}%<> do dano recebido é convertido em dano ao longo do tempo."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleporta-se para o lado do alvo. Se o alvo for um inimigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e aumenta a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<> por <#ffb900ff>{Duration}s<>.",
        "skill2": "Espalha uma chuva de adagas ao seu redor, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos na área. (Pode se mover durante o uso da habilidade.)",
        "ult": "Entra em estado de frenesi por <#ffb900ff>{Time}s<>. Durante esse período, todas as adagas se transformam em adagas ricocheteantes que saltam entre os inimigos."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Arremessa um chakram contra um inimigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. O dano desta habilidade aumenta em {StackCoef}% para cada chakram adicional.",
        "skill2": "Cada eliminação adiciona 1 chakram aos ataques básicos. (Máx. <#ffb900ff>{MaxCount}<>; o dano é reduzido em <#ffb900ff>{Reduce}%<> a cada acerto adicional de chakram)",
        "ult": "Dispara {Count}(+acúmulos) chakrams perfurantes em forma de cone, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Ao final do trajeto, os chakrams retornam, causando adicionalmente <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% do poder de ataque<> como <#ff9028ff>dano físico<>. (Máximo de {MaxCount})"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Dispara uma flecha sombria em linha reta, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos atingidos e os <#ef5350ff>enraizando por {Time}s<>.",
        "skill2": "Após um breve atraso, cobre uma área com escuridão, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos dentro dela.",
        "ult": "Amaldiçoa um campeão inimigo dentro de um alcance de {Range}, conectando-o ao campeão aliado mais próximo por <#ffb900ff>{Duration}s<>. Quando um dos alvos conectados recebe dano, <#a974ffff>{ShareRatio}%<> desse dano também é transferido para o outro."
      },
      "demon": {
        "name": "Demon",
        "skill": "Uma garra infernal emerge do chão e agarra um inimigo. Ao atingir o alvo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e troca de posição com ele.",
        "skill2": "Transforma-se em um grande demônio por {Time}s. Durante a transformação, ganha <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} de poder de ataque<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense} de armadura<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidade de ataque<> e <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidade de movimento<>.",
        "ult": "Causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em um raio de {Range} e os <#ef5350ff>amedronta por {Time}s<>."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Dispara uma onda de energia em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> ao inimigo atingido e <#ef5350ff>enraizando-o por {Time}s<>.",
        "skill2": "Avança contra um inimigo <#ef5350ff>imobilizado<> dentro de um alcance de {Range}, lançando-o ao ar por <#ef5350ff>{Time}s<> e causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "ult": "Retalha um inimigo dentro do alcance de {Range} com sua espada, causando <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#f5f5f5ff>dano verdadeiro<> {Count} vezes."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Dispara um gancho que causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> ao inimigo atingido e o puxa para perto de si.",
        "skill2": "Golpeia um inimigo com um gancho, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e aplicando <#ef5350ff>sangramento por {Duration}s<>. Enquanto estiver sangrando, o alvo sofre <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% do poder de ataque<> como <#ff9028ff>dano físico<> a cada {Tick}s, além de receber <#ef5350ff>{Debuff}% mais dano<>.",
        "ult": "Golpeia os inimigos em uma área semicircular de {Range} à frente do Executor com seu gancho, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e impedindo que recuperem HP por <#ef5350ff>{Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Remove os efeitos de controle de grupo de um aliado e restaura <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> de vida. Remove atordoamento, sono, enraizamento, medo, encanto, provocação, lançamento ao ar e deslocamento forçado. Não remove efeitos aplicados como buffs, como lentidão ou veneno.",
        "skill2": "Concede uma bênção divina a um aliado, aumentando seu <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque em {Attack}<> e sua <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> por <#ffb900ff>{Duration}s<>. Enquanto o efeito estiver ativo, se for atingido por uma habilidade de controle de grupo, o efeito é refletido e aplicado ao inimigo.",
        "ult": "Cria uma explosão no local selecionado, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos na área. Além disso, causa <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% do poder de habilidade<> de dano adicional para cada buff presente no alvo."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Avança contra um alvo dentro do alcance de {Range} a uma velocidade de {Speed}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e o <#ef5350ff>atordoando por {Stun}s<>.",
        "skill2": "Golpeia o chão com força, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em um raio de {Range} e aplicando <#ef5350ff>{Slow}% de lentidão por {SlowTime}s<>.",
        "ult": "Golpeia o chão, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em um raio de {Range} e os deixando <#ef5350ff>no ar por {Time}s<>."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Rola um dado e ataca inimigos dentro de um alcance de {Range} um número de vezes igual ao resultado obtido. Cada ataque causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Arremessa um chip, criando em até {Range} de alcance uma área de <#ef5350ff>lentidão de {Slow}%<> com tamanho de {AttackRange}, que permanece por {Time}s. Quando a área desaparece, ela explode e causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos dentro dela.",
        "ult": "Dispara uma pilha de dinheiro em linha reta que encanta os inimigos. Os inimigos atingidos sofrem <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e ficam <#ef5350ff>encantados por {Time}s<>."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Torna-se inalvejável e avança em linha reta. Sempre que participa da eliminação de um inimigo, ganha <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} de poder de ataque<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidade de ataque<> e <#6aff55ff>recupera {Heal} de HP<>.",
        "skill2": "Avança uma curta distância, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> ao primeiro alvo atingido. Pode ser usada consecutivamente até {Time} vezes.",
        "ult": "Fica imune a efeitos de controle de grupo por <#ffb900ff>{Time}s<>. Sempre que participar da eliminação de um inimigo, o tempo de recarga das habilidades básicas é reiniciado."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Pode atacar enquanto se move. A partir do nível 3, sempre que atacar um inimigo, ganha <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}% de velocidade de movimento<> por {Time}s.",
        "skill2": "Fortalece os ataques por {Time}s, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque em {Attack}<>, e a cada 3 ataques os disparos aplicam <#ef5350ff>{Slow}% de lentidão por {SlowTime}s<> aos inimigos.",
        "ult": "Por {Time}s, os ataques são fortalecidos, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque em {Attack}<>. Além disso, dispara projéteis adicionais contra até 2 inimigos próximos ao alvo. Os projéteis adicionais causam <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>."
      },
      "ice_mage": {
        "name": "Ice Mage",
        "skill": "Congela o inimigo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e o <#ef5350ff>atordoa por {Time}s<>.",
        "skill2": "Invoca uma área congelada na região selecionada por {Duration}s, reduzindo a <#ef5350ff>velocidade de movimento dos inimigos em {Range} de alcance em {MoveSpeed}%<> e causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> a cada {Tick}s. Quando a área desaparece, congela os inimigos dentro dela, <#ef5350ff>atordoando-os por {Stun}s<>.",
        "ult": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos em uma área cônica à frente, empurrando-os para trás. Além disso, aplica <#ef5350ff>{Slow}% de lentidão por {SlowDuration}s<> e impede o uso de habilidades de movimentação por <#ef5350ff>{BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Dispara um projétil que confunde os inimigos, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e invocando uma cópia do Ilusionista à frente do alvo, provocando-o por <#ef5350ff>{Time}s<>.",
        "skill2": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos em um raio de {Range} e aplica <#ef5350ff>Medo por {Time}s<>.",
        "ult": "Cria uma ilusão de um campeão aliado próximo que permanece por <#ffb900ff>{Duration}s<>. A ilusão só pode realizar ataques básicos e possui os mesmos atributos do campeão copiado."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Invoca um pequeno Jiangshi que avança contra os inimigos e causa dano. O pequeno Jiangshi desaparece após realizar 3 ataques, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> por ataque.",
        "skill2": "Golpeia o inimigo, <#ef5350ff>atordoando-o por {Time}s<> e causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, além de <#6aff55ff>restaurar {Heal} de Vida<>.",
        "ult": "Por <#ffb900ff>{Duration}s<>, drena <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% do poder de habilidade<> de <#6aff55ff>Vida<> dos inimigos em um raio de {Range}, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% do poder de habilidade<> como <#a974ffff>dano mágico<>."
      },
      "knight": {
        "name": "Knight",
        "skill": "Seleciona um alvo e o <#ef5350ff>provoca por {Time}s<>.",
        "skill2": "Concede a si mesmo um <#e8d44dff>escudo<> por {Time}s (valor do <#e8d44dff>escudo<>: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% da Vida Máxima<> + <#e8d44dff>{Amount}<>). Enquanto o escudo estiver ativo, reflete <#ff9028ff>{Reflect}% do dano recebido<>.",
        "ult": "Invoca uma área defensiva com alcance de {Range} na posição selecionada, que permanece por <#ffb900ff>{Time}s<>. Aliados dentro da área recebem <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% da Vida Máxima<> de redução de dano recebido. Inimigos dentro da área são <#ef5350ff>desacelerados em {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancer",
        "skill": "Empurra os inimigos ao redor em um raio de {Range}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Avança uma curta distância em um salto, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% do poder de ataque<> como <#ff9028ff>dano físico<> ao inimigo e o atravessa, reposicionando-se atrás dele.",
        "ult": "Avança uma distância de {Range}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos que atingir durante o avanço e os <#ef5350ff>arremessa ao ar por {Time}s<>."
      },
      "lightning_mage": {
        "name": "Lightning Mage",
        "skill": "Dispara um raio elétrico no inimigo selecionado, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>. O raio se propaga continuamente para alvos dentro da área, não podendo atingir o mesmo alvo mais de uma vez.",
        "skill2": "Desfere um relâmpago na área selecionada, causando aos inimigos atingidos <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e aplicando <#ef5350ff>atordoamento por {Time}s<>.",
        "ult": "Canaliza por <#ffb900ff>{Duration}s<> em um campeão inimigo, disparando um raio de relâmpago. Durante a canalização, o alvo fica <#ef5350ff>atordoado<> e inimigos ao redor recebem continuamente <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>."
      },
      "magic_knight": {
        "name": "Magic Knight",
        "skill": "Libera uma explosão de poder mágico em uma área longa e estreita em linha reta, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>.",
        "skill2": "Cria um núcleo de energia mágica em uma área reduzida por {Duration}s, que puxa inimigos dentro de {Range} em direção ao centro a cada {Tick}s e causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>.",
        "ult": "Por <#ffb900ff>{Time}s<>, aumenta o <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>alcance em {Range}<> e a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% do poder de habilidade<>, e cada ataque básico ativa a primeira habilidade."
      },
      "monk": {
        "name": "Monk",
        "skill": "Restaura o HP de aliados em um raio de {Range} em <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>. Se curar apenas a si mesmo, a cura aumenta para <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>.",
        "skill2": "Desfere um golpe com a palma da mão, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> a inimigos em um raio de {Range} e os <#ef5350ff>atordoa por {Time}s<>.",
        "ult": "Concede um <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> aos aliados em um raio de {Range}. Aliados que recebem o escudo ganham <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidade de movimento<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Invoca um ghoul para lutar ao seu lado por <#ffb900ff>{Duration}(+{DurationCoef}% do poder de habilidade)s<>. O tempo de recarga da habilidade diminui conforme o nível e a duração do ghoul aumenta em <#ffb900ff>{DurationPerLevel}s<> por nível.",
        "skill2": "Seleciona um inimigo como alvo por <#ffb900ff>{Time}s<>, fazendo com que os Ghouls entrem em estado de fúria. A velocidade de ataque dos Ghouls aumenta em <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% do poder de habilidade<>, e a velocidade de movimento aumenta em <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% do poder de habilidade<>.",
        "ult": "Revive um campeão aliado morto e o invoca como um espectro. Enquanto a invocação estiver ativa, ele perde <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain}<> de vida por segundo."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Dispara uma esfera sombria, avançando até o inimigo atingido e causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Avança em uma curta distância em direção ao inimigo alvo, ficando inalvejável durante o deslocamento e realizando três ataques consecutivos. Cada ataque causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "ult": "Avança em direção a um inimigo dentro de {Range}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Sempre que causar dano a um campeão inimigo, ganha <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value} de vida máxima<>.",
        "skill2": "Desfere um golpe com um bastão em um único alvo, causando <#ef5350ff>{Time}s<> de <#ef5350ff>atordoamento<> e <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% da vida máxima<> como <#ff9028ff>dano físico<>.",
        "ult": "Durante {Time}s, Ogre cresce em tamanho, aumentando a <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>vida máxima em {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% da vida máxima<>."
      },
      "plague_doctor": {
        "name": "Plague Doctor",
        "skill": "Aplica uma injeção em um aliado e em si mesmo, aumentando por <#ffb900ff>{Duration}s<> a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% do poder de habilidade<>, e a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<>.",
        "skill2": "Realiza um ritual em um aliado, aumentando sua <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>distância de ataque em {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% do poder de habilidade<> por <#ffb900ff>{Duration}s<> e concedendo efeito de investida aos ataques.",
        "ult": "Aplica uma poção proibida a um aliado, reduzindo sua vida atual em {HpReduceRatio}%, mas fazendo com que, por {Duration}s, sua vida não possa cair abaixo de 1. Durante esse período, ele recebe <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> de poder de ataque, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidade de ataque<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% do poder de habilidade<>, e <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidade de movimento<>."
      },
      "poison_dart_hunter": {
        "name": "Poisondart Hunter",
        "skill": "Espalha uma área de veneno no chão, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos na área, aplicando envenenamento por <#ffb900ff>{Duration}s<> e reduzindo sua velocidade em <#ef5350ff>{Slow}%<>.",
        "skill2": "Ao atacar um inimigo envenenado, o <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>alcance aumenta em {Range}<>. Ao se afastar de um inimigo envenenado, ganha <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% de velocidade de movimento<>.",
        "ult": "Por <#ffb900ff>{Duration}s<>, concede efeito de veneno aos ataques dos aliados próximos. O veneno causa, ao longo de <#ffb900ff>{PoisonDuration}s<>, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> de forma contínua."
      },
      "priest": {
        "name": "Priest",
        "skill": "Cria uma área de cura por {Duration}s em um raio de {Range}, restaurando o HP dos aliados dentro dela a cada {Tick}s em <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>.",
        "skill2": "Concede a um aliado um <#e8d44dff>escudo<> por {Time}s, equivalente a <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>. Enquanto o escudo estiver ativo, a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque<> do aliado aumenta em {AttackSpeed}%.",
        "ult": "Permanece no ar por {Time}s, ficando fixo, e dispara projéteis a cada {Tick}s em direção ao aliado com menor vida dentro do alcance da ultimate, curando-o em <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Lança uma bola de fogo que cai na área de {Range}, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos dentro da área.",
        "skill2": "Invoca uma área de fogo na região selecionada, que dura {Duration}s. Inimigos dentro de {Range} sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> a cada {Tick}s.",
        "ult": "Causa uma grande explosão em uma área de {Range}, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> a todos os inimigos na área da explosão."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Restaura <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> de vida de um aliado.",
        "skill2": "Restaura <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> de vida de um aliado, e causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos em um raio de {Range} ao redor desse aliado.",
        "ult": "Invoca o Portão Espiritual. O Portão Espiritual dispara projéteis que, dentro de {Range}, curam aliados em <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> ou causam <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos."
      },
      "shadowmancer": {
        "name": "Shadowmancer",
        "skill": "Surge uma sombra negra no chão que causa aos inimigos na área <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e os <#ef5350ff>enraíza por {Time}s<>.",
        "skill2": "Explode a sombra de um inimigo em estado de incapacidade de movimento, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>.",
        "ult": "Dispara um projétil de sombra que atravessa em linha reta, causando aos campeões inimigos atingidos <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e os <#ef5350ff>banindo por {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Shield Bearer",
        "skill": "Concede a si mesmo e a um aliado selecionado dentro de um determinado alcance um <#e8d44dff>escudo<> equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% da vida máxima<> por {Duration}s.",
        "skill2": "Por um período de tempo, absorve {Damage}% do dano recebido pelos aliados na área ao redor e recebe esse dano no lugar deles. Inimigos que atacarem aliados ficam <#ef5350ff>lentificados em {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% da armadura<> por {Duration}s.",
        "ult": "Ao ativar, por {Duration}s, recebe <#e8d44dff>redução de dano de {DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% da resistência mágica<> e imunidade a interrupções, além de provocar todos os inimigos em uma grande área ao redor por <#ef5350ff>{TauntDuration}s<>. Durante a provocação, não pode se mover."
      },
      "soldier": {
        "name": "Soldier",
        "skill": "A cada nível, a <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>distância de ataque aumenta em {GrowthRange}<>.",
        "skill2": "Dispara três tiros contra um inimigo, causando grande <#ff9028ff>dano físico<> (cada disparo causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<>). O alcance da habilidade aumenta de acordo com o alcance do ataque básico.",
        "ult": "Dispara um projétil gigante em linha reta que snipeia inimigos dentro do alcance de {Range}. O projétil causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em seu trajeto, com o dano reduzindo em {Decay}% a cada inimigo atingido."
      },
      "swordman": {
        "name": "Swordsman",
        "skill": "Dispara uma lâmina de energia, causando aos inimigos atingidos <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. (Alcance da lâmina: {Range})",
        "skill2": "Corta um único alvo três vezes consecutivas, causando grande <#ff9028ff>dano físico<>. Cada golpe causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<>.",
        "ult": "Avança em linha reta por {Range}, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos atingidos pela investida. O dano é dividido entre os inimigos atingidos. Se um inimigo for eliminado com a ultimate, o tempo de recarga da habilidade é reiniciado."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Sela um inimigo com um talismã, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e impedindo que ele realize ataques básicos por <#ef5350ff>{Time}(+{TimeCoef}% do poder de habilidade)s<>.",
        "skill2": "Marca um inimigo com um talismã, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e impedindo-o de usar habilidades por <#ef5350ff>{Time}(+{TimeCoef}% do poder de habilidade)s<>.",
        "ult": "Lança um projétil de amuleto em linha reta que, ao atingir um inimigo, causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, deixando-o <#ef5350ff>incapacitado por {Time}s<> e impossibilitado de ser alvo. Ao fim do efeito, ele se espalha para inimigos próximos, aplicando o mesmo efeito."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Drena o sangue do inimigo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, recupera <#6aff55ff>{Heal} de vida<> e acumula acúmulos. A cada acúmulo, a <#6aff55ff>cura aumenta em {Stack}<>.",
        "skill2": "Consome {Value}% da própria vida e expele sangue em uma área em cone à frente, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>. Cada acúmulo aumenta o dano em {Stack}.",
        "ult": "Fica em estado de alvo inalvejável e avança até {Range} de distância. Durante o trajeto da investida, absorve <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> de cada inimigo atingido e causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% do poder de habilidade<> como <#a974ffff>dano mágico<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Avança com uma garra, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de poder de ataque<> como <#ff9028ff>dano físico<> e se curando em <#6aff55ff>{HealRatio}% do dano causado<>.",
        "skill2": "Avança em linha reta e, ao atingir um inimigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, aplicando uma <#ef5350ff>lentidão de {Slow}% por {SlowTime}s<>.",
        "ult": "Por <#ffb900ff>{Duration}s<>, causa repetidamente <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos dentro de uma área em cone na direção escolhida e aplica <#ef5350ff>hemorragia por {BleedTime}s<>. (Hemorragia: <#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% do poder de ataque<>)"
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Por <#ffb900ff>{Duration}s<>, fortalece o bastão, fazendo com que seus ataques gerem uma onda de choque em formato de leque. A onda de choque causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Fortalece a pele por <#ffb900ff>{Duration}s<>, concedendo um <#e8d44dff>escudo<> equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> e <#e8d44dff>redução de dano de {DamageReduction}%<>.",
        "ult": "Dispara um projétil em linha reta que reduz gradualmente a velocidade de movimento do inimigo atingido ao longo de <#ef5350ff>{SlowTime}s<>, até então <#ef5350ff>enraizá-lo por {BindTime}s<>. Ao ser enraizado, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> em área ao redor, e o efeito se propaga para os inimigos atingidos."
      },
      "hammerer": {
        "name": "Hammerer",
        "skill": "Golpeia um inimigo próximo com um martelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, e <#ef5350ff>arremessando-o ao ar por {Time}s<>.",
        "skill2": "Ergue o martelo e canaliza por um breve momento, então o golpeia contra o chão, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a inimigos na área de {Range}, além de aplicar <#ef5350ff>lentidão de {Move}% por {Time}s<>.",
        "ult": "Gira o martelo com força, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em um semicírculo à frente dentro de {Range}. Inimigos atingidos pelo martelo são empurrados para trás por {Time}s e, ao colidirem com outros campeões inimigos durante o deslocamento, estes são <#ef5350ff>arremessados ao ar por {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Avança uma curta distância e, ao atingir o primeiro inimigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e aplica <#ef5350ff>sangramento<>.",
        "skill2": "Corta o inimigo selecionado, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Se o inimigo estiver <#ef5350ff>sangrando<>, o tempo de recarga da habilidade 1 é reiniciado.",
        "ult": "Avança até um campeão inimigo à frente e, ao chegar ao local, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos na área ao redor do ponto de chegada. Inimigos atingidos que ficarem com vida igual ou inferior a {Threshold}% da vida máxima são executados. Ao realizar uma execução com sucesso, os inimigos ao redor do alvo entram em <#ef5350ff>medo por {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Pole Warrior",
        "skill": "Salta em direção ao inimigo e golpeia com o bastão, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Move-se uma curta distância e sobe sobre um bastão, ficando <#ffb900ff>inatingível por {Time}s<>. Em seguida, gira o bastão, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos em um raio de {Range}.",
        "ult": "Avança até um inimigo alvo dentro de {Range} de alcance, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, arremessando o alvo ao ar por <#ef5350ff>{Time}s<>."
      },
      "spirit_caller": {
        "name": "Spirit Caller",
        "skill": "Anexa um espírito a um aliado, restaurando <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% do poder de habilidade<> de vida ao longo de <#ffb900ff>{Duration}s<> e aumentando a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {SpeedUp}%<>.",
        "skill2": "Aplica um espírito a um inimigo, reduzindo por <#ffb900ff>{Duration}s<> a <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura em {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% do poder de habilidade<>, e a <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistência mágica em {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% do poder de habilidade<>, além de aplicar <#ef5350ff>{Slow}% de lentidão<>.",
        "ult": "Detona o espírito anexado. Espíritos aliados concedem <#e8d44dff>escudo<> equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% do poder de habilidade<> e aumentam a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<>. Espíritos inimigos causam <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, aplicando <#ef5350ff>atordoamento por {StunTime}s<>."
      },
      "whip_master": {
        "name": "Whip Master",
        "skill": "Atinge o inimigo com um forte golpe de chicote, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, além de causar dano adicional equivalente a <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% da vida do alvo<>.",
        "skill2": "Golpeia com um chicote em formato de leque, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos na área e os arremessa para trás.",
        "ult": "Canaliza por <#ffb900ff>{Duration}s<>, disparando projéteis perfurantes em linha reta continuamente na direção de inimigos aleatórios dentro da área, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>."
      },
      "enchanter": {
        "name": "Enchanter",
        "skill": "Fortalece os aliados por <#ffb900ff>{Duration}s<>, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>alcance em {Increase}<>.",
        "skill2": "Aumenta o efeito dos itens dos aliados por <#ffb900ff>{Duration}s<>, elevando em <#ffb900ff>{Percent}%<> os atributos obtidos através de equipamentos.",
        "ult": "Por {Duration}s, fortalece os campeões aliados, aumentando o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque em {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% do poder de habilidade<>), a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> e a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<>, além de conceder imunidade a controle de grupo."
      },
      "siege_breaker": {
        "name": "Siege Breaker",
        "skill": "Golpeia o alvo com um martelo pesado, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Contra estruturas, causa {Bonus}% de dano adicional.",
        "skill2": "Golpeia o chão com uma maça, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos na área, incluindo estruturas.",
        "ult": "Por {Time}s, aumenta o <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>poder de ataque em {Attack}<> , a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<> e a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Prisioner",
        "skill": "Arremessa uma bola de ferro em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos na área.",
        "skill2": "Solta um grito de guerra, ganhando um <#e8d44dff>escudo<> por {Time}s, equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% da vida máxima<>. Também aplica <#ef5350ff>provocação<> em todos os inimigos na área ao redor.",
        "ult": "Avança em direção ao inimigo selecionado e, ao aterrissar, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos na área, aplicando <#ef5350ff>atordoamento por {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Dispara uma onda de choque em linha reta. A onda explode em área circular ao atingir um inimigo ou ao chegar ao alcance máximo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos na área e aplicando <#ef5350ff>{Slow}% de lentidão por {Time}s<>.",
        "skill2": "Concede a si mesmo um <#e8d44dff>escudo<> por {Time}s, equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% da vida máxima<>. Quando o escudo expira, causa <#ef5350ff>atordoamento por {StunTime}s<> a inimigos dentro de {Range} de alcance.",
        "ult": "Concede a um aliado designado dentro de {Range} de alcance um <#e8d44dff>escudo<> equivalente a <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% da vida máxima<> e, após {Time}s, teleporta-se até o aliado selecionado."
      },
      "white_mage": {
        "name": "White Mage",
        "skill": "Um raio em linha reta explode após um curto intervalo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> a todos os inimigos na área.",
        "skill2": "Invoca feixes de luz em uma área circular, atacando 5 vezes e causando aos inimigos na área <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, além de aplicar <#ef5350ff>{Slow}% de lentidão por {SlowTime}s<>.",
        "ult": "Dispara um feixe que atravessa em linha reta, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, e <#ef5350ff>enraizando<> os inimigos atingidos por {Time}s."
      },
      "wind_mage": {
        "name": "Wind Mage",
        "skill": "Invoca um redemoinho por <#ffb900ff>{Duration}s<> que causa a cada {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos em um raio de {Range}. Aliados dentro do redemoinho têm a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento aumentada em {MoveSpeed}%<>.",
        "skill2": "Dispara cinco redemoinhos em linha reta à frente, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> aos inimigos na área.",
        "ult": "Dispara um enorme tornado que se move lentamente em direção ao campeão inimigo mais próximo. Inimigos atingidos pelo tornado sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e ficam <#ef5350ff>no ar por {AirborneTime}s<>. A cada acerto, o tamanho, o dano e a duração do levantamento no ar do tornado diminuem, e ele muda de direção em direção a outro campeão inimigo."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Arremessa uma bomba que causa a todos os inimigos na área <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Instala uma mina invisível no inimigo. Ao ser ativada quando um inimigo pisa nela, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, e aplica <#ef5350ff>enraizamento por {Time}s<>. A mina não é ativada por tropas.",
        "ult": "Lança uma grande bomba na posição selecionada, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> a todos os inimigos na área e aplicando <#ef5350ff>{SlowTime}s de lentidão de {Slow}%<>."
      },
      "cavalry_knight": {
        "name": "Cavalry Knight",
        "skill": "Avança em linha reta e empala o primeiro inimigo atingido, <#ef5350ff>imobilizando-o por {Time}s<> e causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. A velocidade da investida é proporcional à velocidade de movimento.",
        "skill2": "Aumenta a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {Speed}%<> por {Time}s, enquanto fortalece a arma como uma lança de chamas, fazendo com que ataques causem dano adicional de queimadura por {BurnTime}s, causando <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% do poder de ataque<> como dano adicional de queimadura.",
        "ult": "Por {Time}s, aumenta a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% do poder de ataque<>, e cria uma área de efeito que se move em direção à sua posição. Aliados dentro dessa área recebem bônus de velocidade de movimento ao se deslocarem na direção da cavalaria, aumentando em <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% do poder de ataque<>."
      },
      "druid": {
        "name": "Druid",
        "skill": "Invoca um urso. Se o urso morrer, causa <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% do poder de habilidade<> como dano. Se usado enquanto o urso já estiver invocado, recupera <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% do poder de habilidade<> da vida do urso.",
        "skill2": "Invoca uma águia. Caso a águia morra, o druida sofre dano. Enquanto a águia estiver invocada, ao usar esta habilidade novamente, ela avança contra o inimigo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e recupera vida equivalente a <#6aff55ff>{Lifesteal}% do dano causado<>.",
        "ult": "Dispara consecutivamente {Count} espíritos de urso e águia na direção escolhida. Cada projétil causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e empurra os inimigos para trás."
      },
      "voodoo_shaman": {
        "name": "Voodoo Shaman",
        "skill": "Lança um projétil de maldição que causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>, aplica <#ef5350ff>{Time}s de lentidão de {Slow}%<> e reduz a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AtkSpd}%<> por <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Seleciona um alvo inimigo e o amaldiçoa por <#ffb900ff>{Time}s<>, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<>. Durante a duração, cada vez que o alvo for atingido, sofre dano adicional de <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% do poder de habilidade<> (até {Max} vezes).",
        "ult": "Cria uma área de vodu na localização selecionada por <#ffb900ff>{Duration}s<>. Inimigos dentro da área recebem continuamente <#a974ffff>dano mágico<> equivalente a <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% da vida máxima<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>, além de ficarem <#ef5350ff>impedidos de usar habilidades<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Dispara três tiros consecutivos. O primeiro projétil aplica <#ef5350ff>atordoamento por {StunTime}s<> ao inimigo, e cada um dos dois tiros seguintes causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>.",
        "skill2": "Teleporta atrás do último campeão inimigo atacado em <#ffb900ff>{Range}<> de alcance.",
        "ult": "Marca um campeão inimigo e, após <#ffb900ff>{Duration}s<>, causa <#ff9028ff>{Damage} + {Coef}% do dano recebido durante a marca<> como <#ff9028ff>dano físico<>. Ao eliminar o alvo, fica <#ffb900ff>em invisibilidade por {InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Guardian Spirit",
        "skill": "Restaura <#6aff55ff>{Value}<> de vida dos aliados na área ao redor + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<>.",
        "skill2": "Concede aos aliados um <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% do poder de habilidade<>, além de aumento de <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<>.",
        "ult": "Cria uma área sagrada por <#ffb900ff>{Duration}s<>, curando continuamente os aliados dentro da área em <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% do poder de habilidade<> e concedendo um escudo de proteção contra reviver."
      },
      "hunter": {
        "name": "Hunter",
        "skill": "Teleporta-se instantaneamente até o inimigo e muda para o modo de ataque à distância. A <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>distância de ataque aumenta em {RangeIncrease}<>.",
        "marks": "Ataques básicos à distância marcam campeões inimigos por <#ffb900ff>{Duration}s<>. Novos acertos renovam a duração das marcas existentes. A segunda habilidade pode atingir inimigos com 3 marcas.",
        "skill2": "Avança contra um inimigo que tenha 3 acúmulos de marca, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e aplicando <#ef5350ff>silêncio por {SilenceTime}s<>.",
        "ult": "Avança em um dash para frente, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> aos inimigos no trajeto. Pode ser usado novamente caso participe de um abate."
      },
      "circus_blade": {
        "name": "Circus Blade",
        "skill": "Dispara lâminas na direção escolhida, causando a um inimigo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>, e aplicando <#ef5350ff>{Slow}% de lentidão por {SlowTime}s<>. Pode acumular até <#ffb900ff>{ChargeCount} cargas<>, e ganha <#ffb900ff>1 carga<> ao atingir campeões inimigos com ataques básicos.",
        "skill2": "Por <#ffb900ff>{Duration}s<>, aumenta a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidade de movimento em {MoveSpeed}%<> e a <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidade de ataque em {AttackSpeed}%<>, além de ganhar a capacidade de atravessar paredes.",
        "ult": "Avança até o inimigo selecionado, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Inimigos próximos recebem <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% do poder de ataque<> como dano em área e são <#ef5350ff>empurrados para trás (knockback)<> antes de desaparecer."
      },
      "sand_mage": {
        "name": "Mago da Areia",
        "skill": "Ataques básicos carregam energia da areia, causando <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% de Poder de Habilidade<> como <#a974ffff>dano mágico adicional<>. Esse dano adicional e a explosão de areia podem causar crítico. Ao usar, explode areia ao redor do alvo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidade<> como <#a974ffff>dano mágico em área<>.",
        "skill2": "Absorve energia da areia por <#ffb900ff>{Time}s<>, aumentando a <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Velocidade de Movimento em {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% de Poder de Habilidade<> e <#6aff55ff>curando a si mesmo<> em <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% de Poder de Habilidade<>.",
        "ult": "Cria um pântano de areia ao redor do alvo por <#ffb900ff>{Duration}s<>. A cada {Tick}s, inimigos dentro sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidade<> como <#a974ffff>dano mágico<> e são puxados para o centro."
      },
      "alchemist": {
        "name": "Alquimista",
        "skill": "Arremessa um frasco que explode e deixa uma poça tóxica por <#ffb900ff>{Time}s<>. Inimigos na poça ficam <#78e85cff>envenenados<> por <#ffb900ff>{DotTime}s<>, sofrendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidade<> como <#a974ffff>dano mágico<> a cada {DotTick}s, e sua cura é reduzida em {HealReduce}%.",
        "skill2": "Injeta um reagente instável em um inimigo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidade<> como <#a974ffff>dano mágico<>. Por <#ffb900ff>{Time}s<>, o alvo não pode ser curado e fica lento em {Slow}%.",
        "ult": "Arremessa um frasco tóxico em linha reta. Ao atingir um campeão inimigo, cria uma nuvem venenosa que se expande até {CloudRadius} de alcance por <#ffb900ff>{CloudTime}s<>. Inimigos na nuvem ficam <#78e85cff>envenenados<> por <#ffb900ff>{DotTime}s<>, sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidade<> como <#a974ffff>dano mágico<> a cada {DotTick}s, e perdem <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% de Poder de Habilidade<> de Armadura e <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% de Poder de Habilidade<> de Resistência Mágica."
      },
      "crossbowman": {
        "name": "Besteiro",
        "skill": "Dispara uma flecha poderosa em linha reta, causando <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Dano de Ataque<> como <#ff9028ff>dano físico<> ao primeiro campeão inimigo atingido. Enquanto a marca da ultimate durar, causa mais <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de Dano de Ataque<> de dano.",
        "skill2": "Dispara uma flecha perfurante para a frente em linha reta, causando <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Dano de Ataque<> como <#ff9028ff>dano físico<> a inimigos e recuando por <#ffb900ff>{BackstepTime}s<>. Enquanto a marca da ultimate durar, causa mais <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de Dano de Ataque<> de dano.",
        "ult": "Dispara um projétil traçante em linha reta, causando <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Dano de Ataque<> como <#ff9028ff>dano físico<> ao primeiro campeão inimigo atingido e marcando-o por <#ffb900ff>{Duration}s<>. Enquanto a marca durar, todas as habilidades acertam o alvo independentemente da distância e seus tempos de recarga são reduzidos em <#ffb900ff>{CoolReduce}%<>. Outros campeões no caminho podem interceptar."
      },
      "nightmare": {
        "name": "Pesadelo",
        "skill": "Dispara um fragmento de pesadelo em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> ao primeiro inimigo atingido. Pode ser usado até <#ffb900ff>{UseCount} vezes<> em sequência.",
        "skill2": "Avança <#ffb900ff>{Range}<> na direção escolhida, depois causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> aos inimigos em <#ffb900ff>{Radius}<> de alcance e fica invisível por <#ffb900ff>{StealthTime} segundos<>.",
        "ult": "Avança até o campeão inimigo alvo e causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<>. Se esse dano abater o alvo, teleporta para perto de um campeão aliado vivo independentemente da distância."
      },
      "strongman": {
        "name": "Homem-Forte",
        "skill": "Agarra um inimigo próximo, arremessa-o por cima do ombro para trás de si e causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<>, <#ef5350ff>atordoando-o por {Stun}s<>.",
        "skill2": "Gira a barra com força ao redor do corpo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> aos inimigos em um raio de <#ffb900ff>{Range}<> e <#ef5350ff>repelindo-os<>.",
        "ult": "Arremessa um campeão aliado próximo até o local escolhido. Após aterrissar, o aliado arremessado recebe um <#e8d44dff>escudo de {Shield}<> por <#ffb900ff>{ShieldTime}s<>. Inimigos em um raio de <#ffb900ff>{Radius}<> do ponto de aterrissagem sofrem <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> e ficam <#ef5350ff>atordoados por {Stun}s<>. Se não houver um aliado próximo para arremessar, o Homem-Forte salta; nesse caso, o atordoamento dura <#ef5350ff>{SelfStun}s<>."
      },
      "harpooner": {
        "name": "Arpoador",
        "skill": "Dispara um arpão em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> ao primeiro campeão inimigo atingido. Durante <#ffb900ff>{RecastDuration}s<> após o acerto, pode ser reativada para puxar o usuário até o alvo ou puxar o alvo em sua direção.",
        "skill2": "Dispara um arpão poderoso em linha reta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> da Vida perdida do alvo como <#ff9028ff>dano físico<> ao primeiro inimigo atingido.",
        "ult": "Dispara <#ffb900ff>{ProjectileCount}<> arpões acorrentados em cone à frente, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Dano de Ataque<> como <#ff9028ff>dano físico<> e prendendo os atingidos por <#ffb900ff>{LinkDuration}s<>. Inimigos presos são lentos em <#ef5350ff>{Slow}%<>. Se ficarem a mais de <#ffb900ff>{LinkRange}<> de distância, as correntes se retesam: a lentidão aumenta para <#ef5350ff>{TensionSlow}%<> e eles são puxados um para o outro."
      },
      "spellbreaker": {
        "name": "Quebra-Feitiços",
        "skill": "Golpeia a frente com a espada grande, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Ataque<> de <#ff9028ff>dano físico<> e <#ef5350ff>reduzindo a velocidade em {Slow}% por {Time} segundos<>.",
        "skill2": "Avança uma curta distância e causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do Ataque<> de <#ff9028ff>dano físico<> ao primeiro inimigo atingido. Após a investida, <#ffb900ff>o dano recebido é reduzido em {Reduce}% por {Time} segundos<>.",
        "ult": "Destrói instantaneamente todos os escudos dos inimigos em um raio de <#ffb900ff>{Range}<>. Um inimigo cujo escudo foi destruído sofre <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do Poder Mágico<> de <#a974ffff>dano mágico<>, fica <#ef5350ff>atordoado por {Stun} segundos<> e <#ffb900ff>não pode receber escudos por {BlockTime} segundos<>. Inimigos sem escudo sofrem apenas <#a974ffff>{Damage} de dano mágico<>."
      },
      "gladiator": {
        "name": "Gladiador",
        "skill": "Lança uma rede em formato de leque de <#ffb900ff>{FanAngle}°<>, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e <#ef5350ff>enraizando<> os inimigos por <#ffb900ff>{Stun}s<>.",
        "skill2": "Golpeia à frente com o tridente, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<>. Acertar o mesmo campeão novamente em até <#ffb900ff>{Time}s<> adiciona <#ffb900ff>{Amplify}%<> de dano por acúmulo, até <#ffb900ff>{MaxAmplifyTargets}<> acúmulos. Acertar outro campeão reinicia os acúmulos.",
        "ult": "Avança contra um campeão inimigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> e o <#ef5350ff>provocando<> por <#ffb900ff>{Stun}s<>. Durante o duelo, o alvo não pode ser curado nem receber novos escudos, e o Gladiador sofre <#ffb900ff>{Amplify}%<> menos dano de outros inimigos. O duelo termina se a provocação for purificada ou se o alvo morrer."
      },
      "ferryman": {
        "name": "Barqueiro",
        "skill": "Lança uma âncora que atinge o primeiro campeão em seu caminho. Um aliado com até <#ffb900ff>{AllyHpRatio}%<> de vida é puxado para junto do Barqueiro e ganha <#ffb900ff>{Amplify}%<> de velocidade de movimento por <#ffb900ff>{Time}s<>. Aliados com mais vida são ignorados. Inimigos sofrem <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e recebem <#ffb900ff>{Slow}%<> de lentidão por <#ffb900ff>{SlowTime}s<>.",
        "skill2": "Cria à frente um rio de <#ffb900ff>{Range}<> de comprimento e <#ffb900ff>{Width}<> de largura por <#ffb900ff>{Time}s<>. Aliados sobre ele ganham <#ffb900ff>{Amplify}%<> de velocidade de movimento, e inimigos recebem <#ffb900ff>{Slow}%<> de lentidão.",
        "ult": "Purifica outro campeão aliado com até <#ffb900ff>{AllyHpRatio}%<> de vida e o leva de barca por <#ffb900ff>{MoveDistance}<> em direção à base aliada durante <#ffb900ff>{Time}s<>. O passageiro fica inalvejável, não pode agir e é imune a controle de movimento. Ao desembarcar, restaura <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% do poder de habilidade<> de vida e ganha <#ffb900ff>{Slow}%<> de velocidade de movimento por <#ffb900ff>{SlowTime}s<>."
      },
      "bombardier": {
        "name": "Artilheiro",
        "skill": "Posiciona ou recolhe o canhão. Posicionado, não pode se mover, mas o alcance dos ataques básicos e da habilidade 2 aumenta em <#ffb900ff>{MoveDistance}<> e recebe <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% de poder de ataque<>. Ao recolher, ganha <#ffb900ff>{Slow}%<> de velocidade de movimento por <#ffb900ff>{Time}s<>.",
        "skill2": "Dispara um projétil parabólico na área alvo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> em um raio de <#ffb900ff>{Radius}<> e aplicando <#ffb900ff>{Slow}%<> de lentidão por <#ffb900ff>{SlowTime}s<>. Posicionado, o alcance aumenta.",
        "ult": "Dispara <#ffb900ff>{ProjectileCount}<> projéteis na área escolhida. Cada um causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% do poder de ataque<> como <#ff9028ff>dano físico<> em um raio de <#ffb900ff>{ProjectileRadius}<>. Posicionado, o alcance aumenta mais <#ffb900ff>{MoveDistance}<>. Controle de grupo interrompe os disparos restantes."
      },
      "hypnotist": {
        "name": "Hipnotizador",
        "skill": "Lança um pêndulo perfurante que causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% do poder de habilidade<> como <#a974ffff>dano mágico<> e aplica <#ffb900ff>{Slow}%<> de lentidão por <#ffb900ff>{SlowTime}s<>. Esse dano não acorda inimigos em <#ef5350ff>sono<>.",
        "skill2": "Após <#ffb900ff>{Delay}s<>, faz os inimigos em um raio de <#ffb900ff>{Radius}<> caírem no <#ef5350ff>sono<> por <#ffb900ff>{Time}s<>. Adormecidos não podem se mover nem agir. Dano, inclusive dano ao longo do tempo, acorda o alvo, e esse primeiro golpe causa <#ffb900ff>{Amplify}%<> de dano adicional.",
        "ult": "Após <#ffb900ff>{Delay}s<>, faz os inimigos em um raio de <#ffb900ff>{Radius}<> caírem no <#ef5350ff>sono<> por <#ffb900ff>{Time}s<>. Dano acorda o alvo, e o golpe que o acorda causa <#ffb900ff>{Amplify}%<> de dano adicional. A purificação remove o <#ef5350ff>sono<> e o bônus de dano."
      }
    }
  },
