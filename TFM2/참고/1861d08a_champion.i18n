      },
      "shield_bearer": {
        "name": "Kalkan taşıyıcısı",
        "skill": "Belirtilen bir müttefik ve kendine <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% maks. HP<> <#e8d44dff>kalkan<> ver ({Duration}s).",
        "skill2": "{Duration}s boyunca yakındaki müttefiklere verilen hasarın %{Damage}'ini üstlenir ve müttefiki vuran düşmanı <#ef5350ff>%{Coef}<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zırhının %{DefCoef}'i<> kadar yavaşlatır.",
        "ult": "{Duration}s boyunca <#e8d44dff>%{DamageReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü direncinin %{MrCoef}'i<> hasar azaltma ve kitle kontrol bağışıklığı kazanır; çevredeki tüm düşmanları <#ef5350ff>{TauntDuration}s boyunca kışkırtır<>. Etki sırasında hareket edemez."
      },
      "soldier": {
        "name": "Asker",
        "skill": "Her seviye saldırı menzili <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> artar.",
        "skill2": "Bir düşmana üç mermi ateşleyerek ağır <#ff9028ff>fiziksel hasar<> ver (mermi başına <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si). Yetenek menzili temel saldırı menziliyle ölçeklenir.",
        "ult": "{Range} mesafe içindeki düşmanları hedef alan, düz bir çizgide uçan devasa bir mermi ateşler. Mermi, geçen yörünge içindeki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir ve bir düşmana her çarptığında, hasar %{Decay} azalır."
      },
      "swordman": {
        "name": "Kılıç ustası",
        "skill": "Kılıç enerjisi atarak vurulan düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver (menzil {Range}).",
        "skill2": "Tek bir hedefi ardışık üç kez keserek ağır <#ff9028ff>fiziksel hasar<> ver. Vuruş başına <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si.",
        "ult": "Düz bir çizgide {Range} mesafe şarj eder ve şarj menzilindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Eğer bir düşmanı ultinizle öldürürseniz, ultinizin bekleme süresi sıfırlanır."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Bir düşmanı tılsımla mühürleyerek <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si kadar <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}(+yetenek gücünün %{TimeCoef}'i)s<> boyunca normal saldırı yapmasını engeller.",
        "skill2": "Bir düşmana tılsım yapıştırarak <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si kadar <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}(+yetenek gücünün %{TimeCoef}'i)s<> boyunca yetenek kullanmasını engeller.",
        "ult": "Doğrultu boyunca tılsım mermisi ateşler. <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s hedefi etkisizleştirir<>, hedeflenemez yapar. Etki bittiğinde yakın düşmanlara yayılır."
      },
      "vampire": {
        "name": "Vampir",
        "skill": "Bir düşmanın kanını emerek <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver ve <#6aff55ff>{Heal} can yenile<> ve yığın. <#6aff55ff>Yığın başına yenileme {Stack} artar<>.",
        "skill2": "Canının {Value}%'sini tüketerek öne koni şeklinde kan püskürt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün {Coef}%<>'si <#a974ffff>büyü hasarı<> ver. Yığın başına hasar {Stack} artar.",
        "ult": "Hedef alınamaz hale gelir ve {Range} mesafeye atılır, hücum yörüngesindeki her düşmandan <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% büyü gücü<> kadar <#6aff55ff>can emer<> ve <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% büyü gücü<> <#a974ffff>büyü hasarı<> verir."
      },
      "werewolf": {
        "name": "Kurt adam",
        "skill": "Öne pençe atar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#6aff55ff>verdiği hasarın {HealRatio}%'ı kadar iyileşir<>.",
        "skill2": "Öne atılır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "<#ffb900ff>{Duration}s<> kanal yapar, defalarca <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{BleedTime}s kanama<> uygular (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% Saldırı<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "<#ffb900ff>{Duration}s<> sopayı güçlendirir. Her saldırı yelpaze şeklinde şok dalgası oluşturur, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "<#ffb900ff>{Duration}s<> boyunca derisini güçlendirerek <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}'i<> kadar <#e8d44dff>kalkan<> ve <#e8d44dff>%{DamageReduction} hasar azaltma<> kazanır.",
        "ult": "Doğrultu boyunca mermi ateşler. Vurulan düşmanlar <#ef5350ff>{SlowTime}s boyunca giderek yavaşlar<>, sonra <#ef5350ff>{BindTime}s köklenir<>. Köklenmede yakın düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Etki hasar gören düşmanlara yayılır."
      },
      "hammerer": {
        "name": "Ağır piyade",
        "skill": "Yakın bir düşmana çekiç salla, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Time}s havaya fırlat<>.",
        "skill2": "Çekici kaldırıp odaklan, yere vur {Range} alandaki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver ve <#ef5350ff>{Time}s %{Move} yavaşlat<>.",
        "ult": "Çekici genişçe sallayarak öndeki {Range} menzilindeki yarım daire şeklindeki bir alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> verir. Çekiçle vurulan düşmanlar {Time}s geri savrulur ve itilen düşmanın vurduğu rakip şampiyonlar <#ef5350ff>{Airborne}s havada kalır<>."
      },
      "inquisitor": {
        "name": "Engizisyoncu",
        "skill": "Kısa mesafe atılır, ilk vurduğu düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>kanama<> uygular.",
        "skill2": "Hedeflenen düşmanı keser, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Hedef <#ef5350ff>kanıyorsa<> Yetenek 1 bekleme süresini sıfırlar.",
        "ult": "Düşman şampiyona doğru saldırır, varışta alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. Hasar sonrası maks CG'ı {Threshold}%'in altına düşen düşmanlar idam edilir. İdamda yakın düşmanlar <#ef5350ff>{FearTime}s korkutulur<>."
      },
      "pole_warrior": {
        "name": "Kutup savaşçısı",
        "skill": "Düşmana sıçrayarak kutupla vur <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "skill2": "Kısa mesafe hareket et, kutupa çıkarak {Time}s hedeflenemez ol, sonra sallayarak {Range} alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> ver.",
        "ult": "{Range} menzilindeki belirlenmiş bir düşmana hücum eder, düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef}<>'sine eşit <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>hedefi {Time}s havaya kaldırır<>."
      },
      "spirit_caller": {
        "name": "Ruh çağıran",
        "skill": "Müttefike <#ffb900ff>{Duration}s<> ruh iliştirir, <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% YG<> kadar <#6aff55ff>can yeniler<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını {SpeedUp}% artırır<>.",
        "skill2": "Bir düşmana <#ffb900ff>{Duration}s<> boyunca ruh bağlar; <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>zırhını {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{DefCoef}'i<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>büyü direncini {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{MrCoef}'i<> azaltır ve <#ef5350ff>%{Slow} yavaşlatır<>.",
        "ult": "İliştirilen ruhları patlatır. Müttefik ruhlar <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> ve <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% saldırı hızı<> verir. Düşman ruhlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{StunTime}s sersemleştirir<>."
      },
      "whip_master": {
        "name": "Kırbaç ustası",
        "skill": "Kırbacı sallar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% hedef CG<> verir.",
        "skill2": "Kırbacı yelpaze şeklinde sallar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir ve düşmanları geri iter.",
        "ult": "<#ffb900ff>{Duration}s<> kanal yapar, delici mermiler ateşler ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir."
      },
      "enchanter": {
        "name": "Büyücü",
        "skill": "Müttefiği <#ffb900ff>{Duration}s<> büyüler, <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>menzili {Increase}<> artırır.",
        "skill2": "Müttefik ekipmanı <#ffb900ff>{Duration}s<> büyüler, eşya statlarını <#ffb900ff>{Percent}%<> artırır.",
        "ult": "Müttefik şampiyonu {Duration}s güçlendirir, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% YG<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızı {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızı {MoveSpeed}%<> ve kontrol etkisi bağışıklığı verir."
      },
      "siege_breaker": {
        "name": "Kuşatma kırıcı",
        "skill": "Topuzla vurur, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir. Yapılara {Bonus}% bonus hasar verir.",
        "skill2": "Yere vurur, yapılar dahil tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırıyı {Attack}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AttackSpeed}%<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını {MoveSpeed}%<> artırır."
      },
      "prisoner": {
        "name": "Mahkum",
        "skill": "Doğrultu boyunca demir top atar, alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Kükreyerek {Time}s boyunca <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> kazanır ve yakındaki tüm düşmanları <#ef5350ff>kışkırtır<>.",
        "ult": "Düşmana saldırır, iniş noktasına yakın tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time}s sersemletir<>."
      },
      "android": {
        "name": "Android",
        "skill": "Düz yöne şok dalgası ateşle. Şok dalgası düşmana isabet ettiğinde veya menzil sonuna ulaştığında daire şeklinde patlayarak düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time}s boyunca %{Slow} yavaşlatır<>.",
        "skill2": "{Time}s süren <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> kazanır. Kalkan kaybolduğunda {Range} menzil içindeki düşmanları <#ef5350ff>{StunTime}s sersemletir<>.",
        "ult": "{Range} menzil içindeki seçilen müttefiğe <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>azami canın %{Coef}'i<> kadar <#e8d44dff>kalkan<> verir ve {Time}s sonra seçilen müttefiğe ışınlanır."
      },
      "white_mage": {
        "name": "Beyaz büyücü",
        "skill": "Bir ışın gecikme sonrası patlar, tüm düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "skill2": "5 kez saldıran ışınlar çağırır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>.",
        "ult": "Delici ışın ateşler, vurulan düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> <#a974ffff>büyü hasarı<> verir ve <#ef5350ff>{Time}s köklendirir<>."
      },
      "wind_mage": {
        "name": "Rüzgar büyücüsü",
        "skill": "<#ffb900ff>{Duration}s<> hortum çağırır, {Range} içinde her {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir. İçindeki müttefikler <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> kazanır.",
        "skill2": "Öne beş hortum ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir.",
        "ult": "Devasa kasırga fırlatır. Vurulan düşmanlar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>{AirborneTime}s havada<> kalır. Boyut, hasar ve havada kalma süresi vuruş başına azalır. Diğer şampiyonlara yönlendirir."
      },
      "bomber": {
        "name": "Bombacı",
        "skill": "Bomba atar, alandaki tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "Üzerine basıldığında <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı<> <#ff9028ff>fiziksel hasar<> veren ve <#ef5350ff>{Time}s köklendiren<> görünmez mayın yerleştirir. Asker üzerinde tetiklenmez.",
        "ult": "Hedef alana büyük bomba atar, tüm düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>."
      },
      "cavalry_knight": {
        "name": "Süvari şövalye",
        "skill": "Düz bir yöne hücum ederek ilk vurulan düşmanı mızrakla deler, <#ef5350ff>{Time} saniye köklenir<> ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı hasarının {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Hücum hızı hareket hızıyla orantılıdır.",
        "skill2": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını %{Speed} artırır<> ve silahını alevli mızrağa dönüştürerek saldırılarda {BurnTime}s boyunca ek <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{BurnCoef}'i<> kadar yanma hasarı verir.",
        "ult": "{Time}s boyunca <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>hareket hızını %{Speed}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{SpeedCoef}'i<> artırır ve kendi konumuna yönelen bir alan oluşturur. Alandaki müttefikler Süvariye doğru hareket ederken <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>%{Buff}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{SpeedCoef}'i<> hareket hızı kazanır."
      },
      "druid": {
        "name": "Druid",
        "skill": "Ayı çağırır. Ölürse, druid <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% YG<> hasar alır. Çağrılıyken kullanmak ayının canını <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> kadar <#6aff55ff>yeniler<>.",
        "skill2": "Bir kartal çağırır. Kartal ölürse Druid hasar alır. Kartal çağrılıyken bu yetenek kullanılırsa kartal düşmana atılarak <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#a974ffff>büyü hasarı<> verir ve verilen hasarın <#6aff55ff>%{Lifesteal}'i kadar Can yeniler<>.",
        "ult": "Belirlenen yöne art arda {Count} ayı ve kartal ruhu gönderir. Her mermi <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef}'i<> kadar <#a974ffff>büyü hasarı<> verir ve düşmanları geriye iter."
      },
      "voodoo_shaman": {
        "name": "Vudu şamanı",
        "skill": "Lanet mermisi ateşler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir, <#ef5350ff>{Time}s boyunca {Slow}% yavaşlatır<> ve <#ffb900ff>{AtkSpdTime}s<> <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>saldırı hızını {AtkSpd}%<> azaltır.",
        "skill2": "Düşmanı <#ffb900ff>{Time}s<> lanetler, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> verir. Aldığı her vuruşta <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% YG<> bonus hasar verir (maks {Max}).",
        "ult": "<#ffb900ff>{Duration}s<> voodoo bölgesi yaratır. İçindeki düşmanlar periyodik olarak <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maks CG<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% YG<> <#a974ffff>büyü hasarı<> alır ve <#ef5350ff>susturulur<>."
      },
      "hitman": {
        "name": "Tetikçi",
        "skill": "Üç atışlık seri ateş eder. İlk atış düşmanı <#ef5350ff>{StunTime}s sersemletir<>, sonraki iki atışın her biri <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir.",
        "skill2": "<#ffb900ff>{Range}<> menzilinde son saldırılan düşman şampiyonun arkasına ışınlanır.",
        "ult": "Bir düşman şampiyonu işaretler. <#ffb900ff>{Duration}s<> sonra <#ff9028ff>{Damage} + işaret süresince alınan hasarın %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Hedef öldürülürse <#ffb900ff>{InvisibleDuration}s<> gizlenir."
      },
      "guardian_spirit": {
        "name": "Ruh Koruyucusu",
        "skill": "Yakın müttefiklerin canını <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% yetenek gücü<> kadar <#6aff55ff>yeniler<>.",
        "skill2": "Müttefiğe <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% YG<> <#e8d44dff>kalkan<> ve <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<> verir.",
        "ult": "<#ffb900ff>{Duration}s<> boyunca bir sığınak yaratır, menzildeki müttefikleri sürekli olarak <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% YG<> kadar <#6aff55ff>iyileştirir<>. Sığınakta 1 müttefik şampiyon ölürse onu diriltir ve sığınak hemen sona erer."
      },
      "hunter": {
        "name": "Avcı",
        "skill": "Düşmana ışınlanır ve menzilli moda geçer. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Menzil {RangeIncrease}<> artar.",
        "marks": "Menzilli normal saldırılar rakip şampiyonları <#ffb900ff>{Duration} saniyeliğine<> işaretler. Sonraki isabetler mevcut işaretlerin süresini yeniler. İkinci yetenek, 3 işaret taşıyan rakipleri hedef alabilir.",
        "skill2": "3 yığın işaretli düşmana atılır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SilenceTime}s susturur<>.",
        "ult": "İleri atılarak yolundaki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün {Coef}%<>'si kadar <#ff9028ff>fiziksel hasar<> verir. Kullanımdan sonra kısa süre içinde bir kez yeniden kullanılabilir; kill veya assist aldığında bir ek yeniden kullanım hakkı kazanır."
      },
      "circus_blade": {
        "name": "Sirk Bıçağı",
        "skill": "Hedef yöne bıçak ateşler, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{SlowTime}s boyunca {Slow}% yavaşlatır<>. En fazla <#ffb900ff>{ChargeCount}<> şarj depolar. Düşman şampiyonlara normal saldırıda <#ffb900ff>1<> şarj kazanır.",
        "skill2": "<#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% hareket hızı<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% saldırı hızı<> ve duvar geçişi kazanır.",
        "ult": "Hedef düşmana atılır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% saldırı hasarı<> <#ff9028ff>fiziksel hasar<> verir. <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% Saldırı<> sıçrama hasarı verir ve <#ef5350ff>yakın düşmanları geri iter<>, sonra kaybolur."
      },
      "sand_mage": {
        "name": "Kum Büyücüsü",
        "skill": "Temel saldırılar kum enerjisi taşır ve <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% Yetenek Gücü<> kadar <#a974ffff>ek büyü hasarı<> verir. Bu ek hasar ve kum patlaması kritik vurabilir. Kullanıldığında hedefin çevresinde kumu patlatır ve <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Yetenek Gücü<> kadar <#a974ffff>alan büyü hasarı<> verir.",
        "skill2": "<#ffb900ff>{Time}s<> boyunca kum enerjisini emer, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Hareket Hızını {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% Yetenek Gücü<> artırır ve kendini <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Yetenek Gücü<> kadar <#6aff55ff>iyileştirir<>.",
        "ult": "Hedefin çevresinde <#ffb900ff>{Duration}s<> süren bir kum bataklığı oluşturur. Bataklık her {Tick}s içinde kalan düşmanlara <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Yetenek Gücü<> kadar <#a974ffff>büyü hasarı<> verir ve onları merkeze çeker."
      },
      "alchemist": {
        "name": "Simyacı",
        "skill": "Patlayan ve <#ffb900ff>{Time}s<> boyunca zehirli bir alan bırakan bir şişe fırlatır. Alandaki düşmanlar <#ffb900ff>{DotTime}s<> boyunca <#78e85cff>zehirlenir<>, her {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Yetenek Gücü<> kadar <#a974ffff>büyü hasarı<> alır ve aldıkları iyileştirme {HealReduce}% azalır.",
        "skill2": "Bir düşmana dengesiz reaktif enjekte ederek <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Yetenek Gücü<> kadar <#a974ffff>büyü hasarı<> verir. Hedef <#ffb900ff>{Time}s<> boyunca iyileştirilemez ve {Slow}% yavaşlar.",
        "ult": "Düz bir hat üzerinde zehirli bir şişe fırlatır. Bir düşman şampiyona isabet ettiğinde, <#ffb900ff>{CloudTime}s<> boyunca {CloudRadius} menzile kadar genişleyen zehirli bir bulut oluşturur. Buluttaki düşmanlar <#ffb900ff>{DotTime}s<> boyunca <#78e85cff>zehirlenir<>, her {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Yetenek Gücü<> kadar <#a974ffff>büyü hasarı<> alır ve <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% Yetenek Gücü<> Zırh ile <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% Yetenek Gücü<> Büyü Direnci kaybeder."
      },
      "crossbowman": {
        "name": "Arbaletçi",
        "skill": "Düz bir hat üzerinde güçlü bir ok fırlatır ve ilk isabet eden düşman şampiyona <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı Gücü<> kadar <#ff9028ff>fiziksel hasar<> verir. Ulti işareti sürdüğü sürece <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Saldırı Gücü<> kadar ek hasar verir.",
        "skill2": "İleri doğru düz bir hat üzerinde delip geçen bir ok fırlatır, düşmanlara <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı Gücü<> kadar <#ff9028ff>fiziksel hasar<> verir ve <#ffb900ff>{BackstepTime}s<> boyunca geriye savrulur. Ulti işareti sürdüğü sürece <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Saldırı Gücü<> kadar ek hasar verir.",
        "ult": "Düz bir hat üzerinde izli mermi fırlatır, ilk isabet eden düşman şampiyona <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Saldırı Gücü<> kadar <#ff9028ff>fiziksel hasar<> verir ve onu <#ffb900ff>{Duration}s<> işaretler. İşaret sürdüğü sürece tüm yetenekler mesafeden bağımsız olarak hedefe isabet eder ve bekleme süreleri <#ffb900ff>{CoolReduce}%<> azalır. Yoldaki başka şampiyonlar darbeyi engelleyebilir."
      },
      "nightmare": {
        "name": "Kabus",
        "skill": "Düz bir hat üzerinde kabus parçası fırlatır ve isabet eden ilk düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Art arda en fazla <#ffb900ff>{UseCount} kez<> kullanılabilir.",
        "skill2": "Seçilen yöne <#ffb900ff>{Range}<> mesafe atılır, ardından <#ffb900ff>{Radius}<> içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir ve <#ffb900ff>{StealthTime} saniye<> görünmez olur.",
        "ult": "Hedef düşman şampiyona atılır ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir. Bu hasar hedefi öldürürse mesafeden bağımsız olarak hayatta olan bir müttefik şampiyonun yanına ışınlanır."
      },
      "strongman": {
        "name": "Güçlü Adam",
        "skill": "Yakındaki bir düşmanı yakalar, omzunun üzerinden arkasına fırlatır ve <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> vererek hedefi <#ef5350ff>{Stun} saniye sersemletir<>.",
        "skill2": "Halterini genişçe savurur, <#ffb900ff>{Range}<> içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> verir ve onları <#ef5350ff>geri savurur<>.",
        "ult": "Yakındaki bir müttefik şampiyonu hedef konuma fırlatır. Fırlatılan müttefik yere indikten sonra <#ffb900ff>{ShieldTime} saniye<> boyunca <#e8d44dff>{Shield} kalkan<> kazanır. İniş noktasının <#ffb900ff>{Radius}<> çevresindeki düşmanlar <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}'i<> kadar <#ff9028ff>fiziksel hasar<> alır ve <#ef5350ff>{Stun} saniye sersemler<>. Fırlatılacak yakın bir müttefik yoksa Güçlü Adam kendisi sıçrar; bu durumda sersemletme süresi <#ef5350ff>{SelfStun} saniyedir<>."
      },
      "harpooner": {
        "name": "Zıpkıncı",
        "skill": "Düz bir çizgide zıpkın fırlatarak isabet alan ilk rakip şampiyona <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}<> kadarı <#ff9028ff>fiziksel hasar<> verir. İsabetten sonraki <#ffb900ff>{RecastDuration}<> sn. içinde yeniden kullanıldığında kendini hedefe veya hedefi kendine doğru çeker.",
        "skill2": "Düz bir çizgide güçlü bir zıpkın fırlatarak isabet alan ilk rakibe <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}<> + hedefin eksik Canının %<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}<> kadarı <#ff9028ff>fiziksel hasar<> verir.",
        "ult": "Öne doğru koni şeklinde <#ffb900ff>{ProjectileCount}<> zincirli zıpkın fırlatır, isabet edenlere <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırı Gücünün %{Coef}<> kadarı <#ff9028ff>fiziksel hasar<> verir ve <#ffb900ff>{LinkDuration}<> sn. boyunca zincirler. Zincirlenen düşmanlar %<#ef5350ff>{Slow}<> yavaşlar. Birbirlerinden <#ffb900ff>{LinkRange}<> fazla uzaklaşırlarsa zincirler gerilir: yavaşlatma %<#ef5350ff>{TensionSlow}<> seviyesine çıkar ve birbirlerine çekilirler."
      },
      "spellbreaker": {
        "name": "Büyübozan",
        "skill": "Büyük kılıcı öne doğru savurarak <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırının %{Coef}<> kadar <#ff9028ff>fiziksel hasar<> verir ve <#ef5350ff>{Time} saniye boyunca %{Slow} yavaşlatır<>.",
        "skill2": "Kısa bir mesafe hücum eder ve isabet eden ilk düşmana <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Saldırının %{Coef}<> kadar <#ff9028ff>fiziksel hasar<> verir. Hücumdan sonra <#ffb900ff>{Time} saniye boyunca alınan hasar %{Reduce} azalır<>.",
        "ult": "<#ffb900ff>{Range}<> menzildeki tüm düşman kalkanlarını anında yok eder. Kalkanı yok edilen düşman <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Büyü Gücünün %{Coef}<> kadar <#a974ffff>büyü hasarı<> alır, <#ef5350ff>{Stun} saniye sersemler<> ve <#ffb900ff>{BlockTime} saniye boyunca kalkan kazanamaz<>. Kalkanı olmayan düşman yalnızca <#a974ffff>{Damage} büyü hasarı<> alır."
      },
      "gladiator": {
        "name": "Gladyatör",
        "skill": "Önündeki <#ffb900ff>{FanAngle}°<> yelpaze alana ağ fırlatır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef} kadarı<> <#ff9028ff>fiziksel hasar<> verir ve düşmanları <#ffb900ff>{Stun}s<> boyunca <#ef5350ff>köklendirir<>.",
        "skill2": "Üç dişli mızrağını ileri saplar, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef} kadarı<> <#ff9028ff>fiziksel hasar<> verir. <#ffb900ff>{Time}s<> içinde aynı şampiyona yeniden isabet ettirdiğinde hasar her yük için <#ffb900ff>%{Amplify}<> artar (en fazla <#ffb900ff>{MaxAmplifyTargets}<> yük). Başka bir şampiyona isabet etmek yükleri sıfırlar.",
        "ult": "Bir rakip şampiyona atılır, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef} kadarı<> <#ff9028ff>fiziksel hasar<> verir ve onu <#ffb900ff>{Stun}s<> boyunca <#ef5350ff>kışkırtır<>. Düello sırasında hedef iyileştirilemez ve yeni kalkan alamaz; Gladyatör'ün diğer düşmanlardan aldığı hasar <#ffb900ff>%{Amplify}<> azalır. Kışkırtma arındırılırsa veya hedef ölürse düello sona erer."
      },
      "ferryman": {
        "name": "Kayıkçı",
        "skill": "Yolundaki ilk şampiyona isabet eden bir çapa fırlatır. Canı en fazla <#ffb900ff>%{AllyHpRatio}<> olan müttefiki Kayıkçı'nın yanına çeker ve <#ffb900ff>{Time}s<> boyunca hareket hızını <#ffb900ff>%{Amplify}<> artırır; canı daha yüksek müttefiklerin içinden geçer. Düşmanlar ise <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef} kadarı<> <#a974ffff>büyü hasarı<> alır ve <#ffb900ff>{SlowTime}s<> boyunca <#ffb900ff>%{Slow}<> yavaşlar.",
        "skill2": "Önünde <#ffb900ff>{Time}s<> boyunca <#ffb900ff>{Range}<> uzunluğunda ve <#ffb900ff>{Width}<> genişliğinde bir nehir oluşturur. Üzerindeki müttefiklerin hareket hızı <#ffb900ff>%{Amplify}<> artar, düşmanlar <#ffb900ff>%{Slow}<> yavaşlar.",
        "ult": "Canı en fazla <#ffb900ff>%{AllyHpRatio}<> olan başka bir müttefik şampiyonu arındırır ve onu kayıkla <#ffb900ff>{Time}s<> içinde dost üsse doğru <#ffb900ff>{MoveDistance}<> taşır. Yolcu hedeflenemez, eylem yapamaz ve konum değiştirme etkilerinden bağışıktır. Karaya çıkınca <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>yetenek gücünün %{Coef} kadarı<> can yeniler ve <#ffb900ff>{SlowTime}s<> boyunca <#ffb900ff>%{Slow}<> hareket hızı kazanır."
      },
      "bombardier": {
        "name": "Topçu",
        "skill": "Topu kurar veya toplar. Kuruluyken hareket edemez, ancak normal saldırılarının ve 2. yeteneğinin menzili <#ffb900ff>{MoveDistance}<> artar ve <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücü %{Amplify} artar<>. Topladıktan sonra <#ffb900ff>{Time}s<> boyunca <#ffb900ff>%{Slow}<> hareket hızı kazanır.",
        "skill2": "Hedef bölgeye eğik atışla bir mermi fırlatır, <#ffb900ff>{Radius}<> yarıçap içindeki düşmanlara <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef} kadarı<> <#ff9028ff>fiziksel hasar<> verir ve onları <#ffb900ff>{SlowTime}s<> boyunca <#ffb900ff>%{Slow}<> yavaşlatır. Top kuruluyken menzil artar.",
        "ult": "Seçilen bölgeye art arda mermi yağdırır (toplam <#ffb900ff>{ProjectileCount}<>). Her mermi <#ffb900ff>{ProjectileRadius}<> yarıçap içinde <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>saldırı gücünün %{Coef} kadarı<> <#ff9028ff>fiziksel hasar<> verir. Top kuruluyken menzil ayrıca <#ffb900ff>{MoveDistance}<> artar. Kitle kontrolü kalan atışları keser."
      },
      "hypnotist": {
        "name": "Hipnozcu",
        "skill": "Delip geçen bir sarkaç fırlatır, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>yetenek gücünün %{Coef} kadarı<> <#a974ffff>büyü hasarı<> verir ve <#ffb900ff>{SlowTime}s<> boyunca <#ffb900ff>%{Slow}<> yavaşlatır. Bu hasar <#ef5350ff>uyuyan<> düşmanları uyandırmaz.",
        "skill2": "<#ffb900ff>{Delay}s<> sonra <#ffb900ff>{Radius}<> yarıçap içindeki düşmanları <#ffb900ff>{Time}s<> boyunca <#ef5350ff>uyutur<>. Uyuyan hedef hareket edemez ve eylem yapamaz. Zaman içinde verilen hasar dahil her hasar hedefi uyandırır ve bu ilk vuruş <#ffb900ff>%{Amplify}<> daha fazla hasar verir.",
        "ult": "<#ffb900ff>{Delay}s<> sonra <#ffb900ff>{Radius}<> yarıçap içindeki düşmanları <#ffb900ff>{Time}s<> boyunca <#ef5350ff>uyutur<>. Hasar hedefi uyandırır ve uyandıran vuruş <#ffb900ff>%{Amplify}<> daha fazla hasar verir. Arındırma hem <#ef5350ff>uykuyu<> hem de hasar bonusunu kaldırır."
      }
    }
  },
