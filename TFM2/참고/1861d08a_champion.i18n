        "name": "巨盾兵",
        "skill": "在一定范围内，为一名己方英雄和自己赋予<#e8d44dff>{Shield}<>+<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}%最大生命值<>点<#e8d44dff>护盾<>。（持续{Duration}秒）",
        "skill2": "一段时间内，代替周围范围内的己方单位承受其所受伤害的{Damage}%，并使攻击己方单位的敌人<#ef5350ff>减速{Coef}%<>+<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防御力的{DefCoef}%<>。（持续{Duration}秒）",
        "ult": "汲取大地之力，在{Duration}秒内获得<#e8d44dff>伤害减免{DamageReduce}%<>+<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法抗性的{MrCoef}%<>效果，并免疫控制。同时嘲讽周围大范围内的所有敌人，持续<#ef5350ff>{TauntDuration}秒<>。嘲讽期间无法移动。"
      },
      "soldier": {
        "name": "步枪手",
        "skill": "每升一级，<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>攻击距离增加{GrowthRange}<>。",
        "skill2": "向一名敌人连续发射三发子弹，造成大量<#ff9028ff>物理伤害<>（每发造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点伤害）。技能射程与攻击距离成正比。",
        "ult": "向{Range}距离内的敌人发射一枚沿直线飞行的巨型狙击弹。子弹会对飞行轨迹上的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，且每命中一名敌人，伤害降低{Decay}%。"
      },
      "swordman": {
        "name": "剑客",
        "skill": "发射剑气，对命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。（剑气射程{Range}）",
        "skill2": "连续三次斩击单个目标，造成大量<#ff9028ff>物理伤害<>。每次斩击造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "ult": "沿直线冲锋{Range}距离，对冲锋范围内的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。伤害根据击中敌人的数量进行分摊。如果用终极技能击杀了敌人，终极技能的冷却时间就会重置。"
      },
      "taoist": {
        "name": "道士",
        "skill": "用止戈符封印敌人，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>点<#a974ffff>魔法伤害<>，使其在<#ef5350ff>{Time}(+法术强度的{TimeCoef}%)秒<>内无法进行普通攻击。",
        "skill2": "向敌人施加禁魔符，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术强度的{Coef}%<>点<#a974ffff>魔法伤害<>，使其在<#ef5350ff>{Time}(+法术强度的{TimeCoef}%)秒<>内无法使用技能。",
        "ult": "沿直线飞出镇灵符，对命中的敌人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并使其<#ef5350ff>无法行动{Time}秒<>，且进入无法选取状态。效果结束后，会将相同效果蔓延向周围敌人。"
      },
      "vampire": {
        "name": "吸血鬼",
        "skill": "吸取敌人的鲜血，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>，并<#6aff55ff>恢复{Heal}生命值<>，同时叠加饮血层数。每层使<#6aff55ff>生命恢复量增加{Stack}<>。",
        "skill2": "消耗自身{Value}%生命值，向前方扇形范围泼洒鲜血，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#a974ffff>魔法伤害<>。每层饮血层数使伤害增加{Stack}。",
        "ult": "化身蝙蝠，进入无法选中状态，飞行{Range}距离，对飞行路径内的每个敌人<#6aff55ff>吸取{Heal}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法术强度<>点<#6aff55ff>生命值<>，并造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}%法术强度<>点<#a974ffff>魔法伤害<>。"
      },
      "werewolf": {
        "name": "狼人",
        "skill": "挥爪撕裂前方半月形范围内的敌人，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并<#6aff55ff>恢复伤害量{HealRatio}%的生命值<>。",
        "skill2": "向前突进，对命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并使其<#ef5350ff>减速{Slow}%，持续{SlowTime}秒<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>内，持续对扇形范围内的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并施加<#ef5350ff>{BleedTime}秒流血<>效果。（流血伤害：<#ff9028ff>{BleedDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}%攻击力<>）"
      },
      "dokkaebi": {
        "name": "赤魇",
        "skill": "在<#ffb900ff>{Duration}秒<>内强化铁棒。攻击敌人时产生扇形冲击波，冲击波造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。",
        "skill2": "在<#ffb900ff>{Duration}秒<>内强化表皮，获得<#e8d44dff>{Shield}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#e8d44dff>护盾<>和<#e8d44dff>{DamageReduction}%伤害减免<>。",
        "ult": "沿直线投掷冥火，使命中的敌人移动速度在{SlowTime}秒内逐渐降低，然后将其禁锢{BindTime}秒。禁锢时对周围造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并且周围受到伤害的敌人也会被施加相同效果。"
      },
      "hammerer": {
        "name": "重锤手",
        "skill": "向一名附近的敌人挥动重锤，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并将其<#ef5350ff>击飞{Time}秒<>。",
        "skill2": "举起重锤，蓄力后砸向地面，对周围{Range}范围内的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并施加<#ef5350ff>{Move}%减速，持续{Time}秒<>。",
        "ult": "大力挥动重锤，对前方{Range}范围内半圆形区域的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。被重锤击中的敌人会被击退{Time}秒，被击退的敌人撞到的敌方英雄将被<#ef5350ff>击飞{Airborne}秒<>。"
      },
      "inquisitor": {
        "name": "审判官",
        "skill": "短距离突刺，对第一个命中的敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>，并施加<#ef5350ff>流血<>效果。",
        "skill2": "斩击指定敌人，造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。若目标处于<#ef5350ff>流血<>状态，则一技能的冷却时间重置。",
        "ult": "向敌方英雄突刺，对目标点周围的所有敌人造成<#ff9028ff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%攻击力<>点<#ff9028ff>物理伤害<>。受到伤害后，生命值低于最大生命值{Threshold}%的敌人会被处决；若成功处决，则使该敌人周围的敌人陷入<#ef5350ff>{FearTime}秒恐惧<>状态。"
