    "description": {
      "astrologer": {
        "name": "Astroloog",
        "skill": "Laat na <#ffb900ff>{Delay}s<> een meteoor neerkomen op de gekozen locatie, die vijanden in het gebied <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Magische Kracht als <#a974ffff>magische schade<> toebrengt en hun bewegingssnelheid <#ef5350ff>{SlowTime}s<> lang met <#ef5350ff>{Slow}%<> verlaagt.",
        "skill2": "Brengt vijanden in een rechte lijn <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Magische Kracht als <#a974ffff>magische schade<> toe en laat een sterrenbeeldmarkering achter. Het teken houdt <#ffb900ff>{MarkTime}s<> aan, en gemarkeerde vijanden krijgen extra schade van de sterrenbeeldontploffing van de ultimate.",
        "ult": "Tekent een sterrenbeeld in het gekozen gebied en markeert alle vijanden. Na <#ffb900ff>{Delay}s<> ontploffen alle markeringen tegelijk en brengen ze <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Magische Kracht als <#a974ffff>magische schade<> toe. De schade neemt met <#ffb900ff>{Amplify}%<> toe voor elke extra verbonden vijand. Reeds gemarkeerde vijanden krijgen <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> van de vaardigheidskracht als extra schade."
      },
      "archer": {
        "name": "Boogschutter",
        "skill": "Spring in de aangegeven richting en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> toe als <#ff9028ff>fysieke schade<> aan de meest recent aangevallen vijand.",
        "skill2": "Schiet een pijl op een nabije vijand om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen, kort te <#ef5350ff>verdoven<> en achteruit te springen.",
        "ult": "Hij stopt op zijn plaats en vuurt in totaal {Count} pijlen af. De pijl vliegt naar een willekeurige vijand binnen het nabijgelegen bereik van {Range} en veroorzaakt <#ff9028ff>fysieke schade<> gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "bard": {
        "name": "Bard",
        "skill": "Verhoogt de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid van een bondgenoot met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van de vermogenskracht<> gedurende <#ffb900ff>{Duration}s<>.",
        "skill2": "Verlaagt de cooldowns van bondgenoten in het doelgebied met <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van de vermogenskracht<> gedurende {Duration}s.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<> en geeft bondgenoten binnen {Range} bereik <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} aanval<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% van de vermogenskracht<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicPower} vermogenskracht<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<> en {CoolReduce}% cooldownverlaging, maar hun <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pantser daalt met {DefenceReduce}%<> en hun <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>magieweerstand daalt met {MagicResistanceReduce}%<>."
      },
      "barrier_magician": {
        "name": "Barrière magiër",
        "skill": "Creëert een barrière die <#ffb900ff>{Duration}s<> duurt, geeft bondgenoten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% van vaardigheidssterkte<> als <#e8d44dff>schild<> en verlaagt de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid van vijanden met {AttackSpeedReduce}%<>. Vanaf level 3 geeft deze bondgenoten extra <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid<> en <#ef5350ff>vertraagt<> vijanden.",
        "skill2": "Roept een barrière op in het doelgebied die <#ffb900ff>{Duration}s<> duurt en alle projectielen erbinnen vernietigt.",
        "ult": "Creëert een krimpende barrière rond een vijandelijke kampioen. Vijanden die de rand raken krijgen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en worden <#ef5350ff>{Time}s verdoofd<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Word woedend voor {Duration}s, verhoog aanvalssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> en win <#6aff55ff>{Vamp}% levensstel<>.",
        "skill2": "Sla met beide handen op de grond om vijanden in een smal gebied <#ef5350ff>voor {Time}s in de lucht te werpen<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe te brengen.",
        "ult": "{Range} Snelt naar een gerichte vijand binnen een bereik en treft de vijand, waarbij hij <#ff9028ff>fysieke schade<> toebrengt gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht. De afkoeltijd wordt verkort in verhouding tot de verloren <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>gezondheid<>."
      },
      "boomerang_hunter": {
        "name": "Boomerang jager",
        "skill": "Werpt een boemerang in een lijn, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengend. Op maximaal bereik draait hij, brengt continu <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Werpt drie boemerangs die terugkeren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in hun pad.",
        "ult": "Schiet een krachtige boemerang in een rechte lijn, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Bij raken van een vijandelijke kampioen kaatst hij naar de dichtstbijzijnde andere vijandelijke kampioen, schade verhoogt met <#ff9028ff>{Increase}%<> per kaats. Kaatst tot {MaxBounce} keer."
      },
      "chef": {
        "name": "Chef",
        "skill": "Werpt een mes in een lijn, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toebrengend en <#ef5350ff>{Slow}% vertraging gedurende {SlowTime}s<> opleggend.",
        "skill2": "Verspreidt eten naar nabije bondgenoten en herstelt continu <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% van de magische kracht<> aan <#6aff55ff>levenspunten<>. Alleen zelfgenezing verhoogt naar <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% MK<>.",
        "ult": "Gooit speciaal eten naar een bondgenoot. Gedurende <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>verhoogt max HP met {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> van ontvangen schade wordt verspreid als schade over tijd."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleporteert naast een doel. Bij vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en krijgt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<> gedurende <#ffb900ff>{Duration}s<>.",
        "skill2": "Verspreidt dolken rondom, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan vijanden in het gebied. (Kan bewegen tijdens kanalisatie)",
        "ult": "Gaat in razernij gedurende <#ffb900ff>{Time}s<>. Alle dolken worden speciale dolken die tussen vijanden kaatsen."
      },
      "dancer": {
        "name": "Danseres",
        "skill": "Gooi een chakram naar een vijand en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> toe als <#ff9028ff>fysieke schade<>. Elk toegevoegd chakram verhoogt de schade van deze vaardigheid met {StackCoef}%.",
        "skill2": "Elke kill voegt een chakram toe aan basisaanvallen. (Max <#ffb900ff>{MaxCount}<>, schade verlaagt met <#ffb900ff>{Reduce}%<> per extra chakram)",
        "ult": "Schiet {Count}(+stacks) doorborende chakrams in een waaier, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Chakrams keren terug, brengt <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> <#ff9028ff>fysieke schade<> toe. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Donkere magiër",
        "skill": "Schiet een donkere pijl, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vastpint gedurende {Time}s<>.",
        "skill2": "Bedekt een gebied met duisternis na vertraging, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan vijanden binnen.",
        "ult": "Vervloekt een vijandelijke kampioen binnen {Range}, verbindt deze met de dichtstbijzijnde bondgenoot gedurende <#ffb900ff>{Duration}s<>. Wanneer een schade krijgt, wordt <#a974ffff>{ShareRatio}%<> overgedragen naar de ander."
      },
      "demon": {
        "name": "Demon",
        "skill": "Een helse klauw rijst uit de grond om een vijand te grijpen, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen en posities te wisselen.",
        "skill2": "Verander in een grotere demon voor {Time}s. Verhoogt aanval met <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, pantser met <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, aanvalssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> en bewegingssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Brengt <#ff9028ff>fysieke schade<> toe gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht aan alle vijanden binnen {Range} bereik en past <#ef5350ff>angst<> toe gedurende {Time} seconden."
      },
      "dual_blader": {
        "name": "Dubbele zwaardenvechter",
        "skill": "Schiet zwaardenergie in een rechte lijn om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan geraakte vijanden en het doelwit voor {Time}s te <#ef5350ff>wortelen<>.",
        "skill2": "Storm op een <#ef5350ff>immobiele<> vijand in {Range} bereik af, werp de geraakte vijand <#ef5350ff>voor {Time}s in de lucht<> en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe.",
        "ult": "Snijdt een vijand binnen het aangewezen bereik van {Range} af met een zwaard, waarbij {Count} maal <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#f5f5f5ff>vaste schade<> wordt toegebracht."
      },
      "executioner": {
        "name": "Beul",
        "skill": "Schiet een haak om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan een geraakte vijand en hem naar je toe te trekken.",
        "skill2": "Snij een vijand met een haak om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen en <#ef5350ff>{Duration}s te laten bloeden<>. Bloedende vijanden lijden elke {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> en <#ef5350ff>ontvangen {Debuff}% meer schade<>.",
        "ult": "Veegt vijanden in een halfrond gebied vóór {Range} met een haak, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>blokkeert hun herstel voor {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Neutraliseert <#ef5350ff>statuseffecten<> van één bondgenoot en <#6aff55ff>herstelt {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> aan <#6aff55ff>gezondheid<>. Verwijdert verdoving, slaap, vastworteling, angst, charme, provocatie, opwerpen en gedwongen verplaatsing. Verwijdert geen buff-effecten zoals vertraging of gif.",
        "skill2": "Geeft een bondgenoot goddelijke bescherming gedurende <#ffb900ff>{Duration}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval met {Attack}<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<>. Reflecteert controle-effecten terug terwijl actief.",
        "ult": "Creëert een explosie in het doelgebied, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan vijanden. Brengt <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% MK<> bonusschade per buff op het doel toe."
      },
      "fighter": {
        "name": "Vechter",
        "skill": "Stormt naar een doel binnen {Range} met {Speed} snelheid, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#ef5350ff>verdooft gedurende {Stun}s<>.",
        "skill2": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan vijanden binnen {Range} en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden binnen {Range} en <#ef5350ff>lanceert ze {Time}s in de lucht<>."
      },
      "gambler": {
        "name": "Gokker",
        "skill": "Rol een dobbelsteen en val vijanden in {Range} bereik een aantal keren aan gelijk aan het resultaat. Elke aanval brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Gooi een chip om een gebied te creëren binnen {Range} bereik dat vijanden <#ef5350ff>{Slow}% vertraagt<> voor {Time}s in een {AttackRange} gebied. Het gebied explodeert bij afloop en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe aan vijanden erin.",
        "ult": "Vuurt een stapel geld af die vijanden in een rechte lijn charmeert. De getroffen vijand loopt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> op en wordt <#ef5350ff>{Time} seconden gecharmeerd<>."
      },
      "ghost": {
        "name": "Geest",
        "skill": "Wordt onricht­baar en stormt in een lijn. Bij kill/assist krijgt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} aanval<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<> en <#6aff55ff>herstelt {Heal} HP<>.",
        "skill2": "Stormt korte afstand en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan eerste vijand geraakt. Kan tot {Time} keer achtereen worden gebruikt.",
        "ult": "Wordt immuun voor controle-effecten gedurende <#ffb900ff>{Time}s<>. Doden of assisten reset cooldown van basisvaardigheid."
      },
      "gunner": {
        "name": "Schutter",
        "skill": "Kan vijanden aanvallen tijdens bewegen. Vanaf level 3 verhoogt elke aanval bewegingssnelheid met <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> voor {Time}s.",
        "skill2": "Versterk aanvallen voor {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanvalskracht stijgt met {Attack}<>. Elke 3e aanval <#ef5350ff>vertraagt de vijand met {Slow}% voor {SlowTime}s<>.",
        "ult": "De aanval wordt gedurende {Time} seconden versterkt, de aanvalskracht neemt toe met <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> en er worden extra kogels afgevuurd op 2 vijanden rond het aanvalsdoel. Extra kogels veroorzaken <#ff9028ff>fysieke schade<> gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "ice_mage": {
        "name": "Ijsmagiër",
        "skill": "Bevries een vijand om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe te brengen en te <#ef5350ff>verdoven voor {Time}s<>.",
        "skill2": "Roep een ijsveld op voor {Duration}s dat vijanden in {Range} met <#ef5350ff>{MoveSpeed}% loopsnelheid vertraagt<> en elke {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toebrengt. Bevriest en <#ef5350ff>verdooft voor {Stun}s<> aan het eind.",
        "ult": "Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan vijanden in een frontaal kegel en duwt ze terug. <#ef5350ff>Vertraagt {Slow}% gedurende {SlowDuration}s<> en <#ef5350ff>blokkeert bewegingsvaardigheden gedurende {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Schiet een projectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en roept een illusie op die <#ef5350ff>{Time}s tergt<>.",
        "skill2": "Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan vijanden binnen {Range} en <#ef5350ff>angst voor {Time}s<>.",
        "ult": "Creëert een illusie van een nabije bondgenoot die <#ffb900ff>{Duration}s<> duurt. De illusie kan alleen basisaanvallen uitvoeren en heeft dezelfde stats als de gekopieerde kampioen."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Roept een kleine jiangshi op die naar een vijand stormt en 3 keer aanvalt voordat hij verdwijnt, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe per slag.",
        "skill2": "Slaat een vijand om <#ef5350ff>{Time}s te verdoven<>, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#6aff55ff>herstelt {Heal} HP<>.",
        "ult": "Gedurende <#ffb900ff>{Duration}s<>, dranen <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<> <#6aff55ff>HP<> van vijanden binnen {Range} en brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% MK<> <#a974ffff>magische schade<> toe."
      },
      "knight": {
        "name": "Ridder",
        "skill": "Daagt een doel <#ef5350ff>gedurende {Time}s uit<>.",
        "skill2": "Geeft jezelf {Time}s lang een <#e8d44dff>schild<> (<#e8d44dff>schild<>waarde: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> + <#e8d44dff>{Amount}<>). Weerkaatst <#ff9028ff>{Reflect}%<> van de ontvangen schade zolang het schild actief is.",
        "ult": "Roept op de gekozen locatie een verdedigingszone met bereik {Range} op die <#ffb900ff>{Time}s<> duurt. Bondgenoten in de zone krijgen <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<> minder schade, en vijanden in de zone worden met <#ef5350ff>{MoveSpeedReduce}% vertraagd<>."
      },
      "lancer": {
        "name": "Lansier",
        "skill": "Duw vijanden in {Range} terug en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Storm een korte afstand om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe te brengen en achter de vijand te bewegen.",
        "ult": "Laadt een afstand van {Range} op, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden tijdens het opladen en <#ef5350ff>werpt ze {Time}s in de lucht<>."
      },
      "lightning_mage": {
        "name": "Bliksemmagiër",
        "skill": "Schiet bliksem op een doel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe. Springt naar nabije vijanden zonder doelen te dupliceren.",
        "skill2": "Slaat bliksem in een gebied, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>verdooft gedurende {Time}s<>.",
        "ult": "Kanaliseert een bliksemstraal op een vijandelijke kampioen gedurende <#ffb900ff>{Duration}s<>, <#ef5350ff>verdoofd<>. Brengt continu <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan het doel en nabije vijanden."
      },
      "magic_knight": {
        "name": "Magische ridder",
        "skill": "Explodeer mana in een lange smalle lijn om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toe te brengen.",
        "skill2": "Creëer een mana kern voor {Duration}s die vijanden in {Range} elke {Tick}s naar het centrum trekt en <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toebrengt.",
        "ult": "Gedurende <#ffb900ff>{Time}s<> neemt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik toe met {Range}<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<>. Basisaanvallen activeren de eerste vaardigheid."
      },
      "monk": {
        "name": "Monnik",
        "skill": "<#6aff55ff>Herstelt<> bondgenoten binnen {Range} met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>. Bij alleen zelf gericht stijgt de genezing naar <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>.",
        "skill2": "Palm slag om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe te brengen in {Range} en te <#ef5350ff>verdoven voor {Time}s<>.",
        "ult": "Geeft bondgenoten binnen {Range} een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<>. Bondgenoten met een schild krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Roept een ghoul als dienaar op voor <#ffb900ff>{Duration}(+{DurationCoef}% van vaardigheidskracht)s<>. Levels verlagen de afkoeltijd en verhogen de duur van de ghoul met <#ffb900ff>{DurationPerLevel}s<> per level.",
        "skill2": "Markeert een vijand {Time}s lang als aanval doelwit om ghouls razend te maken. Ghouls krijgen <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> aanvalssnelheid en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% van vaardigheidskracht<> bewegingssnelheid.",
        "ult": "Brengt een dode bondgenootkampioen terug als revenant. Zolang de oproep actief is, wordt per seconde <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} gezondheid<> verbruikt."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Schiet een schaduwbol om op een geraakte vijand af te stormen en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen.",
        "skill2": "Storm op een doelwit terwijl ondoelbaar en val drie keer achter elkaar aan, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> per treffer toebrengend.",
        "ult": "Valt aan op een vijand binnen {Range} afstand, waarbij <#ff9028ff>fysieke schade<> wordt toegebracht gelijk aan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van de aanvalskracht."
      },
      "ogre": {
        "name": "Oger",
        "skill": "Elke schade aan een vijandkampioen verhoogt maximale gezondheid met <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value}<>.",
        "skill2": "Sla een enkel doelwit met een knuppel om te <#ef5350ff>verdoven voor {Time}s<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<> als <#ff9028ff>fysieke schade<> toe te brengen.",
        "ult": "Wordt {Time}s lang gigantisch en verhoogt <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximale gezondheid met {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% van maximale gezondheid<>."
      },
      "plague_doctor": {
        "name": "Plaagdokter",
        "skill": "Injecteert een bondgenoot en zichzelf, waardoor <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<> toenemen voor <#ffb900ff>{Duration}s<>.",
        "skill2": "Voert {Duration}s lang een ritueel uit op een bondgenoot, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% van vaardigheidskracht<> en voegt een dash toe aan aanvallen.",
        "ult": "Dient een verboden elixer toe aan een bondgenoot en vermindert huidige gezondheid met {HpReduceRatio}%, maar {Duration}s lang kan gezondheid niet onder 1 komen; <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval neemt toe met {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% van vaardigheidskracht<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<>."
      },
      "poison_dart_hunter": {
        "name": "Gifpijl jager",
        "skill": "Verspreidt een vergifveld, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe, vergiftigt gedurende <#ffb900ff>{Duration}s<> en <#ef5350ff>vertraagt {Slow}%<>.",
        "skill2": "Aanvallen op vergiftigde vijanden verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Range}<>. Wegbewegen van vergiftigde vijanden verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<>.",
        "ult": "Geeft nabije bondgenoten gif op aanvallen gedurende <#ffb900ff>{Duration}s<>. Gif brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe gedurende <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Priester",
        "skill": "Plaats een genezingsveld voor {Duration}s in {Range} dat elke {Tick}s <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> aan <#6aff55ff>levenspunten herstelt<> bij bondgenoten.",
        "skill2": "Geef een bondgenoot een <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> <#e8d44dff>schild<> voor {Time}s. <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Verhoogt hun aanvalssnelheid met {AttackSpeed}%<> terwijl het schild duurt.",
        "ult": "Vliegt {Time}s in de lucht en wordt stationair, schiet elke {Tick}s een kogel die <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#6aff55ff>HP<> herstelt aan de bondgenoot met laagste HP binnen ulti-bereik."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Laat een vuurbal vallen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe binnen {Range}.",
        "skill2": "Roept vuurveld op dat {Duration}s duurt, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe elke {Tick}s binnen {Range}.",
        "ult": "Creëert massieve explosie binnen {Range}, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan alle vijanden."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Herstelt de <#6aff55ff>levenspunten<> van een bondgenoot met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<>.",
        "skill2": "<#6aff55ff>Herstelt<> de levenspunten van een bondgenoot met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> en brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toe aan vijanden in {Range} om hen heen.",
        "ult": "Roept een Geestenpoort op. De Geestenpoort vuurt projectielen af die bondgenoten in {Range} <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidssterkte<> gezondheid <#6aff55ff>herstellen<>, of vijanden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% van vaardigheidssterkte<> als <#a974ffff>magische schade<> toebrengen."
      },
      "shadowmancer": {
        "name": "Schaduwmagiër",
        "skill": "Donkere schaduwen rijzen op, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vastpint {Time}s<>.",
        "skill2": "Laat schaduw van geïmmobiliseerde vijand exploderen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe.",
        "ult": "Schiet doorborend schaduwprojectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan geraakte kampioenen en <#ef5350ff>verbant {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Schilddrager",
        "skill": "Geef een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% max. HP<> aan een bondgenoot en jezelf voor {Duration}s.",
        "skill2": "Neemt {Duration}s lang {Damage}% van de schade aan nabije bondgenoten over en <#ef5350ff>vertraagt aanvallers met {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% van pantser<>.",
        "ult": "Krijgt {Duration}s lang <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% van magieweerstand<> schadevermindering en immuniteit tegen controle-effecten, terwijl alle nabije vijanden <#ef5350ff>{TauntDuration}s worden uitgedaagd<>. Kan tijdens de werking niet bewegen."
      },
      "soldier": {
        "name": "Soldaat",
        "skill": "Aanvalsbereik neemt toe met <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> per level.",
        "skill2": "Schiet drie kogels op een vijand voor zware <#ff9028ff>fysieke schade<> (<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade per kogel). Vaardigheidsbereik schaalt met basis aanvalsbereik.",
        "ult": "Vuurt een enorme kogel af die in een rechte lijn vliegt en zich op vijanden binnen {Range} afstand richt. De kogel brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden binnen het passerende traject, en elke keer dat hij een vijand raakt, wordt de schade verminderd met {Decay}%."
      },
      "swordman": {
        "name": "Zwaardvechter",
        "skill": "Schiet zwaardenergie om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen aan geraakte vijanden (bereik {Range}).",
        "skill2": "Snij een enkel doelwit drie keer achter elkaar voor zware <#ff9028ff>fysieke schade<>. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade per treffer.",
        "ult": "Laadt een afstand van {Range} in een rechte lijn op, waardoor <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> wordt toegebracht aan vijanden binnen het oplaadbereik. Als je een vijand doodt met je ultieme, wordt de cooldown van je ultieme gereset."
      },
      "taoist": {
        "name": "Taoïst",
        "skill": "Verzegelt een vijand met een talisman, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> als <#a974ffff>magische schade<> toe en voorkomt <#ef5350ff>basisaanvallen gedurende {Time}(+{TimeCoef}% van vaardigheidskracht)s<>.",
        "skill2": "Bevestigt een talisman aan een vijand, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> als <#a974ffff>magische schade<> toe en voorkomt <#ef5350ff>het gebruik van vaardigheden gedurende {Time}(+{TimeCoef}% van vaardigheidskracht)s<>.",
        "ult": "Schiet talisman-projectiel in rechte lijn. Brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe en <#ef5350ff>maakt doel {Time}s onbruikbaar<>, onricht­baar. Wanneer effect eindigt, verspreidt het naar nabije vijanden."
      },
      "vampire": {
        "name": "Vampier",
        "skill": "Zuig bloed van een vijand om <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toe te brengen, <#6aff55ff>{Heal}<> gezondheid te <#6aff55ff>herstellen<> en te stapelen. Genezing neemt toe met {Stack} per stapel.",
        "skill2": "Consumeer {Value}% gezondheid om bloed in een voorwaartse kegel te spuwen, <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> van vaardigheidssterkte als <#a974ffff>magische schade<> toebrengend. Schade neemt toe met {Stack} per stapel.",
        "ult": "Wordt onrichtbaar en stormt een afstand van {Range}, <#6aff55ff>absorbeert gezondheid<> gelijk aan <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidssterkte<> van elke vijand in het stormtraject, en veroorzaakt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% vaardigheidssterkte<> als <#a974ffff>magische schade<>."
      },
      "werewolf": {
        "name": "Weerwolf",
        "skill": "Klauwt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#6aff55ff>geneest {HealRatio}% van toegebrachte schade<>.",
        "skill2": "Stormt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<>, brengt herhaaldelijk <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en past <#ef5350ff>bloeden voor {BleedTime}s<> toe (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Verstrekt knuppel <#ffb900ff>{Duration}s<>. Elke aanval creëert een schokgolf in waaier die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toebrengt.",
        "skill2": "Versterkt de huid voor <#ffb900ff>{Duration}s<>, krijgt een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> en <#e8d44dff>{DamageReduction}% schadevermindering<>.",
        "ult": "Schiet projectiel in rechte lijn. Geraakte vijanden worden <#ef5350ff>geleidelijk vertraagd over {SlowTime}s<>, dan <#ef5350ff>vastgepind {BindTime}s<>. Bij vastpinnen brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan nabije vijanden. Effect verspreidt naar beschadigde vijanden."
      },
      "hammerer": {
        "name": "Zware infanterie",
        "skill": "Zwaai een hamer naar een nabije vijand om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen en <#ef5350ff>voor {Time}s in de lucht te werpen<>.",
        "skill2": "Concentreer met de hamer geheven, sla dan op de grond om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen in {Range} en <#ef5350ff>{Move}% vertraging te geven voor {Time}s<>.",
        "ult": "Zwaai de hamer breed en breng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden in een halfcirkelvormig gebied binnen een bereik van {Range} vooraan. Vijanden geraakt door de hamer worden {Time}s teruggeslagen, en vijandelijke kampioenen geraakt door de geduwde vijand <#ef5350ff>blijven {Airborne}s in de lucht<>."
      },
      "inquisitor": {
        "name": "Inquisiteur",
        "skill": "Stormt korte afstand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan eerste vijand geraakt en past <#ef5350ff>bloeden<> toe.",
        "skill2": "Snijdt doelvijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Reset cooldown van Vaardigheid 1 indien <#ef5350ff>bloedend<>.",
        "ult": "Stormt naar vijandelijke kampioen, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied bij aankomst. Vijanden onder {Threshold}% max HP na schade worden geëxecuteerd. Bij executie worden nabije vijanden <#ef5350ff>{FearTime}s bang<>."
      },
      "pole_warrior": {
        "name": "Pool strijder",
        "skill": "Spring op een vijand en sla met de pool om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> van aanvalsschade als <#ff9028ff>fysieke schade<> toe te brengen.",
        "skill2": "Beweeg een korte afstand, sta op de pool om ondoelbaar te worden voor {Time}s, zwaai dan om <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalskracht<> als <#ff9028ff>fysieke schade<> toe te brengen aan alle vijanden in {Range}.",
        "ult": "Valt aan op een aangewezen vijand binnen {Range} bereik, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van de aanvalskracht<> als <#ff9028ff>fysieke schade<> toe aan de vijand en <#ef5350ff>tilt het doelwit gedurende {Time}s de lucht in<>."
      },
      "spirit_caller": {
        "name": "Geest oproeper",
        "skill": "Plakt een geest aan een bondgenoot <#ffb900ff>{Duration}s<>, <#6aff55ff>herstelt levenspunten<> met <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% MK<> en verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {SpeedUp}%<>.",
        "skill2": "Hecht {Duration}s lang een geest aan een vijand, verlaagt <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>pantser met {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% van vaardigheidskracht<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>magieweerstand met {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% van vaardigheidskracht<> en <#ef5350ff>vertraagt met {Slow}%<>.",
        "ult": "Detoneert geplakte geesten. Bondgenote geesten geven <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% MK<> <#e8d44dff>schild<> en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<>. Vijandelijke geesten brengen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% van magische kracht<> als <#a974ffff>magische schade<> toe en <#ef5350ff>verdoven {StunTime}s<>."
      },
      "whip_master": {
        "name": "Zweep meester",
        "skill": "Zwaait zweep, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% doel HP<> toe.",
        "skill2": "Zwaait zweep in kegel, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe en duwt vijanden terug.",
        "ult": "Kanaliseert <#ffb900ff>{Duration}s<>, schiet doorborende projectielen die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengen."
      },
      "enchanter": {
        "name": "Betoveraar",
        "skill": "Verstrekt bondgenoot <#ffb900ff>{Duration}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>bereik met {Increase}<>.",
        "skill2": "Verstrekt bondgenote uitrusting <#ffb900ff>{Duration}s<>, verhoogt voorwerpsstats met <#ffb900ff>{Percent}%<>.",
        "ult": "Versterkt bondgenoot {Duration}s, geeft <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% MK<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid {MoveSpeed}%<> en immuniteit voor controle-effecten."
      },
      "siege_breaker": {
        "name": "Belegering breker",
        "skill": "Slaat ploerendorser, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe. Brengt {Bonus}% bonus schade toe aan structuren.",
        "skill2": "Slaat de grond, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden inclusief structuren.",
        "ult": "Gedurende {Time}s, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aanval met {Attack}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AttackSpeed}%<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Gevangene",
        "skill": "Werpt ijzeren bal in lijn, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied.",
        "skill2": "Brult om {Time}s lang een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> te krijgen en alle nabije vijanden te <#ef5350ff>provoceren<>.",
        "ult": "Stormt naar vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden nabij landingspunt en <#ef5350ff>verdooft {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Schiet een schokgolf in rechte lijn. De schokgolf explodeert in een cirkel bij vijandtreffer of bereikseinde en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt vijanden met {Slow}% voor {Time}s<>.",
        "skill2": "Geeft zichzelf {Time}s lang een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<>. Wanneer het schild verdwijnt, worden vijanden binnen {Range} bereik <#ef5350ff>{StunTime}s verdoofd<>.",
        "ult": "Geeft een gekozen bondgenoot binnen {Range} bereik een <#e8d44dff>schild<> van <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% van maximale gezondheid<> en teleporteert na {Time}s naar die bondgenoot."
      },
      "white_mage": {
        "name": "Witte magiër",
        "skill": "Een straal explodeert na vertraging, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe aan alle vijanden.",
        "skill2": "Roept stralen op om 5 keer aan te vallen, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>.",
        "ult": "Schiet doorborende straal, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<> als <#a974ffff>magische schade<> toe aan geraakte vijanden en <#ef5350ff>vastpint {Time}s<>."
      },
      "wind_mage": {
        "name": "Windmagiër",
        "skill": "Roept wervelwind op <#ffb900ff>{Duration}s<>, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe elke {Tick}s binnen {Range}. Bondgenoten erin krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>.",
        "skill2": "Schiet vijf wervelwinden naar voren, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe.",
        "ult": "Lanceert massieve tornado. Geraakte vijanden krijgen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en zijn <#ef5350ff>{AirborneTime}s in de lucht<>. Grootte, schade en luchttijd verlagen per slag. Stuurt door naar andere kampioenen."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Werpt een bom, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toe aan alle vijanden in gebied.",
        "skill2": "Plaatst onzichtbare mijn die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> <#ff9028ff>fysieke schade<> toebrengt en <#ef5350ff>{Time}s vastpint<> wanneer erop gestapt. Wordt niet getriggerd door minions.",
        "ult": "Werpt grote bom op doelgebied, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan alle vijanden en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Cavalerie ridder",
        "skill": "Storm in een rechte lijn om de eerste geraakte vijand te <#ef5350ff>wortelen voor {Time}s<> en <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe te brengen. Storm snelheid schaalt met bewegingssnelheid.",
        "skill2": "Verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<> voor {Time}s en versterkt het wapen tot een vuurlans, waardoor aanvallen {BurnTime}s lang extra <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% van aanvalsschade<> brandschade toebrengen.",
        "ult": "Verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% van aanvalsschade<> voor {Time}s en creëert een zone die naar je positie leidt. Bondgenoten op de zone krijgen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% van aanvalsschade<> bewegingssnelheid wanneer ze richting de cavalerie bewegen."
      },
      "druid": {
        "name": "Druïde",
        "skill": "Roept een beer op. Als deze sterft, krijgt de druïde <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% MK<> schade. Tijdens opgeroepen casten <#6aff55ff>geneest<> beer met <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<>.",
        "skill2": "Roept een adelaar op. Als de adelaar sterft, krijgt de druïde schade. Als deze vaardigheid wordt gebruikt terwijl de adelaar is opgeroepen, stormt de adelaar op een vijand af, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> toe als <#a974ffff>magische schade<> en <#6aff55ff>geneest voor {Lifesteal}% van de toegebrachte schade<>.",
        "ult": "Vuurt {Count} beren- en adelaarszielen achter elkaar in de gekozen richting. Elk projectiel brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van vaardigheidskracht<> toe als <#a974ffff>magische schade<> en duwt vijanden terug."
      },
      "voodoo_shaman": {
        "name": "Voodoo sjamaan",
        "skill": "Schiet vloek-projectiel, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe, <#ef5350ff>vertraagt {Slow}% gedurende {Time}s<> en verlaagt <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>aanvalssnelheid met {AtkSpd}%<> gedurende <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Vervloekt vijand <#ffb900ff>{Time}s<>, brengt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toe. Brengt <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% MK<> bonus schade toe per ontvangen slag (max {Max}).",
        "ult": "Creëert voodoo-zone <#ffb900ff>{Duration}s<>. Vijanden binnen krijgen periodiek <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% max HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> en zijn <#ef5350ff>gestil<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Schiet een drieschots-burst. Het eerste schot <#ef5350ff>verdooft {StunTime}s<>, en de volgende twee schoten brengen elk <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe.",
        "skill2": "Teleporteert achter de meest recent aangevallen vijandelijke kampioen binnen <#ffb900ff>{Range}<> bereik.",
        "ult": "Markeert een vijandelijke kampioen. Na <#ffb900ff>{Duration}s<> wordt <#ff9028ff>{Damage} + {Coef}% van de tijdens de markering ontvangen schade<> toegebracht als <#ff9028ff>fysieke schade<>. Bij een kill krijg je <#ffb900ff>{InvisibleDuration}s<> stealth."
      },
      "guardian_spirit": {
        "name": "Geestbeschermer",
        "skill": "<#6aff55ff>Herstelt levenspunten<> van nabije bondgenoten met <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van magische kracht<>.",
        "skill2": "Geeft bondgenoot <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% MK<> <#e8d44dff>schild<> en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>.",
        "ult": "Creëert <#ffb900ff>{Duration}s<> lang een heiligdom dat bondgenoten binnen bereik voortdurend <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% MK<> <#6aff55ff>geneest<>. Als 1 geallieerde kampioen in het heiligdom sterft, wordt die herleefd en eindigt het heiligdom direct."
      },
      "hunter": {
        "name": "Jager",
        "skill": "Teleporteert naar een vijand en schakelt naar afstandsmodus. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Bereik verhoogt met {RangeIncrease}<>.",
        "marks": "Basisaanvallen op afstand markeren vijandelijke kampioenen gedurende <#ffb900ff>{Duration}s<>. Nieuwe treffers vernieuwen bestaande markeringen. De tweede vaardigheid kan vijanden met 3 markeringen als doelwit kiezen.",
        "skill2": "Stormt naar 3-stack gemarkeerde vijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>stilt {SilenceTime}s<>.",
        "ult": "Stormt naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan vijanden in het pad. Na het casten kan deze korte tijd eenmaal opnieuw worden gecast; bij kill of assist kan deze nog eenmaal opnieuw worden gecast."
      },
      "circus_blade": {
        "name": "Circusmes",
        "skill": "Schiet mes in doelrichting, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt {Slow}% gedurende {SlowTime}s<>. Slaat tot <#ffb900ff>{ChargeCount}<> ladingen op. Krijgt <#ffb900ff>1<> lading bij basisaanval op vijandelijke kampioenen.",
        "skill2": "Krijgt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% bewegingssnelheid<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% aanvalssnelheid<> en muurfasing gedurende <#ffb900ff>{Duration}s<>.",
        "ult": "Stormt naar doelvijand, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Brengt <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% AD<> splash schade toe en <#ef5350ff>duwt nabije vijanden terug<>, dan verdwijnt."
      },
      "sand_mage": {
        "name": "Zandmagiër",
        "skill": "Basisaanvallen dragen zandenergie en richten <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% vaardigheidskracht<> als <#a974ffff>bonus magische schade<> aan. Deze bonusschade en de zandexplosie kunnen kritisch treffen. Bij gebruik ontploft zand rond het doel en richt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidskracht<> als <#a974ffff>magische gebiedsschade<> aan.",
        "skill2": "Absorbeert zandenergie gedurende <#ffb900ff>{Time}s<>, verhoogt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>bewegingssnelheid met {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% vaardigheidskracht<> en <#6aff55ff>geneest zichzelf<> voor <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% vaardigheidskracht<>.",
        "ult": "Creëert een zandmoeras rond het doel gedurende <#ffb900ff>{Duration}s<>. Elke {Tick}s krijgen vijanden erin <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidskracht<> als <#a974ffff>magische schade<> en worden ze naar het midden getrokken."
      },
      "alchemist": {
        "name": "Alchemist",
        "skill": "Gooit een fles die ontploft en <#ffb900ff>{Time}s<> een giftige plas achterlaat. Vijanden in de plas worden <#ffb900ff>{DotTime}s<> <#78e85cff>vergiftigd<>, krijgen elke {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidskracht<> als <#a974ffff>magische schade<> en ontvangen {HealReduce}% minder genezing.",
        "skill2": "Injecteert één vijand met een instabiel reagens en richt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidskracht<> als <#a974ffff>magische schade<> aan. Gedurende <#ffb900ff>{Time}s<> kan het doel niet worden genezen en wordt het met {Slow}% vertraagd.",
        "ult": "Gooit een giftige fles in een lijn. Als hij een vijandelijke kampioen raakt, ontstaat er gedurende <#ffb900ff>{CloudTime}s<> een gifwolk die uitzet tot {CloudRadius} bereik. Vijanden in de wolk worden <#ffb900ff>{DotTime}s<> <#78e85cff>vergiftigd<>, krijgen elke {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% vaardigheidskracht<> als <#a974ffff>magische schade<> en verliezen <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% vaardigheidskracht<> pantser en <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% vaardigheidskracht<> magieweerstand."
      },
      "crossbowman": {
        "name": "Kruisboogschutter",
        "skill": "Vuurt een krachtige pijl in een lijn af en richt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% aanvalsschade<> als <#ff9028ff>fysieke schade<> aan de eerste geraakte vijandelijke kampioen aan. Zolang de ultieme markering duurt, richt hij extra <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% aanvalsschade<> aan.",
        "skill2": "Vuurt een doordringende pijl recht vooruit af, richt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% aanvalsschade<> als <#ff9028ff>fysieke schade<> aan vijanden aan en veert <#ffb900ff>{BackstepTime}s<> achteruit. Zolang de ultieme markering duurt, richt hij extra <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% aanvalsschade<> aan.",
        "ult": "Vuurt een tracer in een lijn af, richt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% aanvalsschade<> als <#ff9028ff>fysieke schade<> aan de eerste geraakte vijandelijke kampioen aan en markeert die voor <#ffb900ff>{Duration}s<>. Zolang de markering duurt, raken alle vaardigheden het doel ongeacht afstand en worden hun cooldowns met <#ffb900ff>{CoolReduce}%<> verminderd. Andere kampioenen op de baan kunnen de treffer onderscheppen."
      },
      "nightmare": {
        "name": "Nachtmerrie",
        "skill": "Vuurt een nachtmerriescherf in een rechte lijn af en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan de eerste geraakte vijand. Kan maximaal <#ffb900ff>{UseCount} keer<> achter elkaar worden gebruikt.",
        "skill2": "Snelt <#ffb900ff>{Range}<> in de gekozen richting, brengt daarna <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe aan vijanden binnen <#ffb900ff>{Radius}<> en wordt <#ffb900ff>{StealthTime} seconden<> onzichtbaar.",
        "ult": "Snelt naar de gekozen vijandelijke kampioen en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Als deze schade het doel doodt, teleporteert hij ongeacht afstand naast een levende geallieerde kampioen."
      },
      "strongman": {
        "name": "Sterke Man",
        "skill": "Grijpt één vijand in de buurt, werpt die over zijn schouder achter zich en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe, waarbij het doel <#ef5350ff>{Stun} sec. wordt verdoofd<>.",
        "skill2": "Zwaait zijn halter in een wijde boog, brengt vijanden binnen <#ffb900ff>{Range}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>slaat ze terug<>.",
        "ult": "Werpt één geallieerde kampioen in de buurt naar de gekozen locatie. Na de landing krijgt de geworpen bondgenoot <#ffb900ff>{ShieldTime} sec.<> lang een <#e8d44dff>schild van {Shield}<>. Vijanden binnen <#ffb900ff>{Radius}<> van de landingsplek lopen <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> op en worden <#ef5350ff>{Stun} sec. verdoofd<>. Als er geen bondgenoot in de buurt is om te werpen, springt de Sterke Man zelf; dan duurt de verdoving <#ef5350ff>{SelfStun} sec.<>."
      },
      "harpooner": {
        "name": "Harpoenier",
        "skill": "Vuurt een harpoen in een rechte lijn af en brengt de eerste getroffen vijandelijke kampioen <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Na een treffer kan de vaardigheid <#ffb900ff>{RecastDuration}s<> lang opnieuw worden geactiveerd om zichzelf naar het doel of het doel naar zichzelf toe te trekken.",
        "skill2": "Vuurt een krachtige harpoen in een rechte lijn af en brengt de eerste getroffen vijand <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> van de ontbrekende Gezondheid van het doel als <#ff9028ff>fysieke schade<> toe.",
        "ult": "Vuurt <#ffb900ff>{ProjectileCount}<> kettingharpoenen in een kegel naar voren af, brengt getroffen vijanden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en bindt hen <#ffb900ff>{LinkDuration}s<>. Gebonden vijanden worden <#ef5350ff>{Slow}%<> vertraagd. Gaan ze verder dan <#ffb900ff>{LinkRange}<> uit elkaar, dan spannen de kettingen zich: de vertraging stijgt naar <#ef5350ff>{TensionSlow}%<> en ze worden naar elkaar toe getrokken."
      },
      "spellbreaker": {
        "name": "Spreukbreker",
        "skill": "Zwaait het grootzwaard naar voren, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van Aanval<> <#ff9028ff>fysieke schade<> toe en <#ef5350ff>vertraagt {Time} seconden lang met {Slow}%<>.",
        "skill2": "Stormt een korte afstand vooruit en brengt de eerste getroffen vijand <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van Aanval<> <#ff9028ff>fysieke schade<> toe. Daarna wordt <#ffb900ff>ontvangen schade {Time} seconden lang met {Reduce}% verminderd<>.",
        "ult": "Vernietigt onmiddellijk alle schilden van vijanden binnen <#ffb900ff>{Range}<>. Een vijand wiens schild wordt vernietigd, krijgt <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% van Magische Kracht<> <#a974ffff>magische schade<>, wordt <#ef5350ff>{Stun} seconden verdoofd<> en kan <#ffb900ff>{BlockTime} seconden lang geen schild krijgen<>. Vijanden zonder schild krijgen alleen <#a974ffff>{Damage} magische schade<>."
      },
      "gladiator": {
        "name": "Gladiator",
        "skill": "Werpt een net in een waaier van <#ffb900ff>{FanAngle}°<>, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en zet vijanden <#ffb900ff>{Stun}s<> lang <#ef5350ff>vast<>.",
        "skill2": "Steekt met de drietand naar voren en brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Dezelfde kampioen opnieuw raken binnen <#ffb900ff>{Time}s<> voegt <#ffb900ff>{Amplify}%<> schade per stapel toe, tot <#ffb900ff>{MaxAmplifyTargets}<> stapels. Een andere kampioen raken reset de stapels.",
        "ult": "Stormt op een vijandelijke kampioen af, brengt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en <#ef5350ff>daagt<> hem <#ffb900ff>{Stun}s<> lang uit. Tijdens het duel kan het doel niet genezen of nieuwe schilden krijgen, en ontvangt de Gladiator <#ffb900ff>{Amplify}%<> minder schade van andere vijanden. Het duel eindigt als de uitdaging wordt gezuiverd of het doel sterft."
      },
      "ferryman": {
        "name": "Veerman",
        "skill": "Werpt een anker dat de eerste kampioen op zijn pad raakt. Een bondgenoot met maximaal <#ffb900ff>{AllyHpRatio}%<> levenspunten wordt naar de Veerman getrokken en krijgt <#ffb900ff>{Time}s<> lang <#ffb900ff>{Amplify}%<> bewegingssnelheid. Gezondere bondgenoten worden gepasseerd. Vijanden lopen in plaats daarvan <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> op en worden <#ffb900ff>{SlowTime}s<> lang met <#ffb900ff>{Slow}%<> vertraagd.",
        "skill2": "Creëert vooruit <#ffb900ff>{Time}s<> lang een rivier van <#ffb900ff>{Range}<> lang en <#ffb900ff>{Width}<> breed. Bondgenoten erop krijgen <#ffb900ff>{Amplify}%<> bewegingssnelheid, vijanden worden met <#ffb900ff>{Slow}%<> vertraagd.",
        "ult": "Zuivert een andere bondgenootkampioen met maximaal <#ffb900ff>{AllyHpRatio}%<> levenspunten en vaart hem in <#ffb900ff>{Time}s<> <#ffb900ff>{MoveDistance}<> richting de eigen basis. De passagier is ondoelbaar, kan niet handelen en is immuun voor verplaatsingseffecten. Bij aankomst herstelt hij <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% MK<> levenspunten en krijgt hij <#ffb900ff>{SlowTime}s<> lang <#ffb900ff>{Slow}%<> bewegingssnelheid."
      },
      "bombardier": {
        "name": "Kanonnier",
        "skill": "Stelt het kanon op of breekt het af. Opgesteld kan hij niet bewegen, maar het bereik van zijn basisaanvallen en vaardigheid 2 neemt toe met <#ffb900ff>{MoveDistance}<> en hij krijgt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% aanval<>. Na het afbreken krijgt hij <#ffb900ff>{Time}s<> lang <#ffb900ff>{Slow}%<> bewegingssnelheid.",
        "skill2": "Vuurt een granaat in een boog naar de doellocatie, brengt vijanden binnen een straal van <#ffb900ff>{Radius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe en vertraagt ze <#ffb900ff>{SlowTime}s<> lang met <#ffb900ff>{Slow}%<>. Opgesteld neemt het bereik toe.",
        "ult": "Vuurt <#ffb900ff>{ProjectileCount}<> granaten af op het gekozen gebied. Elke granaat brengt binnen een straal van <#ffb900ff>{ProjectileRadius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% van aanvalsschade<> als <#ff9028ff>fysieke schade<> toe. Opgesteld neemt het bereik extra toe met <#ffb900ff>{MoveDistance}<>. Controle-effecten onderbreken de resterende schoten."
      },
      "hypnotist": {
        "name": "Hypnotiseur",
        "skill": "Werpt een doorborende slinger naar voren die <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% MK<> <#a974ffff>magische schade<> toebrengt en <#ffb900ff>{SlowTime}s<> lang met <#ffb900ff>{Slow}%<> vertraagt. Deze schade wekt <#ef5350ff>slapende<> vijanden niet.",
        "skill2": "Brengt na <#ffb900ff>{Delay}s<> vijanden binnen een straal van <#ffb900ff>{Radius}<> <#ffb900ff>{Time}s<> lang in <#ef5350ff>slaap<>. Slapende doelen kunnen niet bewegen of handelen. Schade, ook schade over tijd, wekt het doel, en die eerste treffer doet <#ffb900ff>{Amplify}%<> meer schade.",
        "ult": "Brengt na <#ffb900ff>{Delay}s<> vijanden binnen een straal van <#ffb900ff>{Radius}<> <#ffb900ff>{Time}s<> lang in <#ef5350ff>slaap<>. Schade wekt het doel, en de wekkende treffer doet <#ffb900ff>{Amplify}%<> meer schade. Zuivering verwijdert zowel de <#ef5350ff>slaap<> als de schadebonus."
      }
    }
  },
