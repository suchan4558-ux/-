    "description": {
      "astrologer": {
        "name": "Astrologer",
        "skill": "Astrologer giáng một thiên thạch xuống vị trí chỉ định sau <#ffb900ff>{Delay} giây<>, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên các kẻ địch trong phạm vi và giảm <#ef5350ff>{Slow}%<> Tốc Độ Di Chuyển của chúng <#ef5350ff>trong {SlowTime} giây<>.",
        "skill2": "Astrologer bắn ra luồng sáng tinh tú, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{LinkDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên các kẻ địch và để lại dấu ấn tinh tú. Dấu ấn tồn tại <#ffb900ff>trong {MarkTime} giây<>, khiến mục tiêu trúng dấu ấn chịu thêm sát thương từ vụ nổ của Vũ Trụ Thống Nhất.",
        "ult": "Astrologer vẽ một chòm sao lên vùng chỉ định, đánh dấu tất cả kẻ địch. Sau <#ffb900ff>{Delay} giây<>, cô đồng loạt kích nổ các dấu ấn, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Với mỗi kẻ địch bị liên kết, sát thương sẽ tăng thêm <#ffb900ff>{Amplify}%<>. Những mục tiêu đã mang dấu ấn từ Liên Kết Tinh Tú sẽ phải chịu thêm sát thương bằng <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> SMPT."
      },
      "archer": {
        "name": "Archer",
        "skill": "Archer nhảy về hướng chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch vừa bị tấn công.",
        "skill2": "Archer bắn một mũi tên vào kẻ địch ở gần, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>, <#ef5350ff>Làm Choáng<> mục tiêu trong chốc lát và nhảy lùi lại phía sau.",
        "ult": "Archer đứng yên tại chỗ và bắn ra tổng cộng {Count} mũi tên. Mũi tên bay về phía các kẻ địch ngẫu nhiên trong phạm vi {Range} xung quanh cô ấy, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "bard": {
        "name": "Bard",
        "skill": "Bard cất tiếng đàn, giúp tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tốc Độ Đánh bằng {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho một đồng minh trong <#ffb900ff>{Duration} giây<>.",
        "skill2": "Bard đánh nốt cao trào, làm giảm Thời gian Hồi chiêu cho các đồng minh đi <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> trong {Duration} giây trong phạm vi chỉ định.",
        "ult": "Bard thực hiện bài chiến ca trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<> (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% SMPT<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicPower} Sức Mạnh Phép Thuật<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>, và giảm {CoolReduce}% Thời gian Hồi chiêu cho các tướng đồng minh xung quanh trong phạm vi {Range}, nhưng làm giảm <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}% Giáp<> và <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}% Kháng Phép<> của họ."
      },
      "barrier_magician": {
        "name": "Barrier Magician",
        "skill": "Barrier Magician tạo một kết giới tại khu vực chỉ định, duy trì trong <#ffb900ff>{Duration} giây<>, tạo một <#e8d44dff>Lá chắn<> bằng <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% SMPT<> cho các đồng minh bên trong kết giới và giảm <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeedReduce}% Tốc Độ Đánh<> của kẻ địch. Từ cấp 3, tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tốc Độ Đánh<> cho đồng minh bên trong kết giới và <#ef5350ff>Làm Chậm<> kẻ địch.",
        "skill2": "Barrier Magician triệu hồi một kết giới tại khu vực chỉ định, duy trì trong <#ffb900ff>{Duration} giây<>, vô hiệu hoá tất cả đạn bay bên trong kết giới đó.",
        "ult": "Barrier Magician tạo ra một kết giới thu hẹp dần xung quanh tướng địch. Kẻ địch chạm vào rìa kết giới sẽ phải chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và bị <#ef5350ff>Làm Choáng trong {Time} giây<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Berserker tiến vào trạng thái Cuồng nộ trong {Duration} giây, tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và nhận <#6aff55ff>{Vamp}% Hút Máu<>.",
        "skill2": "Berserker bổ hai cây vũ khí xuống đất, <#ef5350ff>Hất Tung kẻ địch trong {Time} giây<> trong phạm vi hẹp và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> .",
        "ult": "Berserker lao tới một kẻ địch chỉ định trong phạm vi {Range}, chém mạnh xuống mục tiêu và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Thời gian Hồi chiêu giảm đi tỉ lệ thuận với lượng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>Máu<> đã mất."
      },
      "boomerang_hunter": {
        "name": "Boomerang Hunter",
        "skill": "Boomerang Hunter ném Boomerang theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Khi bay đến tầm tối đa, Boomerang sẽ xoay tại chỗ trong một khoảng thời gian, liên tục gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% SMCK<> lên những kẻ địch chạm phải.",
        "skill2": "Boomerang Hunter ném ra 3 Boomerang. Chúng sẽ bay đến điểm cuối rồi quay lại, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trên đường bay.",
        "ult": "Boomerang Hunter ném ra một chiếc Boomerang quyền năng theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Khi trúng một tướng địch, Boomerang sẽ nảy về hướng tướng địch khác gần nhất. Mỗi lần nảy, sát thương tăng thêm <#ff9028ff>{Increase}%<>. Nảy tối đa {MaxBounce} lần."
      },
      "chef": {
        "name": "Chef",
        "skill": "Chef ném ra con dao phay theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "skill2": "Chef chia sẻ thức ăn cho các đồng minh xung quanh, liên tục <#6aff55ff>Hồi Máu<> một lượng bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%SMPT<>. Nếu chỉ hồi máu cho bản thân, lượng hồi phục tăng lên thành <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% SMPT<>.",
        "ult": "Chef nấu một món ăn thượng hạng cho một tướng đồng minh, tăng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% Máu Tối Đa<> trong <#ffb900ff>{Duration} giây<>. Phân tán <#e8d44dff>{SpreadRatio}%<> sát thương gánh chịu thành sát thương theo thời gian."
      },
      "clown": {
        "name": "Clown",
        "skill": "Clown dịch chuyển đến bên cạnh mục tiêu chỉ định, nếu mục tiêu là kẻ địch sẽ gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<> cho ả trong <#ffb900ff>{Duration} giây<>.",
        "skill2": "Clown ném những con dao găm ra xung quanh, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi. (Có thể di chuyển trong khi thi triển)",
        "ult": "Clown tiến vào trạng thái Cuồng Loạn trong <#ffb900ff>{Time} giây<>, cường hoá toàn bộ dao găm của mình có khả năng nảy giữa các kẻ địch."
      },
      "dancer": {
        "name": "Dancer",
        "skill": "Dancer ném Chakram vào kẻ địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Với mỗi Chakram cộng thêm, sát thương của kỹ năng này tăng thêm {StackCoef}%.",
        "skill2": "Đòn đánh thường của Dancer được tích thêm 1 Chakram mỗi lần tiêu diệt kẻ địch. (Tối đa <#ffb900ff>{MaxCount}<> cái, khi tấn công liên tiếp bằng các Chakram cộng thêm sẽ giảm <#ffb900ff>{Reduce}%<> sát thương mỗi đòn)",
        "ult": "Dancer phóng ra {Count} (+Cộng dồn) Chakram xuyên thấu theo hình nón, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Các Chakram quay trở lại từ điểm cuối, gây thêm <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% SMCK<> <#ff9028ff>Sát thương Vật lý<>. (Tối đa {MaxCount} chiếc)"
      },
      "dark_mage": {
        "name": "Dark Mage",
        "skill": "Dark Mage bắn ra một mũi tên hắc ám theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trúng phải và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Sau một khoảng trễ ngắn, Dark Mage bao phủ một khu vực bằng bóng tối, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi đó.",
        "ult": "Dark Mage nguyền rủa một tướng địch trong phạm vi {Range} và liên kết mục tiêu đó với tướng đồng minh gần nhất trong <#ffb900ff>{Duration} giây<>. Khi một trong hai chịu sát thương, <#a974ffff>{ShareRatio}%<> sát thương sẽ được truyền sang mục tiêu còn lại."
      },
      "demon": {
        "name": "Demon",
        "skill": "Demon triệu hồi bàn tay địa ngục từ dưới mặt đất tóm lấy kẻ địch. Khi trúng đích, ả gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và hoán đổi vị trí với kẻ địch.",
        "skill2": "Demon hóa thân thành Quỷ Vương trong {Time} giây. Trong thời gian biến hình, ả được tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense} Giáp<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<>.",
        "ult": "Demon giải phóng sức mạnh thành sóng lửa, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và làm <#ef5350ff>Hoảng Sợ trong {Time} giây<>."
      },
      "dual_blader": {
        "name": "Dual Blader",
        "skill": "Dual Blader phóng ra kiếm khí theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trúng phải và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Dual Blader lao đến kẻ địch đang bị <#ef5350ff>Bất Động<> trong phạm vi {Range}, khiến mục tiêu trúng phải bị <#ef5350ff>Hất Tung trong {Time} giây<> và chịu <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "ult": "Dual Blader chém liên tiếp vào một kẻ địch trong phạm vi {Range} chỉ định, gây {Count} lần <#f5f5f5ff>Sát thương Chuẩn<> bằng <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "executioner": {
        "name": "Executioner",
        "skill": "Executioner ném cây móc theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trúng phải và kéo mục tiêu về phía mình.",
        "skill2": "Executioner dùng cây móc chém vào một kẻ địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và khiến mục tiêu bị <#ef5350ff>Chảy Máu trong {Duration} giây<>. Kẻ địch bị Chảy Máu phải chịu <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% SMCK<> mỗi {Tick} giây, đồng thời sát thương nhận vào <#ef5350ff>tăng {Debuff}%<>.",
        "ult": "Executioner vung cây móc theo vùng hình bán nguyệt trong phạm vi {Range} phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch và khiến chúng <#ef5350ff>Không Thể Hồi Máu trong {Time} giây<>."
      },
      "exorcist": {
        "name": "Exorcist",
        "skill": "Exorcist thanh tẩy <#ef5350ff>hiệu ứng bất lợi<> cho một đồng minh và hồi <#6aff55ff>Máu<> theo <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Xóa choáng, ngủ, trói chân, hoảng sợ, mê hoặc, khiêu khích, hất tung và di chuyển cưỡng ép. Không xóa hiệu ứng dạng buff như làm chậm hoặc độc.",
        "skill2": "Exorcist ban phước cho một đồng minh trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<> và <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>. Trong thời gian hiệu lực, nếu mục tiêu bị trúng kỹ năng khống chế, hiệu ứng khống chế đó sẽ bị phản đòn và áp dụng ngược lại lên kẻ địch.",
        "ult": "Exorcist tạo ra một vụ nổ tại vị trí chỉ định, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi. Với mỗi bùa lợi trên người mục tiêu, gây thêm sát thương bằng <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% SMPT<>."
      },
      "fighter": {
        "name": "Fighter",
        "skill": "Fighter lao đến mục tiêu trong phạm vi {Range} với tốc độ {Speed}, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> rồi <#ef5350ff>Làm Choáng trong {Stun} giây<>.",
        "skill2": "Fighter giẫm mạnh xuống mặt đất, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Fighter dập mạnh xuống đất, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trong phạm vi {Range} xung quanh và khiến chúng bị <#ef5350ff>Hất Tung trong {Time} giây<>."
      },
      "gambler": {
        "name": "Gambler",
        "skill": "Gambler tung xúc xắc và tấn công kẻ địch trong phạm vi {Range} với số lần bằng với số điểm gieo được. Mỗi đòn tấn công gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Gambler ném ra một con chip trong phạm vi {Range}, tạo một vùng có kích thước {AttackRange} gây <#ef5350ff>Làm Chậm {Slow}%<> trong {Time} giây. Khi biến mất, vùng này sẽ phát nổ, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi.",
        "ult": "Gambler ném ra một xấp tiền theo đường thẳng. Kẻ địch trúng chiêu phải chịu <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và bị <#ef5350ff>Mê Hoặc trong {Time} giây<>."
      },
      "ghost": {
        "name": "Ghost",
        "skill": "Ghost lao tới theo đường thẳng, trở nên Không Thể Bị Chỉ Định. Mỗi khi tham gia hạ gục kẻ địch, nó được tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> và <#6aff55ff>Hồi {Heal} Máu<>.",
        "skill2": "Ghost lướt một đoạn ngắn, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên mục tiêu đầu tiên đụng phải. Có thể sử dụng liên tiếp tối đa {Time} lần.",
        "ult": "Ghost nhận Miễn Nhiễm Khống Chế trong <#ffb900ff>{Time} giây<>. Mỗi khi tham gia hạ gục kẻ địch, thời gian hồi chiêu của các kỹ năng cơ bản của nó sẽ được làm mới."
      },
      "gunner": {
        "name": "Gunner",
        "skill": "Gunner có thể tấn công kẻ địch trong khi di chuyển. Từ cấp 3, mỗi khi tấn công kẻ địch anh sẽ được <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {Value}% Tốc Độ Di Chuyển<> trong {Time} giây.",
        "skill2": "Gunner cường hóa đòn đánh trong {Time} giây, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>tăng {Attack} Sức Mạnh Công Kích<>, đồng thời với mỗi 3 đòn đánh, viên đạn sẽ làm kẻ địch bị <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Gunner cường hóa đòn đánh trong {Time} giây, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>tăng {Attack} Sức Mạnh Công Kích<>, đồng thời anh bắn thêm đạn vào 2 kẻ địch xung quanh mục tiêu. Các viên đạn thêm này gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "ice_mage": {
        "name": "Ice Mage",
        "skill": "Ice Mage đóng băng kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "skill2": "Ice Mage tạo một vùng băng giá, tồn tại trong {Duration} giây tại khu vực chỉ định, <#ef5350ff>Làm Chậm {MoveSpeed}% Tốc Độ Di Chuyển<> của kẻ địch trong phạm vi {Range} và gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> mỗi {Tick} giây. Khi biến mất, vùng băng sẽ đóng băng kẻ địch trong phạm vi, <#ef5350ff>Làm Choáng trong {Stun} giây<>.",
        "ult": "Ice Mage phóng ra một cơn bão theo hình nón gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong vùng phía trước và đẩy lùi chúng. <#ef5350ff>Làm Chậm {Slow}% trong {SlowDuration} giây<> và khiến mục tiêu bị <#ef5350ff>Sa Lầy trong {BlockDuration} giây<>. Sa Lầy khiến kẻ địch không thể dùng kỹ năng di chuyển."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Illusionist bắn ra viên đạn làm kẻ địch bị nhiễu loạn, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, đồng thời triệu hồi một phân thân trước mặt mục tiêu để <#ef5350ff>Khiêu Khích trong {Time} giây<>.",
        "skill2": "Illusionst kích nổ ảo ảnh, gây <#a974ffff>Sát thương Phép<> <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range} và làm <#ef5350ff>Hoảng Sợ trong {Time} giây<>.",
        "ult": "Illusionist tạo một phân thân của một đồng minh bên cạnh, tồn tại trong <#ffb900ff>{Duration} giây<>. Phân thân này chỉ có thể đánh thường và sở hữu các chỉ số tương đương với Tướng được sao chép."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Jiangshi triệu hồi một Cương Thi Con lao vào kẻ địch để gây sát thương. Cương Thi Con sẽ biến mất sau 3 đòn đánh, mỗi đòn đánh gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Jiangshi giáng một đòn mạnh mẽ xuống kẻ địch, <#ef5350ff>Làm Choáng trong {Time} giây<>, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#6aff55ff>hồi {Heal} Máu<>.",
        "ult": "Jiangshi tạo một vùng hút sinh lực trong <#ffb900ff>{Duration} giây<>, liên tục hút <#6aff55ff>Máu<> theo <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> từ các kẻ địch trong phạm vi {Range} xung quanh, đồng thời gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<>."
      },
      "knight": {
        "name": "Knight",
        "skill": "Knight <#ef5350ff>Khiêu Khích mục tiêu được chọn trong {Time} giây<>.",
        "skill2": "Knight tạo một <#e8d44dff>Lá chắn<> cho bản thân, tồn tại trong {Time} giây (Giá trị <#e8d44dff>Lá chắn<>: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối Đa<> + <#e8d44dff>{Amount}<>). Trong thời gian lá chắn duy trì, <#ff9028ff>phản lại {Reflect}%<> sát thương gánh chịu.",
        "ult": "Knight tạo một vùng bảo vệ có phạm vi {Range} tại vị trí chỉ định, tồn tại trong <#ffb900ff>{Time} giây<>. Đồng minh trong vùng được giảm sát thương gánh chịu bằng <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối Đa<>, đồng thời kẻ địch bên trong bị <#ef5350ff>Làm Chậm {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancer",
        "skill": "Lancer quét cây thương của mình, đẩy lùi kẻ địch trong phạm vi {Range} xung quanh, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Lancer lướt một đoạn ngắn và xuyên qua mục tiêu, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% SMCK<> lên kẻ địch.",
        "ult": "Lancer phóng lên với khoảng cách {Range}, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tất cả kẻ địch trên đường lướt, đồng thời <#ef5350ff>Hất Tung trong {Time} giây<>."
      },
      "lightning_mage": {
        "name": "Lightning Mage",
        "skill": "Lightning Mage phóng tia sét vào kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Tia sét sẽ liên tục lan ra nếu có các mục tiêu khác trong phạm vi, và không lan trúng cùng một mục tiêu nhiều lần.",
        "skill2": "Lightning Mage giáng sét xuống khu vực chỉ định, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trúng phải và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "ult": "Lightning Mage vận sức trong <#ffb900ff>{Duration} giây<> để phóng một tia sét cao thế vào Tướng địch. Trong thời gian vận sức, cô <#ef5350ff>Làm Choáng<> mục tiêu và liên tục gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên các kẻ địch xung quanh."
      },
      "magic_knight": {
        "name": "Magic Knight",
        "skill": "Magic Knight kích nổ ma thuật theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "skill2": "Magic Knight tạo một lõi ma thuật tồn tại trong {Duration} giây ở một vùng hẹp, hút kẻ địch trong phạm vi {Range} về trung tâm mỗi {Tick} giây và gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "ult": "Magic Knight giải phóng sức mạnh trong <#ffb900ff>{Time} giây<>, giúp tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} Tầm Đánh<> và <#ceff99ff>Tốc Độ Đánh<> bằng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<>, đồng thời mỗi đòn đánh thường của cô sẽ kích hoạt Bộc Phát Ma Thuật."
      },
      "monk": {
        "name": "Monk",
        "skill": "Monk hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho đồng minh trong phạm vi {Range} xung quanh. Nếu chỉ hồi phục cho bản thân, lượng hồi phục sẽ tăng lên thành <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "skill2": "Monk đập lòng bàn tay xuống, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range} và <#ef5350ff>Làm Choáng trong {Time} giây<>.",
        "ult": "Monk tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho đồng minh trong phạm vi {Range} xung quanh. Đồng minh nhận được lá chắn sẽ được tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<>."
      },
      "necromancer": {
        "name": "Necromancer",
        "skill": "Necromancer triệu hồi một con Ngạ Quỷ để chiến đấu cho bạn trong <#ffb900ff>{Duration} (+{DurationCoef}% SMPT) giây<>. Thời gian hồi chiêu của kỹ năng sẽ giảm dần theo cấp độ, đồng thời thời gian tồn tại của Ngạ Quỷ tăng thêm <#ffb900ff>{DurationPerLevel} giây<>.",
        "skill2": "Necromancer chỉ định một kẻ địch làm mục tiêu tấn công trong <#ffb900ff>{Time} giây<> và khiến Ngạ Quỷ trở nên Cuồng Bạo. Ngạ Quỷ được tăng <#ceff99ff>Tốc Độ Đánh<> bằng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<>, và <#ffffffff>Tốc Độ Di Chuyển<> bằng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% SMPT<>.",
        "ult": "Necromancer hồi sinh một Tướng đồng minh đã tử trận và triệu hồi dưới dạng Vong Linh. Trong thời gian duy trì triệu hồi, Vong Linh bị tiêu hao <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} Máu<> mỗi giây."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Ninja bắn ra một quả cầu bóng tối, rồi nhảy tới kẻ địch trúng chiêu và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Ninja lướt một đoạn ngắn về phía kẻ địch chỉ định, tiến vào trạng thái Không Thể Bị Chỉ Định và tấn công liên tiếp 3 lần. Mỗi đòn đánh gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "ult": "Ninja lướt tới một kẻ địch trong phạm vi {Range}, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Mỗi khi chịu sát thương từ Tướng địch, Ogre tăng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value} Máu Tối Đa<>.",
        "skill2": "Ogre dùng cây chày gỗ đập vào mục tiêu, <#ef5350ff>Làm Choáng trong {Time} giây<> và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối Đa<>.",
        "ult": "Ogre hóa khổng lồ trong {Time} giây, tăng <#6aff55ff>Máu Tối Đa<> bằng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% Máu Tối Đa<>."
      },
      "plague_doctor": {
        "name": "Plague Doctor",
        "skill": "Plague Doctor tiêm thuốc cho bản thân và một đồng minh, trong <#ffb900ff>{Duration} giây<> cả hai được tăng <#ceff99ff>Tốc Độ Đánh<> bằng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<>.",
        "skill2": "Plague Doctor thực hiện nghi thức lên một đồng minh, trong <#ffb900ff>{Duration} giây<> tăng <#ff86c2ff>Tầm Đánh<> bằng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% SMPT<>, đồng thời đòn đánh được nhận hiệu ứng lướt.",
        "ult": "Plague Doctor tiêm bí dược cho một đồng minh, làm giảm {HpReduceRatio}% Máu hiện tại. Đổi lại, trong {Duration} giây, Máu của mục tiêu sẽ không thể giảm xuống dưới 1, đồng thời được tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>, <#ceff99ff> Tốc Độ Đánh <> bằng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% SMPT<> và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<>."
      },
      "poison_dart_hunter": {
        "name": "Poison Dart Hunter",
        "skill": "Poison Dart Hunter rải bãi chất độc, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi, khiến chúng bị nhiễm độc trong <#ffb900ff>{Duration} giây<> và bị <#ef5350ff>Làm Chậm {Slow}%<>.",
        "skill2": "Poison Dart Hunter được tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Range} Tầm Đánh<> khi tấn công kẻ địch bị nhiễm độc, và cô được tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Tốc Độ Di Chuyển<> khi di chuyển ra xa khỏi chúng.",
        "ult": "Poison Dart Hunter tẩm độc cho đòn đánh của các đồng minh xung quanh trong <#ffb900ff>{Duration} giây<>. Hiệu ứng độc này liên tục gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> trong <#ffb900ff>{PoisonDuration} giây<>."
      },
      "priest": {
        "name": "Priest",
        "skill": "Priest tạo một vùng hồi phục có phạm vi {Range}, duy trì trong {Duration} giây, mỗi {Tick} giây hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho các đồng minh đứng bên trong.",
        "skill2": "Priest tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho một đồng minh trong {Time} giây. Trong thời gian lá chắn tồn tại, đồng minh đó được tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>.",
        "ult": "Priest bay lên không trung và trở nên Bất Động trong {Time} giây, mỗi {Tick} giây cô bắn một viên đạn vào đồng minh có lượng máu thấp nhất trong tầm chiêu cuối, giúp hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>."
      },
      "pyromancer": {
        "name": "Pyromancer",
        "skill": "Pyromancer ném một quả cầu lửa xuống đất, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range}.",
        "skill2": "Pyromancer đốt cháy mặt đất tại khu vực chỉ định, tồn tại trong {Duration} giây, mỗi {Tick} giây gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range}.",
        "ult": "Pyromancer tạo một vụ nổ lớn trong phạm vi {Range}, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên toàn bộ kẻ địch trong phạm vi vụ nổ."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Pythoness hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho một đồng minh.",
        "skill2": "Pythoness hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho một đồng minh, đồng thời gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<> lên kẻ địch trong phạm vi {Range} xung quanh đồng minh đó.",
        "ult": "Pythoness triệu hồi Quỷ Môn Quan. Quỷ Môn Quan liên tục bắn ra các viên đạn vào các mục tiêu trong phạm vi {Range} xung quanh nó: đạn <#6aff55ff>hồi Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho đồng minh, hoặc đạn gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<> lên kẻ địch."
      },
      "shadowmancer": {
        "name": "Shadowmancer",
        "skill": "Shadowmancer triệu hồi bóng tối từ mặt đất, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi và <#ef5350ff>Trói Chân trong {Time} giây<>.",
        "skill2": "Shadowmancer kích nổ cái bóng của kẻ địch đang bị Bất Động, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "ult": "Shadowmancer ném quả cầu bóng tối xuyên thấu theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên các kẻ địch trúng chiêu và <#ef5350ff>Trục Xuất chúng trong {BanishTime} giây<>."
      },
      "shield_bearer": {
        "name": "Shield Bearer",
        "skill": "Shield Bearer tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối Đa<> cho bản thân và một đồng minh chỉ định trong phạm vi. (Duy trì trong {Duration} giây)",
        "skill2": "Shield Bearer chuyển {Damage}% sát thương các đồng minh xung quanh phải nhận vào bản thân, đồng thời Làm Chậm những kẻ địch tấn công đồng minh đi <#ef5350ff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% Giáp<>. (Duy trì trong {Duration} giây)",
        "ult": "Khi kích hoạt, Shield Bearer nhận được hiệu ứng <#e8d44dff>Giảm Sát Thương<> bằng <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% Kháng Phép<> và nhận Miễn nhiễm Khống Chế trong {Duration} giây, đồng thời khiến toàn bộ kẻ địch trong một phạm vi rộng xung quanh bị <#ef5350ff>Khiêu Khích trong {TauntDuration} giây<>. Ông không thể di chuyển trong thời gian hiệu lực."
      },
      "soldier": {
        "name": "Soldier",
        "skill": "Soldier được tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange} Tầm Đánh<> mỗi cấp.",
        "skill2": "Soldier bắn ba viên đạn liên tiếp vào một kẻ địch, gây lượng lớn <#ff9028ff>Sát thương Vật lý<> (mỗi phát gây sát thương <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>). Tầm thi triển kỹ năng tăng tỉ lệ thuận với Tầm Đánh cơ bản.",
        "ult": "Soldier bắn một viên đạn khổng lồ bay theo đường thẳng nhắm vào kẻ địch trong phạm vi {Range}. Viên đạn gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trên quỹ đạo bay, và lượng sát thương sẽ giảm đi {Decay}% mỗi khi trúng một kẻ địch."
      },
      "swordman": {
        "name": "Swordman",
        "skill": "Swordman phóng ra luồng kiếm khí, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trúng chiêu (Tầm kiếm khí: {Range})",
        "skill2": "Swordman chém liên tiếp 3 nhát vào một mục tiêu, gây lượng lớn <#ff9028ff>Sát thương Vật lý<>. Mỗi nhát chém gây sát thương bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "ult": "Swordman lướt một khoảng cách {Range} theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên mọi kẻ địch trên đường lướt. Nếu Swordman hạ gục kẻ địch bằng Xung Kích Chớp Nhoáng, thời gian hồi chiêu của nó sẽ được đặt lại."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Taoist phong ấn kẻ địch bằng bùa chú, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và khiến mục tiêu bị Giải Giới trong <#ef5350ff>{Time} (+{TimeCoef}% SMPT) giây<>. Giải Giới khiến kẻ địch không thể đánh thường.",
        "skill2": "Taoist dán bùa lên kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và khiến mục tiêu bị Câm Lặng trong <#ef5350ff>{Time} (+{TimeCoef}% SMPT) giây<>. Câm Lặng khiến kẻ địch không thể dùng kỹ năng.",
        "ult": "Taoist phóng ra bùa chú theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trúng chiêu, đồng thời làm <#ef5350ff>Bất Động trong {Time} giây<> và khiến mục tiêu Không Thể Bị Chỉ Định. Khi hiệu ứng kết thúc, hiệu ứng tương tự sẽ lan sang các kẻ địch xung quanh."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Vampire hút máu kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, đồng thời <#6aff55ff>hồi {Heal} Máu<> và tích lũy điểm cộng dồn. Mỗi điểm cộng dồn <#6aff55ff>tăng lượng Máu hồi phục thêm {Stack}<>.",
        "skill2": "Vampire tiêu hao {Value}% Máu của bản thân để phun máu ra theo hình nón phía trước, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Mỗi điểm cộng dồn tăng lượng sát thương thêm {Stack}.",
        "ult": "Vampire trở nên Không Thể Bị Chỉ Định và lướt một khoảng cách {Range}, hút <#6aff55ff>Máu<> bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> từ mỗi kẻ địch trên đường lướt, đồng thời gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<>."
      },
      "werewolf": {
        "name": "Werewolf",
        "skill": "Werewolf cào về phía trước theo hình bán nguyệt, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch và <#6aff55ff>hồi lượng Máu tương đương {HealRatio}% sát thương gây ra<>.",
        "skill2": "Werewolf lướt về phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trúng chiêu và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "Werewolf liên tục cào trong <#ffb900ff>{Duration} giây<>, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trong phạm vi hình nón và gây <#ef5350ff>Chảy Máu trong {BleedTime} giây<>. (Chảy Máu: <#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% SMCK<>)"
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Dokkaebi cường hóa cây chày gai của mình trong <#ffb900ff>{Duration} giây<>, khiến các đòn tấn công lên kẻ địch tạo ra làn sóng xung kích lan tỏa theo hình nón. Sóng xung kích này gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Dokkaebi cường hóa lớp da của bản thân trong <#ffb900ff>{Duration} giây<>, nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và nhận hiệu ứng <#e8d44dff>Giảm {DamageReduction}% Sát thương<>.",
        "ult": "Dokkaebi ném quả cầu lửa theo đường thẳng, <#ef5350ff>Làm Chậm trong {SlowTime} giây<>, sau đó <#ef5350ff>Trói Chân trong {BindTime} giây<>. Khi hiệu ứng Trói Chân kích hoạt, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> ra xung quanh, đồng thời hiệu ứng tương tự sẽ lan sang những kẻ địch chịu sát thương."
      },
      "hammerer": {
        "name": "Hammerer",
        "skill": "Hammerer vung búa vào một kẻ địch ở gần, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và khiến mục tiêu bị <#ef5350ff>Hất Tung trong {Time} giây<>.",
        "skill2": "Hammerer vận búa lên trong một khoảng thời gian rồi nện xuống đất, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch xung quanh trong phạm vi {Range} và <#ef5350ff>Làm Chậm {Move}% trong {Time} giây<>.",
        "ult": "Hammerer vung mạnh cây búa, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trong vùng hình bán nguyệt phạm vi {Range} phía trước. Kẻ địch trúng búa sẽ bị Đẩy Lùi trong {Time} giây, và các tướng địch va chạm với mục tiêu bị đẩy lùi sẽ bị <#ef5350ff>Hất Tung trong {Airborne} giây<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Inquisitor lướt một khoảng ngắn, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch đầu tiên trúng chiêu và gây <#ef5350ff>Chảy Máu<>.",
        "skill2": "Inquisitor chém vào mục tiêu, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Nếu mục tiêu đang bị <#ef5350ff>Chảy Máu<>, thời gian hồi chiêu của Thẩm Phán Đột Kích sẽ được làm mới.",
        "ult": "Inquisitor lướt tới một kẻ địch phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch xung quanh điểm đến. Sau khi chịu sát thương, kẻ địch có lượng Máu dưới {Threshold}% Máu Tối Đa sẽ bị kết liễu. Nếu kết liễu thành công, các kẻ địch xung quanh mục tiêu đó sẽ bị <#ef5350ff>Hoảng Sợ trong {FearTime} giây<>."
      },
      "pole_warrior": {
        "name": "Pole Warrior",
        "skill": "Pole Warrior nhảy tới kẻ địch và đập cây thiết bảng của mình xuống, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Pole Warrior lướt một khoảng ngắn, đứng lên thiết bảng và trở nên Không Thể Bị Chỉ Định trong {Time} giây, sau đó vung xuống, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch xung quanh trong phạm vi {Range}.",
        "ult": "Pole Warrior lướt tới kẻ địch được chỉ định trong phạm vi {Range}, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>, đồng thời khiến mục tiêu bị <#ef5350ff>Hất Tung trong {Time} giây<>."
      },
      "spirit_caller": {
        "name": "Spirit Caller",
        "skill": "Spirit Caller gắn một tinh linh vào đồng minh, giúp hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% SMPT<> và tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{SpeedUp}% Tốc Độ Di Chuyển<> trong <#ffb900ff>{Duration} giây<>.",
        "skill2": "Spirit Caller gắn một tinh linh vào kẻ địch, làm giảm lượng Giáp bằng <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% SMPT<> và lượng Kháng Phép bằng <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% SMPT<>, đồng thời <#ef5350ff>Làm Chậm {Slow}%<> trong <#ffb900ff>{Duration} giây<>.",
        "ult": "Spirit Caller kích nổ những tinh linh đã gắn lên mục tiêu. Tinh linh trên đồng minh tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% SMPT<> và tăng <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>. Tinh linh trên kẻ địch gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% SMPT<> và <#ef5350ff>Làm Choáng trong {StunTime} giây<>."
      },
      "whip_master": {
        "name": "Whip Master",
        "skill": "Whip Master quất cây roi vào kẻ địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> cộng sát thương tương đương <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% Máu của mục tiêu<>.",
        "skill2": "Whip Master quất roi theo hình nón, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trong phạm vi và đẩy lùi chúng.",
        "ult": "Whip Master vận sức trong <#ffb900ff>{Duration} giây<>, liên tục quất roi xuyên thấu theo đường thẳng về hướng của các kẻ địch ngẫu nhiên trong phạm vi, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>."
      },
      "enchanter": {
        "name": "Enchanter",
        "skill": "Enchanter cường hóa một đồng minh trong <#ffb900ff>{Duration} giây<>, tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{Increase} Tầm Đánh<>.",
        "skill2": "Enchanter cường hóa Trang bị của đồng minh trong <#ffb900ff>{Duration} giây<>, tăng <#ffb900ff>{Percent}%<> Chỉ số nhận được từ Trang bị.",
        "ult": "Enchanter cường hóa một đồng minh trong {Duration} giây, tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Sức Mạnh Công Kích<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% SMPT<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<> và được Miễn nhiễm Khống Chế."
      },
      "siege_breaker": {
        "name": "Siege Breaker",
        "skill": "Siege Breaker đập cây chùy gai xuống mục tiêu, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Hắn gây thêm {Bonus}% sát thương lên công trình.",
        "skill2": "Siege Breaker nện cây chùy gai xuống đất, gây <#ff9028ff>Sát Thương Vật Lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trong phạm vi, bao gồm cả công trình.",
        "ult": "Siege Breaker tăng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}% Sức Mạnh Công Kích<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<>, và <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<> trong {Time} giây."
      },
      "prisoner": {
        "name": "Prisoner",
        "skill": "Prisoner ném quả cầu sắt theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "Prisoner gầm lên, nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối Đa<> trong {Time} giây, đồng thời <#ef5350ff>Khiêu Khích<> lên toàn bộ kẻ địch trong phạm vi xung quanh.",
        "ult": "Prisoner lướt tới một kẻ địch được chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch xung quanh điểm đáp và <#ef5350ff>Làm Choáng trong {Time} giây<>."
      },
      "android": {
        "name": "Android",
        "skill": "Android bắn sóng xung kích theo đường thẳng. Sóng xung kích sẽ phát nổ theo hình tròn khi trúng kẻ địch hoặc bay đến hết tầm, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trong phạm vi và <#ef5350ff>Làm Chậm {Slow}% trong {Time} giây<>.",
        "skill2": "Android nhận một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối Đa<> duy trì trong {Time} giây. Khi lá chắn biến mất, <#ef5350ff>Làm Choáng<> toàn bộ kẻ địch xung quanh trong phạm vi {Range} trong {StunTime} giây.",
        "ult": "Android tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% Máu Tối Đa<> cho một đồng minh được chỉ định trong phạm vi {Range}, đồng thời dịch chuyển đến vị trí của đồng minh đó sau {Time} giây."
      },
      "white_mage": {
        "name": "White Mage",
        "skill": "White Mage chiếu tia sáng theo đường thẳng sẽ phát nổ sau chốc lát, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "White Mage triệu hồi chùm tia sáng trong khu vực hình tròn, tấn công 5 lần và gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi, đồng thời <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>.",
        "ult": "White Mage bắn vòng sáng xuyên thấu theo đường thẳng, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trúng chiêu và <#ef5350ff>Trói Chân chúng trong {Time} giây<>."
      },
      "wind_mage": {
        "name": "Wind Mage",
        "skill": "Wind Mage triệu hồi cơn cuồng phong trong <#ffb900ff>{Duration} giây<>, mỗi {Tick} giây gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi {Range}. Đồng minh ở trong cuồng phong được <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {MoveSpeed}% Tốc Độ Di Chuyển<>.",
        "skill2": "Wind Mage bắn năm lốc xoáy về phía trước, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên kẻ địch trong phạm vi.",
        "ult": "Wind Mage bắn một cơn lốc xoáy khổng lồ di chuyển chậm về phía tướng địch gần nhất. Kẻ địch trúng lốc xoáy chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và bị <#ef5350ff>Hất Tung trong {AirborneTime} giây<>. Mỗi lần trúng đích, kích thước, sát thương và thời gian hất tung của cơn lốc xoáy sẽ giảm đi, đồng thời đổi hướng bay về phía một tướng địch khác."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Bomber ném bom, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trong phạm vi.",
        "skill2": "Bomber đặt một quả mìn vô hình với kẻ địch, nếu kẻ địch đạp trúng sẽ gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#ef5350ff>Trói Chân trong {Time} giây<>. Mìn không kích hoạt lên lính.",
        "ult": "Bomber ném một quả bom khổng lổ xuống vị trí chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên toàn bộ kẻ địch trong phạm vi và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>."
      },
      "cavalry_knight": {
        "name": "Cavalry",
        "skill": "Cavalry lướt theo đường thẳng, đâm xuyên kẻ địch đầu tiên trúng chiêu, <#ef5350ff>Trói Chân trong {Time} giây<> và gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Tốc độ lướt tỉ lệ thuận với Tốc Độ Di Chuyển.",
        "skill2": "Cavalry tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}% Tốc Độ Di Chuyển<> trong {Time} giây và cường hóa ngọn giáo của mình thành giáo lửa, khiến các đòn tấn công gây thêm sát thương thiêu đốt bằng <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% SMCK<> trong {BurnTime} giây.",
        "ult": "Cavalry tăng <#ffffffff>Tốc Độ Di Chuyển<> bằng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% SMCK<> trong {Time} giây, đồng thời tạo ra một con đường hướng về vị trí của bản thân. Đồng minh đứng trên con đường khi di chuyển về phía Cavalry sẽ được tăng <#ffffffff>Tốc Độ Di Chuyển<> bằng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% SMCK<>."
      },
      "druid": {
        "name": "Druid",
        "skill": "Druid triệu hồi chú gấu Grizzly thân thiện. Nếu Grizzly bị hạ gục, cô sẽ phải chịu sát thương bằng <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% SMPT<>. Nếu sử dụng kỹ năng này khi Grizzly đang tồn tại, cô hồi <#6aff55ff>Máu<> cho Grizzly một lượng bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<>.",
        "skill2": "Druid triệu hồi đại bàng Harpy dũng mãnh. Nếu Harpy bị hạ gục, cô sẽ phải chịu sát thương. Nếu sử dụng kỹ năng này khi Harpy đang tồn tại, Harpy sẽ lao tới kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và <#6aff55ff>hồi Máu bằng {Lifesteal}%<> lượng sát thương gây ra.",
        "ult": "Druid bắn liên tiếp {Count} linh hồn Grizzly và Harpy theo hướng chỉ định. Mỗi linh hồn gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và đẩy lùi kẻ địch."
      },
      "voodoo_shaman": {
        "name": "Voodoo Shaman",
        "skill": "Voodoo Shaman bắn một mũi tên nguyền rủa, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, <#ef5350ff>Làm Chậm {Slow}% trong {Time} giây<> đồng thời giảm <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AtkSpd}% Tốc Độ Đánh<> trong <#ffb900ff>{AtkSpdTime} giây<>.",
        "skill2": "Voodoo Shaman nguyền rủa mục tiêu chỉ định trong <#ffb900ff>{Time} giây<> và gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Trong thời gian duy trì, gây thêm sát thương tương ứng với số lần mục tiêu bị tấn công bằng <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% SMPT<> (tối đa {Max} lần)",
        "ult": "Voodoo Shaman tạo một vùng tà thuật tại vị trí chỉ định trong <#ffb900ff>{Duration} giây<>. Kẻ địch trong vùng sẽ liên tục chịu <#a974ffff>Sát thương Phép<> băng <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% Máu Tối đa<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và bị <#ef5350ff>Câm Lặng<>. Câm Lặng khiến kẻ địch không thể dùng kỹ năng."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Hitman bắn ra 3 phát đạn liên tiếp. Phát bắn đầu tiên khiến kẻ địch bị <#ef5350ff>Choáng trong {StunTime} giây<>, hai phát tiếp theo mỗi phát gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>.",
        "skill2": "Hitman dịch chuyển ra sau lưng tướng địch vừa bị tấn công trong phạm vi <#ffb900ff>{Range}<>.",
        "ult": "Hitman đánh dấu một tướng địch, sau <#ffb900ff>{Duration} giây<> gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage} + {Coef}% sát thương mục tiêu gánh chịu trong thời gian bị đánh dấu<>. Nếu hạ gục mục tiêu, Hitman sẽ Tàng Hình trong <#ffb900ff>{InvisibleDuration} giây<>."
      },
      "guardian_spirit": {
        "name": "Guardian Spirit",
        "skill": "Guardian Spirit hồi <#6aff55ff>Máu<> bằng <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> cho các đồng minh xung quanh.",
        "skill2": "Guardian Spirit tạo một <#e8d44dff>Lá chắn<> có giá trị <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% SMPT<> cho một đồng minh, đồng thời <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>tăng {MoveSpeed}% Tốc Độ Di Chuyển<>.",
        "ult": "Guardian Spirit tạo ra một thánh vực trong <#ffb900ff>{Duration} giây<>, liên tục <#6aff55ff>Hồi Máu<> bằng <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> cho đồng minh trong phạm vi. Nếu có 1 Tướng đồng minh tử trận bên trong thánh vực, Tướng đó sẽ được hồi sinh và thánh vực lập tức kết thúc."
      },
      "hunter": {
        "name": "Hunter",
        "skill": "Hunter dịch chuyển đến kẻ địch và chuyển sang Đánh Xa. Ả được tăng <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{RangeIncrease} Tầm Đánh<>.",
        "marks": "Đòn đánh thường tầm xa đánh dấu tướng địch trong <#ffb900ff>{Duration} giây<>. Các đòn đánh tiếp theo làm mới thời gian của những dấu ấn hiện có. Kỹ năng thứ hai có thể nhắm vào kẻ địch có 3 dấu ấn.",
        "skill2": "Hunter lao đến kẻ địch đã tích đủ 3 cộng dồn, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và làm <#ef5350ff>Câm Lặng trong {SilenceTime} giây<>. Câm Lặng khiến kẻ địch không thể dùng kỹ năng.",
        "ult": "Hunter lướt về phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên những kẻ địch trên đường lướt. Trong một khoảng thời gian ngắn sau khi tung chiêu, kỹ năng này có thể được thi triển thêm một lần nữa. Ngoài ra, nếu tham gia hạ gục kẻ địch, ả có thể tung chiêu thêm một lần nữa."
      },
      "circus_blade": {
        "name": "Circus Blade",
        "skill": "Circus Blade phóng lưỡi đao theo hướng chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch và <#ef5350ff>Làm Chậm {Slow}% trong {SlowTime} giây<>. Tích trữ tối đa <#ffb900ff>{ChargeCount} lần<>, hồi lại <#ffb900ff>1 lần<> tích trữ khi đòn đánh thường trúng tướng địch.",
        "skill2": "Circus Blade được tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Tốc Độ Di Chuyển<> và <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tốc Độ Đánh<> trong <#ffb900ff>{Duration} giây<>, đồng thời nhận hiệu ứng Đi xuyên Địa hình.",
        "ult": "Circus Blade lao đến kẻ địch chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>, đồng thời gây sát thương diện rộng bằng <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% SMCK<> và <#ef5350ff>Đẩy Lùi<> các kẻ địch xung quanh, sau đó biến mất."
      },
      "sand_mage": {
        "name": "Sand Mage",
        "skill": "Nội tại: Sand Mage tích tụ năng lượng cát vào đòn đánh thường, gây <#a974ffff>Sát thương Phép cộng thêm<> bằng <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% SMPT<>. Sát thương cộng thêm này và sát thương Cát Bùng Nổ có thể chí mạng.\nKích hoạt: Sand Mage tạo ra một vụ nổ cát xung quanh mục tiêu, gây <#a974ffff>Sát thương Phép diện rộng<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>.",
        "skill2": "Sand Mage hấp thụ năng lượng của cát, trong <#ffb900ff>{Time} giây<> tăng <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% SMPT<> <#ffffffff>Tốc Độ Di Chuyển<>, đồng thời <#6aff55ff>hồi Máu<> bằng <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% SMPT<> cho bản thân.",
        "ult": "Sand Mage tạo ra một đầm lầy cát lún xung quanh mục tiêu, tồn tại trong <#ffb900ff>{Duration} giây<>. Mỗi {Tick} giây, đầm lầy gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> lên những kẻ địch bên trong và hút chúng về phía tâm."
      },
      "alchemist": {
        "name": "Alchemist",
        "skill": "Alchemist ném một bình hóa chất phát nổ và để lại một bãi độc trong <#ffb900ff>{Time} giây<>. Kẻ địch bên trong bãi độc bị <#78e85cff>Trúng Độc<> trong <#ffb900ff>{DotTime} giây<>, mỗi {DotTick} giây phải chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, đồng thời bị giảm {HealReduce}% lượng Máu hồi phục.",
        "skill2": "Alchemist tiêm một loại dược chất bất ổn vào một kẻ địch, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>. Trong <#ffb900ff>{Time} giây<>, mục tiêu không thể được hồi Máu và bị làm chậm {Slow}%.",
        "ult": "Alchemist ném một bình chất độc theo đường thẳng. Nếu trúng Tướng địch, nó tạo ra một đám mây độc lan rộng đến phạm vi tối đa {CloudRadius} trong <#ffb900ff>{CloudTime} giây<>. Kẻ địch bên trong đám mây sẽ bị <#78e85cff>Trúng Độc<> trong <#ffb900ff>{DotTime} giây<>, mỗi {DotTick} giây gánh chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, đồng thời bị giảm <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% SMPT<> <#ffdd8eff>Giáp<> và <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% SMPT<> <#88ccffff>Kháng Phép<>."
      },
      "crossbowman": {
        "name": "Crossbowman",
        "skill": "Crossbowman bắn ra một mũi tên uy lực theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tướng địch đầu tiên trúng phải. Trong thời gian Dấu Ấn Vệt Sáng tồn tại, mũi tên gây thêm sát thương bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% SMCK<>.",
        "skill2": "Crossbowman bắn ra một mũi tên xuyên thấu theo đường thẳng về phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch, đồng thời bản thân bị bay ngược về phía sau trong <#ffb900ff>{BackstepTime} giây<>. Trong thời gian Dấu Ấn Vệt Sáng tồn tại, mũi tên gây thêm sát thương bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% SMCK<>.",
        "ult": "Crossbowman bắn ra một vệt sáng theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên Tướng địch đầu tiên trúng phải và để lại Dấu Ấn trong <#ffb900ff>{Duration} giây<>. Trong thời gian Dấu Ấn tồn tại, mọi kỹ năng sẽ trúng mục tiêu bất kể khoảng cách, đồng thời giảm <#ffb900ff>{CoolReduce}%<> Thời gian Hồi chiêu. Các Tướng địch khác trên đường bay có thể hứng chịu những phát bắn thay cho mục tiêu."
      },
      "nightmare": {
        "name": "Nightmare",
        "skill": "Nightmare bắn ra một mảnh vỡ ác mộng theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch đầu tiên trúng phải. Hắn có thể sử dụng liên tiếp tối đa <#ffb900ff>{UseCount} lần<>.",
        "skill2": "Nightmare lao tới một khoảng cách <#ffb900ff>{Range}<> theo hướng chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong phạm vi <#ffb900ff>{Radius}<> xung quanh và tiến vào trạng thái Tàng Hình trong <#ffb900ff>{StealthTime} giây<>.",
        "ult": "Nightmare lao tới mục tiêu, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch. Nếu sát thương này hạ gục mục tiêu, hắn sẽ dịch chuyển tức thời đến bên cạnh một Tướng đồng minh còn sống bất kể khoảng cách."
      },
      "strongman": {
        "name": "Strongman",
        "skill": "Strongman tóm lấy một kẻ địch ở gần rồi ném qua vai ra phía sau lưng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và làm choáng mục tiêu <#ef5350ff>trong {Stun} giây<>.",
        "skill2": "Strongman vung mạnh quả tạ, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trong phạm vi <#ffb900ff>{Range}<> xung quanh và <#ef5350ff>Đẩy Lùi<> chúng.",
        "ult": "Strongman ném một tướng đồng minh ở gần đến vị trí chỉ định. Sau khi chạm đất, đồng minh đó nhận <#e8d44dff>Lá chắn {Shield}<> trong <#ffb900ff>{ShieldTime} giây<>, đồng thời gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trong phạm vi <#ffb900ff>{Radius}<> tại điểm rơi và làm choáng chúng <#ef5350ff>trong {Stun} giây<>. Nếu không có đồng minh ở gần, bản thân Strongman sẽ tự nhảy đến vị trí đó, lúc này thời gian làm choáng sẽ là <#ef5350ff>{SelfStun} giây<>."
      },
      "harpooner": {
        "name": "Harpooner",
        "skill": "Harpooner phóng mũi lao theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên tướng địch đầu tiên trúng chiêu. Sau khi trúng đích, có thể tái kích hoạt trong <#ffb900ff>{RecastDuration} giây<> để kéo bản thân lao tới mục tiêu, hoặc lôi mục tiêu về phía mình.",
        "skill2": "Harpooner phóng một mũi lao uy lực theo đường thẳng, gây <#ff9028ff>Sát thương Vật lý<> lên kẻ địch đầu tiên trúng chiêu. Sát thương bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> Máu đã mất của mục tiêu.",
        "ult": "Harpooner phóng ra <#ffb900ff>{ProjectileCount}<> mũi lao xích theo hình nón phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên các kẻ địch trúng chiêu và trói buộc chúng <#ffb900ff>trong {LinkDuration} giây<>. Những kẻ địch bị trói sẽ bị giảm <#ef5350ff>{Slow}%<> Tốc Độ Di Chuyển. Nếu chúng di chuyển cách xa nhau quá <#ffb900ff>{LinkRange}<>, sợi xích sẽ siết chặt hơn, khiến hiệu ứng làm chậm tăng lên thành <#ef5350ff>{TensionSlow}%<> và kéo chúng lại gần nhau."
      },
      "spellbreaker": {
        "name": "Spellbreaker",
        "skill": "Spellbreaker quét mạnh cây trọng kiếm về phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#ef5350ff>Làm Chậm {Slow}% trong {Time} giây<>.",
        "skill2": "Spellbreaker lướt tới một khoảng cách ngắn, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch đầu tiên trúng chiêu. Sau khi lướt, Spellbreaker được <#ef5350ff>giảm {Reduce}%<> sát thương gánh chịu <#ffb900ff>trong {Time} giây<>.",
        "ult": "Spellbreaker giải phóng sức mạnh ẩn giấu của cây trọng kiếm, phá hủy ngay lập tức Lá chắn của tất cả kẻ địch trong phạm vi <#ffb900ff>{Range}<> xung quanh. Những kẻ địch bị phá Lá chắn sẽ phải chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<>, bị <#ef5350ff>Choáng trong {Stun} giây<>, và <#ffb900ff>Không thể nhận thêm Lá chắn trong {BlockTime} giây<>. Kẻ địch không có lá chắn từ trước chỉ phải chịu <#a974ffff>{Damage} Sát thương Phép<>."
      },
      "gladiator": {
        "name": "Gladiator",
        "skill": "Gladiator tung lưới theo hình nón <#ffb900ff>{FanAngle}°<> phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#ef5350ff>Trói Chân<> kẻ địch trong <#ffb900ff>{Stun} giây<>.",
        "skill2": "Gladiator đâm đinh ba về phía trước, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<>. Đánh trúng cùng một tướng liên tiếp trong vòng <#ffb900ff>{Time} giây<> sẽ tăng sát thương thêm <#ffb900ff>{Amplify}%<> mỗi cộng dồn (tối đa <#ffb900ff>{MaxAmplifyTargets}<> cộng dồn). Đánh trúng tướng khác sẽ đặt lại cộng dồn.",
        "ult": "Gladiator lao tới một tướng địch, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> và <#ef5350ff>Khiêu Khích<> mục tiêu trong <#ffb900ff>{Stun} giây<>. Trong lúc tay đôi, mục tiêu không thể được hồi máu hay nhận lá chắn mới, còn sát thương Gladiator phải chịu từ các kẻ địch khác giảm <#ffb900ff>{Amplify}%<>. Cuộc tay đôi kết thúc khi hiệu ứng Khiêu Khích bị thanh tẩy hoặc mục tiêu tử trận."
      },
      "ferryman": {
        "name": "Ferryman",
        "skill": "Ferryman ném mỏ neo trúng tướng đầu tiên trên đường bay. Đồng minh có Máu từ <#ffb900ff>{AllyHpRatio}%<> trở xuống bị kéo về cạnh Ferryman và được tăng <#ffb900ff>{Amplify}%<> Tốc Độ Di Chuyển trong <#ffb900ff>{Time} giây<>; đồng minh nhiều Máu hơn sẽ bị bỏ qua. Kẻ địch thì chịu <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và bị Làm Chậm <#ffb900ff>{Slow}%<> trong <#ffb900ff>{SlowTime} giây<>.",
        "skill2": "Ferryman tạo ra một dòng sông dài <#ffb900ff>{Range}<>, rộng <#ffb900ff>{Width}<> phía trước trong <#ffb900ff>{Time} giây<>. Đồng minh trên dòng sông được tăng <#ffb900ff>{Amplify}%<> Tốc Độ Di Chuyển, còn kẻ địch bị Làm Chậm <#ffb900ff>{Slow}%<>.",
        "ult": "Ferryman thanh tẩy một tướng đồng minh khác có Máu từ <#ffb900ff>{AllyHpRatio}%<> trở xuống rồi chở họ bằng đò về phía căn cứ đồng minh một quãng <#ffb900ff>{MoveDistance}<> trong <#ffb900ff>{Time} giây<>. Người trên đò Không Thể Bị Chỉ Định, không thể hành động và miễn nhiễm hiệu ứng dịch chuyển cưỡng chế. Khi lên bờ, họ hồi <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% SMPT<> Máu và được tăng <#ffb900ff>{Slow}%<> Tốc Độ Di Chuyển trong <#ffb900ff>{SlowTime} giây<>."
      },
      "bombardier": {
        "name": "Bombardier",
        "skill": "Bombardier triển khai hoặc thu hồi khẩu pháo. Khi triển khai, không thể di chuyển nhưng tầm của đòn đánh thường và kỹ năng 2 tăng thêm <#ffb900ff>{MoveDistance}<>, đồng thời <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>tăng {Amplify}% Sức Mạnh Công Kích<>. Sau khi thu hồi, được tăng <#ffb900ff>{Slow}%<> Tốc Độ Di Chuyển trong <#ffb900ff>{Time} giây<>.",
        "skill2": "Bombardier bắn một quả đạn pháo theo đường cầu vồng vào vị trí chỉ định, gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> lên kẻ địch trong bán kính <#ffb900ff>{Radius}<> và Làm Chậm chúng <#ffb900ff>{Slow}%<> trong <#ffb900ff>{SlowTime} giây<>. Khi triển khai pháo, tầm thi triển tăng lên.",
        "ult": "Bombardier bắn liên tiếp <#ffb900ff>{ProjectileCount}<> quả đạn pháo vào khu vực chỉ định. Mỗi quả gây <#ff9028ff>Sát thương Vật lý<> bằng <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% SMCK<> trong bán kính <#ffb900ff>{ProjectileRadius}<>. Khi triển khai pháo, tầm thi triển tăng thêm <#ffb900ff>{MoveDistance}<>. Bị Khống Chế khi đang bắn sẽ hủy các phát còn lại."
      },
      "hypnotist": {
        "name": "Hypnotist",
        "skill": "Hypnotist phóng con lắc xuyên thấu, gây <#a974ffff>Sát thương Phép<> bằng <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% SMPT<> và Làm Chậm <#ffb900ff>{Slow}%<> trong <#ffb900ff>{SlowTime} giây<>. Sát thương này không đánh thức kẻ địch đang <#ef5350ff>Ngủ<>.",
        "skill2": "Sau <#ffb900ff>{Delay} giây<>, Hypnotist khiến kẻ địch trong bán kính <#ffb900ff>{Radius}<> rơi vào trạng thái <#ef5350ff>Ngủ<> trong <#ffb900ff>{Time} giây<>. Khi Ngủ, mục tiêu không thể di chuyển hay hành động. Mọi sát thương, kể cả sát thương theo thời gian, sẽ đánh thức mục tiêu và đòn đầu tiên đó gây thêm <#ffb900ff>{Amplify}%<> sát thương.",
        "ult": "Sau <#ffb900ff>{Delay} giây<>, Hypnotist khiến kẻ địch trong bán kính <#ffb900ff>{Radius}<> rơi vào trạng thái <#ef5350ff>Ngủ<> trong <#ffb900ff>{Time} giây<>. Sát thương sẽ đánh thức mục tiêu và đòn đánh thức đó gây thêm <#ffb900ff>{Amplify}%<> sát thương. Thanh Tẩy sẽ xóa cả trạng thái <#ef5350ff>Ngủ<> lẫn phần sát thương cộng thêm."
      }
    }
  },
