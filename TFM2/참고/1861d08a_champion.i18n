    "description": {
      "astrologer": {
        "name": "Astrologe",
        "skill": "Lässt nach <#ffb900ff>{Delay}s<> am Zielort einen Meteor einschlagen, der Gegnern im Bereich <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Zauberkraft als <#a974ffff>magischen Schaden<> zufügt und ihr Lauftempo für <#ef5350ff>{SlowTime}s<> um <#ef5350ff>{Slow}%<> verringert.",
        "skill2": "Fügt Gegnern in einer Linie <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Zauberkraft als <#a974ffff>magischen Schaden<> zu und hinterlässt eine Sternbild-Markierung. Die Markierung hält <#ffb900ff>{MarkTime}s<> an, und markierte Gegner erleiden zusätzlichen Schaden durch die Sternbild-Detonation der ultimativen Fähigkeit.",
        "ult": "Zeichnet im Zielbereich ein Sternbild und markiert alle Gegner. Nach <#ffb900ff>{Delay}s<> explodieren alle Markierungen gleichzeitig und verursachen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> Zauberkraft als <#a974ffff>magischen Schaden<>. Für jeden zusätzlich verbundenen Gegner erhöht sich der Schaden um <#ffb900ff>{Amplify}%<>. Bereits markierte Gegner erleiden zusätzlich <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> der Fähigkeitsstärke als Schaden."
      },
      "archer": {
        "name": "Bogenschütze",
        "skill": "Springe in die angegebene Richtung und füge dem zuletzt angegriffenen Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Feuere einen Pfeil auf einen nahen Feind ab, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen, sie kurz zu <#ef5350ff>betäuben<> und rückwärts zu springen.",
        "ult": "Es bleibt stehen und feuert insgesamt {Count} Pfeile ab. Der Pfeil fliegt auf einen zufälligen Feind in der Nähe von {Range} zu und verursacht <#ff9028ff>physischen Schaden<> in Höhe von <#ff9028ff>{Damage}<> + {Coef} % der <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<>."
      },
      "bard": {
        "name": "Barde",
        "skill": "Erhöht das <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Angriffstempo eines Verbündeten um {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> für <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduziert die Fähigkeiten-Abklingzeit von Verbündeten im Zielbereich für {Duration}s um <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<>.",
        "ult": "Kanalisiert für <#ffb900ff>{Duration}s<> und erhöht bei verbündeten Champions in {Range} Reichweite den <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% der Zauberkraft<>), die <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>Zauberkraft um {MagicPower}<> und das <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Angriffstempo um {AttackSpeed}%<> und verkürzt die Abklingzeit um {CoolReduce}%, aber die <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Verteidigung sinkt um {DefenceReduce}%<> und die <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>Magieresistenz sinkt um {MagicResistanceReduce}%<>."
      },
      "barrier_magician": {
        "name": "Barrieren-Magier",
        "skill": "Erschafft für <#ffb900ff>{Duration}s<> eine Barriere, die Verbündeten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Zauberkraft<> als <#e8d44dff>Schild<> gewährt und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo von Feinden um {AttackSpeedReduce}%<> reduziert. Ab Stufe 3 erhalten Verbündete zusätzliche <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo<> und Feinde werden <#ef5350ff>verlangsamt<>.",
        "skill2": "Beschwört im Zielbereich für <#ffb900ff>{Duration}s<> eine Barriere, die alle Projektile darin zerstört.",
        "ult": "Erschafft eine schrumpfende Barriere um einen feindlichen Champion. Feinde, die den Rand berühren, erleiden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>für {Time}s betäubt<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Werde für {Duration}s wütend, erhöhe die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> und gewinne <#6aff55ff>{Vamp}% Lebensraub<>.",
        "skill2": "Schlage mit beiden Händen auf den Boden, um Feinde in einem engen Bereich <#ef5350ff>für {Time}s in die Luft zu werfen<> und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "ult": "Stürme auf einen Feind in {Range} Reichweite zu und schlage ihn, dabei <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zufügend. Die Abklingzeit wird proportional zur verlorenen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>HP<> verkürzt."
      },
      "boomerang_hunter": {
        "name": "Bumerang-Jäger",
        "skill": "Wirft einen Bumerang in gerader Linie und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<>. Am Ende der Reichweite rotiert er und verursacht kontinuierlich <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% Angriff<> als <#ff9028ff>physischen Schaden<>.",
        "skill2": "Wirft drei Bumerangs, die zurückkehren und allen Feinden in ihrer Bahn <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zufügen.",
        "ult": "Feuert einen kraftvollen Bumerang in gerader Linie und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<>. Trifft er einen feindlichen Champion, springt er zum nächsten feindlichen Champion und erhöht den Schaden pro Sprung um <#ff9028ff>{Increase}%<>. Springt bis zu {MaxBounce} Mal."
      },
      "chef": {
        "name": "Koch",
        "skill": "Wirft ein Messer in gerader Linie und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "skill2": "Verteilt Essen an nahe Verbündete und <#6aff55ff>heilt HP<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<>. Bei Selbstheilung steigt die Heilung auf <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% Zauberkraft<>.",
        "ult": "Wirft einem verbündeten Champion ein Spezialgericht zu. Für <#ffb900ff>{Duration}s<> steigen <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximale HP um {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> des erlittenen Schadens wird als Schaden über Zeit verteilt."
      },
      "clown": {
        "name": "Clown",
        "skill": "Teleportiert sich neben ein Ziel. Bei einem Feind verursacht es <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> und gibt <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<> für <#ffb900ff>{Duration}s<>.",
        "skill2": "Streut Dolche umher und fügt Feinden im Bereich <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. (Bewegung während des Wirkens möglich)",
        "ult": "Verfällt für <#ffb900ff>{Time}s<> in Raserei. Alle Dolche werden zu speziellen springenden Dolchen, die zwischen Feinden abprallen."
      },
      "dancer": {
        "name": "Tänzerin",
        "skill": "Wirft ein Chakram auf einen Gegner und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Jedes zusätzliche Chakram erhöht den Schaden dieser Fähigkeit um {StackCoef}%.",
        "skill2": "Jeder Kill fügt ein Chakram zu Standardangriffen hinzu. (Max <#ffb900ff>{MaxCount}<>, Schaden sinkt um <#ffb900ff>{Reduce}%<> pro zusätzlichem Chakram-Treffer)",
        "ult": "Feuert {Count}(+Stapel) durchdringende Chakrams in einem Fächer und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. Chakrams kehren zurück und fügen <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Dunkler Magier",
        "skill": "Feuert einen Schattenpfeil ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>fesselt für {Time}s<>.",
        "skill2": "Bedeckt nach kurzer Verzögerung ein Gebiet mit Dunkelheit und fügt Feinden darin <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "ult": "Verflucht einen feindlichen Champion in {Range} Reichweite und verbindet ihn für <#ffb900ff>{Duration}s<> mit dem nächsten Verbündeten. Erleidet einer Schaden, werden <#a974ffff>{ShareRatio}%<> auf den anderen übertragen."
      },
      "demon": {
        "name": "Dämon",
        "skill": "Eine höllische Klaue steigt aus dem Boden auf, um einen Feind zu greifen, <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und Positionen zu tauschen.",
        "skill2": "Verwandle dich für {Time}s in einen größeren Dämon. Erhöht Angriff um <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Verteidigung um {Defense}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {MoveSpeed}%<>.",
        "ult": "Fügt allen Gegnern in {Range} Reichweite <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und löst <#ef5350ff>{Time}s lang Angst<> aus."
      },
      "dual_blader": {
        "name": "Doppelklingen-Kämpfer",
        "skill": "Feuere Schwertenergie in einer geraden Linie, um getroffenen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und das Ziel <#ef5350ff>für {Time}s zu fesseln<>.",
        "skill2": "Stürme auf einen <#ef5350ff>immobilen<> Feind in {Range} Reichweite zu, wirf den getroffenen Feind <#ef5350ff>für {Time}s in die Luft<> und füge <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Zerschneidet einen Feind in {Range} Reichweite mit einem Schwert und verursacht {Count} mal <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#f5f5f5ff>festen Schaden<>."
      },
      "executioner": {
        "name": "Henker",
        "skill": "Feuere einen Haken ab, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und den getroffenen Feind zu dir zu ziehen.",
        "skill2": "Schlitzt einen Feind mit einem Haken auf, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und lässt das Ziel <#ef5350ff>{Duration}s lang bluten<>. Blutende Feinde erleiden alle {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> und <#ef5350ff>erleiden {Debuff}% mehr Schaden<>.",
        "ult": "Fegt Feinde mit einem Haken in einem halbkreisförmigen Bereich vor {Range}, verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> und macht sie <#ef5350ff>für {Time}s unfähig zu heilen<>."
      },
      "exorcist": {
        "name": "Exorzist",
        "skill": "Neutralisiert <#ef5350ff>Statuseffekte<> eines Verbündeten und <#6aff55ff>heilt {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> <#6aff55ff>Leben<>. Entfernt Betäubung, Schlaf, Verwurzelung, Furcht, Bezauberung, Spott, Hochschleudern und erzwungene Bewegung. Buff-basierte Effekte wie Verlangsamung oder Gift werden nicht entfernt.",
        "skill2": "Gewährt einem Verbündeten für <#ffb900ff>{Duration}s<> göttlichen Schutz, erhöht den <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}<> und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<>. Während aktiv reflektiert es Kontrolleffekte zurück.",
        "ult": "Erzeugt eine Explosion im Zielgebiet und fügt Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Verursacht <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% Zauberkraft<> Bonusschaden pro Buff auf dem Ziel."
      },
      "fighter": {
        "name": "Kämpfer",
        "skill": "Stürmt mit {Speed} Geschwindigkeit auf ein Ziel in {Range} zu und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> und <#ef5350ff>betäubt für {Stun}s<>.",
        "skill2": "Schlägt auf den Boden und fügt Feinden in {Range} <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "ult": "Schlägt auf den Boden und fügt allen Feinden in {Range} Reichweite <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und schleudert sie <#ef5350ff>für {Time}s in die Luft<>."
      },
      "gambler": {
        "name": "Spieler",
        "skill": "Würfle und greife Feinde in {Range} Reichweite so oft an, wie die Würfelzahl ergibt. Jeder Angriff fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Wirf einen Chip, um in {Range} Reichweite ein {AttackRange}-großes Gebiet zu erzeugen, das Feinde {Time}s lang <#ef5350ff>um {Slow}% verlangsamt<>. Das Gebiet explodiert beim Ablaufen und fügt Feinden darin <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Feuert einen Geldhaufen ab, der Feinde in gerader Linie bezaubert. Der getroffene Feind erleidet <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> und ist <#ef5350ff>{Time}s lang bezaubert<>."
      },
      "ghost": {
        "name": "Geist",
        "skill": "Wird unzielbar und stürmt in einer Linie. Bei Kill/Assist erhält er <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} Angriff<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tempo<> und <#6aff55ff>stellt {Heal} Leben wieder her<>.",
        "skill2": "Stürmt eine kurze Distanz und fügt dem ersten getroffenen Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Kann bis zu {Time} Mal hintereinander verwendet werden.",
        "ult": "Wird für <#ffb900ff>{Time}s<> immun gegen Kontrolleffekte. Töten oder Assists setzen die Grundfähigkeits-Abklingzeit zurück."
      },
      "gunner": {
        "name": "Schütze",
        "skill": "Kann Feinde während der Bewegung angreifen. Ab Stufe 3 erhöht jeder Angriff die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo<> für {Time}s um {Value}%.",
        "skill2": "Verstärke Angriffe für {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff steigt um {Attack}<>. Jeder 3. Angriff <#ef5350ff>verlangsamt den Feind um {Slow}% für {SlowTime}s<>.",
        "ult": "Der Angriff wird {Time} Sekunden lang verstärkt, die <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<> erhöht sich um <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> und es werden zusätzliche Kugeln auf 2 Feinde um das Angriffsziel abgefeuert. Zusätzliche Kugeln verursachen <#ff9028ff>physischen Schaden<> in Höhe von <#ff9028ff>{Damage}<> + {Coef} % der Angriff."
      },
      "ice_mage": {
        "name": "Eismagier",
        "skill": "Friere einen Feind ein, um <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zuzufügen und ihn <#ef5350ff>für {Time}s zu betäuben<>.",
        "skill2": "Beschwöre ein Eisfeld für {Duration}s, das Feinde in {Range} um <#ef5350ff>{MoveSpeed}% Lauftempo verlangsamt<> und alle {Tick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zufügt. Friert ein und <#ef5350ff>betäubt Feinde für {Stun}s<>, wenn es endet.",
        "ult": "Fügt Feinden in einem frontalen Kegel <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und stößt sie zurück. <#ef5350ff>Verlangsamt um {Slow}% für {SlowDuration}s<> und <#ef5350ff>blockiert Bewegungsfähigkeiten für {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionist",
        "skill": "Feuert ein Projektil ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und beschwört eine Illusion, die <#ef5350ff>für {Time}s provoziert<>.",
        "skill2": "Fügt Feinden in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>ängstigt für {Time}s<>.",
        "ult": "Erschafft eine Illusion eines nahen verbündeten Champions, die <#ffb900ff>{Duration}s<> lang anhält. Die Illusion kann nur Standardangriffe ausführen und hat dieselben Werte wie der kopierte Champion."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Beschwört einen kleinen Jiangshi, der auf einen Feind zustürmt und 3 Mal angreift, bevor er verschwindet, und pro Treffer <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> verursacht.",
        "skill2": "Schlägt einen Feind zu Boden und <#ef5350ff>betäubt für {Time}s<>, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#6aff55ff>stellt {Heal} Leben wieder her<>.",
        "ult": "Saugt für <#ffb900ff>{Duration}s<> Feinden in {Range} <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<> als <#6aff55ff>Leben<> ab und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu."
      },
      "knight": {
        "name": "Ritter",
        "skill": "Wendet auf ein Ziel <#ef5350ff>{Time}s lang Provozieren<> an.",
        "skill2": "Gewährt dir selbst einen <#e8d44dff>Schild<> für {Time}s (<#e8d44dff>Schild<>wert: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des maximalen Lebens<> + <#e8d44dff>{Amount}<>). Reflektiert <#ff9028ff>{Reflect}%<> des erlittenen Schadens, solange der Schild aktiv ist.",
        "ult": "Beschwört am gewählten Ort eine Verteidigungszone mit {Range} Reichweite für <#ffb900ff>{Time}s<>. Verbündete darin erleiden <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% des maximalen Lebens<> weniger Schaden, und Feinde darin werden um <#ef5350ff>{MoveSpeedReduce}% verlangsamt<>."
      },
      "lancer": {
        "name": "Lanzer",
        "skill": "Stoße Feinde in {Range} zurück und füge <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Stürme eine kurze Distanz, um <#ff9028ff>{Damage}<> + {Value}% des <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<>s als <#ff9028ff>physischen Schaden<> zuzufügen und hinter den Feind zu bewegen.",
        "ult": "Lädt eine Distanz von {Range} auf, fügt allen während des Angriffs angetroffenen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> zu und schleudert sie <#ef5350ff>für {Time}s in die Luft<>."
      },
      "lightning_mage": {
        "name": "Blitzmagier",
        "skill": "Schießt einen Blitz auf ein Ziel und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Springt zu nahen Feinden über, ohne Ziele zu wiederholen.",
        "skill2": "Schlägt einen Blitz in einem Gebiet ein und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>betäubt für {Time}s<>.",
        "ult": "Kanalisiert einen Blitzstrahl auf einen feindlichen Champion für <#ffb900ff>{Duration}s<> und <#ef5350ff>betäubt<> ihn. Verursacht kontinuierlich <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> am Ziel und nahen Feinden."
      },
      "magic_knight": {
        "name": "Magieritter",
        "skill": "Explodiere Mana in einer langen schmalen Linie, um <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> der Zauberkraft als <#a974ffff>magischen Schaden<> zuzufügen.",
        "skill2": "Erzeuge einen Manakern für {Duration}s, der Feinde in {Range} alle {Tick}s zum Zentrum zieht und <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> der Zauberkraft als <#a974ffff>magischen Schaden<> zufügt.",
        "ult": "Für <#ffb900ff>{Time}s<> steigt die <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite um {Range}<> und die <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Angriffsgeschwindigkeit um {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% der Zauberkraft<>. Normale Angriffe lösen die erste Fähigkeit aus."
      },
      "monk": {
        "name": "Mönch",
        "skill": "Stellt Verbündeten in {Range} <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> <#6aff55ff>HP<> wieder her. Wenn nur das Selbst geheilt wird, steigt die Heilmenge auf <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<>.",
        "skill2": "Schlage mit der Handfläche, um in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zuzufügen und <#ef5350ff>für {Time}s zu betäuben<>.",
        "ult": "Gewährt Verbündeten im Umkreis von {Range} einen <#e8d44dff>Schild<> in Höhe von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<>. Verbündete mit Schild erhalten <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Bewegungsgeschwindigkeit<>."
      },
      "necromancer": {
        "name": "Nekromant",
        "skill": "Beschwört einen Ghul als Diener für <#ffb900ff>{Duration}(+{DurationCoef}% der Zauberkraft)s<>. Stufen verringern die Abklingzeit und erhöhen die Dauer des Ghuls jeweils um <#ffb900ff>{DurationPerLevel}s<>.",
        "skill2": "Markiert einen Gegner für <#ffb900ff>{Time}s<> als Angriffsziel und versetzt Ghule in Raserei. Ghule erhalten <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Zauberkraft<> Angriffsgeschwindigkeit und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% Zauberkraft<> Bewegungsgeschwindigkeit.",
        "ult": "Belebt einen gefallenen verbündeten Champion als Wiedergänger wieder. Während der Beschwörung werden pro Sekunde <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} Leben<> verbraucht."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Feuere eine Schattenkugel ab, um auf einen getroffenen Feind zuzustürmen und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "skill2": "Stürme auf ein Ziel zu, während unanvisierbar, und greife dreimal hintereinander an, um pro Treffer <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "ult": "Stürmt auf einen Feind in einer Entfernung von {Range} zu und verursacht <#ff9028ff>physischen Schaden<> in Höhe von <#ff9028ff>{Damage}<> + {Coef} % der <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff<>."
      },
      "ogre": {
        "name": "Oger",
        "skill": "Jeder Schaden an einem Feindchampion erhöht maximale <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>HP<> um {Value}.",
        "skill2": "Schlage ein einzelnes Ziel mit einer Keule, um es <#ef5350ff>für {Time}s zu betäuben<> und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% der maximalen HP<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "ult": "Wird für {Time}s riesig und erhöht <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>maximales Leben um {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% des maximalen Lebens<>."
      },
      "plague_doctor": {
        "name": "Pestdoktor",
        "skill": "Injiziert einen Verbündeten und sich selbst, wodurch <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Angriffsgeschwindigkeit um {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Zauberkraft<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit um {MoveSpeed}%<> für <#ffb900ff>{Duration}s<> steigen.",
        "skill2": "Führt an einem Verbündeten ein Ritual aus, wodurch für <#ffb900ff>{Duration}s<> die <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite um {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% Zauberkraft<> steigt und Angriffe einen Ansturm erhalten.",
        "ult": "Verabreicht einem Verbündeten ein verbotenes Elixier und verringert dessen aktuelles Leben um {HpReduceRatio}%. Dafür kann es {Duration}s lang nicht unter 1 fallen, während <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Angriffsgeschwindigkeit um {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% Zauberkraft<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit um {MoveSpeed}%<> steigen."
      },
      "poison_dart_hunter": {
        "name": "Giftpfeil-Jäger",
        "skill": "Verteilt ein Giftfeld und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu, vergiftet für <#ffb900ff>{Duration}s<> und <#ef5350ff>verlangsamt um {Slow}%<>.",
        "skill2": "Angriffe auf vergiftete Feinde erhöhen die <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite um {Range}<>. Bewegung weg von vergifteten Feinden erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {Speed}%<>.",
        "ult": "Gewährt nahen Verbündeten für <#ffb900ff>{Duration}s<> Gift bei Angriffen. Gift verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> über <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Priester",
        "skill": "Platziere ein Heilfeld für {Duration}s in {Range}, das alle {Tick}s Verbündeten <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> HP <#6aff55ff>wiederherstellt<>.",
        "skill2": "Gewähre einem Verbündeten {Time}s lang einen <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> <#e8d44dff>Schild<>. Erhöht dessen <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<>, während der Schild hält.",
        "ult": "Fliegt für {Time}s in die Luft und wird stationär, feuert alle {Tick}s eine Kugel ab, die dem Verbündeten mit dem niedrigsten Leben in Ultimate-Reichweite <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#6aff55ff>Leben<> wiederherstellt."
      },
      "pyromancer": {
        "name": "Pyromant",
        "skill": "Lässt einen Feuerball fallen und fügt in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "skill2": "Beschwört ein Feuerfeld für {Duration}s, das alle {Tick}s in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> verursacht.",
        "ult": "Erzeugt eine massive Explosion in {Range} und fügt allen Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu."
      },
      "pythoness": {
        "name": "Pythoness",
        "skill": "Stelle einem Verbündeten <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> HP <#6aff55ff>wieder her<>.",
        "skill2": "Stelle <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als HP eines Verbündeten <#6aff55ff>wieder her<> und füge Feinden in {Range} um sie herum <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "ult": "Beschwöre ein Geistertor. Das Geistertor feuert Kugeln ab, die Verbündeten in {Range} <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> HP <#6aff55ff>wiederherstellen<>, oder Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zufügen."
      },
      "shadowmancer": {
        "name": "Schattenmagier",
        "skill": "Dunkle Schatten erheben sich und fügen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>fesseln für {Time}s<>.",
        "skill2": "Lässt den Schatten eines unbeweglichen Feindes explodieren und verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<>.",
        "ult": "Feuert ein durchdringendes Schattenprojektil ab und fügt getroffenen feindlichen Champions <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verbannt sie für {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Schildträger",
        "skill": "Gewähre einem angegebenen Verbündeten und dir selbst einen <#e8d44dff>Schild<> von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% max. HP<> für {Duration}s.",
        "skill2": "Übernimmt {Duration}s lang {Damage}% des Schadens an Verbündeten in der Nähe und <#ef5350ff>verlangsamt Angreifer um {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% der Rüstung<>.",
        "ult": "Erhält für {Duration}s <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% der Magieresistenz<> Schadensreduktion und Immunität gegen Kontrolleffekte, während alle Gegner in der Nähe <#ef5350ff>{TauntDuration}s lang verspottet<> werden. Kann währenddessen nicht bewegen."
      },
      "soldier": {
        "name": "Soldat",
        "skill": "<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Angriffsreichweite<> erhöht sich pro Stufe um {GrowthRange}.",
        "skill2": "Feuere drei Kugeln auf einen Feind ab für schweren <#ff9028ff>physischen Schaden<> (<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> pro Kugel). Fähigkeitsreichweite skaliert mit Grundangriffsreichweite.",
        "ult": "Feuert eine riesige Kugel ab, die in gerader Linie fliegt und Feinde in {Range} Reichweite anvisiert. Die Kugel fügt allen Feinden in der Flugbahn <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu, und jeder Treffer reduziert den Schaden um {Decay}%."
      },
      "swordman": {
        "name": "Schwertkämpfer",
        "skill": "Feuere Schwertenergie ab, um getroffenen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen (Reichweite {Range}).",
        "skill2": "Schlitze ein einzelnes Ziel dreimal hintereinander für schweren <#ff9028ff>physischen Schaden<>. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> pro Treffer.",
        "ult": "Stürme {Range} Distanz in gerader Linie und füge Feinden im Pfad <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Wenn du einen Gegner mit dem Ultimate tötest, wird dessen Abklingzeit zurückgesetzt."
      },
      "taoist": {
        "name": "Taoist",
        "skill": "Versiegelt einen Gegner mit einem Talisman, fügt ihm <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verhindert normale Angriffe für {Time}(+{TimeCoef}% der Zauberkraft)s<>.",
        "skill2": "Heftet einem Gegner einen Talisman an, fügt ihm <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verhindert das Benutzen von Fähigkeiten für {Time}(+{TimeCoef}% der Zauberkraft)s<>.",
        "ult": "Feuert ein Talisman-Projektil in gerader Linie. Verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und <#ef5350ff>setzt das Ziel für {Time}s außer Gefecht<> und macht es unzielbar. Wenn der Effekt endet, breitet er sich auf nahe Feinde aus."
      },
      "vampire": {
        "name": "Vampir",
        "skill": "Entziehe Blut eines Feindes, um <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zuzufügen, <#6aff55ff>{Heal} HP wiederherzustellen<> und zu stapeln. <#6aff55ff>HP-Heilung erhöht sich pro Stapel um {Stack}<>.",
        "skill2": "Verbrauche {Value}% HP, um Blut in einem vorderen Kegel zu speien und <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zuzufügen. Schaden erhöht sich pro Stapel um {Stack}.",
        "ult": "Wird unzielbar und stürmt eine Distanz von {Range}, <#6aff55ff>absorbiert HP<> in Höhe von <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> von jedem Feind in der Sturmbahn und verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% Zauberkraft<> als <#a974ffff>magischen Schaden<>."
      },
      "werewolf": {
        "name": "Werwolf",
        "skill": "Krallt nach vorn und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und <#6aff55ff>heilt {HealRatio}% des verursachten Schadens<>.",
        "skill2": "Stürmt nach vorn und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "ult": "Kanalisiert für <#ffb900ff>{Duration}s<> und verursacht wiederholt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> und wendet <#ef5350ff>Bluten für {BleedTime}s<> an (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% Angriff<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Verstärkt die Keule für <#ffb900ff>{Duration}s<>. Jeder Angriff erzeugt eine fächerförmige Schockwelle, die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> verursacht.",
        "skill2": "Verstärkt die Haut für <#ffb900ff>{Duration}s<> und erhält einen <#e8d44dff>Schild<> in Höhe von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> sowie <#e8d44dff>{DamageReduction}% Schadensreduktion<>.",
        "ult": "Feuert ein Projektil in gerader Linie. Getroffene Feinde werden <#ef5350ff>über {SlowTime}s allmählich verlangsamt<>, dann <#ef5350ff>für {BindTime}s gefesselt<>. Bei Fesselung erleiden nahe Feinde <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<>. Der Effekt breitet sich auf beschädigte Feinde aus."
      },
      "hammerer": {
        "name": "Schwerer Infanterist",
        "skill": "Schwinge einen Hammer auf einen nahen Feind, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen und <#ef5350ff>für {Time}s in die Luft zu werfen<>.",
        "skill2": "Konzentriere dich mit erhobenem Hammer, dann schlage auf den Boden, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> in {Range} zuzufügen und <#ef5350ff>{Move}% Verlangsamung für {Time}s<> zu gewähren.",
        "ult": "Schwingen Sie den Hammer weit und fügen Sie allen Feinden in einem halbkreisförmigen Bereich innerhalb von {Range} vor Ihnen <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> zu. Vom Hammer getroffene Gegner werden {Time} Sekunden lang zurückgeschleudert und gegnerische Champions, die vom gestoßenen Feind getroffen werden, sind <#ef5350ff>für {Airborne}s in der Luft<>."
      },
      "inquisitor": {
        "name": "Inquisitor",
        "skill": "Stürmt eine kurze Distanz und fügt dem ersten getroffenen Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und wendet <#ef5350ff>Bluten<> an.",
        "skill2": "Schlitzt einen markierten Feind und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. Setzt die Abklingzeit von Fähigkeit 1 zurück, wenn das Ziel <#ef5350ff>blutet<>.",
        "ult": "Stürmt auf einen feindlichen Champion zu und fügt allen Feinden im Bereich beim Aufprall <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Feinde unter {Threshold}% maximaler HP nach erlittenem Schaden werden hingerichtet. Bei Hinrichtung werden nahe Feinde <#ef5350ff>für {FearTime}s geängstigt<>."
      },
      "pole_warrior": {
        "name": "Stangenkrieger",
        "skill": "Springe auf einen Feind und schlage mit der Stange nieder, um <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "skill2": "Bewege eine kurze Distanz, stehe auf der Stange, um für {Time}s unanvisierbar zu werden, dann schwinge, um allen Feinden in {Range} <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen.",
        "ult": "Stürmt auf einen bestimmten Feind innerhalb von {Range} zu, fügt dem Feind <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% der Angriff<> als <#ff9028ff>physischen Schaden<> zu und hebt das Ziel <#ef5350ff>für {Time}s in die Luft<>."
      },
      "spirit_caller": {
        "name": "Geisterrufer",
        "skill": "Heftet einem Verbündeten für <#ffb900ff>{Duration}s<> einen Geist an, <#6aff55ff>heilt HP<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% Zauberkraft<> und erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {SpeedUp}%<>.",
        "skill2": "Heftet einem Gegner für <#ffb900ff>{Duration}s<> einen Geist an, verringert <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>Rüstung um {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% Zauberkraft<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>Magieresistenz um {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% Zauberkraft<> und <#ef5350ff>verlangsamt um {Slow}%<>.",
        "ult": "Lässt angeheftete Geister explodieren. Verbündeten-Geister gewähren <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Zauberkraft<> als <#e8d44dff>Schild<> und <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tempo<>. Feindliche Geister verursachen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und <#ef5350ff>betäuben für {StunTime}s<>."
      },
      "whip_master": {
        "name": "Peitschenmeister",
        "skill": "Schwingt die Peitsche und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% der Ziel-HP<> zu.",
        "skill2": "Schwingt die Peitsche in einem Kegel, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu und stößt Feinde zurück.",
        "ult": "Kanalisiert für <#ffb900ff>{Duration}s<> und feuert durchdringende Projektile, die <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> verursachen."
      },
      "enchanter": {
        "name": "Verzauberer",
        "skill": "Verstärkt einen Verbündeten für <#ffb900ff>{Duration}s<> und erhöht die <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite um {Increase}<>.",
        "skill2": "Verstärkt die Ausrüstung eines Verbündeten für <#ffb900ff>{Duration}s<> und erhöht Item-Werte um <#ffb900ff>{Percent}%<>.",
        "ult": "Verstärkt einen verbündeten Champion für {Duration}s und gewährt <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% Zauberkraft<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo {MoveSpeed}%<> und Immunität gegen Kontrolleffekte."
      },
      "siege_breaker": {
        "name": "Belagerungsbrecher",
        "skill": "Schlägt mit einem Morgenstern und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu. Verursacht {Bonus}% Bonusschaden an Strukturen.",
        "skill2": "Schlägt auf den Boden und fügt allen Feinden inkl. Strukturen <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Erhöht für {Time}s <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Angriff um {Attack}%<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AttackSpeed}%<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Gefangener",
        "skill": "Wirft eine Eisenkugel in einer Linie und fügt allen Feinden im Gebiet <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Brüllt, erhält für {Time}s einen <#e8d44dff>Schild<> in Höhe von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des maximalen Lebens<> und <#ef5350ff>verspottet<> alle Gegner in der Nähe.",
        "ult": "Stürmt auf einen Feind zu und fügt allen Feinden nahe der Landestelle <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>betäubt sie für {Time}s<>."
      },
      "android": {
        "name": "Android",
        "skill": "Feuere eine Schockwelle in gerader Linie ab. Die Schockwelle explodiert kreisförmig bei Feindtreffer oder am Reichweitenende und fügt Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt sie um {Slow}% für {Time}s<>.",
        "skill2": "Gewährt sich selbst für {Time}s einen <#e8d44dff>Schild<> in Höhe von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des maximalen Lebens<>. Wenn der Schild verschwindet, werden Gegner im Umkreis von {Range} für <#ef5350ff>{StunTime}s betäubt<>.",
        "ult": "Gewährt einem gewählten Verbündeten in {Range} Reichweite einen <#e8d44dff>Schild<> in Höhe von <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des maximalen Lebens<> und teleportiert sich nach {Time}s zu diesem Verbündeten."
      },
      "white_mage": {
        "name": "Weißer Magier",
        "skill": "Ein Strahl explodiert nach kurzer Verzögerung und fügt allen Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "skill2": "Beschwört Strahlen, die 5 Mal angreifen, fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>.",
        "ult": "Feuert einen durchdringenden Strahl, fügt getroffenen Feinden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> zu und <#ef5350ff>fesselt für {Time}s<>."
      },
      "wind_mage": {
        "name": "Windmagier",
        "skill": "Beschwört für <#ffb900ff>{Duration}s<> einen Wirbelsturm, der alle {Tick}s in {Range} <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> verursacht. Verbündete darin erhalten <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>.",
        "skill2": "Feuert fünf Wirbelstürme nach vorn und fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu.",
        "ult": "Lässt einen massiven Tornado los. Getroffene Feinde erleiden <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>für {AirborneTime}s in die Luft geschleudert<>. Größe, Schaden und Luftzeit sinken pro Treffer. Lenkt zu anderen Champions um."
      },
      "bomber": {
        "name": "Bomber",
        "skill": "Wirft eine Bombe und fügt allen Feinden im Gebiet <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> zu.",
        "skill2": "Platziert eine unsichtbare Mine, die bei Berührung <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriff<> als <#ff9028ff>physischen Schaden<> verursacht und <#ef5350ff>für {Time}s fesselt<>. Wird nicht durch Diener ausgelöst.",
        "ult": "Wirft eine große Bombe ins Zielgebiet, fügt allen Feinden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Kavallerieritter",
        "skill": "Stürme in gerader Linie, um den ersten getroffenen Feind <#ef5350ff>für {Time}s zu fesseln<> und <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zuzufügen. Sturmgeschwindigkeit skaliert mit Lauftempo.",
        "skill2": "Erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit {Time}s lang um {Speed}%<> und verstärkt die Waffe zu einer Flammenlanze, sodass Angriffe {BurnTime}s lang zusätzlich <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% Angriffsschaden<> als Brandschaden verursachen.",
        "ult": "Erhöht die <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Bewegungsgeschwindigkeit {Time}s lang um {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Angriffsschaden<> und erzeugt eine Zone, die zu deiner Position führt. Verbündete auf der Zone erhalten beim Bewegen in Richtung der Kavallerie <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% Angriffsschaden<> Bewegungsgeschwindigkeit."
      },
      "druid": {
        "name": "Druide",
        "skill": "Beschwört einen Bären. Stirbt er, erleidet der Druide <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% Zauberkraft<> Schaden. Erneutes Wirken <#6aff55ff>heilt den Bären<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<>.",
        "skill2": "Beschwört einen Adler. Stirbt der Adler, erleidet der Druide Schaden. Wird die Fähigkeit während der Beschwörung erneut eingesetzt, stürzt der Adler auf einen Gegner zu, verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und <#6aff55ff>heilt um {Lifesteal}% des verursachten Schadens<>.",
        "ult": "Feuert {Count} Bären- und Adlerseelen nacheinander in die gewählte Richtung. Jedes Projektil verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> als <#a974ffff>magischen Schaden<> und stößt Gegner zurück."
      },
      "voodoo_shaman": {
        "name": "Voodoo-Schamane",
        "skill": "Feuert ein Fluch-Projektil ab, fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu, <#ef5350ff>verlangsamt um {Slow}% für {Time}s<> und reduziert <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Tempo um {AtkSpd}%<> für <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Verflucht einen Feind für <#ffb900ff>{Time}s<>, fügt <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zu. Verursacht <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% Zauberkraft<> Bonusschaden pro erlittenem Treffer (max {Max}).",
        "ult": "Erschafft für <#ffb900ff>{Duration}s<> eine Voodoo-Zone. Feinde darin erleiden periodisch <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% maximale HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ef5350ff>stumm geschaltet<>."
      },
      "hitman": {
        "name": "Hitman",
        "skill": "Feuert einen Drei-Schuss-Burst. Der erste Schuss <#ef5350ff>betäubt für {StunTime}s<>, und die nächsten zwei Schüsse verursachen jeweils <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<>.",
        "skill2": "Teleportiert sich hinter den zuletzt angegriffenen feindlichen Champion in <#ffb900ff>{Range}<> Reichweite.",
        "ult": "Markiert einen gegnerischen Champion. Nach <#ffb900ff>{Duration}s<> verursacht die Markierung <#ff9028ff>{Damage} + {Coef}% des während der Markierung erlittenen Schadens<> als <#ff9028ff>physischen Schaden<>. Bei Tötung erhältst du <#ffb900ff>{InvisibleDuration}s<> Tarnung."
      },
      "guardian_spirit": {
        "name": "Schutzgeist",
        "skill": "<#6aff55ff>Heilt HP<> nahe Verbündeter um <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<>.",
        "skill2": "Gewährt einem Verbündeten <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% Zauberkraft<> als <#e8d44dff>Schild<> und <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>.",
        "ult": "Erschafft <#ffb900ff>{Duration}s<> lang ein Heiligtum, das Verbündete in Reichweite fortlaufend um <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Zauberkraft<> <#6aff55ff>heilt<>. Stirbt 1 verbündeter Champion im Heiligtum, wird er wiederbelebt und das Heiligtum endet sofort."
      },
      "hunter": {
        "name": "Jäger",
        "skill": "Teleportiert sich zu einem Feind und wechselt in den Fernkampfmodus. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>Reichweite steigt um {RangeIncrease}<>.",
        "marks": "Fernkampf-Standardangriffe markieren gegnerische Champions für <#ffb900ff>{Duration} Sek.<>. Weitere Treffer erneuern bestehende Markierungen. Die zweite Fähigkeit kann Gegner mit 3 Markierungen anvisieren.",
        "skill2": "Stürmt auf einen 3-Stack-markierten Feind, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>schaltet stumm für {SilenceTime}s<>.",
        "ult": "Stürmt nach vorn und fügt Feinden auf der Bahn <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Nach dem Wirken kann die Fähigkeit kurze Zeit einmal erneut gewirkt werden; bei Kill oder Assist kann sie ein weiteres Mal gewirkt werden."
      },
      "circus_blade": {
        "name": "Zirkusklinge",
        "skill": "Feuert eine Klinge in die Zielrichtung, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>verlangsamt um {Slow}% für {SlowTime}s<>. Speichert bis zu <#ffb900ff>{ChargeCount}<> Ladungen. Erhält <#ffb900ff>1<> Ladung bei Standardangriffen auf feindliche Champions.",
        "skill2": "Erhält für <#ffb900ff>{Duration}s<> <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% Lauftempo<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% Tempo<> und Wandphasing.",
        "ult": "Stürmt auf einen Feind zu, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Verursacht <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% Angriff<> Splash-Schaden und <#ef5350ff>stößt nahe Feinde zurück<>, dann verschwindet."
      },
      "sand_mage": {
        "name": "Sandmagier",
        "skill": "Grundangriffe laden Sandenergie auf und verursachen <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% Fähigkeitsstärke<> als <#a974ffff>zusätzlichen magischen Schaden<>. Dieser Zusatzschaden und die Sandexplosion können kritisch treffen. Bei Aktivierung explodiert Sand um das Ziel und verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Fähigkeitsstärke<> als <#a974ffff>magischen Flächenschaden<>.",
        "skill2": "Absorbiert Sandenergie für <#ffb900ff>{Time}s<>, erhöht <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>Lauftempo um {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% Fähigkeitsstärke<> und <#6aff55ff>heilt sich<> um <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% Fähigkeitsstärke<>.",
        "ult": "Errichtet um das Ziel einen Sandmorast für <#ffb900ff>{Duration}s<>. Alle {Tick}s erleiden Gegner darin <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Fähigkeitsstärke<> als <#a974ffff>magischen Schaden<> und werden zur Mitte gezogen."
      },
      "alchemist": {
        "name": "Alchemist",
        "skill": "Wirft eine Flasche, die explodiert und für <#ffb900ff>{Time}s<> eine toxische Fläche hinterlässt. Gegner darin werden für <#ffb900ff>{DotTime}s<> <#78e85cff>vergiftet<>, erleiden alle {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Fähigkeitsstärke<> als <#a974ffff>magischen Schaden<> und erhalten {HealReduce}% weniger Heilung.",
        "skill2": "Injiziert einem Gegner ein instabiles Reagenz und verursacht <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Fähigkeitsstärke<> als <#a974ffff>magischen Schaden<>. Für <#ffb900ff>{Time}s<> kann das Ziel nicht geheilt werden und wird um {Slow}% verlangsamt.",
        "ult": "Wirft eine toxische Flasche in einer Linie. Trifft sie einen gegnerischen Champion, entsteht für <#ffb900ff>{CloudTime}s<> eine Giftwolke, die sich bis auf {CloudRadius} Reichweite ausbreitet. Gegner in der Wolke werden für <#ffb900ff>{DotTime}s<> <#78e85cff>vergiftet<>, erleiden alle {DotTick}s <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Fähigkeitsstärke<> als <#a974ffff>magischen Schaden<> und verlieren <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% Fähigkeitsstärke<> Rüstung sowie <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% Fähigkeitsstärke<> Magieresistenz."
      },
      "crossbowman": {
        "name": "Armbrustschütze",
        "skill": "Feuert einen mächtigen Pfeil in einer Linie ab und verursacht am ersten getroffenen gegnerischen Champion <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Solange die Ultimativ-Markierung anhält, verursacht er zusätzlich <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Angriffsschaden<> Schaden.",
        "skill2": "Feuert einen durchschlagenden Pfeil geradeaus ab, verursacht an Gegnern <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> und stößt sich für <#ffb900ff>{BackstepTime}s<> zurück. Solange die Ultimativ-Markierung anhält, verursacht er zusätzlich <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% Angriffsschaden<> Schaden.",
        "ult": "Feuert ein Leuchtgeschoss in einer Linie ab, verursacht am ersten getroffenen gegnerischen Champion <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> und markiert ihn für <#ffb900ff>{Duration}s<>. Solange die Markierung anhält, treffen alle Fähigkeiten das Ziel unabhängig von der Entfernung und ihre Abklingzeit wird um <#ffb900ff>{CoolReduce}%<> verringert. Andere Champions auf der Flugbahn können den Treffer abfangen."
      },
      "nightmare": {
        "name": "Albtraum",
        "skill": "Feuert einen Albtraumsplitter geradeaus ab und verursacht beim ersten getroffenen Gegner <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Kann bis zu <#ffb900ff>{UseCount} Mal<> nacheinander eingesetzt werden.",
        "skill2": "Stürmt <#ffb900ff>{Range}<> in die gewählte Richtung, verursacht dann an Gegnern im Umkreis von <#ffb900ff>{Radius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> und wird <#ffb900ff>{StealthTime} Sekunden<> unsichtbar.",
        "ult": "Stürmt zum anvisierten gegnerischen Champion und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Stirbt das Ziel durch diesen Schaden, teleportiert sich Albtraum unabhängig von der Entfernung neben einen lebenden verbündeten Champion."
      },
      "strongman": {
        "name": "Kraftprotz",
        "skill": "Packt einen Gegner in der Nähe, wirft ihn über die Schulter hinter sich und verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<>. Das Ziel wird <#ef5350ff>{Stun} Sek. lang betäubt<>.",
        "skill2": "Schwingt seine Langhantel weit herum, fügt Gegnern im Umkreis von <#ffb900ff>{Range}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>stößt sie zurück<>.",
        "ult": "Wirft einen verbündeten Champion in der Nähe zum Zielort. Nach der Landung erhält der geworfene Verbündete für <#ffb900ff>{ShieldTime} Sek.<> einen <#e8d44dff>Schild von {Shield}<>. Gegner im Umkreis von <#ffb900ff>{Radius}<> um den Landepunkt erleiden <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> und werden <#ef5350ff>{Stun} Sek. lang betäubt<>. Ist kein Verbündeter zum Werfen in der Nähe, springt der Kraftprotz selbst; dann beträgt die Betäubungsdauer <#ef5350ff>{SelfStun} Sek.<>."
      },
      "harpooner": {
        "name": "Harpunier",
        "skill": "Feuert eine Harpune in einer geraden Linie ab und fügt dem ersten getroffenen gegnerischen Champion <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> zu. Nach einem Treffer kann die Fähigkeit <#ffb900ff>{RecastDuration}s<> lang erneut aktiviert werden, um sich zum Ziel oder das Ziel zu sich zu ziehen.",
        "skill2": "Feuert eine mächtige Harpune in einer geraden Linie ab und fügt dem ersten getroffenen Gegner <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> des fehlenden Lebens des Ziels als <#ff9028ff>physischen Schaden<> zu.",
        "ult": "Feuert <#ffb900ff>{ProjectileCount}<> Kettenharpunen in einem Kegel nach vorn ab, fügt getroffenen Gegnern <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% Angriffsschaden<> als <#ff9028ff>physischen Schaden<> zu und fesselt sie <#ffb900ff>{LinkDuration}s<> lang. Gefesselte Gegner werden um <#ef5350ff>{Slow}%<> verlangsamt. Entfernen sie sich weiter als <#ffb900ff>{LinkRange}<>, straffen sich die Ketten: Die Verlangsamung steigt auf <#ef5350ff>{TensionSlow}%<> und sie werden zueinander gezogen."
      },
      "spellbreaker": {
        "name": "Zauberbrecher",
        "skill": "Schwingt das Großschwert nach vorn, verursacht <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> <#ff9028ff>physischen Schaden<> und <#ef5350ff>verlangsamt {Time} Sekunden lang um {Slow}%<>.",
        "skill2": "Stürmt eine kurze Distanz vor und verursacht beim ersten getroffenen Gegner <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> <#ff9028ff>physischen Schaden<>. Danach wird der erlittene Schaden <#ffb900ff>{Time} Sekunden lang um {Reduce}% verringert<>.",
        "ult": "Zerstört sofort alle Schilde von Gegnern im Umkreis von <#ffb900ff>{Range}<>. Ein Gegner mit zerstörtem Schild erleidet <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% der Zauberkraft<> <#a974ffff>magischen Schaden<>, wird <#ef5350ff>{Stun} Sekunden lang betäubt<> und kann <#ffb900ff>{BlockTime} Sekunden lang keinen Schild erhalten<>. Gegner ohne Schild erleiden nur <#a974ffff>{Damage} magischen Schaden<>."
      },
      "gladiator": {
        "name": "Gladiator",
        "skill": "Wirft ein Netz fächerförmig (<#ffb900ff>{FanAngle}°<>) nach vorn, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>fesselt<> Gegner für <#ffb900ff>{Stun}s<>.",
        "skill2": "Sticht mit dem Dreizack nach vorn und fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Trifft er denselben Champion innerhalb von <#ffb900ff>{Time}s<> erneut, steigt der Schaden pro Stapel um <#ffb900ff>{Amplify}%<> (max. <#ffb900ff>{MaxAmplifyTargets}<> Stapel). Ein Treffer an einem anderen Champion setzt die Stapel zurück.",
        "ult": "Stürmt auf einen gegnerischen Champion zu, fügt <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und <#ef5350ff>provoziert<> ihn <#ffb900ff>{Stun}s<> lang. Während des Duells kann das Ziel weder geheilt werden noch neue Schilde erhalten, und der Gladiator erleidet <#ffb900ff>{Amplify}%<> weniger Schaden von anderen Gegnern. Das Duell endet, wenn die Provokation gereinigt wird oder das Ziel stirbt."
      },
      "ferryman": {
        "name": "Fährmann",
        "skill": "Wirft einen Anker, der den ersten Champion auf seinem Weg trifft. Verbündete mit höchstens <#ffb900ff>{AllyHpRatio}%<> HP werden zum Fährmann gezogen und erhalten <#ffb900ff>{Time}s<> lang <#ffb900ff>{Amplify}%<> Bewegungsgeschwindigkeit; Verbündete mit mehr HP werden übergangen. Gegner erleiden stattdessen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> und werden <#ffb900ff>{SlowTime}s<> lang um <#ffb900ff>{Slow}%<> verlangsamt.",
        "skill2": "Erschafft vor sich für <#ffb900ff>{Time}s<> einen Fluss mit <#ffb900ff>{Range}<> Länge und <#ffb900ff>{Width}<> Breite. Verbündete darauf erhalten <#ffb900ff>{Amplify}%<> Bewegungsgeschwindigkeit, Gegner werden um <#ffb900ff>{Slow}%<> verlangsamt.",
        "ult": "Reinigt einen anderen verbündeten Champion mit höchstens <#ffb900ff>{AllyHpRatio}%<> HP und bringt ihn per Boot in <#ffb900ff>{Time}s<> <#ffb900ff>{MoveDistance}<> weit in Richtung der eigenen Basis. Während der Fahrt ist er unanvisierbar, handlungsunfähig und immun gegen Bewegungskontrolle. Beim Anlegen erhält er <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% der Zauberkraft<> HP zurück und <#ffb900ff>{SlowTime}s<> lang <#ffb900ff>{Slow}%<> Bewegungsgeschwindigkeit."
      },
      "bombardier": {
        "name": "Kanonier",
        "skill": "Baut das Geschütz auf oder ab. Aufgebaut kann er sich nicht bewegen, aber die Reichweite von Standardangriffen und Fähigkeit 2 steigt um <#ffb900ff>{MoveDistance}<> und er erhält <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% Angriff<>. Nach dem Abbau erhält er <#ffb900ff>{Time}s<> lang <#ffb900ff>{Slow}%<> Bewegungsgeschwindigkeit.",
        "skill2": "Feuert eine Granate im Bogen auf den Zielort, fügt Gegnern im Radius <#ffb900ff>{Radius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu und verlangsamt sie <#ffb900ff>{SlowTime}s<> lang um <#ffb900ff>{Slow}%<>. Aufgebaut erhöht sich die Reichweite.",
        "ult": "Feuert <#ffb900ff>{ProjectileCount}<> Granaten in den gewählten Bereich. Jede fügt im Radius <#ffb900ff>{ProjectileRadius}<> <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des Angriffs<> als <#ff9028ff>physischen Schaden<> zu. Aufgebaut steigt die Reichweite zusätzlich um <#ffb900ff>{MoveDistance}<>. Kontrolleffekte unterbrechen die verbleibenden Schüsse."
      },
      "hypnotist": {
        "name": "Hypnotiseur",
        "skill": "Schickt ein durchdringendes Pendel nach vorn, das <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% Zauberkraft<> als <#a974ffff>magischen Schaden<> zufügt und <#ffb900ff>{SlowTime}s<> lang um <#ffb900ff>{Slow}%<> verlangsamt. Dieser Schaden weckt <#ef5350ff>schlafende<> Gegner nicht auf.",
        "skill2": "Versetzt Gegner im Radius <#ffb900ff>{Radius}<> nach <#ffb900ff>{Delay}s<> für <#ffb900ff>{Time}s<> in <#ef5350ff>Schlaf<>. Schlafende können sich weder bewegen noch handeln. Schaden – auch Schaden über Zeit – weckt das Ziel, und dieser erste Treffer verursacht <#ffb900ff>{Amplify}%<> mehr Schaden.",
        "ult": "Versetzt Gegner im Radius <#ffb900ff>{Radius}<> nach <#ffb900ff>{Delay}s<> für <#ffb900ff>{Time}s<> in <#ef5350ff>Schlaf<>. Schaden weckt das Ziel, und der weckende Treffer verursacht <#ffb900ff>{Amplify}%<> mehr Schaden. Reinigung entfernt sowohl den <#ef5350ff>Schlaf<> als auch den Schadensbonus."
      }
    }
  },
