    "description": {
      "astrologer": {
        "name": "Astrologue",
        "skill": "Après <#ffb900ff>{Delay} s<>, fait tomber une météorite à l'emplacement ciblé, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance en <#a974ffff>dégâts magiques<> aux ennemis dans la zone et réduisant leur vitesse de déplacement de <#ef5350ff>{Slow}%<> pendant <#ef5350ff>{SlowTime} s<>.",
        "skill2": "Inflige <#a974ffff>{LinkDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance en <#a974ffff>dégâts magiques<> aux ennemis en ligne droite et laisse une marque de constellation. La marque dure <#ffb900ff>{MarkTime} s<>, et les ennemis marqués subissent des dégâts supplémentaires lors de la détonation de la constellation de l'ultime.",
        "ult": "Trace une constellation dans la zone ciblée et marque tous les ennemis. Après <#ffb900ff>{Delay} s<>, toutes les marques explosent simultanément et infligent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance en <#a974ffff>dégâts magiques<>. Les dégâts augmentent de <#ffb900ff>{Amplify}%<> pour chaque ennemi relié supplémentaire. Les ennemis déjà marqués subissent <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> de la Puissance comme dégâts supplémentaires."
      },
      "archer": {
        "name": "Archer",
        "skill": "Sautez dans la direction indiquée et infligez <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à l'ennemi attaqué le plus récemment.",
        "skill2": "Tirez une flèche sur un ennemi proche pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>, <#ef5350ff>étourdir<> brièvement et sauter en arrière.",
        "ult": "Il s'arrête sur place et tire un total de {Count} flèches. La flèche vole vers un ennemi aléatoire dans la portée proche de {Range}, infligeant des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque."
      },
      "bard": {
        "name": "Barde",
        "skill": "Augmente la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque d'un allié de {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> pendant <#ffb900ff>{Duration}s<>.",
        "skill2": "Réduit le temps de recharge des compétences des alliés dans la zone ciblée de <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> pendant {Duration}s.",
        "ult": "Canalise pendant <#ffb900ff>{Duration}s<> : les champions alliés dans un rayon de {Range} gagnent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} d'attaque<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% de la puissance magique<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicPower} de puissance magique<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de vitesse d'attaque<> et {CoolReduce}% de réduction des temps de recharge, mais leur <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>défense diminue de {DefenceReduce}%<> et leur <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>résistance magique diminue de {MagicResistanceReduce}%<>."
      },
      "barrier_magician": {
        "name": "Mage de barrière",
        "skill": "Crée une barrière durant <#ffb900ff>{Duration}s<>, accordant aux alliés <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PM<> de <#e8d44dff>bouclier<> et réduisant la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque ennemie de {AttackSpeedReduce}%<>. À partir du niveau 3, accorde aux alliés une <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque<> bonus et <#ef5350ff>ralentit<> les ennemis.",
        "skill2": "Invoque une barrière durant <#ffb900ff>{Duration}s<> dans la zone ciblée qui détruit tous les projectiles à l'intérieur.",
        "ult": "Crée une barrière qui rétrécit autour d'un champion ennemi. Les ennemis touchant le bord subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et sont <#ef5350ff>étourdis pendant {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entrez en rage pendant {Duration}s, augmentant la vitesse d'attaque de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> et gagnant <#6aff55ff>{Vamp}% vol de vie<>.",
        "skill2": "Frappez le sol avec les deux mains pour lancer les ennemis dans une zone étroite <#ef5350ff>en l'air pendant {Time}s<> et infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>.",
        "ult": "{Range} Se précipite vers un ennemi désigné à portée et frappe l'ennemi, lui infligeant des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque. Le temps de recharge est réduit proportionnellement à la <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>santé<> perdue."
      },
      "boomerang_hunter": {
        "name": "Chasseur de boomerang",
        "skill": "Lance un boomerang en ligne, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. À portée maximale, il tourne et inflige continuellement <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> de <#ff9028ff>dégâts physiques<>.",
        "skill2": "Lance trois boomerangs qui reviennent, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis sur leur trajectoire.",
        "ult": "Tire un puissant boomerang en ligne droite, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. En frappant un champion ennemi, il rebondit vers le champion ennemi le plus proche, augmentant les dégâts de <#ff9028ff>{Increase}%<> par rebond. Rebondit jusqu'à {MaxBounce} fois."
      },
      "chef": {
        "name": "Chef",
        "skill": "Lance un couteau en ligne, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "skill2": "Distribue de la nourriture aux alliés proches, <#6aff55ff>soignant<> de <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PM<>. Soin uniquement sur soi augmente à <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% PM<>.",
        "ult": "Lance une nourriture spéciale à un champion allié. Pendant <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>les PV max augmentent de {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> des dégâts subis sont répartis en dégâts dans le temps."
      },
      "clown": {
        "name": "Clown",
        "skill": "Téléporte près d'une cible. Si ennemi, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et gagne <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<> pendant <#ffb900ff>{Duration}s<>.",
        "skill2": "Disperse des dagues autour, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> aux ennemis dans la zone. (Peut bouger pendant l'incantation)",
        "ult": "Entre en frénésie pendant <#ffb900ff>{Time}s<>. Toutes les dagues deviennent des dagues spéciales qui ricochent entre les ennemis."
      },
      "dancer": {
        "name": "Danseuse",
        "skill": "Lance un chakram sur un ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. Chaque chakram ajouté augmente les dégâts de cette compétence de {StackCoef}%.",
        "skill2": "Chaque kill ajoute un chakram aux attaques de base. (Max <#ffb900ff>{MaxCount}<>, dégâts diminuent de <#ffb900ff>{Reduce}%<> par chakram supplémentaire)",
        "ult": "Tire {Count}(+stacks) chakrams pénétrants en éventail, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. Les chakrams reviennent et infligent <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> de <#ff9028ff>dégâts physiques<>. (Max {MaxCount})"
      },
      "dark_mage": {
        "name": "Mage noir",
        "skill": "Tire une flèche sombre, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>enracinant pendant {Time}s<>.",
        "skill2": "Couvre une zone de ténèbres après un délai, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> aux ennemis à l'intérieur.",
        "ult": "Maudit un champion ennemi à {Range}, le liant à l'allié le plus proche pendant <#ffb900ff>{Duration}s<>. Quand l'un subit des dégâts, <#a974ffff>{ShareRatio}%<> sont transférés à l'autre."
      },
      "demon": {
        "name": "Démon",
        "skill": "Une griffe infernale surgit du sol pour saisir un ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et échangeant les positions.",
        "skill2": "Transformez-vous en un démon plus grand pendant {Time}s. Augmente l'attaque de <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, l'armure de <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, la vitesse d'attaque de <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> et la vitesse de déplacement de <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Inflige des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque à tous les ennemis à portée de {Range} et applique la <#ef5350ff>peur<> pendant {Time} secondes."
      },
      "dual_blader": {
        "name": "Double lame",
        "skill": "Tirez de l'énergie d'épée en ligne droite pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> aux ennemis touchés et <#ef5350ff>enraciner<> la cible pendant {Time}s.",
        "skill2": "Foncez sur un ennemi <#ef5350ff>immobile<> dans la portée de {Range}, lancez l'ennemi touché <#ef5350ff>en l'air pendant {Time}s<> et infligez <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "ult": "Coupe un ennemi dans la portée désignée de {Range} avec une épée, lui infligeant {Count} fois <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#f5f5f5ff>dégâts fixes<>."
      },
      "executioner": {
        "name": "Exécuteur",
        "skill": "Tirez un crochet pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> à un ennemi touché et le tirer vers vous.",
        "skill2": "Tranchez un ennemi avec un crochet pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et appliquer <#ef5350ff>saignement pendant {Duration}s<>. Les ennemis qui saignent subissent toutes les {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> et <#ef5350ff>reçoivent {Debuff}% de dégâts supplémentaires<>.",
        "ult": "Balaie les ennemis dans une zone semi-circulaire devant {Range} avec un crochet, leur infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> et les <#ef5350ff>empêchant de récupérer pendant {Time}s<>."
      },
      "exorcist": {
        "name": "Exorciste",
        "skill": "Annule les <#ef5350ff>effets de statut<> d'un allié et lui <#6aff55ff>rend {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> <#6aff55ff>PV<>. Supprime étourdissement, sommeil, immobilisation, peur, charme, provocation, projection en l’air et déplacement forcé. Ne supprime pas les effets appliqués comme des buffs, tels que ralentissement ou poison.",
        "skill2": "Accorde une protection divine à un allié pendant <#ffb900ff>{Duration}s<>, augmentant l'<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attaque de {Attack}<> et la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque de {AttackSpeed}%<>. Pendant l'effet, reflète les effets de contrôle.",
        "ult": "Crée une explosion sur la zone ciblée, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> aux ennemis. Inflige <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% PM<> de dégâts bonus par buff sur la cible."
      },
      "fighter": {
        "name": "Combattant",
        "skill": "Charge sur une cible à {Range} à la vitesse {Speed}, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et <#ef5350ff>étourdissant pendant {Stun}s<>.",
        "skill2": "Frappe le sol, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> aux ennemis dans {Range} et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "ult": "Frappe le sol, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> à tous les ennemis dans {Range} et les <#ef5350ff>projetant en l'air pendant {Time}s<>."
      },
      "gambler": {
        "name": "Joueur",
        "skill": "Lancez un dé et attaquez les ennemis dans la portée de {Range} un nombre de fois égal au résultat. Chaque attaque inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "skill2": "Lancez un jeton pour créer une zone dans la portée de {Range} qui <#ef5350ff>ralentit les ennemis de {Slow}%<> pendant {Time}s dans une zone de {AttackRange}. La zone explose à expiration, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> aux ennemis à l'intérieur.",
        "ult": "Tire une pile d'argent qui charme les ennemis en ligne droite. L'ennemi touché subit <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> et est <#ef5350ff>charmé pendant {Time}s<>."
      },
      "ghost": {
        "name": "Fantôme",
        "skill": "Devient inciblable et se déplace en ligne. Sur kill/assist, gagne <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} d'attaque<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de vitesse d'attaque<> et <#6aff55ff>restaure {Heal} de vie<>.",
        "skill2": "Se déplace une courte distance et inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> au premier ennemi touché. Peut être utilisé jusqu'à {Time} fois de suite.",
        "ult": "Devient immunisé au contrôle de foule pendant <#ffb900ff>{Time}s<>. Tuer ou assister à un kill réinitialise le cooldown de la compétence basique."
      },
      "gunner": {
        "name": "Tireur",
        "skill": "Peut attaquer les ennemis en se déplaçant. À partir du niveau 3, chaque attaque augmente la vitesse de déplacement de <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> pendant {Time}s.",
        "skill2": "Renforcez les attaques pendant {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>la puissance d'attaque augmente de {Attack}<>. Chaque 3e attaque <#ef5350ff>ralentit l'ennemi de {Slow}% pendant {SlowTime}s<>.",
        "ult": "L'attaque est renforcée pendant {Time} secondes, la puissance d'attaque augmente de <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> et des balles supplémentaires sont tirées sur 2 ennemis autour de la cible d'attaque. Les balles supplémentaires infligent des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque."
      },
      "ice_mage": {
        "name": "Mage de glace",
        "skill": "Gelez un ennemi pour infliger <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> et <#ef5350ff>étourdir pendant {Time}s<>.",
        "skill2": "Invoquez un champ de glace pendant {Duration}s qui <#ef5350ff>ralentit la vitesse de déplacement des ennemis dans {Range} de {MoveSpeed}%<> et inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> toutes les {Tick}s. Gèle et <#ef5350ff>étourdit pendant {Stun}s<> à la fin.",
        "ult": "Inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> aux ennemis dans un cône frontal et les repousse. <#ef5350ff>Ralentit de {Slow}% pendant {SlowDuration}s<> et <#ef5350ff>bloque les compétences de mouvement pendant {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Illusionniste",
        "skill": "Tire un projectile, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et invoquant une illusion qui <#ef5350ff>provoque pendant {Time}s<>.",
        "skill2": "Inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> aux ennemis dans {Range} et les <#ef5350ff>terrifie pendant {Time}s<>.",
        "ult": "Crée une illusion d'un champion allié proche qui dure <#ffb900ff>{Duration}s<>. L'illusion ne peut effectuer que des attaques de base et a les mêmes statistiques que le champion copié."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Invoque un petit jiangshi qui charge sur un ennemi et attaque 3 fois avant de disparaître, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> par coup.",
        "skill2": "Frappe un ennemi pour <#ef5350ff>étourdir pendant {Time}s<>, infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>, et <#6aff55ff>restaurer {Heal} de vie<>.",
        "ult": "Pendant <#ffb900ff>{Duration}s<>, draine <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PM<> de <#6aff55ff>vie<> aux ennemis dans {Range} et inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% PM<> de <#a974ffff>dégâts magiques<>."
      },
      "knight": {
        "name": "Chevalier",
        "skill": "Désigne une cible et la <#ef5350ff>provoque pendant {Time}s<>.",
        "skill2": "S'octroie un <#e8d44dff>bouclier<> pendant {Time}s (valeur du <#e8d44dff>bouclier<> : <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des PV max<> + <#e8d44dff>{Amount}<>). Renvoie <#ff9028ff>{Reflect}%<> des dégâts subis tant que le bouclier tient.",
        "ult": "Invoque à l'emplacement ciblé une zone défensive de portée {Range} pendant <#ffb900ff>{Time}s<>. Les alliés dans la zone subissent <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% des PV max<> de dégâts en moins, et les ennemis dans la zone sont <#ef5350ff>ralentis de {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancier",
        "skill": "Poussez les ennemis dans {Range} en arrière et infligez <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "skill2": "Chargez une courte distance pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% AD<> de <#ff9028ff>dégâts physiques<> et vous déplacer derrière l'ennemi.",
        "ult": "Charge {Range} de distance, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> à tous les ennemis rencontrés pendant la charge et les <#ef5350ff>projetant en l'air pendant {Time}s<>."
      },
      "lightning_mage": {
        "name": "Mage de foudre",
        "skill": "Tire un éclair sur une cible, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<>. Se propage aux ennemis proches sans dupliquer les cibles.",
        "skill2": "Fait s'abattre un éclair dans une zone, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>étourdissant pendant {Time}s<>.",
        "ult": "Canalise un rayon d'éclair sur un champion ennemi pendant <#ffb900ff>{Duration}s<>, l'<#ef5350ff>étourdissant<>. Inflige continuellement <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> à la cible et aux ennemis proches."
      },
      "magic_knight": {
        "name": "Chevalier magique",
        "skill": "Explosez du mana dans une longue ligne étroite pour infliger <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance magique comme <#a974ffff>dégâts magiques<>.",
        "skill2": "Créez un noyau de mana pendant {Duration}s qui attire les ennemis dans {Range} vers le centre toutes les {Tick}s et inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance magique comme <#a974ffff>dégâts magiques<>.",
        "ult": "Pendant <#ffb900ff>{Time}s<>, <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>la portée augmente de {Range}<> et <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la vitesse d'attaque augmente de {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% de la puissance magique<>. Les attaques de base déclenchent la première compétence."
      },
      "monk": {
        "name": "Moine",
        "skill": "<#6aff55ff>Soigne<> les alliés dans {Range} de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>. Lors d'un auto-ciblage seul, les soins augmentent à <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>.",
        "skill2": "Coup de paume pour infliger <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> dans {Range} et <#ef5350ff>étourdir pendant {Time}s<>.",
        "ult": "Octroie aux alliés dans une portée de {Range} un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>. Les alliés protégés gagnent <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<>."
      },
      "necromancer": {
        "name": "Nécromancien",
        "skill": "Invoque une goule comme serviteur pendant <#ffb900ff>{Duration}(+{DurationCoef}% de la puissance magique)s<>. Les niveaux réduisent le délai de récupération et augmentent la durée de la goule de <#ffb900ff>{DurationPerLevel}s<> par niveau.",
        "skill2": "Marque un ennemi comme cible d'attaque pendant <#ffb900ff>{Time}s<> pour rendre les goules furieuses. Les goules gagnent <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% de la puissance magique<> de vitesse d'attaque et <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% de la puissance magique<> de vitesse de déplacement.",
        "ult": "Ranime un champion allié mort en revenant. Tant que l'invocation est maintenue, consomme <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} PV<> par seconde."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Tirez une orbe d'ombre pour charger sur un ennemi touché et infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "skill2": "Chargez sur une cible tout en étant inciblable et attaquez trois fois de suite, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> par coup.",
        "ult": "Charge un ennemi à moins de {Range} de distance, lui infligeant des <#ff9028ff>dégâts physiques<> égaux à <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> de la puissance d'attaque."
      },
      "ogre": {
        "name": "Ogre",
        "skill": "Chaque dégât à un champion ennemi augmente la santé max de <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value}<>.",
        "skill2": "Frappez une cible unique avec une massue pour <#ef5350ff>étourdir pendant {Time}s<> et infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% de la santé max<> comme <#ff9028ff>dégâts physiques<>.",
        "ult": "Devient gigantesque pendant {Time}s, augmentant <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>les PV max de {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% des PV max<>."
      },
      "plague_doctor": {
        "name": "Médecin de la peste",
        "skill": "Injecte un allié et soi-même, augmentant <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la vitesse d'attaque de {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% de la puissance magique<> et <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>la vitesse de déplacement de {MoveSpeed}%<> pendant <#ffb900ff>{Duration}s<>.",
        "skill2": "Effectue un rituel sur un allié pendant <#ffb900ff>{Duration}s<>, augmentant <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>la portée de {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% de la puissance magique<> et ajoutant une ruée aux attaques.",
        "ult": "Administre un élixir interdit à un allié, réduisant ses PV actuels de {HpReduceRatio}% ; pendant {Duration}s, ses PV ne peuvent pas tomber sous 1, tandis que <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>l'attaque augmente de {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la vitesse d'attaque de {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% de la puissance magique<> et <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>la vitesse de déplacement de {MoveSpeed}%<>."
      },
      "poison_dart_hunter": {
        "name": "Chasseur à sarbacane",
        "skill": "Répand un champ de poison, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>, empoisonnant pendant <#ffb900ff>{Duration}s<> et <#ef5350ff>ralentissant de {Slow}%<>.",
        "skill2": "Attaquer des ennemis empoisonnés augmente la <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>portée de {Range}<>. S'éloigner d'ennemis empoisonnés augmente la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {Speed}%<>.",
        "ult": "Accorde aux alliés proches du poison sur leurs attaques pendant <#ffb900ff>{Duration}s<>. Le poison inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> sur <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Prêtre",
        "skill": "Placez un champ de <#6aff55ff>soin<> pendant {Duration}s dans {Range} qui <#6aff55ff>restaure {Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> de santé des alliés toutes les {Tick}s.",
        "skill2": "Accordez à un allié un <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> de <#e8d44dff>bouclier<> pendant {Time}s. <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Augmente sa vitesse d'attaque de {AttackSpeed}%<> pendant que le bouclier dure.",
        "ult": "Vole en l'air pendant {Time}s en restant immobile, tirant une balle toutes les {Tick}s qui <#6aff55ff>restaure {Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> de <#6aff55ff>vie<> à l'allié avec le moins de PV dans la portée de l'ulti."
      },
      "pyromancer": {
        "name": "Pyromancien",
        "skill": "Lâche une boule de feu, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> dans {Range}.",
        "skill2": "Invoque un champ de feu durant {Duration}s, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> toutes les {Tick}s dans {Range}.",
        "ult": "Crée une explosion massive dans {Range}, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> à tous les ennemis."
      },
      "pythoness": {
        "name": "Pythonisse",
        "skill": "<#6aff55ff>Soigne<> un allié de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>.",
        "skill2": "<#6aff55ff>Soigne<> un allié de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> et inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> aux ennemis dans {Range} autour de lui.",
        "ult": "Invoquez une Porte Spirituelle. La Porte Spirituelle tire des projectiles qui <#6aff55ff>soignent<> les alliés dans {Range} de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>, ou infligent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> aux ennemis."
      },
      "shadowmancer": {
        "name": "Mage des ombres",
        "skill": "Des ombres sombres s'élèvent, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>enracinant pendant {Time}s<>.",
        "skill2": "Fait exploser l'ombre d'un ennemi immobilisé, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<>.",
        "ult": "Tire un projectile d'ombre pénétrant, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> aux champions ennemis touchés et les <#ef5350ff>bannissant pendant {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Porteur de bouclier",
        "skill": "Accordez un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% PV max.<> à un allié et à vous-même pendant {Duration}s.",
        "skill2": "Pendant {Duration}s, subit {Damage}% des dégâts infligés aux alliés proches et <#ef5350ff>ralentit les attaquants de {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% de l'armure<>.",
        "ult": "Gagne pendant {Duration}s <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% de la résistance magique<> de réduction des dégâts et une immunité aux contrôles, tout en <#ef5350ff>provoquant tous les ennemis proches pendant {TauntDuration}s<>. Ne peut pas se déplacer pendant l'effet."
      },
      "soldier": {
        "name": "Soldat",
        "skill": "Portée d'attaque augmente de <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> par niveau.",
        "skill2": "Tirez trois balles sur un ennemi pour des <#ff9028ff>dégâts physiques<> lourds (<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque par balle). Portée de compétence échelle avec portée d'attaque de base.",
        "ult": "{Range} Tire une énorme balle qui vole en ligne droite, ciblant les ennemis à distance. La balle inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis dans la trajectoire de passage, et chaque fois qu'elle touche un ennemi, les dégâts sont réduits de {Decay}%."
      },
      "swordman": {
        "name": "Épéiste",
        "skill": "Tirez de l'énergie d'épée pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<> aux ennemis touchés (portée {Range}).",
        "skill2": "Tranchez une cible unique trois fois de suite pour des <#ff9028ff>dégâts physiques<> lourds. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque par coup.",
        "ult": "Charge une distance de {Range} en ligne droite, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> aux ennemis à portée de charge. Si l'ultime tue un ennemi, son temps de recharge est réinitialisé."
      },
      "taoist": {
        "name": "Taoïste",
        "skill": "Scelle un ennemi avec un talisman, lui inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> et <#ef5350ff>l'empêche d'effectuer des attaques de base pendant {Time}(+{TimeCoef}% de la puissance magique)s<>.",
        "skill2": "Attache un talisman à un ennemi, lui inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> comme <#a974ffff>dégâts magiques<> et <#ef5350ff>l'empêche d'utiliser des compétences pendant {Time}(+{TimeCoef}% de la puissance magique)s<>.",
        "ult": "Tire un projectile de talisman en ligne droite. Inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> et <#ef5350ff>incapacite la cible pendant {Time}s<>, la rendant inciblable. Quand l'effet se termine, il se propage aux ennemis proches."
      },
      "vampire": {
        "name": "Vampire",
        "skill": "Drainez le sang d'un ennemi pour infliger <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance magique comme <#a974ffff>dégâts magiques<>, <#6aff55ff>restaurer<> <#6aff55ff>{Heal}<> santé et empiler. Soins augmentent de {Stack} par pile.",
        "skill2": "Consommez {Value}% santé pour cracher du sang dans un cône avant, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> de la puissance magique comme <#a974ffff>dégâts magiques<>. Dégâts augmentent de {Stack} par pile.",
        "ult": "Devient impossible à cibler et charge sur une distance de {Range}, <#6aff55ff>absorbant de la santé<> égale à <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> de chaque ennemi dans la trajectoire, et infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de puissance magique<> en <#a974ffff>dégâts magiques<>."
      },
      "werewolf": {
        "name": "Loup-garou",
        "skill": "Griffe en avant, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et <#6aff55ff>se soignant de {HealRatio}% des dégâts infligés<>.",
        "skill2": "Se déplace en avant, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "ult": "Canalise pendant <#ffb900ff>{Duration}s<>, infligeant à plusieurs reprises <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et appliquant <#ef5350ff>saignement pendant {BleedTime}s<> (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Améliore la massue pendant <#ffb900ff>{Duration}s<>. Chaque attaque crée une onde de choc en éventail infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>.",
        "skill2": "Renforce sa peau pendant <#ffb900ff>{Duration}s<>, gagnant un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> et <#e8d44dff>{DamageReduction}% de réduction des dégâts<>.",
        "ult": "Tire un projectile en ligne droite. Les ennemis touchés sont <#ef5350ff>progressivement ralentis pendant {SlowTime}s<>, puis <#ef5350ff>enracinés pendant {BindTime}s<>. À l'enracinement, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> aux ennemis proches. L'effet se propage aux ennemis blessés."
      },
      "hammerer": {
        "name": "Infanterie lourde",
        "skill": "Balancez un marteau sur un ennemi proche pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> comme <#ff9028ff>dégâts physiques<> et le <#ef5350ff>lancer en l'air pendant {Time}s<>.",
        "skill2": "Concentrez-vous avec le marteau levé, puis frappez le sol pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> comme <#ff9028ff>dégâts physiques<> dans {Range} et appliquer <#ef5350ff>{Move}% de ralentissement pendant {Time}s<>.",
        "ult": "Faites pivoter largement le marteau, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> à tous les ennemis dans une zone semi-circulaire à portée de {Range} devant. Les ennemis touchés par le marteau sont repoussés pendant {Time}s, et les champions ennemis touchés par l'ennemi poussé <#ef5350ff>sont en l'air pendant {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisiteur",
        "skill": "Se déplace une courte distance, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> au premier ennemi touché et appliquant <#ef5350ff>saignement<>.",
        "skill2": "Tranche un ennemi ciblé, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. Réinitialise le cooldown de la Compétence 1 si <#ef5350ff>saigne<>.",
        "ult": "Charge vers un champion ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> à tous les ennemis dans la zone à l'arrivée. Les ennemis sous {Threshold}% de PV max après les dégâts sont exécutés. À l'exécution, les ennemis proches sont <#ef5350ff>terrifiés pendant {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Guerrier de perche",
        "skill": "Sautez sur un ennemi et frappez avec la perche pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des dégâts d'attaque comme <#ff9028ff>dégâts physiques<>.",
        "skill2": "Déplacez une courte distance, tenez-vous sur la perche pour devenir inciblable pendant {Time}s, puis balancez pour infliger <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis dans {Range}.",
        "ult": "Charge sur un ennemi désigné à portée de {Range}, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de la puissance d'attaque<> comme <#ff9028ff>dégâts physiques<> à l'ennemi et <#ef5350ff>soulève la cible dans les airs pendant {Time}s<>."
      },
      "spirit_caller": {
        "name": "Invocateur d'esprit",
        "skill": "Attache un esprit à un allié pendant <#ffb900ff>{Duration}s<>, <#6aff55ff>soignant<> <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% PM<> et augmentant la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {SpeedUp}%<>.",
        "skill2": "Attache un esprit à un ennemi pendant <#ffb900ff>{Duration}s<>, réduisant <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>l'armure de {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% de la puissance magique<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>la résistance magique de {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% de la puissance magique<> et <#ef5350ff>ralentissant de {Slow}%<>.",
        "ult": "Détonne les esprits attachés. Les esprits alliés accordent <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PM<> de <#e8d44dff>bouclier<> et <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de vitesse d'attaque<>. Les esprits ennemis infligent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> et <#ef5350ff>étourdissent pendant {StunTime}s<>."
      },
      "whip_master": {
        "name": "Maître du fouet",
        "skill": "Fait tournoyer le fouet, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% des PV de la cible<>.",
        "skill2": "Fait tournoyer le fouet en cône, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et repoussant les ennemis.",
        "ult": "Canalise pendant <#ffb900ff>{Duration}s<>, tirant des projectiles pénétrants infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>."
      },
      "enchanter": {
        "name": "Enchanteur",
        "skill": "Améliore un allié pendant <#ffb900ff>{Duration}s<>, augmentant la <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>portée de {Increase}<>.",
        "skill2": "Améliore l'équipement allié pendant <#ffb900ff>{Duration}s<>, augmentant les statistiques d'objet de <#ffb900ff>{Percent}%<>.",
        "ult": "Renforce un champion allié pendant {Duration}s, accordant <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attaque {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% PM<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement {MoveSpeed}%<> et immunité au contrôle de foule."
      },
      "siege_breaker": {
        "name": "Briseur de siège",
        "skill": "Frappe avec un fléau, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<>. Inflige {Bonus}% de dégâts bonus aux structures.",
        "skill2": "Frappe le sol, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis y compris les structures.",
        "ult": "Pendant {Time}s, augmente l'<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>attaque de {Attack}%<>, la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque de {AttackSpeed}%<> et la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Prisonnier",
        "skill": "Lance une boule de fer en ligne, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis dans la zone.",
        "skill2": "Pousse un cri pour gagner un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des PV max<> pendant {Time}s et <#ef5350ff>provoquer<> tous les ennemis proches.",
        "ult": "Charge vers un ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> à tous les ennemis près du point d'atterrissage et les <#ef5350ff>étourdissant pendant {Time}s<>."
      },
      "android": {
        "name": "Androïde",
        "skill": "Tire une onde de choc en ligne droite. L'onde explose en cercle en touchant un ennemi ou en fin de portée, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> comme <#ff9028ff>dégâts physiques<> et <#ef5350ff>ralentissant les ennemis de {Slow}% pendant {Time}s<>.",
        "skill2": "S'octroie un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des PV max<> pendant {Time}s. Lorsque le bouclier disparaît, <#ef5350ff>étourdit les ennemis dans une portée de {Range} pendant {StunTime}s<>.",
        "ult": "Octroie à un allié ciblé dans une portée de {Range} un <#e8d44dff>bouclier<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% des PV max<> et se téléporte vers cet allié après {Time}s."
      },
      "white_mage": {
        "name": "Mage blanc",
        "skill": "Un rayon explose après un délai, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> à tous les ennemis.",
        "skill2": "Invoque des rayons pour attaquer 5 fois, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>.",
        "ult": "Tire un rayon pénétrant, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> aux ennemis touchés et <#ef5350ff>enracinant pendant {Time}s<>."
      },
      "wind_mage": {
        "name": "Mage du vent",
        "skill": "Invoque une tornade pendant <#ffb900ff>{Duration}s<>, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> toutes les {Tick}s dans {Range}. Les alliés à l'intérieur gagnent <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<>.",
        "skill2": "Tire cinq tornades en avant, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<>.",
        "ult": "Lance une tornade massive. Les ennemis touchés subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et sont <#ef5350ff>projetés en l'air pendant {AirborneTime}s<>. Taille, dégâts et temps en l'air diminuent par coup. Redirige vers d'autres champions."
      },
      "bomber": {
        "name": "Bombardier",
        "skill": "Lance une bombe, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> à tous les ennemis dans la zone.",
        "skill2": "Place une mine invisible qui inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>dégâts physiques<> et <#ef5350ff>enracine pendant {Time}s<> quand on marche dessus. Ne se déclenche pas avec les sbires.",
        "ult": "Lance une grosse bombe sur la zone ciblée, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> à tous les ennemis et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Chevalier de cavalerie",
        "skill": "Chargez en ligne droite pour empaler le premier ennemi touché, <#ef5350ff>enracinant pendant {Time}s<> et infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> comme <#ff9028ff>dégâts physiques<>. Vitesse de charge proportionnelle à la vitesse de déplacement.",
        "skill2": "Augmente la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {Speed}%<> pendant {Time}s et transforme l'arme en lance enflammée, ajoutant aux attaques <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% des dégâts d'attaque<> en dégâts de brûlure pendant {BurnTime}s.",
        "ult": "Augmente la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% des dégâts d'attaque<> pendant {Time}s et crée une zone menant à sa position. Les alliés sur la zone gagnent <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% des dégâts d'attaque<> de vitesse de déplacement lorsqu'ils se déplacent vers la cavalerie."
      },
      "druid": {
        "name": "Druide",
        "skill": "Invoque un ours. S'il meurt, le druide subit <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% PM<> de dégâts. Lancer pendant qu'il est invoqué <#6aff55ff>soigne<> l'ours de <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PM<>.",
        "skill2": "Invoque un aigle. Si l'aigle meurt, le druide subit des dégâts. Utiliser la compétence pendant que l'aigle est invoqué le fait charger un ennemi, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> et <#6aff55ff>soignant {Lifesteal}% des dégâts infligés<>.",
        "ult": "Lance {Count} projectiles d'esprit d'ours et d'aigle dans la direction ciblée. Chaque projectile inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<> en <#a974ffff>dégâts magiques<> et repousse les ennemis."
      },
      "voodoo_shaman": {
        "name": "Chaman vaudou",
        "skill": "Tire un projectile de malédiction, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<>, <#ef5350ff>ralentissant de {Slow}% pendant {Time}s<> et réduisant la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>vitesse d'attaque de {AtkSpd}%<> pendant <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Maudit un ennemi pendant <#ffb900ff>{Time}s<>, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<>. Inflige <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% PM<> de dégâts bonus par coup reçu (max {Max}).",
        "ult": "Crée une zone vaudou pendant <#ffb900ff>{Duration}s<>. Les ennemis dedans subissent <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% des PV max<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> périodiquement et sont <#ef5350ff>silencés<>."
      },
      "hitman": {
        "name": "Tueur à gages",
        "skill": "Tire une rafale de trois tirs. Le premier tir <#ef5350ff>étourdit pendant {StunTime}s<>, et chacun des deux tirs suivants inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>.",
        "skill2": "Se téléporte derrière le dernier champion ennemi attaqué dans <#ffb900ff>{Range}<> de portée.",
        "ult": "Marque un champion ennemi. Après <#ffb900ff>{Duration}s<>, inflige <#ff9028ff>{Damage} + {Coef}% des dégâts subis pendant la marque<> en <#ff9028ff>dégâts physiques<>. En cas d'élimination, gagne la furtivité pendant <#ffb900ff>{InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Esprit gardien",
        "skill": "<#6aff55ff>Soigne<> les alliés proches de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la puissance magique<>.",
        "skill2": "Accorde à un allié <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PM<> de <#e8d44dff>bouclier<> et <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<>.",
        "ult": "Crée un sanctuaire pendant <#ffb900ff>{Duration}s<> qui <#6aff55ff>soigne<> continuellement les alliés à portée de <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PM<>. Si 1 champion allié meurt dans le sanctuaire, il est ressuscité et le sanctuaire prend fin immédiatement."
      },
      "hunter": {
        "name": "Chasseur",
        "skill": "Se téléporte sur un ennemi et passe en mode distance. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>La portée augmente de {RangeIncrease}<>.",
        "marks": "Les attaques de base à distance marquent les champions ennemis pendant <#ffb900ff>{Duration}s<>. Les coups suivants renouvellent les marques existantes. La deuxième compétence peut cibler les ennemis portant 3 marques.",
        "skill2": "Se déplace sur un ennemi marqué de 3 stacks, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> et <#ef5350ff>silençant pendant {SilenceTime}s<>.",
        "ult": "Se déplace en avant, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> aux ennemis sur la trajectoire. Après son lancement, peut être relancée une fois pendant un bref moment; participer à une élimination accorde une relance supplémentaire."
      },
      "circus_blade": {
        "name": "Lame de Cirque",
        "skill": "Tire une lame dans la direction ciblée, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> et <#ef5350ff>ralentissant de {Slow}% pendant {SlowTime}s<>. Stocke jusqu'à <#ffb900ff>{ChargeCount}<> charges. Gagne <#ffb900ff>1<> charge en attaquant basiquement des champions ennemis.",
        "skill2": "Gagne <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de vitesse de déplacement<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de vitesse d'attaque<> et la traversée des murs pendant <#ffb900ff>{Duration}s<>.",
        "ult": "Se déplace sur un ennemi ciblé, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. Inflige <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% AD<> de dégâts de splash et <#ef5350ff>repousse les ennemis proches<>, puis disparaît."
      },
      "sand_mage": {
        "name": "Mage du sable",
        "skill": "Les attaques de base portent l'énergie du sable et infligent <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% de puissance magique<> en <#a974ffff>dégâts magiques bonus<>. Ces dégâts bonus et l'explosion de sable peuvent infliger un coup critique. À l'activation, fait exploser le sable autour de la cible et inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> en <#a974ffff>dégâts magiques de zone<>.",
        "skill2": "Absorbe l'énergie du sable pendant <#ffb900ff>{Time}s<>, augmente la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>vitesse de déplacement de {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% de puissance magique<> et <#6aff55ff>se soigne<> de <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% de puissance magique<>.",
        "ult": "Crée un marais de sable autour de la cible pendant <#ffb900ff>{Duration}s<>. Toutes les {Tick}s, les ennemis à l'intérieur subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> en <#a974ffff>dégâts magiques<> et sont attirés vers le centre."
      },
      "alchemist": {
        "name": "Alchimiste",
        "skill": "Lance une fiole qui explose et laisse une zone toxique pendant <#ffb900ff>{Time}s<>. Les ennemis dans la zone sont <#78e85cff>empoisonnés<> pendant <#ffb900ff>{DotTime}s<>, subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> en <#a974ffff>dégâts magiques<> toutes les {DotTick}s, et leurs soins sont réduits de {HealReduce}%.",
        "skill2": "Injecte un réactif instable à un ennemi, infligeant <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> en <#a974ffff>dégâts magiques<>. Pendant <#ffb900ff>{Time}s<>, la cible ne peut pas être soignée et est ralentie de {Slow}%.",
        "ult": "Lance une fiole toxique en ligne droite. Lorsqu'elle touche un champion ennemi, elle crée un nuage toxique qui s'étend jusqu'à {CloudRadius} de portée pendant <#ffb900ff>{CloudTime}s<>. Les ennemis dans le nuage sont <#78e85cff>empoisonnés<> pendant <#ffb900ff>{DotTime}s<>, subissent <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de puissance magique<> en <#a974ffff>dégâts magiques<> toutes les {DotTick}s, et perdent <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% de puissance magique<> d'armure ainsi que <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% de puissance magique<> de résistance magique."
      },
      "crossbowman": {
        "name": "Arbalétrier",
        "skill": "Tire une puissante flèche en ligne droite, infligeant <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> au premier champion ennemi touché. Tant que la marque de l'ultime dure, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de dégâts d'attaque<> supplémentaires.",
        "skill2": "Tire une flèche perforante droit devant, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> aux ennemis et recule pendant <#ffb900ff>{BackstepTime}s<>. Tant que la marque de l'ultime dure, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de dégâts d'attaque<> supplémentaires.",
        "ult": "Tire une balle traçante en ligne droite, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> au premier champion ennemi touché et le marque pendant <#ffb900ff>{Duration}s<>. Tant que la marque dure, toutes les compétences touchent la cible quelle que soit la distance et leurs délais de récupération sont réduits de <#ffb900ff>{CoolReduce}%<>. Les autres champions sur la trajectoire peuvent intercepter le tir."
      },
      "nightmare": {
        "name": "Cauchemar",
        "skill": "Tire un éclat de cauchemar en ligne droite et inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> au premier ennemi touché. Peut être utilisé jusqu'à <#ffb900ff>{UseCount} fois<> d'affilée.",
        "skill2": "Fonce de <#ffb900ff>{Range}<> dans la direction choisie, puis inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> aux ennemis dans un rayon de <#ffb900ff>{Radius}<> et devient invisible pendant <#ffb900ff>{StealthTime} s<>.",
        "ult": "Fonce sur le champion ennemi ciblé et inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. Si ces dégâts tuent la cible, se téléporte près d'un champion allié vivant quelle que soit la distance."
      },
      "strongman": {
        "name": "Homme fort",
        "skill": "Saisit un ennemi proche, le projette par-dessus son épaule derrière lui et lui inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>, tout en <#ef5350ff>l'étourdissant pendant {Stun} s<>.",
        "skill2": "Fait tournoyer sa barre dans un large mouvement, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> aux ennemis dans un rayon de <#ffb900ff>{Range}<> et <#ef5350ff>les repousse<>.",
        "ult": "Projette un champion allié proche vers l'emplacement ciblé. Après l'atterrissage, l'allié projeté obtient un <#e8d44dff>bouclier de {Shield}<> pendant <#ffb900ff>{ShieldTime} s<>. Les ennemis dans un rayon de <#ffb900ff>{Radius}<> autour du point d'impact subissent <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> et sont <#ef5350ff>étourdis pendant {Stun} s<>. Si aucun allié proche ne peut être projeté, l'Homme fort bondit lui-même ; dans ce cas, l'étourdissement dure <#ef5350ff>{SelfStun} s<>."
      },
      "harpooner": {
        "name": "Harponneur",
        "skill": "Lance un harpon en ligne droite et inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des Dégâts d'attaque en <#ff9028ff>dégâts physiques<> au premier champion ennemi touché. Pendant <#ffb900ff>{RecastDuration} s<> après l'impact, la compétence peut être réactivée pour attirer le lanceur vers la cible ou la cible vers le lanceur.",
        "skill2": "Lance un puissant harpon en ligne droite et inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des Dégâts d'attaque + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> des PV manquants de la cible en <#ff9028ff>dégâts physiques<> au premier ennemi touché.",
        "ult": "Lance <#ffb900ff>{ProjectileCount}<> harpons enchaînés en cône devant soi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> des Dégâts d'attaque en <#ff9028ff>dégâts physiques<> et entravant les cibles touchées pendant <#ffb900ff>{LinkDuration} s<>. Les cibles entravées sont ralenties de <#ef5350ff>{Slow}%<>. Si elles s'éloignent de plus de <#ffb900ff>{LinkRange}<>, les chaînes se tendent : le ralentissement passe à <#ef5350ff>{TensionSlow}%<> et elles sont attirées l'une vers l'autre."
      },
      "spellbreaker": {
        "name": "Brise-sort",
        "skill": "Balaye l'avant avec l'espadon, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de l’Attaque<> de <#ff9028ff>dégâts physiques<> et <#ef5350ff>ralentit de {Slow}% pendant {Time} s<>.",
        "skill2": "Charge sur une courte distance et inflige au premier ennemi touché <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de l’Attaque<> de <#ff9028ff>dégâts physiques<>. Après la charge, <#ffb900ff>les dégâts subis sont réduits de {Reduce}% pendant {Time} s<>.",
        "ult": "Détruit instantanément tous les boucliers des ennemis dans un rayon de <#ffb900ff>{Range}<>. Un ennemi dont le bouclier est détruit subit <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de la Puissance magique<> de <#a974ffff>dégâts magiques<>, est <#ef5350ff>étourdi pendant {Stun} s<> et <#ffb900ff>ne peut plus recevoir de bouclier pendant {BlockTime} s<>. Un ennemi sans bouclier ne subit que <#a974ffff>{Damage} dégâts magiques<>."
      },
      "gladiator": {
        "name": "Gladiateur",
        "skill": "Lance un filet en éventail de <#ffb900ff>{FanAngle}°<>, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> et <#ef5350ff>enracinant<> les ennemis pendant <#ffb900ff>{Stun}s<>.",
        "skill2": "Frappe droit devant avec un trident, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<>. Toucher le même champion dans les <#ffb900ff>{Time}s<> ajoute <#ffb900ff>{Amplify}%<> de dégâts par cumul, jusqu'à <#ffb900ff>{MaxAmplifyTargets}<> cumuls. Toucher un autre champion réinitialise les cumuls.",
        "ult": "Fonce sur un champion ennemi, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> et le <#ef5350ff>provoquant<> pendant <#ffb900ff>{Stun}s<>. Pendant le duel, la cible ne peut ni être soignée ni recevoir de nouveaux boucliers, et le Gladiateur subit <#ffb900ff>{Amplify}%<> de dégâts en moins des autres ennemis. Le duel prend fin si la provocation est purifiée ou si la cible meurt."
      },
      "ferryman": {
        "name": "Passeur",
        "skill": "Lance une ancre qui frappe le premier champion sur sa trajectoire. Un allié ayant au plus <#ffb900ff>{AllyHpRatio}%<> de PV est attiré auprès du Passeur et gagne <#ffb900ff>{Amplify}%<> de vitesse de déplacement pendant <#ffb900ff>{Time}s<>. Les alliés en meilleure santé sont ignorés. Un ennemi subit à la place <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et est ralenti de <#ffb900ff>{Slow}%<> pendant <#ffb900ff>{SlowTime}s<>.",
        "skill2": "Crée devant lui une rivière de <#ffb900ff>{Range}<> de long et <#ffb900ff>{Width}<> de large pendant <#ffb900ff>{Time}s<>. Les alliés qui s'y trouvent gagnent <#ffb900ff>{Amplify}%<> de vitesse de déplacement, et les ennemis sont ralentis de <#ffb900ff>{Slow}%<>.",
        "ult": "Purifie un autre champion allié ayant au plus <#ffb900ff>{AllyHpRatio}%<> de PV, puis le transporte en barque sur <#ffb900ff>{MoveDistance}<> vers la base alliée en <#ffb900ff>{Time}s<>. Le passager est inciblable, ne peut pas agir et est insensible aux contrôles de mouvement. À l'arrivée, il récupère <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% PM<> PV et gagne <#ffb900ff>{Slow}%<> de vitesse de déplacement pendant <#ffb900ff>{SlowTime}s<>."
      },
      "bombardier": {
        "name": "Artilleur",
        "skill": "Met en batterie ou replie le canon. En batterie, il ne peut pas se déplacer, mais la portée de ses attaques de base et de sa compétence 2 augmente de <#ffb900ff>{MoveDistance}<> et il gagne <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Amplify}% d'attaque<>. Après le repli, il gagne <#ffb900ff>{Slow}%<> de vitesse de déplacement pendant <#ffb900ff>{Time}s<>.",
        "skill2": "Tire un obus en cloche sur la zone ciblée, infligeant <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> dans un rayon de <#ffb900ff>{Radius}<> et ralentissant les ennemis de <#ffb900ff>{Slow}%<> pendant <#ffb900ff>{SlowTime}s<>. La mise en batterie augmente la portée.",
        "ult": "Tire <#ffb900ff>{ProjectileCount}<> obus sur la zone choisie. Chacun inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% des dégâts d'attaque<> en <#ff9028ff>dégâts physiques<> dans un rayon de <#ffb900ff>{ProjectileRadius}<>. En batterie, la portée augmente encore de <#ffb900ff>{MoveDistance}<>. Un contrôle de foule interrompt les tirs restants."
      },
      "hypnotist": {
        "name": "Hypnotiseur",
        "skill": "Projette un pendule perforant qui inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PM<> de <#a974ffff>dégâts magiques<> et ralentit de <#ffb900ff>{Slow}%<> pendant <#ffb900ff>{SlowTime}s<>. Ces dégâts ne réveillent pas les ennemis <#ef5350ff>endormis<>.",
        "skill2": "Après <#ffb900ff>{Delay}s<>, plonge les ennemis dans un rayon de <#ffb900ff>{Radius}<> dans le <#ef5350ff>sommeil<> pendant <#ffb900ff>{Time}s<>. Le sommeil empêche de se déplacer et d'agir. Les dégâts, y compris les dégâts dans le temps, réveillent la cible, et ce premier coup inflige <#ffb900ff>{Amplify}%<> de dégâts supplémentaires.",
        "ult": "Après <#ffb900ff>{Delay}s<>, plonge les ennemis dans un rayon de <#ffb900ff>{Radius}<> dans le <#ef5350ff>sommeil<> pendant <#ffb900ff>{Time}s<>. Les dégâts réveillent la cible, et le coup qui la réveille inflige <#ffb900ff>{Amplify}%<> de dégâts supplémentaires. La purification retire le <#ef5350ff>sommeil<> et son bonus de dégâts."
      }
    }
  },
