    "description": {
      "astrologer": {
        "name": "Astrólogo",
        "skill": "Tras <#ffb900ff>{Delay} s<>, hace caer un meteoro en la ubicación seleccionada que inflige <#a974ffff>{Damage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del Poder de Habilidad como <#a974ffff>daño mágico<> a los enemigos del área y reduce su Velocidad de Movimiento un <#ef5350ff>{Slow}%<> durante <#ef5350ff>{SlowTime} s<>.",
        "skill2": "Inflige <#a974ffff>{LinkDamage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del Poder de Habilidad como <#a974ffff>daño mágico<> a los enemigos en línea recta y deja una marca de constelación. La marca dura <#ffb900ff>{MarkTime} s<>, y los enemigos marcados reciben daño adicional en la detonación de la constelación de la definitiva.",
        "ult": "Dibuja una constelación en el área seleccionada y marca a todos los enemigos. Tras <#ffb900ff>{Delay} s<>, todas las marcas explotan a la vez e infligen <#a974ffff>{Damage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del Poder de Habilidad como <#a974ffff>daño mágico<>. El daño aumenta un <#ffb900ff>{Amplify}%<> por cada enemigo adicional enlazado. Los enemigos que ya estaban marcados reciben un <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MarkCoef}%<> del Poder de Habilidad como daño adicional."
      },
      "archer": {
        "name": "Arquero",
        "skill": "Salta en la dirección indicada e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> al enemigo atacado más recientemente.",
        "skill2": "Dispara una flecha a un enemigo cercano para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>, <#ef5350ff>aturdir<> brevemente y saltar hacia atrás.",
        "ult": "Se detiene en su lugar y dispara un total de {Count} flechas. La flecha vuela hacia un enemigo aleatorio dentro del rango cercano de {Range}, infligiendo <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque."
      },
      "bard": {
        "name": "Bardo",
        "skill": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque de un aliado un {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del Poder de Habilidad<> durante <#ffb900ff>{Duration}s<>.",
        "skill2": "Reduce el tiempo de reutilización de habilidades de los aliados en el área designada en <#ffb900ff>{CoolReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del Poder de Habilidad<> durante {Duration}s.",
        "ult": "Canaliza durante <#ffb900ff>{Duration}s<>: los campeones aliados en un radio de {Range} ganan <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} de ataque<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% del Poder de Habilidad<>), <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicPower} de Poder de Habilidad<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<> y un {CoolReduce}% de reducción de enfriamientos, pero su <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>defensa se reduce un {DefenceReduce}%<> y su <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistencia mágica se reduce un {MagicResistanceReduce}%<>."
      },
      "barrier_magician": {
        "name": "Mago de barrera",
        "skill": "Crea una barrera que dura <#ffb900ff>{Duration}s<>, otorgando a los aliados <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y reduciendo la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque enemiga en {AttackSpeedReduce}%<>. Desde el nivel 3, otorga a los aliados <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque<> adicional y <#ef5350ff>ralentiza<> a los enemigos.",
        "skill2": "Invoca una barrera que dura <#ffb900ff>{Duration}s<> en el área designada que destruye todos los proyectiles dentro.",
        "ult": "Crea una barrera que se reduce alrededor de un campeón enemigo. Los enemigos que toquen el borde reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y son <#ef5350ff>aturdidos durante {Time}s<>."
      },
      "berserker": {
        "name": "Berserker",
        "skill": "Entra en furia por {Duration}s, aumentando la velocidad de ataque en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> y ganando <#6aff55ff>{Vamp}% robo de vida<>.",
        "skill2": "Golpea el suelo con ambas manos para lanzar enemigos en un área estrecha <#ef5350ff>al aire por {Time}s<> e infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "ult": "{Range} Corre hacia un enemigo designado dentro de un rango y lo golpea, infligiéndole <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque. El tiempo de recuperación se reduce en proporción a la <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>salud<> perdida."
      },
      "boomerang_hunter": {
        "name": "Cazador de bumerán",
        "skill": "Lanza un bumerán en línea, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Al alcance máximo gira, causando continuamente <#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}% AD<> de <#ff9028ff>daño físico<>.",
        "skill2": "Lanza tres bumeranes que regresan, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos en su trayectoria.",
        "ult": "Dispara un poderoso bumerán en línea recta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Al impactar a un campeón enemigo, rebota hacia el campeón enemigo más cercano, aumentando el daño en <#ff9028ff>{Increase}%<> por rebote. Rebota hasta {MaxBounce} veces."
      },
      "chef": {
        "name": "Chef",
        "skill": "Lanza un cuchillo en línea, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "skill2": "Distribuye comida a aliados cercanos para <#6aff55ff>restaurar vida<> continuamente por <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<>. La curación solo a sí mismo aumenta a <#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}% PH<>.",
        "ult": "Lanza comida especial a un campeón aliado. Durante <#ffb900ff>{Duration}s<>, <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>la vida máxima aumenta un {HpRatio}%<>. <#e8d44dff>{SpreadRatio}%<> del daño recibido se distribuye como daño con el tiempo."
      },
      "clown": {
        "name": "Payaso",
        "skill": "Teletransporta junto a un objetivo. Si es enemigo, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y obtiene <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<> durante <#ffb900ff>{Duration}s<>.",
        "skill2": "Esparce dagas alrededor, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a enemigos en el área. (Puede moverse mientras lanza)",
        "ult": "Entra en frenesí durante <#ffb900ff>{Time}s<>. Todas las dagas se convierten en dagas especiales que rebotan entre enemigos."
      },
      "dancer": {
        "name": "Bailarina",
        "skill": "Lanza un chakram a un enemigo, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Cada chakram añadido aumenta el daño de esta habilidad un {StackCoef}%.",
        "skill2": "Cada eliminación añade un chakram a los ataques básicos. (Máx <#ffb900ff>{MaxCount}<>, el daño se reduce un <#ffb900ff>{Reduce}%<> por chakram extra)",
        "ult": "Dispara {Count}(+acumulación) chakrams penetrantes en abanico, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Los chakrams regresan, causando <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}% AD<> de <#ff9028ff>daño físico<>. (Máx {MaxCount})"
      },
      "dark_mage": {
        "name": "Mago oscuro",
        "skill": "Dispara una flecha oscura, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>enraizando durante {Time}s<>.",
        "skill2": "Cubre un área con oscuridad tras un retraso, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a los enemigos dentro.",
        "ult": "Maldice a un campeón enemigo en {Range}, vinculándolo con el aliado más cercano durante <#ffb900ff>{Duration}s<>. Cuando uno recibe daño, <#a974ffff>{ShareRatio}%<> se transfiere al otro."
      },
      "demon": {
        "name": "Demonio",
        "skill": "Una garra infernal surge del suelo para agarrar a un enemigo, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> y cambiando posiciones.",
        "skill2": "Transfórmate en un demonio mayor por {Time}s. Aumenta ataque en <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<>, armadura en <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{Defense}<>, velocidad de ataque en <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> y velocidad de movimiento en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<>.",
        "ult": "Inflige <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque a todos los enemigos dentro del rango {Range} y aplica <#ef5350ff>miedo<> durante {Time} segundos."
      },
      "dual_blader": {
        "name": "Doble espada",
        "skill": "Dispara energía de espada en línea recta para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos golpeados y <#ef5350ff>enraizar<> al objetivo por {Time}s.",
        "skill2": "Carga contra un enemigo <#ef5350ff>inmóvil<> dentro de {Range}, lanza al enemigo golpeado <#ef5350ff>al aire por {Time}s<> e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "ult": "Corta a un enemigo dentro del rango designado {Range} con una espada, infligiendo {Count} veces <#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#f5f5f5ff>daño fijo<>."
      },
      "executioner": {
        "name": "Ejecutor",
        "skill": "Dispara un gancho para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a un enemigo golpeado y tirarlo hacia ti.",
        "skill2": "Corta un enemigo con un gancho para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> y aplicar <#ef5350ff>sangrado por {Duration}s<>. Enemigos sangrando sufren cada {Tick}s <#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%<> del daño de ataque como <#ff9028ff>daño físico<> y <#ef5350ff>reciben {Debuff}% más daño<>.",
        "ult": "Barre a los enemigos en un área semicircular frente a {Range} con un gancho, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>dejándolos incapaces de curarse durante {Time}s<>."
      },
      "exorcist": {
        "name": "Exorcista",
        "skill": "Anula los <#ef5350ff>efectos de estado<> de un aliado y <#6aff55ff>restaura {Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> de <#6aff55ff>salud<>. Elimina aturdimiento, sueño, inmovilización, miedo, encanto, provocación, lanzamiento por los aires y desplazamiento forzado. No elimina efectos aplicados como buffs, como ralentización o veneno.",
        "skill2": "Otorga protección divina a un aliado durante <#ffb900ff>{Duration}s<>, aumentando el <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque en {Attack}<> y la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque en {AttackSpeed}%<>. Mientras esté activo, refleja efectos de control de masas.",
        "ult": "Crea una explosión en el área objetivo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos. Causa <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}% PH<> de daño bonus por cada buff en el objetivo."
      },
      "fighter": {
        "name": "Luchador",
        "skill": "Embiste a un objetivo en {Range} a {Speed} de velocidad, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>aturdiendo durante {Stun}s<>.",
        "skill2": "Golpea el suelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a enemigos en {Range} y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Golpea el suelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en {Range} y <#ef5350ff>lanzándolos al aire durante {Time}s<>."
      },
      "gambler": {
        "name": "Jugador",
        "skill": "Tira un dado y ataca enemigos dentro de {Range} un número de veces igual al resultado. Cada ataque inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Lanza una ficha para crear un área dentro de {Range} que <#ef5350ff>ralentiza enemigos en {Slow}%<> por {Time}s en un área de {AttackRange}. El área explota al expirar, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos dentro.",
        "ult": "Dispara una pila de dinero que encanta a los enemigos en línea recta. El enemigo golpeado recibe <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> y queda <#ef5350ff>encantado durante {Time}s<>."
      },
      "ghost": {
        "name": "Fantasma",
        "skill": "Se vuelve no objetivo y se desplaza en línea. Al matar/asistir, gana <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack} de ataque<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<> y <#6aff55ff>restaura {Heal} de vida<>.",
        "skill2": "Se desplaza una distancia corta y causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> al primer enemigo golpeado. Puede usarse hasta {Time} veces seguidas.",
        "ult": "Se vuelve inmune al control de masas durante <#ffb900ff>{Time}s<>. Matar o asistir reinicia el cooldown de la habilidad básica."
      },
      "gunner": {
        "name": "Tirador",
        "skill": "Puede atacar enemigos mientras se mueve. Desde nivel 3, cada ataque aumenta velocidad de movimiento en <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Value}%<> por {Time}s.",
        "skill2": "Mejora los ataques por {Time}s, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>aumentando el poder de ataque en {Attack}<>. Cada 3er ataque aplica <#ef5350ff>{Slow}% de ralentización por {SlowTime}s<>.",
        "ult": "El ataque se fortalece durante {Time} segundos, el poder de ataque aumenta en <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Attack}<> y se disparan balas adicionales a 2 enemigos alrededor del objetivo del ataque. Las balas adicionales infligen <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque."
      },
      "ice_mage": {
        "name": "Mago de hielo",
        "skill": "Congela un enemigo para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#ef5350ff>aturdir por {Time}s<>.",
        "skill2": "Invoca un campo de hielo por {Duration}s que <#ef5350ff>ralentiza la velocidad de movimiento de enemigos en {Range} en {MoveSpeed}%<> e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> cada {Tick}s. Congela y <#ef5350ff>aturde por {Stun}s<> al final.",
        "ult": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos en cono frontal y los empuja. <#ef5350ff>Ralentiza un {Slow}% durante {SlowDuration}s<> y <#ef5350ff>bloquea habilidades de movimiento durante {BlockDuration}s<>."
      },
      "illusionist": {
        "name": "Ilusionista",
        "skill": "Dispara un proyectil, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> e invocando una ilusión que <#ef5350ff>provoca durante {Time}s<>.",
        "skill2": "Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a enemigos en {Range} y los <#ef5350ff>aterroriza durante {Time}s<>.",
        "ult": "Crea una ilusión de un campeón aliado cercano que dura <#ffb900ff>{Duration}s<>. La ilusión solo realiza ataques básicos y tiene los mismos atributos que el campeón copiado."
      },
      "jiangshi": {
        "name": "Jiangshi",
        "skill": "Invoca un pequeño jiangshi que embiste a un enemigo y ataca 3 veces antes de desaparecer, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> por golpe.",
        "skill2": "Golpea a un enemigo para <#ef5350ff>aturdir durante {Time}s<>, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>, y <#6aff55ff>restaura {Heal} de vida<>.",
        "ult": "Durante <#ffb900ff>{Duration}s<>, drena <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<> de <#6aff55ff>vida<> a enemigos en {Range} y causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% PH<> de <#a974ffff>daño mágico<>."
      },
      "knight": {
        "name": "Caballero",
        "skill": "Designa un objetivo y le aplica <#ef5350ff>provocación durante {Time}s<>.",
        "skill2": "Otorga a sí mismo un <#e8d44dff>escudo<> durante {Time}s (valor del <#e8d44dff>escudo<>: <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de la salud máxima<> + <#e8d44dff>{Amount}<>). Refleja <#ff9028ff>{Reflect}%<> del daño recibido mientras el escudo está activo.",
        "ult": "Invoca en la ubicación seleccionada una zona defensiva de alcance {Range} durante <#ffb900ff>{Time}s<>. Los aliados dentro reciben <#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% de la salud máxima<> menos daño, y los enemigos dentro se <#ef5350ff>ralentizan un {MoveSpeedReduce}%<>."
      },
      "lancer": {
        "name": "Lancero",
        "skill": "Empuja enemigos en {Range} hacia atrás e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Carga una corta distancia para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}% del daño de ataque<> como <#ff9028ff>daño físico<> y moverte detrás del enemigo.",
        "ult": "Carga {Range} de distancia, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos encontrados mientras carga y <#ef5350ff>los lanza al aire por {Time}s<>."
      },
      "lightning_mage": {
        "name": "Mago de rayo",
        "skill": "Dispara un rayo a un objetivo, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>. Salta a enemigos cercanos sin duplicar objetivos.",
        "skill2": "Cae un rayo en un área, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>aturdiendo durante {Time}s<>.",
        "ult": "Canaliza un rayo a un campeón enemigo durante <#ffb900ff>{Duration}s<>, <#ef5350ff>aturdiéndolo<>. Causa continuamente <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> al objetivo y enemigos cercanos."
      },
      "magic_knight": {
        "name": "Caballero mágico",
        "skill": "Explota mana en una línea larga y estrecha para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>.",
        "skill2": "Crea un núcleo de mana por {Duration}s que atrae enemigos en {Range} hacia el centro cada {Tick}s e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>.",
        "ult": "Durante <#ffb900ff>{Time}s<>, <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>el alcance aumenta en {Range}<> y <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la velocidad de ataque aumenta en {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% del poder de habilidad<>. Los ataques básicos activan la primera habilidad."
      },
      "monk": {
        "name": "Monje",
        "skill": "<#6aff55ff>Restaura<> a aliados en {Range} de <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> de salud. Cuando solo se cura a sí mismo, la curación aumenta a <#6aff55ff>{SingleValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>.",
        "skill2": "Golpe de palma para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> en {Range} y <#ef5350ff>aturdir por {Time}s<>.",
        "ult": "Otorga a los aliados en un alcance de {Range} un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>. Los aliados con escudo obtienen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>."
      },
      "necromancer": {
        "name": "Nigromante",
        "skill": "Invoca un necrófago como sirviente durante <#ffb900ff>{Duration}(+{DurationCoef}% del poder de habilidad)s<>. El nivel reduce el enfriamiento y aumenta la duración del necrófago en <#ffb900ff>{DurationPerLevel}s<> por nivel.",
        "skill2": "Marca a un enemigo como objetivo de ataque durante <#ffb900ff>{Time}s<> para enfurecer a los necrófagos. Los necrófagos obtienen <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% del poder de habilidad<> de velocidad de ataque y <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MoveSpeedCoef}% del poder de habilidad<> de velocidad de movimiento.",
        "ult": "Revive a un campeón aliado muerto como espectro. Mientras la invocación se mantiene, consume <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain} de salud<> por segundo."
      },
      "ninja": {
        "name": "Ninja",
        "skill": "Dispara una orbe de sombra para cargar contra un enemigo golpeado e infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Carga contra un objetivo mientras inalcanzable y ataca tres veces en sucesión, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> por golpe.",
        "ult": "Carga a un enemigo dentro de una distancia de {Range}, infligiendo <#ff9028ff>daño físico<> equivalente a <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del poder de ataque."
      },
      "ogre": {
        "name": "Ogro",
        "skill": "Cada daño a un campeón enemigo aumenta salud máxima en <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Value}<>.",
        "skill2": "Golpea un objetivo único con una maza para <#ef5350ff>aturdir por {Time}s<> e infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% de la salud máxima<> como <#ff9028ff>daño físico<>.",
        "ult": "Se vuelve gigantesco durante {Time}s, aumentando <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>la salud máxima en {Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}% de la salud máxima<>."
      },
      "plague_doctor": {
        "name": "Médico de la plaga",
        "skill": "Inyecta a un aliado y a sí mismo, aumentando <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la velocidad de ataque un {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% del poder de habilidad<> y <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>la velocidad de movimiento un {MoveSpeed}%<> durante <#ffb900ff>{Duration}s<>.",
        "skill2": "Realiza un ritual sobre un aliado durante <#ffb900ff>{Duration}s<>, aumentando <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>el alcance en {Range}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{RangeCoef}% del poder de habilidad<> y añadiendo embestida a los ataques.",
        "ult": "Administra un elixir prohibido a un aliado, reduciendo su salud actual un {HpReduceRatio}%; durante {Duration}s su salud no puede caer por debajo de 1, mientras aumenta <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>el ataque en {Attack}<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>la velocidad de ataque en {AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackSpeedCoef}% del poder de habilidad<> y <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>la velocidad de movimiento en {MoveSpeed}%<>."
      },
      "poison_dart_hunter": {
        "name": "Cazador de dardos venenosos",
        "skill": "Esparce un campo de veneno, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>, envenenando durante <#ffb900ff>{Duration}s<> y <#ef5350ff>ralentizando un {Slow}%<>.",
        "skill2": "Atacar a enemigos envenenados aumenta el <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>alcance en {Range}<>. Alejarse de enemigos envenenados aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {Speed}%<>.",
        "ult": "Otorga veneno a los ataques de aliados cercanos durante <#ffb900ff>{Duration}s<>. El veneno causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> durante <#ffb900ff>{PoisonDuration}s<>."
      },
      "priest": {
        "name": "Sacerdote",
        "skill": "Coloca un campo de <#6aff55ff>curación<> por {Duration}s en {Range} que <#6aff55ff>restaura {Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> de salud de aliados cada {Tick}s.",
        "skill2": "Otorga a un aliado un <#e8d44dff>escudo<> de <#e8d44dff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> por {Time}s. <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>Aumenta su velocidad de ataque en {AttackSpeed}%<> mientras dura el escudo.",
        "ult": "Vuela en el aire durante {Time}s y se vuelve inmóvil, disparando una bala cada {Tick}s que <#6aff55ff>restaura {Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> de <#6aff55ff>vida<> al aliado con menor vida en el alcance del ulti."
      },
      "pyromancer": {
        "name": "Piromante",
        "skill": "Lanza una bola de fuego, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> en {Range}.",
        "skill2": "Invoca un campo de fuego que dura {Duration}s, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> cada {Tick}s en {Range}.",
        "ult": "Crea una explosión masiva en {Range}, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a todos los enemigos."
      },
      "pythoness": {
        "name": "Pitonesa",
        "skill": "<#6aff55ff>Restaura<> la salud de un aliado en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>.",
        "skill2": "<#6aff55ff>Restaura<> la salud de un aliado en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos en {Range} alrededor de ellos.",
        "ult": "Invoca una Puerta Espiritual. La Puerta Espiritual dispara proyectiles que <#6aff55ff>restauran<> la salud de los aliados en {Range} en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>, o infligen <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a los enemigos."
      },
      "shadowmancer": {
        "name": "Mago de sombras",
        "skill": "Sombras oscuras se elevan, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>enraizando durante {Time}s<>.",
        "skill2": "Hace estallar la sombra de un enemigo inmovilizado, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>.",
        "ult": "Dispara un proyectil de sombra penetrante, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a campeones enemigos golpeados y <#ef5350ff>desterrándolos durante {BanishTime}s<>."
      },
      "shield_bearer": {
        "name": "Portador de escudo",
        "skill": "Otorga un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de HP máx.<> a un aliado y a ti mismo por {Duration}s.",
        "skill2": "Durante {Duration}s recibe el {Damage}% del daño infligido a aliados cercanos y <#ef5350ff>ralentiza a los atacantes un {Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefCoef}% de la armadura<>.",
        "ult": "Obtiene durante {Duration}s <#e8d44dff>{DamageReduce}%<> + <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MrCoef}% de la resistencia mágica<> de reducción de daño e inmunidad al control, mientras <#ef5350ff>provoca a todos los enemigos cercanos durante {TauntDuration}s<>. No puede moverse mientras está activo."
      },
      "soldier": {
        "name": "Soldado",
        "skill": "Alcance de ataque aumenta en <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>{GrowthRange}<> por nivel.",
        "skill2": "Dispara tres balas a un enemigo para <#ff9028ff>daño físico<> pesado (<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque por bala). Alcance de habilidad escala con alcance de ataque básico.",
        "ult": "Dispara una bala enorme que vuela en línea recta para impactar a los enemigos dentro de {Range}. La bala inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en la trayectoria, y cada vez que golpea a un enemigo, el daño se reduce un {Decay}%."
      },
      "swordman": {
        "name": "Espadachín",
        "skill": "Dispara energía de espada para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a enemigos golpeados (alcance {Range}).",
        "skill2": "Corta un objetivo único tres veces en sucesión para <#ff9028ff>daño físico<> pesado. <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque por golpe.",
        "ult": "Carga {Range} distancia en línea recta, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a los enemigos dentro del rango de carga. Si mata a un enemigo con la definitiva, el tiempo de reutilización de la definitiva se reinicia."
      },
      "taoist": {
        "name": "Taoísta",
        "skill": "Sella a un enemigo con un talismán, infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> e <#ef5350ff>impidiendo ataques básicos durante {Time}(+{TimeCoef}% del poder de habilidad)s<>.",
        "skill2": "Pega un talismán a un enemigo, infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> e <#ef5350ff>impidiendo el uso de habilidades durante {Time}(+{TimeCoef}% del poder de habilidad)s<>.",
        "ult": "Dispara un proyectil de talismán en línea recta. Causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> e <#ef5350ff>incapacita al objetivo durante {Time}s<>, haciéndolo no objetivo. Cuando el efecto termina, se extiende a enemigos cercanos."
      },
      "vampire": {
        "name": "Vampiro",
        "skill": "Drena sangre de un enemigo para infligir <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>, <#6aff55ff>restaurar<> <#6aff55ff>{Heal}<> salud y apilar. Curación aumenta en {Stack} por pila.",
        "skill2": "Consume {Value}% salud para escupir sangre en un cono frontal, infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%<> del poder de habilidad como <#a974ffff>daño mágico<>. Daño aumenta en {Stack} por pila.",
        "ult": "Se vuelve inalcanzable y carga {Range} distancia, <#6aff55ff>absorbiendo salud<> igual a <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de poder de habilidad<> de cada enemigo en la trayectoria, e infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% de poder de habilidad<> como <#a974ffff>daño mágico<>."
      },
      "werewolf": {
        "name": "Hombre lobo",
        "skill": "Garra hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#6aff55ff>curándose el {HealRatio}% del daño causado<>.",
        "skill2": "Se desplaza hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Canaliza durante <#ffb900ff>{Duration}s<>, causando repetidamente <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y aplicando <#ef5350ff>sangrado durante {BleedTime}s<> (<#ff9028ff>{BleedDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BleedCoef}% AD<>)."
      },
      "dokkaebi": {
        "name": "Dokkaebi",
        "skill": "Mejora la maza durante <#ffb900ff>{Duration}s<>. Cada ataque crea una onda de choque en abanico que causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>.",
        "skill2": "Refuerza la piel durante <#ffb900ff>{Duration}s<>, obteniendo un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> y <#e8d44dff>{DamageReduction}% de reducción de daño<>.",
        "ult": "Dispara un proyectil en línea recta. Los enemigos golpeados son <#ef5350ff>ralentizados gradualmente durante {SlowTime}s<>, luego <#ef5350ff>enraizados durante {BindTime}s<>. Al enraizarse, causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a enemigos cercanos. El efecto se propaga a enemigos dañados."
      },
      "hammerer": {
        "name": "Infantería pesada",
        "skill": "Balancea un martillo a un enemigo cercano para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>lanzarlo al aire por {Time}s<>.",
        "skill2": "Concéntrate con el martillo levantado, luego golpea el suelo para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> en {Range} y aplicar <#ef5350ff>{Move}% de ralentización por {Time}s<>.",
        "ult": "Balancea el martillo ampliamente, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en un área semicircular dentro del rango {Range} al frente. Los enemigos golpeados por el martillo son empujados hacia atrás durante {Time}s, y los campeones enemigos golpeados por el enemigo empujado <#ef5350ff>quedan en el aire durante {Airborne}s<>."
      },
      "inquisitor": {
        "name": "Inquisidor",
        "skill": "Se desplaza una distancia corta, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> al primer enemigo golpeado y aplicando <#ef5350ff>sangrado<>.",
        "skill2": "Corta a un enemigo objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Reinicia el cooldown de la Habilidad 1 si está <#ef5350ff>sangrando<>.",
        "ult": "Embiste a un campeón enemigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos en el área al llegar. Los enemigos por debajo del {Threshold}% del HP máximo tras recibir daño son ejecutados. Al ejecutar, los enemigos cercanos son <#ef5350ff>aterrorizados durante {FearTime}s<>."
      },
      "pole_warrior": {
        "name": "Guerrero de pértiga",
        "skill": "Salta a un enemigo y golpea con la pértiga para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<>.",
        "skill2": "Mueve una corta distancia, párate en la pértiga para volverte inalcanzable por {Time}s, luego balancea para infligir <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del daño de ataque como <#ff9028ff>daño físico<> a todos los enemigos en {Range}.",
        "ult": "Carga contra un enemigo designado dentro del rango {Range}, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del poder de ataque<> como <#ff9028ff>daño físico<> al enemigo y <#ef5350ff>eleva al objetivo en el aire durante {Time}s<>."
      },
      "spirit_caller": {
        "name": "Invocador de espíritus",
        "skill": "Adhiere un espíritu a un aliado durante <#ffb900ff>{Duration}s<>, <#6aff55ff>restaurando vida<> en <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealRatio}% PH<> y aumentando la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {SpeedUp}%<>.",
        "skill2": "Une un espíritu a un enemigo durante <#ffb900ff>{Duration}s<>, reduciendo <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armadura en {DefDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefCoef}% del poder de habilidad<>, <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>resistencia mágica en {MrDown}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MrCoef}% del poder de habilidad<> y <#ef5350ff>ralentizando un {Slow}%<>.",
        "ult": "Detona los espíritus adheridos. Los espíritus aliados otorgan <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<>. Los espíritus enemigos causan <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#ef5350ff>aturden durante {StunTime}s<>."
      },
      "whip_master": {
        "name": "Maestro del látigo",
        "skill": "Hace girar el látigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% del HP del objetivo<>.",
        "skill2": "Hace girar el látigo en cono, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y empujando enemigos.",
        "ult": "Canaliza durante <#ffb900ff>{Duration}s<>, disparando proyectiles penetrantes que causan <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>."
      },
      "enchanter": {
        "name": "Encantador",
        "skill": "Mejora a un aliado durante <#ffb900ff>{Duration}s<>, aumentando el <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>alcance en {Increase}<>.",
        "skill2": "Mejora el equipo aliado durante <#ffb900ff>{Duration}s<>, aumentando los atributos de los objetos un <#ffb900ff>{Percent}%<>.",
        "ult": "Empodera a un campeón aliado durante {Duration}s, otorgando <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{AttackRatio}% PH<>), <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque {AttackSpeed}%<>, <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento {MoveSpeed}%<> e inmunidad al control de masas."
      },
      "siege_breaker": {
        "name": "Rompedor de asedio",
        "skill": "Golpea con un mangual, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<>. Causa {Bonus}% de daño bonus a estructuras.",
        "skill2": "Golpea el suelo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos incluidas estructuras.",
        "ult": "Durante {Time}s, aumenta el <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>ataque en {Attack}%<>, la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque un {AttackSpeed}%<> y la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {MoveSpeed}%<>."
      },
      "prisoner": {
        "name": "Prisionero",
        "skill": "Lanza una bola de hierro en línea, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos en el área.",
        "skill2": "Ruge para obtener un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de la salud máxima<> durante {Time}s y <#ef5350ff>provocar<> a todos los enemigos cercanos.",
        "ult": "Embiste a un enemigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos cerca del punto de aterrizaje y <#ef5350ff>aturdiéndolos durante {Time}s<>."
      },
      "android": {
        "name": "Androide",
        "skill": "Dispara una onda de choque en línea recta. La onda explota en círculo al impactar a un enemigo o alcanzar el rango máximo, infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>ralentizando enemigos en {Slow}% por {Time}s<>.",
        "skill2": "Se otorga un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de la salud máxima<> durante {Time}s. Cuando el escudo desaparece, <#ef5350ff>aturde a enemigos en alcance {Range} durante {StunTime}s<>.",
        "ult": "Otorga a un aliado designado en alcance {Range} un <#e8d44dff>escudo<> de <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{Coef}% de la salud máxima<> y se teletransporta a ese aliado tras {Time}s."
      },
      "white_mage": {
        "name": "Mago blanco",
        "skill": "Un haz explota tras un retraso, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> a todos los enemigos.",
        "skill2": "Invoca haces para atacar 5 veces, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>.",
        "ult": "Dispara un haz penetrante, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> a enemigos golpeados y <#ef5350ff>enraizando durante {Time}s<>."
      },
      "wind_mage": {
        "name": "Mago de viento",
        "skill": "Invoca un torbellino durante <#ffb900ff>{Duration}s<>, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> cada {Tick}s en {Range}. Los aliados dentro ganan <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>.",
        "skill2": "Dispara cinco torbellinos hacia adelante, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>.",
        "ult": "Lanza un tornado masivo. Los enemigos golpeados reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y son <#ef5350ff>lanzados al aire durante {AirborneTime}s<>. Tamaño, daño y tiempo en el aire disminuyen por golpe. Redirige a otros campeones."
      },
      "bomber": {
        "name": "Bombardero",
        "skill": "Lanza una bomba, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> a todos los enemigos en el área.",
        "skill2": "Coloca una mina invisible que causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% AD<> de <#ff9028ff>daño físico<> y <#ef5350ff>enraiza durante {Time}s<> al pisarla. No se activa con minions.",
        "ult": "Lanza una bomba grande al área objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a todos los enemigos y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>."
      },
      "cavalry_knight": {
        "name": "Jinete de Caballería",
        "skill": "Carga en línea recta para empalar al primer enemigo golpeado, <#ef5350ff>enraizando por {Time}s<> e infligiendo <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. La velocidad de carga escala con la velocidad de movimiento.",
        "skill2": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {Speed}%<> durante {Time}s y fortalece el arma como lanza ígnea, haciendo que los ataques inflijan <#ff9028ff>{BurnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{BurnCoef}% del daño de ataque<> como daño de quemadura adicional durante {BurnTime}s.",
        "ult": "Aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento un {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% del daño de ataque<> durante {Time}s y crea una zona que conduce a su ubicación. Los aliados sobre la zona obtienen <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{Buff}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SpeedCoef}% del daño de ataque<> de velocidad de movimiento al moverse hacia la caballería."
      },
      "druid": {
        "name": "Druida",
        "skill": "Invoca un oso. Si muere, el druida recibe <#ff9028ff>{DeathDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DeathCoef}% PH<> de daño. Lanzar mientras está invocado <#6aff55ff>restaura<> la salud del oso en <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<>.",
        "skill2": "Invoca un águila. Si muere, el druida recibe daño. Si usa esta habilidad mientras el águila está invocada, el águila carga contra un enemigo, inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y <#6aff55ff>cura un {Lifesteal}% del daño infligido<>.",
        "ult": "Dispara {Count} proyectiles espirituales de oso y águila en la dirección designada. Cada proyectil inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<> como <#a974ffff>daño mágico<> y empuja a los enemigos hacia atrás."
      },
      "voodoo_shaman": {
        "name": "Chamán vudú",
        "skill": "Dispara un proyectil de maldición, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>, <#ef5350ff>ralentizando un {Slow}% durante {Time}s<> y reduciendo la <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>velocidad de ataque un {AtkSpd}%<> durante <#ffb900ff>{AtkSpdTime}s<>.",
        "skill2": "Maldice a un enemigo durante <#ffb900ff>{Time}s<>, causando <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<>. Causa <#a974ffff>{HitDmg}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HitCoef}% PH<> de daño bonus por golpe recibido (máx {Max}).",
        "ult": "Crea una zona vudú durante <#ffb900ff>{Duration}s<>. Los enemigos dentro reciben <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpRatio}% del HP máximo<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> periódicamente y son <#ef5350ff>silenciados<>."
      },
      "hitman": {
        "name": "Sicario",
        "skill": "Dispara una ráfaga de tres tiros. El primer tiro <#ef5350ff>aturde durante {StunTime}s<>, y cada uno de los dos tiros siguientes inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>.",
        "skill2": "Se teletransporta detrás del último campeón enemigo atacado en <#ffb900ff>{Range}<> de alcance.",
        "ult": "Marca a un campeón enemigo. Tras <#ffb900ff>{Duration}s<>, inflige <#ff9028ff>{Damage} + {Coef}% del daño recibido durante la marca<> como <#ff9028ff>daño físico<>. Al matar al objetivo, obtiene sigilo durante <#ffb900ff>{InvisibleDuration}s<>."
      },
      "guardian_spirit": {
        "name": "Guardián Espiritual",
        "skill": "<#6aff55ff>Restaura<> la salud de aliados cercanos en <#6aff55ff>{Value}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del poder de habilidad<>.",
        "skill2": "Otorga a un aliado <#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}% PH<> de <#e8d44dff>escudo<> y <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>.",
        "ult": "Crea un santuario durante <#ffb900ff>{Duration}s<> que <#6aff55ff>restaura<> continuamente a los aliados en alcance <#6aff55ff>{HealValue}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% PH<> de salud. Si 1 campeón aliado muere dentro del santuario, lo revive y el santuario termina inmediatamente."
      },
      "hunter": {
        "name": "Cazador",
        "skill": "Se teletransporta a un enemigo y cambia a modo distancia. <i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>El alcance aumenta en {RangeIncrease}<>.",
        "marks": "Los ataques básicos a distancia marcan a los campeones enemigos durante <#ffb900ff>{Duration}s<>. Los siguientes impactos renuevan las marcas existentes. La segunda habilidad puede usarse contra enemigos con 3 marcas.",
        "skill2": "Se desplaza a un enemigo marcado con 3 cargas, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>silenciando durante {SilenceTime}s<>.",
        "ult": "Se desplaza hacia adelante, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a enemigos en la trayectoria. Tras lanzarla, puede relanzarse una vez durante un breve periodo; al participar en una baja, obtiene un relanzamiento adicional."
      },
      "circus_blade": {
        "name": "Cuchilla Circense",
        "skill": "Dispara una hoja en la dirección objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>ralentizando un {Slow}% durante {SlowTime}s<>. Almacena hasta <#ffb900ff>{ChargeCount}<> cargas. Gana <#ffb900ff>1<> carga al atacar básicamente a campeones enemigos.",
        "skill2": "Gana <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}% de velocidad de movimiento<>, <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}% de velocidad de ataque<> y atraviesa muros durante <#ffb900ff>{Duration}s<>.",
        "ult": "Se desplaza a un enemigo objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Causa <#ff9028ff>{SplashDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{SplashCoef}% AD<> de daño de salpicadura y <#ef5350ff>empuja enemigos cercanos<>, luego desaparece."
      },
      "sand_mage": {
        "name": "Mago de arena",
        "skill": "Los ataques básicos llevan energía de arena e infligen <#a974ffff>{PassiveDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{PassiveCoef}% de Poder de Habilidad<> como <#a974ffff>daño mágico adicional<>. Este daño adicional y la explosión de arena pueden ser críticos. Al usarlo, hace estallar arena alrededor del objetivo e inflige <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidad<> como <#a974ffff>daño mágico en área<>.",
        "skill2": "Absorbe energía de arena durante <#ffb900ff>{Time}s<>, aumenta la <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>velocidad de movimiento en {Speed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SpeedCoef}% de Poder de Habilidad<> y <#6aff55ff>se cura<> <#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}% de Poder de Habilidad<>.",
        "ult": "Crea un pantano de arena alrededor del objetivo durante <#ffb900ff>{Duration}s<>. Cada {Tick}s, los enemigos dentro reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidad<> como <#a974ffff>daño mágico<> y son atraídos hacia el centro."
      },
      "alchemist": {
        "name": "Alquimista",
        "skill": "Lanza un frasco que explota y deja una zona tóxica durante <#ffb900ff>{Time}s<>. Los enemigos dentro quedan <#78e85cff>envenenados<> durante <#ffb900ff>{DotTime}s<>, reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidad<> como <#a974ffff>daño mágico<> cada {DotTick}s, y su curación se reduce un {HealReduce}%.",
        "skill2": "Inyecta un reactivo inestable a un enemigo, infligiendo <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidad<> como <#a974ffff>daño mágico<>. Durante <#ffb900ff>{Time}s<>, el objetivo no puede recibir curación y se ralentiza un {Slow}%.",
        "ult": "Lanza un frasco tóxico en línea recta. Al impactar a un campeón enemigo, crea una nube venenosa que se expande hasta {CloudRadius} de alcance durante <#ffb900ff>{CloudTime}s<>. Los enemigos en la nube quedan <#78e85cff>envenenados<> durante <#ffb900ff>{DotTime}s<>, reciben <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% de Poder de Habilidad<> como <#a974ffff>daño mágico<> cada {DotTick}s, y pierden <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>{DefenceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DefenceCoef}% de Poder de Habilidad<> de armadura y <i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>{MagicResistanceReduce}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{MagicResistanceCoef}% de Poder de Habilidad<> de resistencia mágica."
      },
      "crossbowman": {
        "name": "Ballestero",
        "skill": "Dispara una flecha poderosa en línea recta que inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Daño de Ataque<> como <#ff9028ff>daño físico<> al primer campeón enemigo alcanzado. Mientras dure la marca de la definitiva, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de Daño de Ataque<> de daño adicional.",
        "skill2": "Dispara hacia delante una flecha perforante en línea recta, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Daño de Ataque<> como <#ff9028ff>daño físico<> a los enemigos y retrocede durante <#ffb900ff>{BackstepTime}s<>. Mientras dure la marca de la definitiva, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{MarkCoef}% de Daño de Ataque<> de daño adicional.",
        "ult": "Dispara una bala trazadora en línea recta, inflige <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% de Daño de Ataque<> como <#ff9028ff>daño físico<> al primer campeón enemigo alcanzado y lo marca durante <#ffb900ff>{Duration}s<>. Mientras dure la marca, todas las habilidades alcanzan al objetivo sin importar la distancia y sus enfriamientos se reducen un <#ffb900ff>{CoolReduce}%<>. Otros campeones en la trayectoria pueden interceptarla."
      },
      "nightmare": {
        "name": "Pesadilla",
        "skill": "Dispara un fragmento de pesadilla en línea recta e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> al primer enemigo alcanzado. Puede usarse hasta <#ffb900ff>{UseCount} veces<> seguidas.",
        "skill2": "Se desliza <#ffb900ff>{Range}<> en la dirección elegida, luego inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a los enemigos en <#ffb900ff>{Radius}<> de alcance y se vuelve invisible durante <#ffb900ff>{StealthTime} s<>.",
        "ult": "Se desliza hasta el campeón enemigo objetivo e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Si este daño mata al objetivo, se teletransporta junto a un campeón aliado vivo sin importar la distancia."
      },
      "strongman": {
        "name": "Forzudo",
        "skill": "Agarra a un enemigo cercano, lo lanza por encima del hombro detrás de sí e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>, <#ef5350ff>aturdiéndolo durante {Stun} s<>.",
        "skill2": "Hace girar la barra en un amplio arco, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> a los enemigos en un radio de <#ffb900ff>{Range}<> y <#ef5350ff>los empuja<>.",
        "ult": "Lanza a un campeón aliado cercano hasta la ubicación seleccionada. Tras aterrizar, el aliado lanzado obtiene un <#e8d44dff>escudo de {Shield}<> durante <#ffb900ff>{ShieldTime} s<>. Los enemigos en un radio de <#ffb900ff>{Radius}<> del punto de aterrizaje reciben <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y quedan <#ef5350ff>aturdidos durante {Stun} s<>. Si no hay un aliado cercano al que lanzar, el Forzudo salta; en ese caso, el aturdimiento dura <#ef5350ff>{SelfStun} s<>."
      },
      "harpooner": {
        "name": "Arponero",
        "skill": "Dispara un arpón en línea recta que inflige <#ff9028ff>{Damage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del Daño de Ataque como <#ff9028ff>daño físico<> al primer campeón enemigo alcanzado. Durante <#ffb900ff>{RecastDuration} s<> tras impactar, puede reactivarse para atraer al usuario hacia el objetivo o atraer el objetivo hacia el usuario.",
        "skill2": "Dispara un arpón potente en línea recta que inflige <#ff9028ff>{Damage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del Daño de Ataque + un <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpCoef}%<> de la Vida que le falta al objetivo como <#ff9028ff>daño físico<> al primer enemigo alcanzado.",
        "ult": "Dispara <#ffb900ff>{ProjectileCount}<> arpones encadenados en cono frontal, infligiendo <#ff9028ff>{Damage}<> + un <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%<> del Daño de Ataque como <#ff9028ff>daño físico<> y atando a los alcanzados durante <#ffb900ff>{LinkDuration} s<>. Los enemigos atados se ralentizan un <#ef5350ff>{Slow}%<>. Si se separan más de <#ffb900ff>{LinkRange}<>, las cadenas se tensan: la ralentización sube al <#ef5350ff>{TensionSlow}%<> y son atraídos entre sí."
      },
      "spellbreaker": {
        "name": "Rompehechizos",
        "skill": "Barre el frente con el mandoble, inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del Ataque<> de <#ff9028ff>daño físico<> y <#ef5350ff>ralentiza un {Slow}% durante {Time} s<>.",
        "skill2": "Carga una corta distancia e inflige <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del Ataque<> de <#ff9028ff>daño físico<> al primer enemigo alcanzado. Tras la carga, <#ffb900ff>el daño recibido se reduce un {Reduce}% durante {Time} s<>.",
        "ult": "Destruye al instante todos los escudos de los enemigos en un radio de <#ffb900ff>{Range}<>. Un enemigo cuyo escudo sea destruido recibe <#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% del Poder Mágico<> de <#a974ffff>daño mágico<>, queda <#ef5350ff>aturdido durante {Stun} s<> y <#ffb900ff>no puede obtener escudos durante {BlockTime} s<>. Los enemigos sin escudo solo reciben <#a974ffff>{Damage} de daño mágico<>."
      },
      "gladiator": {
        "name": "Gladiador",
        "skill": "Lanza una red en abanico de <#ffb900ff>{FanAngle}°<>, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>enraizando<> a los enemigos durante <#ffb900ff>{Stun}s<>.",
        "skill2": "Ataca hacia delante con el tridente, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<>. Golpear al mismo campeón en menos de <#ffb900ff>{Time}s<> añade un <#ffb900ff>{Amplify}%<> de daño por acumulación, hasta <#ffb900ff>{MaxAmplifyTargets}<> acumulaciones. Golpear a otro campeón reinicia las acumulaciones.",
        "ult": "Embiste a un campeón enemigo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> y <#ef5350ff>provocándolo<> durante <#ffb900ff>{Stun}s<>. Durante el duelo, el objetivo no puede curarse ni recibir escudos nuevos, y el Gladiador recibe un <#ffb900ff>{Amplify}%<> menos de daño de otros enemigos. El duelo termina si se purifica la provocación o muere el objetivo."
      },
      "ferryman": {
        "name": "Barquero",
        "skill": "Lanza un ancla que golpea al primer campeón en su trayectoria. Un aliado con un <#ffb900ff>{AllyHpRatio}%<> de vida o menos es atraído junto al Barquero y gana un <#ffb900ff>{Amplify}%<> de velocidad de movimiento durante <#ffb900ff>{Time}s<>. Los aliados con más vida son ignorados. Un enemigo recibe en su lugar <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y es ralentizado un <#ffb900ff>{Slow}%<> durante <#ffb900ff>{SlowTime}s<>.",
        "skill2": "Crea delante un río de <#ffb900ff>{Range}<> de largo y <#ffb900ff>{Width}<> de ancho durante <#ffb900ff>{Time}s<>. Los aliados sobre él ganan un <#ffb900ff>{Amplify}%<> de velocidad de movimiento, y los enemigos son ralentizados un <#ffb900ff>{Slow}%<>.",
        "ult": "Purifica a otro campeón aliado con un <#ffb900ff>{AllyHpRatio}%<> de vida o menos y lo lleva en barca <#ffb900ff>{MoveDistance}<> hacia la base aliada durante <#ffb900ff>{Time}s<>. El pasajero es inalcanzable, no puede actuar y es inmune al control de movimiento. Al desembarcar, recupera <#6aff55ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#6aff55ff>{Coef}% PH<> de vida y gana un <#ffb900ff>{Slow}%<> de velocidad de movimiento durante <#ffb900ff>{SlowTime}s<>."
      },
      "bombardier": {
        "name": "Artillero",
        "skill": "Despliega o recoge el cañón. Desplegado no puede moverse, pero el alcance de sus ataques básicos y de su habilidad 2 aumenta en <#ffb900ff>{MoveDistance}<> y obtiene <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>un {Amplify}% de ataque<>. Al recogerlo, gana un <#ffb900ff>{Slow}%<> de velocidad de movimiento durante <#ffb900ff>{Time}s<>.",
        "skill2": "Lanza un proyectil parabólico a la zona objetivo, causando <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> en un radio de <#ffb900ff>{Radius}<> y ralentizando a los enemigos un <#ffb900ff>{Slow}%<> durante <#ffb900ff>{SlowTime}s<>. Desplegado, aumenta el alcance.",
        "ult": "Dispara <#ffb900ff>{ProjectileCount}<> proyectiles sobre la zona elegida. Cada uno causa <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}% del daño de ataque<> como <#ff9028ff>daño físico<> en un radio de <#ffb900ff>{ProjectileRadius}<>. Desplegado, el alcance aumenta además en <#ffb900ff>{MoveDistance}<>. El control de masas interrumpe los disparos restantes."
      },
      "hypnotist": {
        "name": "Hipnotizador",
        "skill": "Lanza un péndulo perforante que causa <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}% PH<> de <#a974ffff>daño mágico<> y ralentiza un <#ffb900ff>{Slow}%<> durante <#ffb900ff>{SlowTime}s<>. Este daño no despierta a los enemigos <#ef5350ff>dormidos<>.",
        "skill2": "Tras <#ffb900ff>{Delay}s<>, <#ef5350ff>duerme<> a los enemigos en un radio de <#ffb900ff>{Radius}<> durante <#ffb900ff>{Time}s<>. Los dormidos no pueden moverse ni actuar. El daño, incluido el daño con el tiempo, despierta al objetivo, y ese primer golpe causa un <#ffb900ff>{Amplify}%<> más de daño.",
        "ult": "Tras <#ffb900ff>{Delay}s<>, <#ef5350ff>duerme<> a los enemigos en un radio de <#ffb900ff>{Radius}<> durante <#ffb900ff>{Time}s<>. El daño despierta al objetivo, y el golpe que lo despierta causa un <#ffb900ff>{Amplify}%<> más de daño. La purificación elimina el <#ef5350ff>sueño<> y su bonificación de daño."
      }
    }
  },
