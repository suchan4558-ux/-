      "cloud_start_radius": "毒雲初始範圍",
      "cloud_end_radius": "毒雲最大範圍",
      "cloud_expand_speed": "毒雲擴散速度",
      "cloud_edge_thickness": "毒雲邊緣厚度",
      "projectile_time": "投射物飛行時間",
      "first_delay": "首次觸發延遲",
      "defence_reduce": "物理防禦降低",
      "magic_resistance_reduce": "魔法防禦降低",
      "ap_defence_reduce_coef": "物理防禦降低魔法攻擊係數",
      "ap_magic_resistance_reduce_coef": "魔法防禦降低魔法攻擊係數",
      "damage_reduce": "受傷減免",
      "projectile_count": "投射物數量",
      "fan_angle": "扇形角度",
      "damage_amplify": "傷害增幅",
      "max_target_count": "最大目標數",
      "stop_distance": "停止距離",
      "link_range": "鎖鏈長度",
      "target_pull_speed": "目標拉扯速度",
      "missing_hp_coef": "已損失生命值係數",
      "pull_speed": "拉扯速度",
      "link_time": "鎖鏈持續時間",
      "structure_bonus": "對建築額外傷害"
    },
    "description": {
      "astrologer": {
        "name": "占星術師",
        "skill": "在指定位置於<#ffb900ff>{Delay}秒<>後召喚隕星墜落，對範圍內的敵人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術強度的{Coef}%<><#a974ffff>魔法傷害<>，並使其移動速度降低<#ef5350ff>{Slow}%<>，持續<#ef5350ff>{SlowTime}秒<>。",
        "skill2": "對直線上的敵人造成<#a974ffff>{LinkDamage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術強度的{Coef}%<><#a974ffff>魔法傷害<>，並留下星座標記。標記持續<#ffb900ff>{MarkTime}秒<>，帶有標記的敵人會在終極技能的星座爆炸中受到額外傷害。",
        "ult": "在指定範圍內繪製星座，為所有敵人留下標記。<#ffb900ff>{Delay}秒<>後，所有標記同時爆炸，造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術強度的{Coef}%<><#a974ffff>魔法傷害<>。每多連結一名敵人，傷害提高<#ffb900ff>{Amplify}%<>。 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>已帶有印記的敵人額外受到法術強度{MarkCoef}%<>的傷害。"
      },
      "archer": {
        "name": "弓箭手",
        "skill": "向指定方向跳躍，對最近攻擊過的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "向附近敵人發射箭矢造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，使其短暫<#ef5350ff>僵直<>，並向後跳躍拉開距離。",
        "ult": "停在原地，連續發射 {Count} 支箭。箭矢隨機飛向附近 {Range} 範圍內的敵人，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。"
      },
      "bard": {
        "name": "吟遊詩人",
        "skill": "提升一名隊友<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeed}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#ceff99ff>攻擊速度<>，持續<#ffb900ff>{Duration}秒<>。",
        "skill2": "降低範圍內隊友的技能冷卻時間(<#ffb900ff>{CoolReduce}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>)%，持續{Duration}秒。",
        "ult": "在<#ffb900ff>{Duration} 秒<>內持續演奏詩歌激勵隊友，使周圍{Range}範圍內的隊友<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加 {Attack}<>(+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff> {AttackRatio}%魔法攻擊<>)， <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法攻擊增加 {MagicPower}<>， <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度增加 {AttackSpeed}%<>，並使技能冷卻時間縮短 {CoolReduce}%。但同時<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>防禦力降低 {DefenceReduce}%<>，<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0><#88ccffff>魔法防禦降低 {MagicResistanceReduce}%<>。"
      },
      "barrier_magician": {
        "name": "結界師",
        "skill": "在指定區域設置維持<#ffb900ff>{Duration}秒<>的結界，為結界內的隊友提供<#e8d44dff>{Shield}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{ShieldCoef}%魔法攻擊<>的<#e8d44dff>護盾<>，並降低敵人<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>{AttackSpeedReduce}%攻擊速度<>。技能等級3級起，結界範圍增加，並額外提升結界內隊友的<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度<>，並使敵人被<#ef5350ff>緩速<>。",
        "skill2": "在指定區域創造維持<#ffb900ff>{Duration}秒<>的結界，消除其範圍內的所有投射物。",
        "ult": "在敵方英雄周圍設置逐漸縮小的圓形結界。觸碰結界邊緣的敵人受到<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>並被<#ef5350ff>暈眩{Time}秒<>。"
      },
      "berserker": {
        "name": "狂戰士",
        "skill": "進入狂怒狀態，持續 {Duration}秒。期間 <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度提升 {AttackSpeed}%<>，並獲得 <#6aff55ff>{Vamp}% 吸血<>。",
        "skill2": "雙手猛擊地面，擊飛小範圍內的敵人<#ef5350ff>{Time}秒<>並造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "衝向 {Range} 距離內指定的敵人並重擊目標，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。依據已損失的<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>生命值<>比例減少該技能的冷卻時間。"
      },
      "boomerang_hunter": {
        "name": "迴旋鏢獵人",
        "skill": "朝直線方向投擲迴旋鏢，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。迴旋鏢在攻擊距離最遠處旋轉，對觸碰的敵人持續造成<#ff9028ff>{DotDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{DotCoef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "向三個方向投擲迴旋鏢，迴旋鏢飛至盡頭後返回，對路徑上所有敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "朝直線方向發射強力迴旋鏢，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。命中敵方英雄時，會彈射至距離最近的另一名敵方英雄；每次彈射使傷害增加 <#ff9028ff>{Increase}%<>。最多彈射 {MaxBounce} 次。"
      },
      "chef": {
        "name": "廚師",
        "skill": "朝直線方向投擲菜刀，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>，並使敵人<#ef5350ff>緩速{Slow}%{SlowTime}秒<>。",
        "skill2": "向周圍隊友分發料理，持續回復<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%魔法攻擊<>的<#6aff55ff>生命值<>。若僅回復自身，回復量增加為<#6aff55ff>{SelfHeal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{SelfHealCoef}%魔法攻擊<>。",
        "ult": "向友方英雄投擲特製料理，使其 <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值提升 {HpRatio}%<>，持續 <#ffb900ff>{Duration}秒<>。期間所受傷害的 <#e8d44dff>{SpreadRatio}%<> 會轉化為持續傷害。"
      },
      "clown": {
        "name": "小丑",
        "skill": "瞬間移動到目標旁。若為敵人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並獲得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>{MoveSpeed}%移動速度<>，持續<#ffb900ff>{Duration}秒<>。",
        "skill2": "向周圍擲出大量短劍，對範圍內敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。(施放期間可自由移動)",
        "ult": "進入瘋狂狀態<#ffb900ff>{Time}秒<>，所有短劍變為可在敵人間反彈的特殊短劍。"
      },
      "dancer": {
        "name": "舞者",
        "skill": "向敵人投擲環刃，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。每個額外環刃都會使此技能傷害提高{StackCoef}%。",
        "skill2": "每擊殺一名敵人，普通攻擊額外增加 1 個環刃。（最多 <#ffb900ff>{MaxCount}<> 個，以額外環刃進行連續攻擊時，傷害每次降低 <#ffb900ff>{Reduce}%<>）",
        "ult": "向扇形範圍發射 {Count}(+額外環刃個數) 個穿透環刃，造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。環刃抵達終點後會折返，額外造成 <#ff9028ff>{ReturnDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{ReturnCoef}%物理攻擊<>的<#ff9028ff>物理傷害<>。（最多 {MaxCount} 個）"
      },
      "dark_mage": {
        "name": "黑魔法師",
        "skill": "發射黑暗法箭，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>，並<#ef5350ff>束縛敵人{Time}秒<>。",
        "skill2": "短暫延遲後，以黑暗籠罩指定區域，對區域內敵人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。",
        "ult": "詛咒{Range}範圍內的敵方英雄，使其與距離最近的隊友連結，持續<#ffb900ff>{Duration}秒<>。連結中的任一方受到傷害時，另一方也會受到相當於<#a974ffff>{ShareRatio}%<>該傷害的傷害。"
      },
      "demon": {
        "name": "惡魔",
        "skill": "地面竄出地獄魔爪抓住敵人，命中時造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並交換敵人和自己的位置。",
        "skill2": "變身為大惡魔，持續{Time}秒。期間<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>物理防禦增加{Defense}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度提升{AttackSpeed}%<>，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度提升{MoveSpeed}%<>。",
        "ult": "對周圍{Range}範圍內的所有敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使其陷入<#ef5350ff>恐懼<>，持續<#ef5350ff>{Time}秒<>。"
      },
      "dual_blader": {
        "name": "雙劍士",
        "skill": "朝直線方向發射劍氣，對命中的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並<#ef5350ff>束縛<>目標{Time}秒。",
        "skill2": "朝{Range}範圍內處於<#ef5350ff>不可移動<>狀態的敵人突進，<#ef5350ff>擊飛<>命中的敵人{Time}秒，並造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "對指定 {Range} 範圍內的一名敵人發動連續斬擊，共造成{Count}次<#f5f5f5ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#f5f5f5ff>真實傷害<>。"
      },
      "executioner": {
        "name": "處刑人",
        "skill": "投擲彎鉤，對命中的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>並將其拉到自身面前。",
        "skill2": "用鉤子撕裂1名敵人，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使其<#ef5350ff>流血{Duration}秒<>。流血傷害每{Tick}秒造成<#ff9028ff>{TickDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{TickCoef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使目標<#ef5350ff>受到傷害提高{Debuff}%<>。",
        "ult": "以彎鉤掃掠前方{Range}範圍內的半圓區域，對敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的 <#ff9028ff>物理傷害<>，並使其陷入<#ef5350ff>無法回復<>的狀態，持續<#ef5350ff>{Time}秒<>。"
      },
      "exorcist": {
        "name": "驅魔師",
        "skill": "解除一名隊友身上的<#ef5350ff>異常狀態<>，並使其<#6aff55ff>恢復{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#6aff55ff>生命值<>。 可解除暈眩、睡眠、禁錮、恐懼、魅惑、嘲諷、擊飛與強制位移；無法解除以增益或減益形式施加的效果，例如緩速或中毒。",
        "skill2": "為一名隊友降下<#ffb900ff>{Duration}秒<>的神聖加護，期間<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度增加{AttackSpeed}%<>。效果持續期間，會將受到的控制效果反射給敵人。",
        "ult": "在目標區域產生爆炸，對敵人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。目標身上每擁有一項增益，額外造成<#a974ffff>{BonusDamage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{BonusCoef}%魔法攻擊<>的額外傷害。"
      },
      "fighter": {
        "name": "格鬥家",
        "skill": "以{Speed}速度向{Range}距離內的目標衝鋒，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使其<#ef5350ff>暈眩{Stun}秒<>。",
        "skill2": "用腳猛踏地面，對{Range}範圍內所有敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使其<#ef5350ff>緩速{Slow}%，持續{SlowTime}秒<>。",
        "ult": "重擊地面，對周圍{Range}範圍內所有敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並將其<#ef5350ff>擊飛{Time}秒<>。"
      },
      "gambler": {
        "name": "賭徒",
        "skill": "擲出骰子，依骰出的點數對{Range}範圍內的敵人發動同等次數的攻擊。每次攻擊造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "投擲籌碼，在{Range}攻擊距離內生成一個{AttackRange}大小的區域，持續{Time}秒。區域內敵人會受到<#ef5350ff>{Slow}%緩速<>，區域消失時爆炸，對範圍內敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "發射大量金幣魅惑直線上的敵人，對命中的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並使其陷入<#ef5350ff>魅惑{Time}秒<>。"
      },
      "ghost": {
        "name": "幽靈",
        "skill": "進入無法被指定狀態朝直線衝刺。每次參與擊殺時，<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加{Attack}<>、<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度提升{AttackSpeed}%<>，並<#6aff55ff>恢復{Heal}生命值<>。",
        "skill2": "向前短距離衝刺，對第一個碰撞到的敵人造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。最多可連續使用{Time}次。",
        "ult": "在<#ffb900ff>{Time}秒<>內免疫移動控制效果。參與擊殺敵人時，重置基礎技能的冷卻時間。"
      },
      "gunner": {
        "name": "槍手",
        "skill": "可以在移動時攻擊敵人。從3級開始，每次攻擊敵人時<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度提升{Value}%<>，持續{Time}秒。",
        "skill2": "攻擊強化{Time}秒，期間<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加{Attack}<>，且每3次攻擊，子彈對敵人施加<#ef5350ff>{Slow}%緩速<>，持續{SlowTime}秒。",
        "ult": "攻擊強化{Time}秒，期間<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻擊增加{Attack}<>，並向目標周圍的2名敵人發射額外子彈。額外的子彈會造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。"
      },
      "ice_mage": {
        "name": "冰霜法師",
        "skill": "凍結一名敵人，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>並使其<#ef5350ff>暈眩{Time}秒<>。",
        "skill2": "在指定位置召喚持續{Duration}秒的冰霜區域，使{Range}範圍內的敵人<#ef5350ff>移動速度降低{MoveSpeed}%<>，區域內每{Tick}秒造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。冰霜區域消失時，凍結範圍內敵人，並使其暈眩<#ef5350ff>{Stun}秒<>。",
        "ult": "對前方扇形範圍的敵人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>並將其擊退。隨後使其<#ef5350ff>緩速{Slow}%，持續{SlowDuration}秒<>，且封印其位移技能<#ef5350ff>{BlockDuration}秒<>。"
      },
      "illusionist": {
        "name": "幻術師",
        "skill": "發射擾亂敵人的投射物，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>，命中後在敵人面前召喚幻術師的分身，嘲諷其 <#ef5350ff>{Time} 秒<>。",
        "skill2": "對{Range}範圍內敵人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>，並使其陷入<#ef5350ff>恐懼{Time}秒<>。",
        "ult": "在附近生成一名隊友的幻象，持續<#ffb900ff>{Duration}秒<>。幻象只能進行普通攻擊，且能力值等同於被複製的英雄。"
      },
      "jiangshi": {
        "name": "殭屍",
        "skill": "召喚小殭屍撲向敵人進行攻擊，小殭屍會在攻擊3次後消失，每次攻擊造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "重擊敵人，使其陷入<#ef5350ff>暈眩{Time}秒<>，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>，並<#6aff55ff>恢復{Heal}生命值<>。",
        "ult": "在<#ffb900ff>{Duration}秒<>內，從周圍{Range}範圍內的敵人吸取<#6aff55ff>{Heal}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{HealCoef}%魔法攻擊<>的<#6aff55ff>生命值<>，並造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{DamageCoef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。"
      },
      "knight": {
        "name": "騎士",
        "skill": "使指定目標受到<#ef5350ff>嘲諷{Time}秒<>。",
        "skill2": "賦予自身持續 {Time}秒的<#e8d44dff>護盾<>（<#e8d44dff>護盾<>量為：<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值{Coef}%<> + <#e8d44dff>{Amount}<>）。護盾存在期間，<#ff9028ff>反射{Reflect}%<>所受傷害。",
        "ult": "在指定位置召喚一個範圍為{Range}、持續<#ffb900ff>{Time}秒<>的守護領域。領域內隊友受到的傷害降低<#e8d44dff>{Coef}%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大生命值的{HpCoef}%<>，領域內的敵人則會<#ef5350ff>減速{MoveSpeedReduce}%<>。"
      },
      "lancer": {
        "name": "長槍兵",
        "skill": "擊退周圍{Range}範圍內的敵人，並造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "skill2": "向前短距離衝刺，穿過敵人移動到其身後，造成<#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Value}%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "ult": "向前突進 {Range} 距離，對沿途碰撞到的所有敵人造成 <#ff9028ff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>{Coef}%物理攻擊<> 的 <#ff9028ff>物理傷害<>，並將其 <#ef5350ff>擊飛 {Time} 秒<>。"
      },
      "lightning_mage": {
        "name": "雷電法師",
        "skill": "向指定目標發射閃電，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。閃電會在範圍內有其他目標時持續傳遞，但不會重複作用於同一目標。",
        "skill2": "在指定區域內降下閃電，對命中的敵人造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>，並使其 <#ef5350ff>暈眩{Time}秒<>。",
        "ult": "對敵方英雄持續發射閃電光束<#ffb900ff>{Duration}秒<>，期間目標將陷入<#ef5350ff>暈眩<>，並對目標及周圍敵人持續造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。"
      },
      "magic_knight": {
        "name": "魔劍士",
        "skill": "在一條狹長的直線範圍內引爆魔力，造成<#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<>的<#a974ffff>魔法傷害<>。",
        "skill2": "在小範圍內生成持續 {Duration} 秒的魔力核心，每 {Tick} 秒將 {Range} 範圍內的敵人逐漸拉向中心，並造成 <#a974ffff>{Damage}<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%魔法攻擊<> 的 <#a974ffff>魔法傷害<>。",
        "ult": "在<#ffb900ff>{Time}秒<>內，<i#asset/base/ui/banpick/champion_stat_icon:range_0><#ff86c2ff>攻擊距離增加{Range}<>，<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度增加{AttackSpeed}%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔法攻擊的{AttackSpeedCoef}%<>，且每次普通攻擊都會觸發技能一。"
      },
      "monk": {
        "name": "僧侶",
        "skill": "為周圍{Range}範圍內的友方英雄<#6aff55ff>恢復{Value}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法術強度<>點<#6aff55ff>生命值<>。若僅治療自身，則恢復量提升為<#6aff55ff>{SingleValue}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法術強度<>。",
        "skill2": "降下如來神掌懲戒敵人，對{Range}範圍內的敵人造成<#a974ffff>{Damage}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法術強度<>點<#a974ffff>魔法傷害<>，並使其<#ef5350ff>眩暈{Time}秒<>。",
        "ult": "為周圍{Range}範圍內的己方英雄施加<#e8d44dff>{Shield}<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>{Coef}%法術強度<>點<#e8d44dff>護盾<>。獲得護盾的己方英雄<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度增加{MoveSpeed}%<>。"
      },
      "necromancer": {
        "name": "死靈法師",
        "skill": "召喚食屍鬼，並驅使其作戰，持續<#ffb900ff>{Duration}(+法術強度的{DurationCoef}%)秒<>。隨着等級提升，該技能的冷卻時間降低，且食屍鬼的持續時間每級增加<#ffb900ff>{DurationPerLevel}秒<>。",
        "skill2": "將一名敵人指定為食屍鬼的攻擊目標，持續<#ffb900ff>{Time}秒<>，並使食屍鬼狂暴。令食屍鬼的<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻擊速度增加{AttackSpeed}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術強度的{AttackSpeedCoef}%<>，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度增加{MoveSpeed}%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術強度的{MoveSpeedCoef}%<>。",
        "ult": "將一名死亡的友方英雄復生為亡靈。維持復生期間英雄亡靈每秒減少<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>{HpDrain}生命值<>。"
      },
      "ninja": {
